<mxfile host="thecodeclouds.com" agent="hand-built" version="24.0.0" type="device">
<diagram id="promotion" name="2. Promotion across accounts"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="840" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Promotion: the same digest moves dev, staging, prod, one pull request at a time" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1200" height="24" as="geometry"/></mxCell>
<mxCell id="c2" value="A CodePipeline V2 promotion pipeline decides when. Git records what. Argo CD in each environment makes it so. Rebuilding per environment is not allowed." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1400" height="18" as="geometry"/></mxCell>
<mxCell id="c3" value="&lt;b&gt;Tooling account: promotion pipeline (CodePipeline V2, QUEUED execution mode)&lt;/b&gt;" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="1460" height="250" as="geometry"/></mxCell>
<mxCell id="img" value="Image built + signed&lt;br&gt;sha256:9f3c...e21&lt;br&gt;ci run #4182" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#ED7100;fillColor=#FFF4E5;fontColor=#232F3E;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="45" y="139" width="190" height="70" as="geometry"/></mxCell>
<mxCell id="pdev" value='&lt;b&gt;Stage: dev&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;CodeBuild opens PR,&lt;br&gt;bot auto-merges&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codebuild;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="320" y="150" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="g1" value="Entry conditions&lt;br&gt;LambdaInvoke rule: Argo CD&lt;br&gt;app Synced + Healthy,&lt;br&gt;smoke + API tests pass" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#DD344C;fillColor=#FDEDEF;fontColor=#232F3E;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="455" y="119" width="230" height="110" as="geometry"/></mxCell>
<mxCell id="pstg" value='&lt;b&gt;Stage: staging&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;PR auto-merged&lt;br&gt;after gate&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codebuild;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="150" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="g2" value="Entry conditions&lt;br&gt;CloudWatchAlarm rule: no SLO&lt;br&gt;alarm in staging for 30 min&lt;br&gt;DeploymentWindow rule:&lt;br&gt;Tue-Thu 09:00-16:00&lt;br&gt;then a manual approval&lt;br&gt;action (service owner)" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#DD344C;fillColor=#FDEDEF;fontColor=#232F3E;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="895" y="99" width="250" height="150" as="geometry"/></mxCell>
<mxCell id="pprd" value='&lt;b&gt;Stage: prod&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;PR needs 2 CODEOWNERS&lt;br&gt;reviews, then merge&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codebuild;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1220" y="150" width="48" height="48" as="geometry"/></mxCell>
