<mxCell id="c33" value="Argo CD pulls each overlay into its own cluster" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#8C4FFF;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="400" y="566" width="360" height="17" as="geometry"/></mxCell>
<mxCell id="c34" value="&lt;b&gt;Rules that keep this honest&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#7D8998;fillColor=#F7F8FA;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="740" width="1460" height="84" as="geometry"/></mxCell>
<mxCell id="c35" value="- One build per commit. Promotion changes a digest in Git, never rebuilds." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="772" width="700" height="18" as="geometry"/></mxCell>
<mxCell id="c36" value="- CI writes only to the dev overlay. Staging and prod overlays need a gate or a human." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="760" y="772" width="700" height="18" as="geometry"/></mxCell>
<mxCell id="c37" value="- Config and image move together: a prod PR shows the image diff and the YAML diff." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="798" width="700" height="18" as="geometry"/></mxCell>
<mxCell id="c38" value="- Argo CD has read-only Git access. Nobody has kubectl write in prod except break-glass." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="760" y="798" width="700" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram>
