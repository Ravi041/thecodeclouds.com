<mxCell id="held" value='&lt;b&gt;HELD&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;expires_at = now() + 15 min&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#E8710A;fillColor=#FEF1E3;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="650" width="220" height="60" as="geometry"/></mxCell>
<mxCell id="com" value='&lt;b&gt;COMMITTED&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;on_hand -= qty, reserved -= qty&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#E6F4EA;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="600" width="260" height="60" as="geometry"/></mxCell>
