<mxCell id="c44" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1A73E8;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1304" y="678" as="sourcePoint"/><mxPoint x="1344" y="678" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c45" value="sync call" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1356" y="671" width="114" height="17" as="geometry"/></mxCell>
