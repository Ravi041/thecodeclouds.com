<mxCell id="c49" value="external PSP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1356" y="713" width="114" height="17" as="geometry"/></mxCell>
