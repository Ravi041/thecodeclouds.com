<mxCell id="c33" value="UPDATE stock SET reserved = reserved + :qty" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="812" y="403" width="640" height="17" as="geometry"/></mxCell>
<mxCell id="c34" value=" WHERE sku = :sku AND on_hand - reserved &amp;gt;= :qty;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="812" y="420" width="640" height="17" as="geometry"/></mxCell>
<mxCell id="c35" value="-- 0 rows? ROLLBACK, tell the shopper it sold out" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="812" y="437" width="640" height="17" as="geometry"/></mxCell>
