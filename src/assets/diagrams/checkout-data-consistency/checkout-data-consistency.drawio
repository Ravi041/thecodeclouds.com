<mxCell id="bad" value='&lt;b&gt;2 orders, 1 unit. Someone gets a "sorry" email.&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;Raising the isolation level to SERIALIZABLE fixes it&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;but aborts and retries under load.&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#D93025;fillColor=#FCE8E6;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="455" width="600" height="56" as="geometry"/></mxCell>
