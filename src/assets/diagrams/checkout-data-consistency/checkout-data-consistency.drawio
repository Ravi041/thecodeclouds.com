<mxCell id="rec" value='&lt;b&gt;Reconciler&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;hourly: PSP report vs ledger&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#D93025;fillColor=#FCE8E6;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1290" y="450" width="190" height="60" as="geometry"/></mxCell>
