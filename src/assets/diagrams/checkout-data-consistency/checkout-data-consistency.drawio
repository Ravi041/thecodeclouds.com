<mxCell id="c70" value="unknown outcome path" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1226" y="554" width="244" height="17" as="geometry"/></mxCell>
<mxCell id="c71" value="Choreography (services reacting to each other's events) works for 2 or 3 steps. Past that, an orchestrator&lt;br&gt;with a state table is far easier to debug at 3 a.m.: one row tells you where every checkout is." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1100" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="idempotency" name="3. Idempotent payment on retry"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Scenario: the shopper taps Pay, the network drops the response, the app retries" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1300" height="24" as="geometry"/></mxCell>
<mxCell id="c2" value="Without a key this is two charges. With one, the retry gets the first answer back and the PSP is never called twice." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1300" height="18" as="geometry"/></mxCell>
