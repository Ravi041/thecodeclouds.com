<mxCell id="c54" value="A recovery worker picks up rows stuck IN_PROGRESS for over 30 s and replays that step with the same key." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="55" y="640" width="620" height="16" as="geometry"/></mxCell>
<mxCell id="c55" value="&lt;b&gt;Rules that keep a saga honest&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#202124;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#202124;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="720" y="460" width="400" height="200" as="geometry"/></mxCell>
<mxCell id="c56" value="1. Save the step, then call. Never the other way round." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="735" y="495" width="380" height="18" as="geometry"/></mxCell>
<mxCell id="c57" value="2. Every step and compensation is idempotent." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="735" y="521" width="380" height="18" as="geometry"/></mxCell>
<mxCell id="c58" value='3. A timeout is "unknown", not "failed".' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="735" y="547" width="380" height="18" as="geometry"/></mxCell>
<mxCell id="c59" value="4. Nothing irreversible before the pivot." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="735" y="573" width="380" height="18" as="geometry"/></mxCell>
<mxCell id="c60" value="5. Shoppers see PENDING; email only on CONFIRMED." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="735" y="599" width="380" height="18" as="geometry"/></mxCell>
<mxCell id="c61" value="6. Alert on sagas older than 10 minutes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="735" y="625" width="380" height="18" as="geometry"/></mxCell>
<mxCell id="c62" value="&lt;b&gt;Legend&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#9AA0A6;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1160" y="460" width="320" height="114" as="geometry"/></mxCell>
<mxCell id="c63" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1E8E3E;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1174" y="498" as="sourcePoint"/><mxPoint x="1214" y="498" as="targetPoint"/></mxGeometry></mxCell>
