<mxCell id="c41" style="edgeStyle=none;html=1;rounded=0;strokeColor=#D93025;strokeWidth=2;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1290" y="480" as="sourcePoint"/><mxPoint x="1205" y="470" as="targetPoint"/><Array as="points"><mxPoint x="1250" y="480"/><mxPoint x="1250" y="470"/></Array></mxGeometry></mxCell>
<mxCell id="c42" value='fixes "unknown"&lt;br&gt;payments' style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#D93025;fontStyle=0;spacing=0;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1300" y="520" width="170" height="32" as="geometry"/></mxCell>
