<mxCell id="c37" value=" VALUES (:id, :sku, :qty, :ck, now() + interval '15 min');" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="812" y="471" width="640" height="17" as="geometry"/></mxCell>
