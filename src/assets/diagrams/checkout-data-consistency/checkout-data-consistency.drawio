<mxCell id="c38" value="same key on&lt;br&gt;every retry" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#8430CE;fontStyle=0;spacing=0;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1240" y="290" width="100" height="32" as="geometry"/></mxCell>
