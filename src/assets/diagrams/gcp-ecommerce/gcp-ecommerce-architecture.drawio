<mxCell id="c69" value='&lt;b&gt;shard 9&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;qty 50&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#E6F4EA;dashed=0;fontSize=12;fontStyle=0;fontColor=#1E8E3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1384" y="720" width="68" height="54" as="geometry"/></mxCell>
<mxCell id="c70" value="Pick a random shard (or the shopper id hash), decrement it, try another if it is empty.&lt;br&gt;Total stock = sum of shards. Contention drops by the number of shards." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="700" y="805" width="760" height="32" as="geometry"/></mxCell>
<mxCell id="c71" value="Other ways to get the same effect" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="870" width="600" height="18" as="geometry"/></mxCell>
<mxCell id="c72" value="- Reservation tokens: pre-mint 500 tokens into a Valkey list, LPOP one per shopper, then write the order to Spanner. No token, no checkout." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="898" width="1400" height="18" as="geometry"/></mxCell>
<mxCell id="c73" value="- Batch allocation: checkout writes a reservation request; one worker per SKU drains them in order and allocates in batches of 50." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="928" width="1400" height="18" as="geometry"/></mxCell>
<mxCell id="c74" value="- Whatever you pick, Spanner stays the source of truth. A lost Valkey token just means one unit sells a few minutes late, never twice." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="958" width="1400" height="18" as="geometry"/></mxCell>
<mxCell id="c75" value="- Use a UUIDv4 or bit-reversed sequence for order ids, never a timestamp or a plain counter, or the order table gets a hotspot too." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="988" width="1400" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="ecom-data-ai" name="Data and personalisation: events to search, recommendations and forecasts"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="780" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Data and personalisation: how a click turns into better search, recommendations and stock forecasts" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1460" height="24" as="geometry"/></mxCell>
<mxCell id="c2" value="Nothing here sits on the checkout path. If this whole page is down, the store still sells; it just stops getting smarter for a while." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1460" height="18" as="geometry"/></mxCell>
