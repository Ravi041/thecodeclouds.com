<diagram id="ecom-checkout" name="Checkout: the request path, step by step"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value='Checkout, step by step: what has to happen before you say "order placed"' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1400" height="24" as="geometry"/></mxCell>
<mxCell id="c2" value="Steps 1 to 6 are synchronous and sit on the shopper's click. Steps 7 to 9 happen after the response and can retry for hours without anyone noticing." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1400" height="18" as="geometry"/></mxCell>
