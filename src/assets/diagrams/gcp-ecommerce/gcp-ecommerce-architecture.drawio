<mxCell id="c31" value="Before 10:00 (the part that decides how it goes)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#1A73E8;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="34" y="429" width="700" height="19" as="geometry"/></mxCell>
<mxCell id="c32" value="Load test at 1.5x the forecast a week before, same code, same data size" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="34" y="454" width="696" height="18" as="geometry"/></mxCell>
<mxCell id="c33" value="Raise quotas early: GKE nodes, Spanner compute, Cloud Run instances" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="34" y="476" width="696" height="18" as="geometry"/></mxCell>
<mxCell id="c34" value="Pre-scale: HPA minReplicas up at 09:30, Spanner capacity up at 09:00" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="34" y="498" width="696" height="18" as="geometry"/></mxCell>
<mxCell id="c35" value="Warm the CDN: request every sale page once, long max-age + versioned URLs" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="34" y="520" width="696" height="18" as="geometry"/></mxCell>
<mxCell id="c36" value="Freeze deploys from 09:00 to 12:00, feature flags only" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="34" y="542" width="696" height="18" as="geometry"/></mxCell>
<mxCell id="c37" value="Turn on Cloud Armor rate limits and bot rules in preview first, then enforce" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="34" y="564" width="696" height="18" as="geometry"/></mxCell>
<mxCell id="c38" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="760" y="420" width="720" height="172" as="geometry"/></mxCell>
<mxCell id="c39" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1E8E3E;strokeWidth=5;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="424" as="sourcePoint"/><mxPoint x="760" y="588" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c40" value="During the spike" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#1E8E3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="774" y="429" width="700" height="19" as="geometry"/></mxCell>
<mxCell id="c41" value="Waiting room hands out tokens at the rate checkout can take, not faster" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="774" y="454" width="696" height="18" as="geometry"/></mxCell>
<mxCell id="c42" value="Hold stock in Spanner when the item goes in the basket, with a TTL" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="774" y="476" width="696" height="18" as="geometry"/></mxCell>
<mxCell id="c43" value='Respond "order received" after the Spanner commit; the rest is async' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="774" y="498" width="696" height="18" as="geometry"/></mxCell>
<mxCell id="c44" value="Shed non-essential features first: reviews, recommendations, wishlists" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="774" y="520" width="696" height="18" as="geometry"/></mxCell>
<mxCell id="c45" value="Watch checkout success rate and p95, not CPU" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="774" y="542" width="696" height="18" as="geometry"/></mxCell>
<mxCell id="c46" value="If the PSP slows down, queue the authorise call, do not retry in a loop" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="774" y="564" width="696" height="18" as="geometry"/></mxCell>
<mxCell id="c47" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#D93025;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="1460" height="380" as="geometry"/></mxCell>
<mxCell id="c48" style="edgeStyle=none;html=1;rounded=0;strokeColor=#D93025;strokeWidth=5;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="644" as="sourcePoint"/><mxPoint x="20" y="1016" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c49" value="The hot SKU problem: 5,000 shoppers buying the same TV in the same second" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#D93025;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="34" y="650" width="1400" height="19" as="geometry"/></mxCell>
