<mxCell id="c67" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="600" width="1460" height="150" as="geometry"/></mxCell>
<mxCell id="c68" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1A73E8;strokeWidth=5;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="604" as="sourcePoint"/><mxPoint x="20" y="746" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c69" value="Rules that keep this useful (and legal)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#1A73E8;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="34" y="609" width="1440" height="19" as="geometry"/></mxCell>
<mxCell id="c70" value="One event schema, versioned, owned by a team. Every event has event_id, session_id, user_id (if consented), sku, ts." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="34" y="634" width="1436" height="18" as="geometry"/></mxCell>
<mxCell id="c71" value="Consent first: no user_id on events from shoppers who said no. Drop or hash PII in Dataflow before BigQuery." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="34" y="656" width="1436" height="18" as="geometry"/></mxCell>
<mxCell id="c72" value="Send the same user events to AI Commerce Search that you use for analytics, or the models learn from a different store." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="34" y="678" width="1436" height="18" as="geometry"/></mxCell>
<mxCell id="c73" value="Catalog in AI Commerce Search is updated from Spanner change streams, so a price or stock change shows up in minutes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="34" y="700" width="1436" height="18" as="geometry"/></mxCell>
<mxCell id="c74" value="Measure recs with an A/B test on revenue per session, not click-through rate." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="34" y="722" width="1436" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
