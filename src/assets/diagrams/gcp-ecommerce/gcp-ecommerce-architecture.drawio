<diagram id="ecom-flash-sale" name="Scenario: a flash sale sends 30x normal traffic"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1040" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Scenario: a 10:00 flash sale. Traffic goes from 2,000 to 60,000 requests a second in under a minute." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1460" height="24" as="geometry"/></mxCell>
<mxCell id="c2" value="Every layer exists to make sure the next one sees less traffic than the one before. Spanner and the PSP should never see the spike, only a steady stream." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1460" height="18" as="geometry"/></mxCell>
