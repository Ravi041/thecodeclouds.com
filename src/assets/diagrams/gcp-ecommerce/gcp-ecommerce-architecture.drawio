<mxCell id="c37" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8430CE;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ps" target="f1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="910" y="650"/><mxPoint x="325" y="650"/></Array></mxGeometry></mxCell>
<mxCell id="c38" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8430CE;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="650" as="sourcePoint"/><mxPoint x="568" y="694" as="targetPoint"/><Array as="points"><mxPoint x="568" y="650"/></Array></mxGeometry></mxCell>
<mxCell id="c39" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8430CE;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="650" as="sourcePoint"/><mxPoint x="812" y="694" as="targetPoint"/><Array as="points"><mxPoint x="812" y="650"/></Array></mxGeometry></mxCell>
<mxCell id="c40" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8430CE;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="650" as="sourcePoint"/><mxPoint x="1055" y="694" as="targetPoint"/><Array as="points"><mxPoint x="1055" y="650"/></Array></mxGeometry></mxCell>
<mxCell id="c41" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1E8E3E;strokeWidth=2;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.95;entryDx=0;entryDy=0;" edge="1" parent="1" source="sch" target="sp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="840" y="492"/><mxPoint x="840" y="210"/></Array></mxGeometry></mxCell>
<mxCell id="c42" value="1" style="ellipse;html=1;fillColor=#D93025;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="160" y="150" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c43" value="2" style="ellipse;html=1;fillColor=#D93025;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="360" y="150" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c44" value="3" style="ellipse;html=1;fillColor=#1A73E8;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="470" y="268" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c45" value="4" style="ellipse;html=1;fillColor=#1E8E3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="760" y="150" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c46" value="5" style="ellipse;html=1;fillColor=#E37400;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="860" y="101" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c47" value="6" style="ellipse;html=1;fillColor=#1E8E3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="760" y="232" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c48" value="7" style="ellipse;html=1;fillColor=#E37400;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1469" y="260" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c49" value="8" style="ellipse;html=1;fillColor=#8430CE;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="860" y="420" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c50" value="9" style="ellipse;html=1;fillColor=#8430CE;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="560" y="639" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c51" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#5F6368;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="830" width="1460" height="220" as="geometry"/></mxCell>
<mxCell id="c52" style="edgeStyle=none;html=1;rounded=0;strokeColor=#5F6368;strokeWidth=5;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="834" as="sourcePoint"/><mxPoint x="20" y="1046" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c53" value="What happens at each number" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#5F6368;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="34" y="839" width="1440" height="19" as="geometry"/></mxCell>
<mxCell id="c54" value="1  Shopper posts the order with an Idempotency-Key header (one per checkout attempt, made by the client)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="34" y="864" width="1436" height="18" as="geometry"/></mxCell>
<mxCell id="c55" value="2  The global LB routes to the nearest healthy region. Cloud Armor rate-limits checkout per session and per IP." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="34" y="884" width="1436" height="18" as="geometry"/></mxCell>
<mxCell id="c56" value="3  checkout reads the cart from Valkey, then re-prices it from Spanner. Never trust the cached price." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="34" y="904" width="1436" height="18" as="geometry"/></mxCell>
<mxCell id="c57" value="4  One Spanner read-write transaction: hold stock (reservation with a 15 min expiry), insert order PENDING, insert outbox row." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="34" y="924" width="1436" height="18" as="geometry"/></mxCell>
<mxCell id="c58" value="5  Score fraud, then authorise with the PSP through Cloud NAT, reusing the idempotency key. Timeout 8 s, no blind retries." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="34" y="944" width="1436" height="18" as="geometry"/></mxCell>
<mxCell id="c59" value='6  Second transaction: order AUTHORISED + outbox row. Respond "order placed" (or "pending") to the shopper.' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="34" y="964" width="1436" height="18" as="geometry"/></mxCell>
<mxCell id="c60" value="7  PSP webhook lands on Cloud Run. Verify the signature, upsert payment state by PSP reference. Duplicates are no-ops." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="34" y="984" width="1436" height="18" as="geometry"/></mxCell>
<mxCell id="c61" value="8  An outbox relay (or a Spanner change stream) publishes each outbox row to Pub/Sub with its event_id." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="34" y="1004" width="1436" height="18" as="geometry"/></mxCell>
<mxCell id="c62" value="9  Fulfilment, email, analytics and recommendations consume at their own pace. Failures go to a dead-letter topic." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="34" y="1024" width="1436" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="ecom-region-failure" name="Scenario: a whole region goes down during trading"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Scenario: us-east4 goes dark at 11:02 on a Saturday. What keeps taking orders, and what you had to set up beforehand." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1460" height="24" as="geometry"/></mxCell>
<mxCell id="c2" value="The goal is that shoppers see a few slow requests and a handful of retries, not an outage page. RPO for orders is zero because Spanner commits to two regions." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1460" height="18" as="geometry"/></mxCell>
<mxCell id="shop" value='&lt;b&gt;Shoppers&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;same URL, same IP&lt;/font&gt;' style="sketch=0;html=1;aspect=fixed;strokeColor=none;shadow=0;fillColor=#5184F3;fontSize=12;fontColor=#3C4043;shape=mxgraph.gcp2.users;labelBackgroundColor=#FFFFFF;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="500" y="74" width="56" height="35.53" as="geometry"/></mxCell>
<mxCell id="c3" value="&lt;b&gt;Google Cloud&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;whiteSpace=wrap;strokeColor=#4285F4;fillColor=#FFFFFF;strokeWidth=1.5;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=34;spacingTop=-2;" vertex="1" parent="1"><mxGeometry x="20" y="140" width="1020" height="840" as="geometry"/></mxCell>
<mxCell id="c4" value="" style="sketch=0;html=1;aspect=fixed;strokeColor=none;fillColor=#4285F4;shape=mxgraph.gcp2.google_cloud_platform;" vertex="1" parent="1"><mxGeometry x="28" y="145" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="lb" value='&lt;b&gt;Global external App LB + Cloud Armor + CDN&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;health checks every 5 s, outlier detection on 5xx&lt;/font&gt;' style="sketch=0;html=1;aspect=fixed;strokeColor=none;shadow=0;fillColor=#5184F3;fontSize=12;fontColor=#3C4043;shape=mxgraph.gcp2.cloud_load_balancing;labelBackgroundColor=#FFFFFF;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="498" y="180" width="60" height="53.15" as="geometry"/></mxCell>
<mxCell id="c5" style="edgeStyle=none;html=1;rounded=0;strokeColor=#D93025;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="shop" target="lb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c6" value="&lt;b&gt;Region us-east4: unavailable&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#D93025;fillColor=#FCE8E6;dashed=1;fontSize=12;fontStyle=0;fontColor=#D93025;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="470" height="300" as="geometry"/></mxCell>
<mxCell id="gkea" value='&lt;b&gt;GKE Autopilot&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;backends unhealthy&lt;/font&gt;' style="sketch=0;html=1;aspect=fixed;strokeColor=none;shadow=0;fillColor=#5184F3;fontSize=12;fontColor=#3C4043;shape=mxgraph.gcp2.container_engine;labelBackgroundColor=#FFFFFF;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="360" width="56" height="49.61" as="geometry"/></mxCell>
<mxCell id="runa" value='&lt;b&gt;Cloud Run&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;no traffic&lt;/font&gt;' style="sketch=0;html=1;aspect=fixed;strokeColor=none;shadow=0;fillColor=#5184F3;fontSize=12;fontColor=#3C4043;shape=mxgraph.gcp2.cloud_run;labelBackgroundColor=#FFFFFF;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="250" y="360" width="56" height="49.61" as="geometry"/></mxCell>
<mxCell id="mema" value='&lt;b&gt;Valkey primary&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;lost&lt;/font&gt;' style="sketch=0;html=1;aspect=fixed;strokeColor=none;shadow=0;fillColor=#5184F3;fontSize=12;fontColor=#3C4043;shape=mxgraph.gcp2.cloud_memorystore;labelBackgroundColor=#FFFFFF;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="400" y="360" width="56" height="49.61" as="geometry"/></mxCell>
<mxCell id="c7" style="edgeStyle=none;html=1;rounded=0;strokeColor=#D93025;strokeWidth=4;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="245" y="470" as="sourcePoint"/><mxPoint x="305" y="530" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c8" style="edgeStyle=none;html=1;rounded=0;strokeColor=#D93025;strokeWidth=4;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="245" y="530" as="sourcePoint"/><mxPoint x="305" y="470" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c9" value="Nothing to fail over by hand at this layer: the load balancer stops sending here on its own." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#D93025;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="550" width="430" height="17" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;b&gt;Region us-east1: now serving 100%&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#E6F4EA;dashed=0;fontSize=12;fontStyle=0;fontColor=#1E8E3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="550" y="300" width="470" height="300" as="geometry"/></mxCell>
<mxCell id="gkeb" value='&lt;b&gt;GKE Autopilot&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;HPA 40 to 90 pods&lt;/font&gt;' style="sketch=0;html=1;aspect=fixed;strokeColor=none;shadow=0;fillColor=#5184F3;fontSize=12;fontColor=#3C4043;shape=mxgraph.gcp2.container_engine;labelBackgroundColor=#FFFFFF;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="600" y="360" width="56" height="49.61" as="geometry"/></mxCell>
<mxCell id="runb" value='&lt;b&gt;Cloud Run&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;scales on requests&lt;/font&gt;' style="sketch=0;html=1;aspect=fixed;strokeColor=none;shadow=0;fillColor=#5184F3;fontSize=12;fontColor=#3C4043;shape=mxgraph.gcp2.cloud_run;labelBackgroundColor=#FFFFFF;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="360" width="56" height="49.61" as="geometry"/></mxCell>
<mxCell id="memb" value='&lt;b&gt;Valkey secondary&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;promoted to primary&lt;/font&gt;' style="sketch=0;html=1;aspect=fixed;strokeColor=none;shadow=0;fillColor=#5184F3;fontSize=12;fontColor=#3C4043;shape=mxgraph.gcp2.cloud_memorystore;labelBackgroundColor=#FFFFFF;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="910" y="360" width="56" height="49.61" as="geometry"/></mxCell>
<mxCell id="c11" value="Runs at about 50% CPU normally, so it absorbs the other half before new nodes arrive." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1E8E3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="592" y="550" width="420" height="17" as="geometry"/></mxCell>
<mxCell id="c12" style="edgeStyle=none;html=1;rounded=0;strokeColor=#D93025;strokeWidth=2;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="233" as="sourcePoint"/><mxPoint x="330" y="298" as="targetPoint"/><Array as="points"><mxPoint x="510" y="270"/><mxPoint x="330" y="270"/></Array></mxGeometry></mxCell>
<mxCell id="c13" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1E8E3E;strokeWidth=4;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="546" y="233" as="sourcePoint"/><mxPoint x="850" y="298" as="targetPoint"/><Array as="points"><mxPoint x="546" y="270"/><mxPoint x="850" y="270"/></Array></mxGeometry></mxCell>
<mxCell id="c14" value="0% after ~30 s" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#D93025;fontStyle=0;spacing=0;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="360" y="254" width="100" height="16" as="geometry"/></mxCell>
<mxCell id="c15" value="100% of traffic" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#1E8E3E;fontStyle=0;spacing=0;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="700" y="254" width="100" height="16" as="geometry"/></mxCell>
<mxCell id="c16" style="edgeStyle=none;html=1;rounded=0;strokeColor=#5F6368;strokeWidth=2;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mema" target="memb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="530" y="388"/><mxPoint x="530" y="490"/><mxPoint x="1005" y="490"/><mxPoint x="1005" y="388"/></Array></mxGeometry></mxCell>
<mxCell id="c17" value="Valkey cross-region replication (async)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=0;spacing=0;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="640" y="482" width="230" height="16" as="geometry"/></mxCell>
<mxCell id="c18" value="&lt;b&gt;Spanner instance, multi-region config nam3&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#1E8E3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="980" height="200" as="geometry"/></mxCell>
