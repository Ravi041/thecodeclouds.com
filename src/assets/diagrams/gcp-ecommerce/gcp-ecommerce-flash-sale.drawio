<mxCell id="c24" value="900 writes" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=10;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="958" y="382" width="160" height="16" as="geometry"/></mxCell>
