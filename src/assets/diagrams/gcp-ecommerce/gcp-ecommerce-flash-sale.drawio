<mxCell id="c52" style="edgeStyle=none;html=1;rounded=0;strokeColor=#D93025;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="700" as="sourcePoint"/><mxPoint x="322" y="745" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c53" style="edgeStyle=none;html=1;rounded=0;strokeColor=#D93025;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="718" as="sourcePoint"/><mxPoint x="322" y="745" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c54" style="edgeStyle=none;html=1;rounded=0;strokeColor=#D93025;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="736" as="sourcePoint"/><mxPoint x="322" y="745" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c55" style="edgeStyle=none;html=1;rounded=0;strokeColor=#D93025;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="754" as="sourcePoint"/><mxPoint x="322" y="745" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c56" style="edgeStyle=none;html=1;rounded=0;strokeColor=#D93025;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="772" as="sourcePoint"/><mxPoint x="322" y="745" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c57" style="edgeStyle=none;html=1;rounded=0;strokeColor=#D93025;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="790" as="sourcePoint"/><mxPoint x="322" y="745" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c58" value="Every checkout locks the same row. Transactions queue, abort and retry.&lt;br&gt;Latency climbs, throughput tops out at what one row can take." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="805" width="600" height="32" as="geometry"/></mxCell>
<mxCell id="c59" value="Split the counter into shards" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="700" y="690" width="400" height="18" as="geometry"/></mxCell>
<mxCell id="c60" value='&lt;b&gt;shard 0&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;qty 50&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#E6F4EA;dashed=0;fontSize=12;fontStyle=0;fontColor=#1E8E3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="700" y="720" width="68" height="54" as="geometry"/></mxCell>
<mxCell id="c61" value='&lt;b&gt;shard 1&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;qty 50&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#E6F4EA;dashed=0;fontSize=12;fontStyle=0;fontColor=#1E8E3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="776" y="720" width="68" height="54" as="geometry"/></mxCell>
<mxCell id="c62" value='&lt;b&gt;shard 2&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;qty 50&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#E6F4EA;dashed=0;fontSize=12;fontStyle=0;fontColor=#1E8E3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="852" y="720" width="68" height="54" as="geometry"/></mxCell>
<mxCell id="c63" value='&lt;b&gt;shard 3&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;qty 50&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#E6F4EA;dashed=0;fontSize=12;fontStyle=0;fontColor=#1E8E3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="928" y="720" width="68" height="54" as="geometry"/></mxCell>
<mxCell id="c64" value='&lt;b&gt;shard 4&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;qty 50&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#E6F4EA;dashed=0;fontSize=12;fontStyle=0;fontColor=#1E8E3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1004" y="720" width="68" height="54" as="geometry"/></mxCell>
<mxCell id="c65" value='&lt;b&gt;shard 5&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;qty 50&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#E6F4EA;dashed=0;fontSize=12;fontStyle=0;fontColor=#1E8E3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1080" y="720" width="68" height="54" as="geometry"/></mxCell>
<mxCell id="c66" value='&lt;b&gt;shard 6&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;qty 50&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#E6F4EA;dashed=0;fontSize=12;fontStyle=0;fontColor=#1E8E3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1156" y="720" width="68" height="54" as="geometry"/></mxCell>
<mxCell id="c67" value='&lt;b&gt;shard 7&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;qty 50&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#E6F4EA;dashed=0;fontSize=12;fontStyle=0;fontColor=#1E8E3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1232" y="720" width="68" height="54" as="geometry"/></mxCell>
<mxCell id="c68" value='&lt;b&gt;shard 8&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;qty 50&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#E6F4EA;dashed=0;fontSize=12;fontStyle=0;fontColor=#1E8E3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1308" y="720" width="68" height="54" as="geometry"/></mxCell>
<mxCell id="c69" value='&lt;b&gt;shard 9&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;qty 50&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#E6F4EA;dashed=0;fontSize=12;fontStyle=0;fontColor=#1E8E3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1384" y="720" width="68" height="54" as="geometry"/></mxCell>
<mxCell id="c70" value="Pick a random shard (or the shopper id hash), decrement it, try another if it is empty.&lt;br&gt;Total stock = sum of shards. Contention drops by the number of shards." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="700" y="805" width="760" height="32" as="geometry"/></mxCell>
<mxCell id="c71" value="Other ways to get the same effect" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="870" width="600" height="18" as="geometry"/></mxCell>
<mxCell id="c72" value="- Reservation tokens: pre-mint 500 tokens into a Valkey list, LPOP one per shopper, then write the order to Spanner. No token, no checkout." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="898" width="1400" height="18" as="geometry"/></mxCell>
<mxCell id="c73" value="- Batch allocation: checkout writes a reservation request; one worker per SKU drains them in order and allocates in batches of 50." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="928" width="1400" height="18" as="geometry"/></mxCell>
<mxCell id="c74" value="- Whatever you pick, Spanner stays the source of truth. A lost Valkey token just means one unit sells a few minutes late, never twice." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="958" width="1400" height="18" as="geometry"/></mxCell>
<mxCell id="c75" value="- Use a UUIDv4 or bit-reversed sequence for order ids, never a timestamp or a plain counter, or the order table gets a hotspot too." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="988" width="1400" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
