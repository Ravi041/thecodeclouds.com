<mxCell id="aks_we" value='&lt;b&gt;AKS&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#605E5C"&gt;unreachable&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/containers/Kubernetes_Services.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="433.13" width="52" height="45.73" as="geometry"/></mxCell>
