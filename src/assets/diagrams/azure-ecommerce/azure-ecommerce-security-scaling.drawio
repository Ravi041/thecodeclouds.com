<mxCell id="acr_we" value='&lt;b&gt;ACR&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#605E5C"&gt;replica&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/containers/Container_Registries.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="340" y="572.28" width="44" height="39.43" as="geometry"/></mxCell>
<mxCell id="c30" value='&lt;b&gt;North Europe · now serving&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#605E5C"&gt;priority 2 takes 100% of traffic&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;whiteSpace=wrap;strokeColor=#0078D4;fillColor=none;strokeWidth=1.2;dashed=1;fontSize=12;fontColor=#323130;align=left;verticalAlign=top;spacingLeft=32;spacingTop=-2;container=0;" vertex="1" parent="1"><mxGeometry x="780" y="360" width="700" height="400" as="geometry"/></mxCell>
