<mxCell id="red_we" value='&lt;b&gt;Managed Redis&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#605E5C"&gt;sessions lost&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/databases/Cache_Redis.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="480" y="434.43" width="48" height="39.13" as="geometry"/></mxCell>
