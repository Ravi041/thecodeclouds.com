<mxCell id="cos_ne" value='&lt;b&gt;Cosmos DB&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#605E5C"&gt;NEW write region&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/databases/Azure_Cosmos_DB.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1100" y="430.12" width="48" height="47.75" as="geometry"/></mxCell>
