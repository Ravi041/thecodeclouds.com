<mxCell id="pls" value='&lt;b&gt;Internal LB 10.11.8.10&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#605E5C"&gt;+ Private Link service&lt;br&gt;Front Door PE approved once&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/networking/Load_Balancers.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="655" y="130" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="c17" value="1" style="ellipse;html=1;fillColor=#D13438;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="750" y="106" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c18" value="&lt;b&gt;snet-aks-system · 10.11.0.0/24&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;whiteSpace=wrap;strokeColor=#8A8886;fillColor=#FFFFFF;strokeWidth=1;dashed=1;fontSize=12;fontColor=#323130;align=left;verticalAlign=top;spacingLeft=8;spacingTop=-2;container=0;" vertex="1" parent="1"><mxGeometry x="795" y="100" width="200" height="165" as="geometry"/></mxCell>
<mxCell id="sys" value='&lt;b&gt;System pool · 3 zones&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#605E5C"&gt;CriticalAddonsOnly taint&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/containers/Kubernetes_Services.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="870" y="132.89" width="48" height="42.21" as="geometry"/></mxCell>
<mxCell id="c19" value="&lt;b&gt;snet-aks-user · 10.11.4.0/22&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;whiteSpace=wrap;strokeColor=#8A8886;fillColor=#FFFFFF;strokeWidth=1;dashed=1;fontSize=12;fontColor=#323130;align=left;verticalAlign=top;spacingLeft=8;spacingTop=-2;container=0;" vertex="1" parent="1"><mxGeometry x="1010" y="100" width="255" height="165" as="geometry"/></mxCell>
<mxCell id="usr" value='&lt;b&gt;User pool · 3 zones&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#605E5C"&gt;cluster autoscaler 6 → 60 nodes&lt;br&gt;HPA on RPS and queue depth&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/containers/Kubernetes_Services.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1113" y="132.89" width="48" height="42.21" as="geometry"/></mxCell>
<mxCell id="c20" value="2" style="ellipse;html=1;fillColor=#D13438;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1236" y="106" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c21" value="&lt;b&gt;snet-pe · 10.11.9.0/27&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;whiteSpace=wrap;strokeColor=#8A8886;fillColor=#FFFFFF;strokeWidth=1;dashed=1;fontSize=12;fontColor=#323130;align=left;verticalAlign=top;spacingLeft=8;spacingTop=-2;container=0;" vertex="1" parent="1"><mxGeometry x="1280" y="100" width="180" height="165" as="geometry"/></mxCell>
<mxCell id="kv1" value='&lt;b&gt;kv-shop-weu&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#605E5C"&gt;10.11.9.4&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/security/Key_Vaults.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1298" y="135" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="acr1" value='&lt;b&gt;ACR&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#605E5C"&gt;10.11.9.5&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/containers/Container_Registries.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1388" y="137.08" width="40" height="35.85" as="geometry"/></mxCell>
<mxCell id="rt" value='&lt;b&gt;rt-shop (all subnets except ILB)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#605E5C"&gt;0.0.0.0/0 → 10.10.0.4 (Firewall)&lt;br&gt;10.12.0.0/22 → 10.10.0.4&lt;br&gt;gateway route propagation: off&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/networking/Route_Tables.svg;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="590" y="300.76" width="44" height="42.48" as="geometry"/></mxCell>
<mxCell id="c22" value="AKS cluster settings&lt;br&gt;• Private API server, Entra ID auth + Azure RBAC, local accounts off&lt;br&gt;• Azure CNI Overlay: pods in 192.168.0.0/16, never routed in the VNet&lt;br&gt;• Cilium network policy: default deny per namespace&lt;br&gt;• OIDC issuer + workload identity, one managed identity per service&lt;br&gt;• Outbound type: userDefinedRouting (egress only via Firewall)&lt;br&gt;• Defender for Containers sensor, Azure Policy add-on" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FFF4CE;strokeColor=#C19C00;fontSize=11;fontColor=#323130;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="930" y="285" width="530" height="117" as="geometry"/></mxCell>
<mxCell id="data" value="&lt;b&gt;Data spoke · 10.12.0.0/22 · subscription: data-prod · public network access disabled on every service&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;whiteSpace=wrap;strokeColor=#107C10;fillColor=#F1F8F1;strokeWidth=1;dashed=0;fontSize=12;fontColor=#323130;align=left;verticalAlign=top;spacingLeft=32;spacingTop=-2;container=0;" vertex="1" parent="1"><mxGeometry x="560" y="440" width="920" height="220" as="geometry"/></mxCell>
<mxCell id="c24" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Virtual_Networks.svg;" vertex="1" parent="1"><mxGeometry x="566" y="450.01" width="20" height="11.98" as="geometry"/></mxCell>
<mxCell id="c25" value="&lt;b&gt;snet-pe-data · 10.12.0.0/26 · private endpoints only · PE network policies on, so NSG and UDR apply&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;whiteSpace=wrap;strokeColor=#8A8886;fillColor=#FFFFFF;strokeWidth=1;dashed=1;fontSize=12;fontColor=#323130;align=left;verticalAlign=top;spacingLeft=8;spacingTop=-2;container=0;" vertex="1" parent="1"><mxGeometry x="580" y="478" width="880" height="165" as="geometry"/></mxCell>
<mxCell id="d_sql" value='&lt;b&gt;sql-shop (fog listener)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#605E5C"&gt;10.12.0.4 · TCP 1433&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/databases/SQL_Database.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="630.66" y="515" width="34.69" height="46" as="geometry"/></mxCell>
<mxCell id="d_cosmos" value='&lt;b&gt;cosmos-shop&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#605E5C"&gt;10.12.0.5-.7&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/databases/Azure_Cosmos_DB.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="765" y="515.12" width="46" height="45.76" as="geometry"/></mxCell>
<mxCell id="d_redis" value='&lt;b&gt;redis-shop&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#605E5C"&gt;10.12.0.8 · TLS 10000&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/databases/Cache_Redis.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="905" y="519.25" width="46" height="37.5" as="geometry"/></mxCell>
<mxCell id="d_servicebus" value='&lt;b&gt;sb-shop Premium&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#605E5C"&gt;10.12.0.9&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/integration/Service_Bus.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1045" y="517.51" width="46" height="40.97" as="geometry"/></mxCell>
<mxCell id="d_keyvault" value='&lt;b&gt;kv-data-weu&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#605E5C"&gt;10.12.0.10&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/security/Key_Vaults.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1185" y="515" width="46" height="46" as="geometry"/></mxCell>
<mxCell id="d_storage" value='&lt;b&gt;stshopmedia (blob)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#605E5C"&gt;10.12.0.11&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/storage/Storage_Accounts.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1325" y="519.51" width="46" height="36.99" as="geometry"/></mxCell>
<mxCell id="c26" value="2" style="ellipse;html=1;fillColor=#D13438;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="672" y="506" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c27" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8A8886;strokeWidth=2;dashed=1;startArrow=block;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="160" as="sourcePoint"/><mxPoint x="560" y="160" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c28" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8A8886;strokeWidth=2;dashed=1;startArrow=block;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="550" as="sourcePoint"/><mxPoint x="560" y="550" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c29" value="peering&lt;br&gt;(AVNM)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#605E5C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="522" y="168" width="40" height="28" as="geometry"/></mxCell>
<mxCell id="c30" value="peering&lt;br&gt;(AVNM)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#605E5C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="522" y="558" width="40" height="28" as="geometry"/></mxCell>
<mxCell id="c31" value="&lt;b&gt;Four packet walks through this design&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;whiteSpace=wrap;strokeColor=#A19F9D;fillColor=#FAF9F8;strokeWidth=1;dashed=0;fontSize=12;fontColor=#323130;align=left;verticalAlign=top;spacingLeft=8;spacingTop=-2;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="680" width="1460" height="255" as="geometry"/></mxCell>
<mxCell id="c32" value="1" style="ellipse;html=1;fillColor=#D13438;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c33" value="Shopper → storefront" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#323130;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="70" y="722" width="320" height="19" as="geometry"/></mxCell>
<mxCell id="c34" value="Front Door Premium terminates TLS, runs the WAF,&lt;br&gt;then connects over its own private endpoint to the&lt;br&gt;Private Link service. The ILB has no public IP, so&lt;br&gt;the internet cannot reach it, only Front Door can." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#323130;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="755" width="345" height="62" as="geometry"/></mxCell>
<mxCell id="c35" value="2" style="ellipse;html=1;fillColor=#D13438;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="402" y="720" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c36" value="Checkout pod → Azure SQL" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#323130;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="432" y="722" width="320" height="19" as="geometry"/></mxCell>
<mxCell id="c37" value="The pod resolves sql-shop.database.windows.net.&lt;br&gt;The resolver answers 10.12.0.4 from the privatelink&lt;br&gt;zone. The UDR sends it to the Firewall, which allows&lt;br&gt;aks-user → 10.12.0.4:1433, SNATs it so the reply&lt;br&gt;comes back the same way, and logs the flow." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#323130;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="402" y="755" width="345" height="77" as="geometry"/></mxCell>
<mxCell id="c38" value="3" style="ellipse;html=1;fillColor=#D13438;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="764" y="720" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c39" value="Pod → payment provider" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#323130;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="794" y="722" width="320" height="19" as="geometry"/></mxCell>
<mxCell id="c40" value="Outbound type is userDefinedRouting, so every&lt;br&gt;egress packet hits the Firewall. An application rule&lt;br&gt;allows only api.psp.example:443 for the payments&lt;br&gt;namespace (source IP group); everything else is denied." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#323130;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="764" y="755" width="345" height="62" as="geometry"/></mxCell>
<mxCell id="c41" value="4" style="ellipse;html=1;fillColor=#D13438;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1126" y="720" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c42" value="Engineer → cluster" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#323130;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1156" y="722" width="320" height="19" as="geometry"/></mxCell>
<mxCell id="c43" value="No public IPs and no jump-box keys. The engineer&lt;br&gt;activates a PIM role, signs in through Bastion with&lt;br&gt;Entra ID, and reaches the private API server.&lt;br&gt;Every step lands in the Entra and Activity logs." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#323130;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1126" y="755" width="345" height="62" as="geometry"/></mxCell>
<mxCell id="c44" value="Azure Virtual Network Manager owns the topology: one hub-and-spoke connectivity configuration, one routing configuration (0.0.0.0/0 → Firewall) and security admin rules that block inbound internet traffic to every spoke, whatever its NSGs say." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5C2D91;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="1420" height="17" as="geometry"/></mxCell>
<mxCell id="c45" value="Address plan: hub 10.10.0.0/22, shop 10.11.0.0/16, data 10.12.0.0/22 in West Europe; 10.20/10.21/10.22 in North Europe. Pods use overlay 192.168.0.0/16 in both regions and never leave the node." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#605E5C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="1420" height="17" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="identity" name="3. Identity, secrets and detection"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="965" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Scenario: a client secret leaks to a public repo. What stops the attacker, what detects them, and what cleans up" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1460" height="24" as="geometry"/></mxCell>
<mxCell id="c2" value="&lt;b&gt;How the shop is meant to authenticate&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;whiteSpace=wrap;strokeColor=#A19F9D;fillColor=#FAF9F8;strokeWidth=1;dashed=0;fontSize=12;fontColor=#323130;align=left;verticalAlign=top;spacingLeft=32;spacingTop=-2;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="470" height="600" as="geometry"/></mxCell>
<mxCell id="c3" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/identity/Azure_Active_Directory.svg;" vertex="1" parent="1"><mxGeometry x="26" y="66.9" width="20" height="18.2" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;b&gt;People: engineers, support, finance&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;whiteSpace=wrap;strokeColor=#0078D4;fillColor=#EFF6FC;strokeWidth=1;dashed=0;fontSize=12;fontColor=#323130;align=left;verticalAlign=top;spacingLeft=8;spacingTop=-2;container=0;" vertex="1" parent="1"><mxGeometry x="35" y="95" width="440" height="230" as="geometry"/></mxCell>
<mxCell id="u" value="&lt;b&gt;Staff&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/identity/Users.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56.83" y="135" width="36.35" height="40" as="geometry"/></mxCell>
<mxCell id="ca" value='&lt;b&gt;Conditional Access&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#605E5C"&gt;phishing-resistant MFA&lt;br&gt;compliant device&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/security/Conditional_Access.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="148.68" y="130" width="36.64" height="44" as="geometry"/></mxCell>
<mxCell id="pim" value='&lt;b&gt;PIM&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#605E5C"&gt;no standing Owner,&lt;br&gt;1-4 h activation&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/identity/Entra_Privileged_Identity_Management.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="290" y="130" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="kv0" value='&lt;b&gt;Azure RBAC&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#605E5C"&gt;scoped roles&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/security/Key_Vaults.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="400" y="132" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="c5" style="edgeStyle=none;html=1;rounded=0;strokeColor=#107C10;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="u" target="ca"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c6" style="edgeStyle=none;html=1;rounded=0;strokeColor=#107C10;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ca" target="pim"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c7" style="edgeStyle=none;html=1;rounded=0;strokeColor=#107C10;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pim" target="kv0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c8" value="Risk-based policy: high user risk → &quot;Require risk remediation&quot;.&lt;br&gt;The user changes password, sessions are revoked, attacker's&lt;br&gt;refresh tokens die. Break-glass accounts are excluded and alarmed." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="250" width="420" height="47" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;b&gt;Workloads: pods in AKS, no secrets anywhere&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;whiteSpace=wrap;strokeColor=#5C2D91;fillColor=#F7F3FB;strokeWidth=1;dashed=0;fontSize=12;fontColor=#323130;align=left;verticalAlign=top;spacingLeft=8;spacingTop=-2;container=0;" vertex="1" parent="1"><mxGeometry x="35" y="340" width="440" height="305" as="geometry"/></mxCell>
<mxCell id="pod" value='&lt;b&gt;checkout pod&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#605E5C"&gt;service account&lt;br&gt;checkout-sa&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/containers/Kubernetes_Services.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="55" y="387.65" width="44" height="38.69" as="geometry"/></mxCell>
<mxCell id="mi" value='&lt;b&gt;Managed identity&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#605E5C"&gt;id-checkout&lt;br&gt;federated credential&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/identity/Managed_Identities.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="185" y="383.87" width="44" height="42.26" as="geometry"/></mxCell>
<mxCell id="en" value='&lt;b&gt;Entra ID&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#605E5C"&gt;issues a&lt;br&gt;1-hour token&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/identity/Azure_Active_Directory.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="320" y="384.98" width="44" height="40.04" as="geometry"/></mxCell>
<mxCell id="c10" style="edgeStyle=none;html=1;rounded=0;strokeColor=#107C10;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pod" target="mi"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c11" style="edgeStyle=none;html=1;rounded=0;strokeColor=#107C10;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mi" target="en"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="t_sql" value='&lt;b&gt;SQL&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#605E5C"&gt;Entra-only auth&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/databases/SQL_Database.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="79.43" y="520" width="27.15" height="36" as="geometry"/></mxCell>
<mxCell id="t_cos" value='&lt;b&gt;Cosmos DB&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#605E5C"&gt;data-plane RBAC&lt;br&gt;local auth off&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/databases/Azure_Cosmos_DB.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="190" y="518.1" width="40" height="39.8" as="geometry"/></mxCell>
<mxCell id="t_kv" value='&lt;b&gt;Key Vault&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#605E5C"&gt;Secrets User&lt;br&gt;on one vault&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/security/Key_Vaults.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="330" y="518" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="c12" style="edgeStyle=none;html=1;rounded=0;strokeColor=#107C10;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="342" y="470" as="sourcePoint"/><mxPoint x="93" y="520" as="targetPoint"/><Array as="points"><mxPoint x="342" y="495"/><mxPoint x="93" y="495"/></Array></mxGeometry></mxCell>
<mxCell id="c13" style="edgeStyle=none;html=1;rounded=0;strokeColor=#107C10;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="210" y="495" as="sourcePoint"/><mxPoint x="210" y="518" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c14" style="edgeStyle=none;html=1;rounded=0;strokeColor=#107C10;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="495" as="sourcePoint"/><mxPoint x="350" y="518" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c15" value="Token exchange: Kubernetes SA token → Entra token. Nothing to leak." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5C2D91;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="620" width="420" height="16" as="geometry"/></mxCell>
<mxCell id="c16" value="&lt;b&gt;The attack (one legacy app still had a client secret)&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;whiteSpace=wrap;strokeColor=#D13438;fillColor=#FDF3F4;strokeWidth=1.2;dashed=0;fontSize=12;fontColor=#323130;align=left;verticalAlign=top;spacingLeft=8;spacingTop=-2;container=0;" vertex="1" parent="1"><mxGeometry x="510" y="60" width="480" height="600" as="geometry"/></mxCell>
<mxCell id="c17" value="1" style="ellipse;html=1;fillColor=#D13438;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="530" y="100" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c18" value="T+0" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#D13438;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="562" y="102" width="80" height="18" as="geometry"/></mxCell>
<mxCell id="c19" value="sp-reporting secret pushed to a public GitHub repo by&lt;br&gt;a contractor. The app reads order totals for finance." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="562" y="124" width="410" height="32" as="geometry"/></mxCell>
<mxCell id="c20" value="2" style="ellipse;html=1;fillColor=#D13438;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="530" y="208" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c21" value="T+4 min" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#D13438;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="562" y="210" width="80" height="18" as="geometry"/></mxCell>
<mxCell id="c22" value="Attacker gets a token for sp-reporting from a TOR exit&lt;br&gt;node. The secret is valid, so Entra ID issues it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="562" y="232" width="410" height="32" as="geometry"/></mxCell>
<mxCell id="c23" value="3" style="ellipse;html=1;fillColor=#D13438;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="530" y="316" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c24" value="T+5 min" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#D13438;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="562" y="318" width="80" height="18" as="geometry"/></mxCell>
<mxCell id="c25" value="Calls kv-data-weu to list secrets: 403. Public network&lt;br&gt;access is disabled; only the private endpoint answers." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="562" y="340" width="410" height="32" as="geometry"/></mxCell>
<mxCell id="c26" value="4" style="ellipse;html=1;fillColor=#D13438;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="530" y="424" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c27" value="T+6 min" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#D13438;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="562" y="426" width="80" height="18" as="geometry"/></mxCell>
<mxCell id="c28" value="Calls Azure Resource Manager with the role it has&lt;br&gt;(Reader on data-prod): enumerates resources, finds&lt;br&gt;the SQL server, tries the public endpoint: refused." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="562" y="448" width="410" height="47" as="geometry"/></mxCell>
<mxCell id="c29" value="5" style="ellipse;html=1;fillColor=#D13438;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="530" y="532" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c30" value="later" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#D13438;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="562" y="534" width="80" height="18" as="geometry"/></mxCell>
<mxCell id="c31" value='Entra ID Protection matches the secret it found on&lt;br&gt;GitHub against valid credentials: "Leaked credentials".&lt;br&gt;Workload identity risk becomes high.' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="562" y="556" width="410" height="47" as="geometry"/></mxCell>
<mxCell id="tor" value="&lt;b&gt;TOR exit node&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/general/Globe.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="907.94" y="130" width="32.12" height="38" as="geometry"/></mxCell>
<mxCell id="c32" value="&lt;b&gt;Detection and response&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;whiteSpace=wrap;strokeColor=#A19F9D;fillColor=#FAF9F8;strokeWidth=1;dashed=0;fontSize=12;fontColor=#323130;align=left;verticalAlign=top;spacingLeft=32;spacingTop=-2;container=0;" vertex="1" parent="1"><mxGeometry x="1010" y="60" width="470" height="600" as="geometry"/></mxCell>
<mxCell id="c33" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/security/Azure_Sentinel.svg;" vertex="1" parent="1"><mxGeometry x="1017.77" y="66" width="16.46" height="20" as="geometry"/></mxCell>
<mxCell id="dfc" value='&lt;b&gt;Defender for Cloud&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#605E5C"&gt;KV_SuspiciousIPAccessDenied&lt;br&gt;Defender for Resource Manager&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/security/Security_Center.svg;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1033.5" y="105" width="34.99" height="42" as="geometry"/></mxCell>
<mxCell id="idp" value='&lt;b&gt;Entra ID Protection&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#605E5C"&gt;leakedCredentials on&lt;br&gt;sp-reporting (workload risk)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/identity/Entra_ID_Protection.svg;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1030" y="206.84" width="42" height="38.33" as="geometry"/></mxCell>
<mxCell id="logs" value='&lt;b&gt;Log Analytics&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#605E5C"&gt;Entra sign-in logs (service principal)&lt;br&gt;Key Vault + Activity logs&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/management_governance/Log_Analytics_Workspaces.svg;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1030" y="305" width="42" height="42" as="geometry"/></mxCell>
<mxCell id="sen" value='&lt;b&gt;Microsoft Sentinel&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#605E5C"&gt;correlates into one High incident&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/security/Azure_Sentinel.svg;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1033.71" y="405" width="34.58" height="42" as="geometry"/></mxCell>
<mxCell id="pb" value="&lt;b&gt;Playbook (Logic App, managed identity)&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/integration/Logic_Apps.svg;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1030" y="509.67" width="42" height="32.67" as="geometry"/></mxCell>
<mxCell id="c34" value="1. Disable sp-reporting, remove all its credentials&lt;br&gt;2. Rotate every secret it could read, from Key Vault logs&lt;br&gt;3. Add the IP to the Front Door WAF block list&lt;br&gt;4. Page on-call, open a ticket with the evidence" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0078D4;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1085" y="540" width="390" height="62" as="geometry"/></mxCell>
<mxCell id="c35" style="edgeStyle=none;html=1;rounded=0;strokeColor=#5C2D91;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1030" y="126" as="sourcePoint"/><mxPoint x="1030" y="426" as="targetPoint"/><Array as="points"><mxPoint x="1018" y="126"/><mxPoint x="1018" y="426"/></Array></mxGeometry></mxCell>
<mxCell id="c36" style="edgeStyle=none;html=1;rounded=0;strokeColor=#5C2D91;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1030" y="226" as="sourcePoint"/><mxPoint x="1018" y="226" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c37" style="edgeStyle=none;html=1;rounded=0;strokeColor=#5C2D91;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1030" y="326" as="sourcePoint"/><mxPoint x="1018" y="326" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c38" style="edgeStyle=none;html=1;rounded=0;strokeColor=#D13438;strokeWidth=2;dashed=1;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="990" y="350" as="sourcePoint"/><mxPoint x="1018" y="350" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c39" style="edgeStyle=none;html=1;rounded=0;strokeColor=#0078D4;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sen" target="pb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c40" value="&lt;b&gt;Why the attacker got nothing, and what changed afterwards&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;whiteSpace=wrap;strokeColor=#107C10;fillColor=#F1F8F1;strokeWidth=1;dashed=0;fontSize=12;fontColor=#323130;align=left;verticalAlign=top;spacingLeft=8;spacingTop=-2;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="680" width="1460" height="270" as="geometry"/></mxCell>
<mxCell id="b0" value="&lt;b&gt;&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/networking/Private_Endpoint.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="726.43" width="36" height="33.15" as="geometry"/></mxCell>
<mxCell id="c41" value="What held" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#107C10;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="86" y="733" width="300" height="20" as="geometry"/></mxCell>
<mxCell id="c42" value="Private endpoints with public network access&lt;br&gt;Disabled on Key Vault, SQL, Cosmos DB and&lt;br&gt;Storage. A valid token is not enough: the&lt;br&gt;request also has to come from inside the VNet." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="775" width="345" height="66" as="geometry"/></mxCell>
<mxCell id="b1" value="&lt;b&gt;&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/security/Security_Center.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="405" y="725" width="29.99" height="36" as="geometry"/></mxCell>
<mxCell id="c43" value="What detected it" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#5C2D91;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="448" y="733" width="300" height="20" as="geometry"/></mxCell>
<mxCell id="c44" value="Defender for Key Vault flagged denied access&lt;br&gt;from a suspicious IP. ID Protection flagged&lt;br&gt;the leaked secret. Sentinel joined both with&lt;br&gt;the sign-in logs into one incident." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="402" y="775" width="345" height="66" as="geometry"/></mxCell>
<mxCell id="b2" value="&lt;b&gt;&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/security/Conditional_Access.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="767.01" y="725" width="29.98" height="36" as="geometry"/></mxCell>
<mxCell id="c45" value="What was missing" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#D13438;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="810" y="733" width="300" height="20" as="geometry"/></mxCell>
<mxCell id="c46" value="sp-reporting had a 2-year secret and no&lt;br&gt;Conditional Access for workload identities.&lt;br&gt;A location policy would have refused the&lt;br&gt;token request from outside known IPs." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="764" y="775" width="345" height="66" as="geometry"/></mxCell>
<mxCell id="b3" value="&lt;b&gt;&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/identity/Managed_Identities.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1126" y="725.71" width="36" height="34.58" as="geometry"/></mxCell>
<mxCell id="c47" value="The fix" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#0078D4;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1172" y="733" width="300" height="20" as="geometry"/></mxCell>
<mxCell id="c48" value="Reporting job moved into AKS with workload&lt;br&gt;identity (no secret). An Entra app management&lt;br&gt;policy blocks new client secrets, and GitHub&lt;br&gt;push protection stops secrets at commit time." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1126" y="775" width="345" height="66" as="geometry"/></mxCell>
<mxCell id="c49" value="Same pattern for a phished engineer: risk-based Conditional Access revokes sessions, PIM means no standing Owner role to steal, and every activation is logged." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#323130;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="1420" height="18" as="geometry"/></mxCell>
<mxCell id="c50" value="Alert names are from the Defender for Cloud alert reference. The timeline is illustrative; ID Protection's leaked-credentials check runs offline, so it can lag the attacker by hours." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#605E5C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="910" width="1420" height="17" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="failover" name="4. Region failover runbook"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="790" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Scenario: West Europe goes down during a sale. How the shop moves to North Europe, step by step" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1460" height="24" as="geometry"/></mxCell>
<mxCell id="c2" value="&lt;b&gt;The runbook, with typical timings (rehearsed every quarter in a game day)&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;whiteSpace=wrap;strokeColor=#A19F9D;fillColor=#FAF9F8;strokeWidth=1;dashed=0;fontSize=12;fontColor=#323130;align=left;verticalAlign=top;spacingLeft=32;spacingTop=-2;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="56" width="1460" height="160" as="geometry"/></mxCell>
<mxCell id="c3" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/general/Service_Health.svg;" vertex="1" parent="1"><mxGeometry x="26" y="62.54" width="20" height="18.92" as="geometry"/></mxCell>
<mxCell id="c4" value="1" style="ellipse;html=1;fillColor=#D13438;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c5" value="Detect · ~1-2 min" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#323130;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="70" y="100" width="205" height="19" as="geometry"/></mxCell>
<mxCell id="c6" value="Front Door probes /healthz/deep&lt;br&gt;(checks SQL, Redis, Cosmos) every&lt;br&gt;30 s. 3 of 4 samples fail: West&lt;br&gt;Europe origin marked unhealthy." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="135" width="225" height="62" as="geometry"/></mxCell>
<mxCell id="c7" style="edgeStyle=none;html=1;rounded=0;strokeColor=#A19F9D;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="245" y="109" as="sourcePoint"/><mxPoint x="272" y="109" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c8" value="2" style="ellipse;html=1;fillColor=#5C2D91;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="280" y="98" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c9" value="Route · automatic" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#323130;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="310" y="100" width="205" height="19" as="geometry"/></mxCell>
<mxCell id="c10" value="Front Door sends every request to&lt;br&gt;the priority 2 origin in North&lt;br&gt;Europe. Browse and search work&lt;br&gt;at once; catalog reads are local." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="280" y="135" width="225" height="62" as="geometry"/></mxCell>
<mxCell id="c11" style="edgeStyle=none;html=1;rounded=0;strokeColor=#A19F9D;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="485" y="109" as="sourcePoint"/><mxPoint x="512" y="109" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c12" value="3" style="ellipse;html=1;fillColor=#5C2D91;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="520" y="98" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c13" value="Scale · ~5-8 min" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#323130;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="550" y="100" width="205" height="19" as="geometry"/></mxCell>
<mxCell id="c14" value="HPA scales pods on RPS, cluster&lt;br&gt;autoscaler adds nodes 6 → 40.&lt;br&gt;WAF rate limits and a queue page&lt;br&gt;protect checkout while it warms." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="520" y="135" width="225" height="62" as="geometry"/></mxCell>
<mxCell id="c15" style="edgeStyle=none;html=1;rounded=0;strokeColor=#A19F9D;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="725" y="109" as="sourcePoint"/><mxPoint x="752" y="109" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c16" value="4" style="ellipse;html=1;fillColor=#5C2D91;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="760" y="98" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c17" value="Promote data · &amp;lt;1 min each" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#323130;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="790" y="100" width="205" height="19" as="geometry"/></mxCell>
<mxCell id="c18" value="On-call runs the runbook: forced&lt;br&gt;failover of the SQL failover group&lt;br&gt;and of the Cosmos DB write region.&lt;br&gt;No waiting for Microsoft-managed." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="760" y="135" width="225" height="62" as="geometry"/></mxCell>
<mxCell id="c19" style="edgeStyle=none;html=1;rounded=0;strokeColor=#A19F9D;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="965" y="109" as="sourcePoint"/><mxPoint x="992" y="109" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c20" value="5" style="ellipse;html=1;fillColor=#5C2D91;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1000" y="98" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c21" value="Replay · minutes" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#323130;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1030" y="100" width="205" height="19" as="geometry"/></mxCell>
<mxCell id="c22" value="The order outbox in SQL re-sends&lt;br&gt;events not yet acknowledged by&lt;br&gt;Service Bus. Consumers are&lt;br&gt;idempotent on order ID." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1000" y="135" width="225" height="62" as="geometry"/></mxCell>
<mxCell id="c23" style="edgeStyle=none;html=1;rounded=0;strokeColor=#A19F9D;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1205" y="109" as="sourcePoint"/><mxPoint x="1232" y="109" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c24" value="6" style="ellipse;html=1;fillColor=#5C2D91;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1240" y="98" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c25" value="Fail back · planned" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#323130;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1270" y="100" width="205" height="19" as="geometry"/></mxCell>
<mxCell id="c26" value="Days later, when West Europe is&lt;br&gt;healthy: planned failover (no data&lt;br&gt;loss) at low traffic, then Front&lt;br&gt;Door priorities restored." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1240" y="135" width="225" height="62" as="geometry"/></mxCell>
