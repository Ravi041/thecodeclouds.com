<mxCell id="kv_we" value='&lt;b&gt;Key Vault&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#605E5C"&gt;regional copy&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/security/Key_Vaults.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="570" width="44" height="44" as="geometry"/></mxCell>
