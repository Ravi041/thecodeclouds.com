<mxCell id="fd" value='&lt;b&gt;Front Door Premium&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#605E5C"&gt;origin group: WE p1 · NE p2&lt;br&gt;probe 30 s · sample 4 · need 3&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#323130;image=img/lib/azure2/networking/Front_Doors.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="640" y="248.09" width="52" height="45.82" as="geometry"/></mxCell>
