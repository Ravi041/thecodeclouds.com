<mxCell id="c36" value="all traffic, Private Link" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0078D4;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="900" y="280" width="200" height="17" as="geometry"/></mxCell>
<mxCell id="c37" style="edgeStyle=none;html=1;rounded=0;strokeColor=#0078D4;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="380" as="sourcePoint"/><mxPoint x="846" y="430" as="targetPoint"/><Array as="points"><mxPoint x="1100" y="410"/><mxPoint x="846" y="410"/></Array></mxGeometry></mxCell>
