<mxCell id="c28" value='&lt;b&gt;West Europe · DOWN&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#605E5C"&gt;origin unhealthy · priority 1&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;whiteSpace=wrap;strokeColor=#D13438;fillColor=#FDF3F4;strokeWidth=1.2;dashed=0;fontSize=12;fontColor=#323130;align=left;verticalAlign=top;spacingLeft=32;spacingTop=-2;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="360" width="700" height="400" as="geometry"/></mxCell>
