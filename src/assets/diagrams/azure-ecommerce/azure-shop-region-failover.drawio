<mxCell id="c16" value="4" style="ellipse;html=1;fillColor=#5C2D91;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="760" y="98" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c17" value="Promote data · &amp;lt;1 min each" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#323130;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="790" y="100" width="205" height="19" as="geometry"/></mxCell>
<mxCell id="c18" value="On-call runs the runbook: forced&lt;br&gt;failover of the SQL failover group&lt;br&gt;and of the Cosmos DB write region.&lt;br&gt;No waiting for Microsoft-managed." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="760" y="135" width="225" height="62" as="geometry"/></mxCell>
