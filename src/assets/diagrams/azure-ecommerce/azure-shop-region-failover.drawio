<mxCell id="c24" value="6" style="ellipse;html=1;fillColor=#5C2D91;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1240" y="98" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c25" value="Fail back · planned" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#323130;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1270" y="100" width="205" height="19" as="geometry"/></mxCell>
<mxCell id="c26" value="Days later, when West Europe is&lt;br&gt;healthy: planned failover (no data&lt;br&gt;loss) at low traffic, then Front&lt;br&gt;Door priorities restored." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1240" y="135" width="225" height="62" as="geometry"/></mxCell>
