<mxCell id="c20" value="5" style="ellipse;html=1;fillColor=#5C2D91;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1000" y="98" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c21" value="Replay · minutes" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#323130;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1030" y="100" width="205" height="19" as="geometry"/></mxCell>
<mxCell id="c22" value="The order outbox in SQL re-sends&lt;br&gt;events not yet acknowledged by&lt;br&gt;Service Bus. Consumers are&lt;br&gt;idempotent on order ID." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1000" y="135" width="225" height="62" as="geometry"/></mxCell>
