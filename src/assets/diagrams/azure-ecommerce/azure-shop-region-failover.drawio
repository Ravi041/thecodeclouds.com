<mxCell id="c4" value="1" style="ellipse;html=1;fillColor=#D13438;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c5" value="Detect · ~1-2 min" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#323130;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="70" y="100" width="205" height="19" as="geometry"/></mxCell>
<mxCell id="c6" value="Front Door probes /healthz/deep&lt;br&gt;(checks SQL, Redis, Cosmos) every&lt;br&gt;30 s. 3 of 4 samples fail: West&lt;br&gt;Europe origin marked unhealthy." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="135" width="225" height="62" as="geometry"/></mxCell>
<mxCell id="c7" style="edgeStyle=none;html=1;rounded=0;strokeColor=#A19F9D;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="245" y="109" as="sourcePoint"/><mxPoint x="272" y="109" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c8" value="2" style="ellipse;html=1;fillColor=#5C2D91;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="280" y="98" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c9" value="Route · automatic" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#323130;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="310" y="100" width="205" height="19" as="geometry"/></mxCell>
<mxCell id="c10" value="Front Door sends every request to&lt;br&gt;the priority 2 origin in North&lt;br&gt;Europe. Browse and search work&lt;br&gt;at once; catalog reads are local." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="280" y="135" width="225" height="62" as="geometry"/></mxCell>
<mxCell id="c11" style="edgeStyle=none;html=1;rounded=0;strokeColor=#A19F9D;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="485" y="109" as="sourcePoint"/><mxPoint x="512" y="109" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c12" value="3" style="ellipse;html=1;fillColor=#5C2D91;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="520" y="98" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c13" value="Scale · ~5-8 min" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#323130;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="550" y="100" width="205" height="19" as="geometry"/></mxCell>
<mxCell id="c14" value="HPA scales pods on RPS, cluster&lt;br&gt;autoscaler adds nodes 6 → 40.&lt;br&gt;WAF rate limits and a queue page&lt;br&gt;protect checkout while it warms." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="520" y="135" width="225" height="62" as="geometry"/></mxCell>
