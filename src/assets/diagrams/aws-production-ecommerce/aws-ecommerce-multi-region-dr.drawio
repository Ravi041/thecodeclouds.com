<mxCell id="c33" value="PRIMARY: on" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#8C4FFF;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="560" y="238" width="140" height="17" as="geometry"/></mxCell>
<mxCell id="c34" value="SECONDARY: standby" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;fontSize=11;fontColor=#8C4FFF;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="748" y="238" width="160" height="17" as="geometry"/></mxCell>
<mxCell id="c35" value="&lt;b&gt;Not replicated, rebuilt after failover&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#9AA0A6;fillColor=#F8F9FA;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="36" y="300" width="250" height="200" as="geometry"/></mxCell>
<mxCell id="c36" value="OpenSearch product index:&lt;br&gt;re-fed from the catalog table.&lt;br&gt;&lt;br&gt;SQS in-flight messages:&lt;br&gt;producers are idempotent,&lt;br&gt;so replays are safe.&lt;br&gt;&lt;br&gt;Scheduled jobs: disabled&lt;br&gt;in standby, enabled by&lt;br&gt;the failover plan." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="336" width="230" height="152" as="geometry"/></mxCell>
<mxCell id="c37" value="&lt;b&gt;Failover plan (unplanned)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#E7157B;fillColor=#FFF5FA;dashed=0;fontSize=12;fontStyle=0;fontColor=#E7157B;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1214" y="300" width="252" height="590" as="geometry"/></mxCell>
<mxCell id="c38" value="1. Canaries in 3 regions fail;&lt;br&gt;    composite alarm pages on-call" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1226" y="336" width="236" height="32" as="geometry"/></mxCell>
<mxCell id="c39" value="2. Incident lead decides to&lt;br&gt;    fail over (human approval)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1226" y="402" width="236" height="32" as="geometry"/></mxCell>
<mxCell id="c40" value="3. Karpenter scales us-west-2&lt;br&gt;    EKS from 15 to 60 nodes" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1226" y="468" width="236" height="32" as="geometry"/></mxCell>
<mxCell id="c41" value="4. Aurora global failover:&lt;br&gt;    promote us-west-2 cluster" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1226" y="534" width="236" height="32" as="geometry"/></mxCell>
<mxCell id="c42" value="5. Promote ElastiCache&lt;br&gt;    secondary (or start cold)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1226" y="600" width="236" height="32" as="geometry"/></mxCell>
<mxCell id="c43" value="6. Flip ARC routing control:&lt;br&gt;    us-west-2 on, us-east-1 off" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1226" y="666" width="236" height="32" as="geometry"/></mxCell>
<mxCell id="c44" value="7. Watch checkout success&lt;br&gt;    rate and p99 in us-west-2" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1226" y="732" width="236" height="32" as="geometry"/></mxCell>
<mxCell id="c45" value="8. Later: rebuild old primary&lt;br&gt;    as secondary, fail back&lt;br&gt;    in a quiet hour" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1226" y="798" width="236" height="47" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
