<mxCell id="c27" value="&lt;b&gt;shop-dev&lt;/b&gt;" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="1"><mxGeometry x="995" y="548" width="220" height="155" as="geometry"/></mxCell>
<mxCell id="c28" value="Spot-only node pools.&lt;br&gt;No customer data,&lt;br&gt;synthetic test data only." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1010" y="590" width="200" height="47" as="geometry"/></mxCell>
<mxCell id="c29" value="&lt;b&gt;Sandbox OU&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#7AA116;fillColor=#F5F9EC;dashed=0;fontSize=12;fontStyle=0;fontColor=#5B7A12;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1260" y="262" width="220" height="300" as="geometry"/></mxCell>
<mxCell id="sbud" value='&lt;b&gt;Per-engineer accounts&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;$200/month budget&lt;br&gt;nuked every Sunday&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.budgets;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1338" y="330" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="c30" value="No VPN, no TGW attachment,&lt;br&gt;no path to prod data" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1275" y="470" width="200" height="32" as="geometry"/></mxCell>
<mxCell id="c31" value="&lt;b&gt;Suspended OU&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#7D8998;fillColor=#F7F8FA;dashed=0;fontSize=12;fontStyle=0;fontColor=#5A6C86;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1260" y="580" width="220" height="152" as="geometry"/></mxCell>
<mxCell id="c32" value="Deny-all SCP. Closed accounts&lt;br&gt;wait here for 90 days." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1275" y="625" width="200" height="32" as="geometry"/></mxCell>
<mxCell id="c33" value="&lt;b&gt;Preventive guardrails attached at the OU, not the account&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#E7157B;fillColor=#FFF5FA;dashed=0;fontSize=12;fontStyle=0;fontColor=#E7157B;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="752" width="1460" height="158" as="geometry"/></mxCell>
<mxCell id="c34" value="SCP: deny regions other than us-east-1 and us-west-2 (global services exempt)&lt;br&gt;SCP: deny leaving the org, deleting CloudTrail, disabling GuardDuty or Config&lt;br&gt;SCP: deny any action by the root user; deny creating IAM users and access keys&lt;br&gt;SCP: deny ec2:RunInstances unless IMDSv2 is required" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="700" height="66" as="geometry"/></mxCell>
<mxCell id="c35" value="RCP: S3, KMS and Secrets Manager only reachable by principals in this org&lt;br&gt;RCP: deny requests that do not use TLS&lt;br&gt;Declarative policy: block public AMI and EBS snapshot sharing&lt;br&gt;Tag policy: CostCentre and Service tags required on every resource" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="760" y="790" width="700" height="66" as="geometry"/></mxCell>
<mxCell id="c36" value="Detective controls (Config rules, Security Hub standards) report drift. Preventive ones stop it happening." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="878" width="1100" height="17" as="geometry"/></mxCell></root></mxGraphModel></diagram>
