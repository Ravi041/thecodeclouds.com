<mxCell id="qs" value='&lt;b&gt;QuickSight&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;model health board&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.quicksight;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="830" y="760" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="mlf" value='&lt;b&gt;MLflow App&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;monitoring runs&lt;br&gt;per model version&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sagemaker_notebook;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1020" y="760" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="sns" value='&lt;b&gt;SNS: on-call&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;fraud ops channel&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1080" y="610" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="c34" style="edgeStyle=none;html=1;rounded=0;strokeColor=#E7157B;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cw" target="sns"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c35" value="PSI &amp;gt; 0.25 on 3+ features&lt;br&gt;for 6 h, or precision&lt;br&gt;drop of 5 pts" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#E7157B;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="880" y="578" width="190" height="44" as="geometry"/></mxCell>
<mxCell id="c36" value="&lt;b&gt;Retrain decision&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#01A88D;fillColor=#E6F6F3;dashed=0;fontSize=12;fontStyle=0;fontColor=#01A88D;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1230" y="560" width="250" height="280" as="geometry"/></mxCell>
<mxCell id="c37" value="On-call checks the cause first:&lt;br&gt;data pipeline bug, upstream&lt;br&gt;schema change, or real change&lt;br&gt;in fraud patterns. Only the last&lt;br&gt;one needs a new model.&lt;br&gt;&lt;br&gt;Then start the training pipeline&lt;br&gt;with a fresh window. A new&lt;br&gt;version goes through every&lt;br&gt;gate above again." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1245" y="595" width="230" height="152" as="geometry"/></mxCell>
<mxCell id="c38" style="edgeStyle=none;html=1;rounded=0;strokeColor=#01A88D;strokeWidth=1.5;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="sns" target="p1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1215" y="634"/><mxPoint x="1215" y="245"/><mxPoint x="215" y="245"/></Array></mxGeometry></mxCell>
<mxCell id="c39" value="retrain: new version, back to the top" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#01A88D;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="940" y="249" width="270" height="16" as="geometry"/></mxCell>
<mxCell id="c40" value="Model Monitor and Clarify are no longer&lt;br&gt;open to new customers, so the checks&lt;br&gt;below are your own Processing jobs&lt;br&gt;(open-source drift libraries, SHAP),&lt;br&gt;with results in CloudWatch, MLflow&lt;br&gt;and QuickSight." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="940" y="280" width="260" height="86" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
