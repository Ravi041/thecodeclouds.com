<mxCell id="m1" value="Hourly: drift&lt;br&gt;PSI on top-20 features and the&lt;br&gt;score, null and range checks&lt;br&gt;against the training baseline" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#E7157B;fillColor=#FDF2F8;fontColor=#232F3E;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="220" y="600" width="250" height="96" as="geometry"/></mxCell>
<mxCell id="m2" value="Daily: alert precision&lt;br&gt;analyst outcomes after 48 h,&lt;br&gt;decline rate per segment" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#E7157B;fillColor=#FDF2F8;fontColor=#232F3E;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="220" y="720" width="250" height="84" as="geometry"/></mxCell>
<mxCell id="m3" value="Monthly: true recall&lt;br&gt;chargebacks matured at 90 days,&lt;br&gt;fraud loss in basis points" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#E7157B;fillColor=#FDF2F8;fontColor=#232F3E;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="500" y="720" width="250" height="84" as="geometry"/></mxCell>
