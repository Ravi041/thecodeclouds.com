<mxCell id="c25" value="&lt;b&gt;Monitoring pipeline (scheduled SageMaker Processing jobs, fraud-prod)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#E7157B;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#E7157B;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="1180" height="280" as="geometry"/></mxCell>
