<mxCell id="c17" value="&lt;b&gt;Endpoint scaling (Application Auto Scaling)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#01A88D;fillColor=#E6F6F3;dashed=0;fontSize=12;fontStyle=0;fontColor=#01A88D;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1110" y="330" width="350" height="250" as="geometry"/></mxCell>
<mxCell id="c18" value="Target tracking on&lt;br&gt;SageMakerVariantInvocationsPerInstance:&lt;br&gt;18,000 per minute per instance, 60% of&lt;br&gt;the 30,000 where p99 broke in load tests.&lt;br&gt;Second policy on the 10-second&lt;br&gt;ConcurrentRequestsPerModel metric.&lt;br&gt;Min 6 (2 per AZ), max 30.&lt;br&gt;Scale-out cooldown 60 s, scale-in 600 s.&lt;br&gt;Scheduled action: min 16 for the&lt;br&gt;Black Friday weekend." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1170" y="360" width="285" height="152" as="geometry"/></mxCell>
