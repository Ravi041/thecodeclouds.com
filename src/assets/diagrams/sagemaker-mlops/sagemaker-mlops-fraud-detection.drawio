<mxCell id="c23" value="&lt;b&gt;p99 budget in the risk service&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#545B64;fillColor=#F7F8FA;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="210" height="250" as="geometry"/></mxCell>
<mxCell id="c24" value="receive and parse      2 ms&lt;br&gt;online features (3)   10 ms&lt;br&gt;build vector           2 ms&lt;br&gt;endpoint (4)          22 ms&lt;br&gt;rules and response     4 ms&lt;br&gt;total                 40 ms&lt;br&gt;headroom              20 ms" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="32" y="336" width="190" height="107" as="geometry"/></mxCell>
