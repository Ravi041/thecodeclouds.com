<mxCell id="c20" value="Budgets and anomaly alerts&lt;br&gt;lag by hours. CloudWatch alarms&lt;br&gt;on request rate catch a runaway&lt;br&gt;loop in minutes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1200" y="482" width="240" height="62" as="geometry"/></mxCell>
<mxCell id="c21" value="Budget alerts do not stop spending. The throttles above are what actually cap it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3F6E10;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="250" y="680" width="900" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="async" name="3. Uploads and weekly digest"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Keep slow work off the request path: photo uploads and the weekly email digest" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1200" height="24" as="geometry"/></mxCell>
<mxCell id="c2" value="&lt;b&gt;A. Recipe photo upload (Lambda never touches the bytes)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#7AA116;fillColor=#F6FAF0;dashed=0;fontSize=12;fontStyle=0;fontColor=#3F6E10;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="1460" height="300" as="geometry"/></mxCell>
