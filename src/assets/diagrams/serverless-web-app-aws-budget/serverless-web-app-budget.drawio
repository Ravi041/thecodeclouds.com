<mxCell id="fn" value='&lt;b&gt;uploads fn&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;signs a presigned POST&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="470" y="150" width="52" height="52" as="geometry"/></mxCell>
