<mxfile host="thecodeclouds.com" agent="hand-built" version="24.0.0" type="device">
<diagram id="guardrails" name="2. Spike and cost guardrails"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Six places to put a ceiling: absorb a real spike, stop a runaway bill" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1200" height="24" as="geometry"/></mxCell>
<mxCell id="c2" value="Example spike: a TV feature sends 80,000 sessions in 3 hours. Peak about 740 API requests/s, about 90 Lambda functions running at once, 35 sign-ups/s for two minutes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1400" height="18" as="geometry"/></mxCell>
<mxCell id="users" value='&lt;b&gt;Visitors&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;humans + bots&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.users;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="52" height="52" as="geometry"/></mxCell>
<mxCell id="waf" value="&lt;b&gt;AWS WAF&lt;/b&gt;" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.waf;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="269" y="150" width="52" height="52" as="geometry"/></mxCell>
<mxCell id="c3" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=2.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="users" target="waf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="cf" value="&lt;b&gt;CloudFront&lt;/b&gt;" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="479" y="150" width="52" height="52" as="geometry"/></mxCell>
<mxCell id="c4" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=2.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="waf" target="cf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="api" value="&lt;b&gt;HTTP API&lt;/b&gt;" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="689" y="150" width="52" height="52" as="geometry"/></mxCell>
<mxCell id="c5" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=2.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cf" target="api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="fn" value="&lt;b&gt;Lambda&lt;/b&gt;" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="899" y="150" width="52" height="52" as="geometry"/></mxCell>
<mxCell id="c6" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=2.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="api" target="fn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="ddb" value="&lt;b&gt;DynamoDB&lt;/b&gt;" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1109" y="150" width="52" height="52" as="geometry"/></mxCell>
<mxCell id="c7" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=2.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fn" target="ddb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="cog" value="&lt;b&gt;Cognito&lt;/b&gt;" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1319" y="150" width="52" height="52" as="geometry"/></mxCell>
<mxCell id="c8" style="edgeStyle=none;html=1;rounded=0;strokeColor=#DD344C;strokeWidth=2;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="users" target="cog"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="66" y="120"/><mxPoint x="1345" y="120"/></Array></mxGeometry></mxCell>
<mxCell id="c9" value="sign-up and sign-in go straight to the user pool" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#DD344C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="560" y="102" width="360" height="17" as="geometry"/></mxCell>
<mxCell id="c10" value="1  Rate-based rule&lt;br&gt;1,000 requests per 5 min per IP&lt;br&gt;AWS managed: core rule set,&lt;br&gt;known bad inputs, IP reputation&lt;br&gt;Blocked requests never reach&lt;br&gt;API Gateway or Lambda, so&lt;br&gt;they never bill there either" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#DD344C;fillColor=#FFFFFF;fontColor=#232F3E;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="210" y="250" width="200" height="150" as="geometry"/></mxCell>
<mxCell id="c11" value="2  Cache what you can&lt;br&gt;SPA and images: 1-year TTL,&lt;br&gt;hashed file names&lt;br&gt;GET /api/public/*: 60 s TTL&lt;br&gt;Origin Shield off (not needed&lt;br&gt;for a single Region origin)&lt;br&gt;Most bytes never reach the Region" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#8C4FFF;fillColor=#FFFFFF;fontColor=#232F3E;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="420" y="250" width="200" height="150" as="geometry"/></mxCell>
<mxCell id="c12" value="3  Throttle the front door&lt;br&gt;Stage: 1,000 req/s steady,&lt;br&gt;burst 2,000&lt;br&gt;Route PUT /plans: 200 req/s&lt;br&gt;Account default is 10,000&lt;br&gt;req/s; set yours far lower&lt;br&gt;Clients get 429, retry w/ jitter" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#8C4FFF;fillColor=#FFFFFF;fontColor=#232F3E;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="630" y="250" width="200" height="150" as="geometry"/></mxCell>
<mxCell id="c13" value="4  Cap parallel spend&lt;br&gt;API functions: reserved&lt;br&gt;concurrency 300&lt;br&gt;thumbnail fn: 20, send fn: 5&lt;br&gt;Account default 1,000; scales&lt;br&gt;1,000 envs every 10 s per fn&lt;br&gt;Peak needed here: about 90" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#ED7100;fillColor=#FFFFFF;fontColor=#232F3E;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="840" y="250" width="200" height="150" as="geometry"/></mxCell>
<mxCell id="c14" value="5  Cap the table&lt;br&gt;On-demand max throughput:&lt;br&gt;2,000 writes/s, 6,000 reads/s&lt;br&gt;New on-demand tables take&lt;br&gt;4,000 writes/s, 12,000 reads/s&lt;br&gt;and double the previous peak&lt;br&gt;Peak needed here: about 300 WRU/s" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#C925D1;fillColor=#FFFFFF;fontColor=#232F3E;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1050" y="250" width="200" height="150" as="geometry"/></mxCell>
<mxCell id="c15" value="6  Know the auth quotas&lt;br&gt;UserCreation (SignUp): 50 req/s&lt;br&gt;UserAuthentication: 120 req/s&lt;br&gt;Both adjustable: raise them&lt;br&gt;before a planned launch&lt;br&gt;Lite plan: 10,000 MAU free,&lt;br&gt;then $0.0055 per MAU" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#DD344C;fillColor=#FFFFFF;fontColor=#232F3E;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1260" y="250" width="200" height="150" as="geometry"/></mxCell>
<mxCell id="c16" value="&lt;b&gt;If something gets through anyway: find out the same day, not on the invoice&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#7AA116;fillColor=#F6FAF0;dashed=0;fontSize=12;fontStyle=0;fontColor=#3F6E10;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="210" y="440" width="1250" height="280" as="geometry"/></mxCell>
<mxCell id="cw" value='&lt;b&gt;CloudWatch alarms&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;4XX/5XX rate, Lambda&lt;br&gt;throttles, p95 latency&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="250" y="490" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="bud" value='&lt;b&gt;AWS Budgets&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;$60/month: alerts at 50%,&lt;br&gt;80%, 100% + forecast&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.budgets;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="520" y="490" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="ce" value='&lt;b&gt;Cost Anomaly Detection&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;per-service monitor,&lt;br&gt;daily summary&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cost_explorer;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="790" y="490" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="sns" value='&lt;b&gt;SNS topic&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;email + chat&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1060" y="490" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="c17" style="edgeStyle=none;html=1;rounded=0;strokeColor=#E7157B;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="274" y="590" as="sourcePoint"/><mxPoint x="1084" y="578" as="targetPoint"/><Array as="points"><mxPoint x="274" y="640"/><mxPoint x="1084" y="640"/></Array></mxGeometry></mxCell>
<mxCell id="c18" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7AA116;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="544" y="590" as="sourcePoint"/><mxPoint x="544" y="640" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c19" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7AA116;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="814" y="578" as="sourcePoint"/><mxPoint x="814" y="640" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c20" value="Budgets and anomaly alerts&lt;br&gt;lag by hours. CloudWatch alarms&lt;br&gt;on request rate catch a runaway&lt;br&gt;loop in minutes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1200" y="482" width="240" height="62" as="geometry"/></mxCell>
<mxCell id="c21" value="Budget alerts do not stop spending. The throttles above are what actually cap it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3F6E10;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="250" y="680" width="900" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
