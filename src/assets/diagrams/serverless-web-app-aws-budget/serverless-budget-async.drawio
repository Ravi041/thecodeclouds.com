<mxCell id="c27" value="Max concurrency 5 keeps the send rate inside the SES quota. A failed batch retries,&lt;br&gt;then lands in the DLQ instead of looping. Lambda and SQS cost cents; SES is about $8 per 50,000 emails." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="680" y="655" width="640" height="32" as="geometry"/></mxCell></root></mxGraphModel></diagram>
