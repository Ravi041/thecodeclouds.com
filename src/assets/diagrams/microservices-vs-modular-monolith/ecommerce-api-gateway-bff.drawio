<mxfile host="thecodeclouds.com" agent="hand-built" version="24.0.0" type="device">
<diagram id="ecommerce-api-gateway-bff" name="4. API gateway and BFF"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="790" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="API gateway and Backend-for-Frontend: who does what on the request path" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1460" height="26" as="geometry"/></mxCell>
<mxCell id="c2" value="The gateway owns cross-cutting concerns. Each BFF is owned by the team that owns the screen. Neither holds business rules." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1460" height="19" as="geometry"/></mxCell>
<mxCell id="c_web" value='&lt;b&gt;Web storefront&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;Next.js, SSR&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#5F6368;fillColor=#FFFFFF;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="140" width="180" height="62" as="geometry"/></mxCell>
<mxCell id="c_app" value='&lt;b&gt;iOS / Android app&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;3 versions in the wild&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#5F6368;fillColor=#FFFFFF;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="260" width="180" height="62" as="geometry"/></mxCell>
<mxCell id="c_partner" value='&lt;b&gt;Marketplace partners&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;server to server&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#5F6368;fillColor=#FFFFFF;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="380" width="180" height="62" as="geometry"/></mxCell>
<mxCell id="c_admin" value='&lt;b&gt;Back-office&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;staff, SSO&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#5F6368;fillColor=#FFFFFF;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="500" width="180" height="62" as="geometry"/></mxCell>
