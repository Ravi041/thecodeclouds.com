<diagram id="ecommerce-team-growth-5-to-50" name="2. From 5 to 50 engineers"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Scenario: an online shop growing from 5 to 50 engineers" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1460" height="26" as="geometry"/></mxCell>
<mxCell id="c2" value="Architecture follows the team. Each stage solves the problem the previous one created, not one you might have later." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1460" height="19" as="geometry"/></mxCell>
<mxCell id="c3" value="&lt;b&gt;Stage 1 · year 1 · 5 engineers&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#1A73E8;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="470" height="660" as="geometry"/></mxCell>
<mxCell id="c4" value="One team, one Rails/Django/Spring app" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="112" width="440" height="19" as="geometry"/></mxCell>
<mxCell id="s0_0" value='&lt;b&gt;One deployable&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;deploys 10x a day, no waiting&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#E8F0FE;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="410" height="62" as="geometry"/></mxCell>
<mxCell id="s0_1" value='&lt;b&gt;One database&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;joins and transactions are free&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#E8F0FE;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="232" width="410" height="62" as="geometry"/></mxCell>
<mxCell id="s0_2" value='&lt;b&gt;Folders, not modules&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;fine while everyone knows the code&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#E8F0FE;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="314" width="410" height="62" as="geometry"/></mxCell>
<mxCell id="a0" value="&lt;b&gt;shop-app&lt;/b&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#E8F0FE;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="170" y="410" width="170" height="50" as="geometry"/></mxCell>
<mxCell id="a0db" value="&lt;b&gt;shop DB&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;strokeColor=#1A73E8;fillColor=#FFFFFF;fontSize=11;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="195" y="490" width="120" height="56" as="geometry"/></mxCell>
<mxCell id="c5" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1A73E8;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a0" target="a0db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c6" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#D93025;fillColor=#FCE8E6;dashed=0;fontSize=12;fontStyle=0;fontColor=#D93025;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="600" width="410" height="94" as="geometry"/></mxCell>
<mxCell id="c7" value='Pain that ends this stage:&lt;br&gt;merge conflicts in checkout code,&lt;br&gt;a 25 min test suite, one person&lt;br&gt;who "owns" payments in their head.' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="624" width="390" height="62" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;Stage 2 · year 2 · 15 to 20 engineers&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#7B3FE4;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#7B3FE4;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="515" y="80" width="470" height="660" as="geometry"/></mxCell>
<mxCell id="c9" value="Three teams, same deployable, real modules" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="531" y="112" width="440" height="19" as="geometry"/></mxCell>
<mxCell id="s1_0" value='&lt;b&gt;Modules with interfaces&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;Discover · Buy · Fulfil&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#7B3FE4;fillColor=#F3EDFD;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="545" y="150" width="410" height="62" as="geometry"/></mxCell>
<mxCell id="s1_1" value='&lt;b&gt;Schema per module&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;no cross-module joins&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#7B3FE4;fillColor=#F3EDFD;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="545" y="232" width="410" height="62" as="geometry"/></mxCell>
<mxCell id="s1_2" value='&lt;b&gt;CODEOWNERS + CI rules&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;boundary checks fail the build&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#7B3FE4;fillColor=#F3EDFD;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="545" y="314" width="410" height="62" as="geometry"/></mxCell>
