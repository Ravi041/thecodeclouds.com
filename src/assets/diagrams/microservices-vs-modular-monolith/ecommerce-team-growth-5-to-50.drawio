<mxCell id="a2s2" value="&lt;b&gt;inventory&lt;/b&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#188038;fillColor=#E6F4EA;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1374" y="455" width="78" height="46" as="geometry"/></mxCell>
