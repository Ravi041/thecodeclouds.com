<mxCell id="c19" value="Extract only where there is a&lt;br&gt;reason: different scale, different&lt;br&gt;compliance, or a team blocked&lt;br&gt;by the release train. Everything&lt;br&gt;else stays in the core." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1050" y="624" width="390" height="77" as="geometry"/></mxCell>
