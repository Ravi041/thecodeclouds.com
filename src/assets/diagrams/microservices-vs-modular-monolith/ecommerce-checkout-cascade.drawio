<mxfile host="thecodeclouds.com" agent="hand-built" version="24.0.0" type="device">
<diagram id="ecommerce-checkout-cascade" name="5. Checkout outage cascade"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Scenario: how one slow fraud check took the whole shop down, and the fixed design" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1460" height="26" as="geometry"/></mxCell>
<mxCell id="c2" value="Sale night, 20:00. Nothing crashed. Everything waited." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1460" height="19" as="geometry"/></mxCell>
<mxCell id="c3" value="&lt;b&gt;Before: synchronous chain, default timeouts, retries at every hop, one shared pool&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#D93025;fillColor=#FFFBFA;dashed=0;fontSize=12;fontStyle=0;fontColor=#D93025;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="1460" height="370" as="geometry"/></mxCell>
<mxCell id="u" value='&lt;b&gt;Shoppers&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;9,000 checkouts/min&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#5F6368;fillColor=#FFFFFF;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="220" height="62" as="geometry"/></mxCell>
<mxCell id="g" value='&lt;b&gt;API gateway&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;one shared upstream pool&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#5F6368;fillColor=#FFFFFF;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="130" width="220" height="62" as="geometry"/></mxCell>
<mxCell id="c4" style="edgeStyle=none;html=1;rounded=0;strokeColor=#D93025;strokeWidth=2.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="u" target="g"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="ck" value='&lt;b&gt;Checkout&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;200 worker threads&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#5F6368;fillColor=#FFFFFF;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620" y="130" width="220" height="62" as="geometry"/></mxCell>
<mxCell id="c5" style="edgeStyle=none;html=1;rounded=0;strokeColor=#D93025;strokeWidth=2.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g" target="ck"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="py" value='&lt;b&gt;Payments&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;timeout: 30 s (library default)&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#5F6368;fillColor=#FFFFFF;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="910" y="130" width="220" height="62" as="geometry"/></mxCell>
<mxCell id="c6" style="edgeStyle=none;html=1;rounded=0;strokeColor=#D93025;strokeWidth=2.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ck" target="py"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="fr" value='&lt;b&gt;Fraud scoring&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;vendor API, p99 0.4 s → 28 s&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#D93025;fillColor=#FCE8E6;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="130" width="220" height="62" as="geometry"/></mxCell>
<mxCell id="c7" style="edgeStyle=none;html=1;rounded=0;strokeColor=#D93025;strokeWidth=2.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="py" target="fr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c8" value="retry x3" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#D93025;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="558" y="140" width="60" height="17" as="geometry"/></mxCell>
<mxCell id="c9" value="retry x3" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#D93025;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="848" y="140" width="60" height="17" as="geometry"/></mxCell>
<mxCell id="c10" value="retry x3" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#D93025;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1138" y="140" width="60" height="17" as="geometry"/></mxCell>
<mxCell id="pp" value='&lt;b&gt;Product pages, search, cart&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;share the gateway pool&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#5F6368;fillColor=#FFFFFF;strokeWidth=1.5;dashed=1;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="250" width="220" height="50" as="geometry"/></mxCell>
<mxCell id="c11" style="edgeStyle=none;html=1;rounded=0;strokeColor=#D93025;strokeWidth=2;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g" target="pp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c12" value="20:02  Fraud vendor slows down. Payments threads sit waiting on 30 s calls." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="640" y="225" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="c13" value="20:04  Checkout's 200 threads are all blocked on Payments. New checkouts queue, then time out." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="640" y="247" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="c14" value="20:05  Gateway, Checkout and Payments each retry 3 times: 3 x 3 x 3 = 27 requests per click." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="640" y="269" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="c15" value="20:07  Gateway upstream pool is full of checkout requests. Product pages and search start failing too." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="640" y="291" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="c16" value="20:31  Rollback does nothing (no code changed). Fraud check disabled by hand; 29 minutes of lost sales." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#D93025;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="640" y="313" width="820" height="18" as="geometry"/></mxCell>
<mxCell id="c17" value="Root cause: not the vendor. Unbounded waiting, multiplied retries and no isolation between checkout and browsing." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#D93025;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="405" width="1400" height="19" as="geometry"/></mxCell>
<mxCell id="c18" value="&lt;b&gt;After: deadlines, isolation and an async tail. A slow dependency degrades one feature, not the shop.&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#188038;fillColor=#FBFEFC;dashed=0;fontSize=12;fontStyle=0;fontColor=#188038;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="480" width="1460" height="400" as="geometry"/></mxCell>
<mxCell id="u2" value="&lt;b&gt;Shoppers&lt;/b&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#5F6368;fillColor=#FFFFFF;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="150" height="50" as="geometry"/></mxCell>
<mxCell id="g2" value='&lt;b&gt;API gateway&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;per-route pools + load shedding&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#7B3FE4;fillColor=#F3EDFD;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230" y="530" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="ck2" value='&lt;b&gt;Checkout&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;deadline 2 s end to end&lt;br&gt;bulkhead: pool per dependency&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#E8F0FE;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="525" width="250" height="80" as="geometry"/></mxCell>
<mxCell id="py2" value='&lt;b&gt;Payments&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;authorise, timeout 800 ms&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#188038;fillColor=#E6F4EA;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="530" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="cb" value='&lt;b&gt;Circuit breaker&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;opens at 20% errors / slow calls&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#E8710A;fillColor=#FEF0E3;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="515" width="230" height="50" as="geometry"/></mxCell>
<mxCell id="fr2" value='&lt;b&gt;Fraud scoring&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;timeout 300 ms&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#5F6368;fillColor=#FFFFFF;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="600" width="230" height="50" as="geometry"/></mxCell>
<mxCell id="fb" value='&lt;b&gt;Fallback: rules-based score,&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;hold orders &amp;gt; $300 for review&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#E8710A;fillColor=#FEF0E3;strokeWidth=1.5;dashed=1;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="680" width="230" height="56" as="geometry"/></mxCell>
<mxCell id="c19" style="edgeStyle=none;html=1;rounded=0;strokeColor=#188038;strokeWidth=2.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="u2" target="g2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c20" style="edgeStyle=none;html=1;rounded=0;strokeColor=#188038;strokeWidth=2.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g2" target="ck2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c21" style="edgeStyle=none;html=1;rounded=0;strokeColor=#188038;strokeWidth=2.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ck2" target="py2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c22" style="edgeStyle=none;html=1;rounded=0;strokeColor=#188038;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="py2" target="cb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c23" style="edgeStyle=none;html=1;rounded=0;strokeColor=#188038;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cb" target="fr2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c24" style="edgeStyle=none;html=1;rounded=0;strokeColor=#E8710A;strokeWidth=2;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cb" target="fb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1360" y="540"/><mxPoint x="1360" y="708"/></Array></mxGeometry></mxCell>
<mxCell id="c25" value="open" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#E8710A;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1365" y="610" width="60" height="17" as="geometry"/></mxCell>
<mxCell id="q" value="&lt;b&gt;order-placed queue (outbox)&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;strokeColor=#E8710A;fillColor=#FEF0E3;strokeWidth=1.5;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="650" width="380" height="40" as="geometry"/></mxCell>
<mxCell id="c26" style="edgeStyle=none;html=1;rounded=0;strokeColor=#E8710A;strokeWidth=2;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ck2" target="q"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="w" value='&lt;b&gt;Capture + emails + fulfilment workers&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;retry with backoff, idempotency keys&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#E8710A;fillColor=#FEF0E3;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="735" width="380" height="56" as="geometry"/></mxCell>
<mxCell id="c27" style="edgeStyle=none;html=1;rounded=0;strokeColor=#E8710A;strokeWidth=2;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q" target="w"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c28" value="1  Retry in one place only (the client or gateway), with jitter and a retry budget of 10%." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="440" height="17" as="geometry"/></mxCell>
<mxCell id="c29" value="2  Every call carries the remaining deadline; nothing waits longer than the user will." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="664" width="440" height="17" as="geometry"/></mxCell>
<mxCell id="c30" value="3  Separate pools per downstream: Payments being slow cannot use Search's threads." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="688" width="440" height="17" as="geometry"/></mxCell>
<mxCell id="c31" value='4  Accept the order, then capture, email and ship from a queue. User sees "Order received".' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="712" width="440" height="17" as="geometry"/></mxCell>
<mxCell id="c32" value="Result in the next sale: fraud vendor slowed again for 11 minutes, breaker opened, 0 checkout errors, 214 orders held for review." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#188038;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="1420" height="19" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
