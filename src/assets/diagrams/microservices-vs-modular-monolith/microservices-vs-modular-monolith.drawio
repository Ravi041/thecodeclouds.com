<mxCell id="b_partner" value='&lt;b&gt;Partner API&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;public, versioned v1/v2,&lt;br&gt;quotas, webhooks&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#E8F0FE;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="380" width="220" height="70" as="geometry"/></mxCell>
