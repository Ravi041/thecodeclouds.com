<mxCell id="c24" style="edgeStyle=none;html=1;rounded=0;strokeColor=#E8710A;strokeWidth=2;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="930" y="542" as="sourcePoint"/><mxPoint x="390" y="542" as="targetPoint"/><Array as="points"><mxPoint x="930" y="600"/><mxPoint x="390" y="600"/></Array></mxGeometry></mxCell>
<mxCell id="c25" value="PaymentCaptured" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#E8710A;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="790" y="604" width="140" height="17" as="geometry"/></mxCell>
<mxCell id="c26" value='&lt;b&gt;"Product" is not one thing&lt;/b&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#202124;fillColor=#F1F3F4;dashed=0;fontSize=12;fontStyle=0;fontColor=#202124;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="760" width="700" height="79" as="geometry"/></mxCell>
<mxCell id="c27" value="Catalog Product = description and images. Inventory SKU = stock per warehouse.&lt;br&gt;Order line = what the customer saw and paid, frozen at checkout. Three models, three owners.&lt;br&gt;Sharing one Product table across all three is how a distributed monolith starts." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="784" width="680" height="47" as="geometry"/></mxCell>
<mxCell id="c28" value="&lt;b&gt;Boundary test&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#D93025;fillColor=#FCE8E6;dashed=0;fontSize=12;fontStyle=0;fontColor=#D93025;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="760" y="760" width="720" height="79" as="geometry"/></mxCell>
<mxCell id="c29" value='Can this team change its tables and deploy without asking anyone?&lt;br&gt;Does a single user action need more than one or two sync hops?&lt;br&gt;If the answers are "no" and "yes", the line is in the wrong place.' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="770" y="784" width="700" height="47" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="ecommerce-api-gateway-bff" name="4. API gateway and BFF"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="790" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="API gateway and Backend-for-Frontend: who does what on the request path" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1460" height="26" as="geometry"/></mxCell>
<mxCell id="c2" value="The gateway owns cross-cutting concerns. Each BFF is owned by the team that owns the screen. Neither holds business rules." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1460" height="19" as="geometry"/></mxCell>
<mxCell id="c_web" value='&lt;b&gt;Web storefront&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;Next.js, SSR&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#5F6368;fillColor=#FFFFFF;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="140" width="180" height="62" as="geometry"/></mxCell>
<mxCell id="c_app" value='&lt;b&gt;iOS / Android app&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;3 versions in the wild&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#5F6368;fillColor=#FFFFFF;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="260" width="180" height="62" as="geometry"/></mxCell>
<mxCell id="c_partner" value='&lt;b&gt;Marketplace partners&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;server to server&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#5F6368;fillColor=#FFFFFF;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="380" width="180" height="62" as="geometry"/></mxCell>
<mxCell id="c_admin" value='&lt;b&gt;Back-office&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;staff, SSO&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#5F6368;fillColor=#FFFFFF;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="500" width="180" height="62" as="geometry"/></mxCell>
<mxCell id="edge" value='&lt;b&gt;CDN + WAF&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;cache, bot rules, TLS&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#5F6368;fillColor=#F1F3F4;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="270" y="140" width="150" height="360" as="geometry"/></mxCell>
<mxCell id="gw" value='&lt;b&gt;API gateway&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;&lt;br&gt;JWT / API-key auth&lt;br&gt;rate limits per client&lt;br&gt;routing by path + version&lt;br&gt;request ID, access logs&lt;br&gt;no aggregation&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#7B3FE4;fillColor=#F3EDFD;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="160" width="190" height="380" as="geometry"/></mxCell>
