<mxCell id="c27" style="edgeStyle=none;html=1;rounded=0;strokeColor=#E8710A;strokeWidth=2;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1212.5" y="420" as="sourcePoint"/><mxPoint x="1212.5" y="465" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c28" style="edgeStyle=none;html=1;rounded=0;strokeColor=#E8710A;strokeWidth=2;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1387.5" y="420" as="sourcePoint"/><mxPoint x="1387.5" y="465" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c29" value="OrderPlaced · PaymentCaptured · StockReserved · ProductUpdated" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#E8710A;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="790" y="512" width="670" height="17" as="geometry"/></mxCell>
<mxCell id="c30" value="&lt;b&gt;What you sign up for&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#188038;fillColor=#E6F4EA;dashed=0;fontSize=12;fontStyle=0;fontColor=#188038;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="790" y="585" width="670" height="94" as="geometry"/></mxCell>
<mxCell id="c31" value="Each service: its own deploys, dashboards, alerts, on-call rota and schema migrations.&lt;br&gt;No cross-service transactions: sagas, outbox and idempotent consumers instead.&lt;br&gt;Contract tests or schema registry between teams, versioned APIs and events.&lt;br&gt;Platform needs: service discovery, mTLS, tracing, per-service CI/CD." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="800" y="609" width="650" height="62" as="geometry"/></mxCell>
<mxCell id="c32" value="Good fit: 6+ teams, parts with very different scale or compliance needs" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#188038;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="790" y="735" width="670" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="ecommerce-team-growth-5-to-50" name="2. From 5 to 50 engineers"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Scenario: an online shop growing from 5 to 50 engineers" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1460" height="26" as="geometry"/></mxCell>
<mxCell id="c2" value="Architecture follows the team. Each stage solves the problem the previous one created, not one you might have later." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1460" height="19" as="geometry"/></mxCell>
<mxCell id="c3" value="&lt;b&gt;Stage 1 · year 1 · 5 engineers&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#1A73E8;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="470" height="660" as="geometry"/></mxCell>
<mxCell id="c4" value="One team, one Rails/Django/Spring app" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="112" width="440" height="19" as="geometry"/></mxCell>
<mxCell id="s0_0" value='&lt;b&gt;One deployable&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;deploys 10x a day, no waiting&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#E8F0FE;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="410" height="62" as="geometry"/></mxCell>
<mxCell id="s0_1" value='&lt;b&gt;One database&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;joins and transactions are free&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#E8F0FE;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="232" width="410" height="62" as="geometry"/></mxCell>
<mxCell id="s0_2" value='&lt;b&gt;Folders, not modules&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;fine while everyone knows the code&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#E8F0FE;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="314" width="410" height="62" as="geometry"/></mxCell>
<mxCell id="a0" value="&lt;b&gt;shop-app&lt;/b&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#E8F0FE;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="170" y="410" width="170" height="50" as="geometry"/></mxCell>
<mxCell id="a0db" value="&lt;b&gt;shop DB&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;strokeColor=#1A73E8;fillColor=#FFFFFF;fontSize=11;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="195" y="490" width="120" height="56" as="geometry"/></mxCell>
<mxCell id="c5" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1A73E8;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a0" target="a0db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c6" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#D93025;fillColor=#FCE8E6;dashed=0;fontSize=12;fontStyle=0;fontColor=#D93025;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="600" width="410" height="94" as="geometry"/></mxCell>
<mxCell id="c7" value='Pain that ends this stage:&lt;br&gt;merge conflicts in checkout code,&lt;br&gt;a 25 min test suite, one person&lt;br&gt;who "owns" payments in their head.' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="624" width="390" height="62" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;Stage 2 · year 2 · 15 to 20 engineers&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#7B3FE4;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#7B3FE4;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="515" y="80" width="470" height="660" as="geometry"/></mxCell>
<mxCell id="c9" value="Three teams, same deployable, real modules" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="531" y="112" width="440" height="19" as="geometry"/></mxCell>
<mxCell id="s1_0" value='&lt;b&gt;Modules with interfaces&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;Discover · Buy · Fulfil&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#7B3FE4;fillColor=#F3EDFD;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="545" y="150" width="410" height="62" as="geometry"/></mxCell>
<mxCell id="s1_1" value='&lt;b&gt;Schema per module&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;no cross-module joins&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#7B3FE4;fillColor=#F3EDFD;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="545" y="232" width="410" height="62" as="geometry"/></mxCell>
<mxCell id="s1_2" value='&lt;b&gt;CODEOWNERS + CI rules&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;boundary checks fail the build&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#7B3FE4;fillColor=#F3EDFD;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="545" y="314" width="410" height="62" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;b&gt;shop-app&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#7B3FE4;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#7B3FE4;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="555" y="398" width="390" height="82" as="geometry"/></mxCell>
<mxCell id="a1_0" value="&lt;b&gt;Discover&lt;/b&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#7B3FE4;fillColor=#F3EDFD;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="570" y="426" width="110" height="40" as="geometry"/></mxCell>
<mxCell id="a1_1" value="&lt;b&gt;Buy&lt;/b&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#7B3FE4;fillColor=#F3EDFD;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="695" y="426" width="110" height="40" as="geometry"/></mxCell>
<mxCell id="a1_2" value="&lt;b&gt;Fulfil&lt;/b&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#7B3FE4;fillColor=#F3EDFD;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="426" width="110" height="40" as="geometry"/></mxCell>
<mxCell id="a1db0" value="&lt;b&gt;catalog.*&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;strokeColor=#7B3FE4;fillColor=#FFFFFF;fontSize=11;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="580" y="510" width="90" height="46" as="geometry"/></mxCell>
<mxCell id="c11" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7B3FE4;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="625" y="480" as="sourcePoint"/><mxPoint x="625" y="510" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="a1db1" value="&lt;b&gt;orders.*&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;strokeColor=#7B3FE4;fillColor=#FFFFFF;fontSize=11;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="705" y="510" width="90" height="46" as="geometry"/></mxCell>
<mxCell id="c12" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7B3FE4;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="480" as="sourcePoint"/><mxPoint x="750" y="510" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="a1db2" value="&lt;b&gt;stock.*&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;strokeColor=#7B3FE4;fillColor=#FFFFFF;fontSize=11;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="830" y="510" width="90" height="46" as="geometry"/></mxCell>
<mxCell id="c13" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7B3FE4;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="875" y="480" as="sourcePoint"/><mxPoint x="875" y="510" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c14" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#D93025;fillColor=#FCE8E6;dashed=0;fontSize=12;fontStyle=0;fontColor=#D93025;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="545" y="600" width="410" height="109" as="geometry"/></mxCell>
<mxCell id="c15" value="Pain that ends this stage:&lt;br&gt;search needs 40 nodes at 9 PM sale&lt;br&gt;time, the rest needs 6; PCI scope&lt;br&gt;covers the whole app; deploy&lt;br&gt;queue reaches 2 hours." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="555" y="624" width="390" height="77" as="geometry"/></mxCell>
<mxCell id="c16" value="&lt;b&gt;Stage 3 · year 3+ · 50 engineers&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#188038;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#188038;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1010" y="80" width="470" height="660" as="geometry"/></mxCell>
<mxCell id="c17" value="Seven teams, core + extracted services" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1026" y="112" width="440" height="19" as="geometry"/></mxCell>
<mxCell id="s2_0" value='&lt;b&gt;Modular core&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;catalog, cart, checkout, orders&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#188038;fillColor=#E6F4EA;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1040" y="150" width="410" height="62" as="geometry"/></mxCell>
<mxCell id="s2_1" value='&lt;b&gt;Extracted services&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;search, payments, inventory&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#188038;fillColor=#E6F4EA;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1040" y="232" width="410" height="62" as="geometry"/></mxCell>
<mxCell id="s2_2" value='&lt;b&gt;Event bus + gateway&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;strangler routing per path&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#188038;fillColor=#E6F4EA;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1040" y="314" width="410" height="62" as="geometry"/></mxCell>
<mxCell id="a2gw" value="&lt;b&gt;gateway&lt;/b&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#7B3FE4;fillColor=#F3EDFD;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1040" y="398" width="410" height="32" as="geometry"/></mxCell>
<mxCell id="a2core" value="&lt;b&gt;core (modular)&lt;/b&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#E8F0FE;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1040" y="455" width="150" height="46" as="geometry"/></mxCell>
<mxCell id="a2s0" value="&lt;b&gt;search&lt;/b&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#188038;fillColor=#E6F4EA;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1206" y="455" width="78" height="46" as="geometry"/></mxCell>
<mxCell id="a2s1" value="&lt;b&gt;payments&lt;/b&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#188038;fillColor=#E6F4EA;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1290" y="455" width="78" height="46" as="geometry"/></mxCell>
<mxCell id="a2s2" value="&lt;b&gt;inventory&lt;/b&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#188038;fillColor=#E6F4EA;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1374" y="455" width="78" height="46" as="geometry"/></mxCell>
<mxCell id="a2bus" value="&lt;b&gt;events&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;strokeColor=#E8710A;fillColor=#FEF0E3;strokeWidth=1.5;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1040" y="525" width="410" height="30" as="geometry"/></mxCell>
<mxCell id="c18" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#188038;fillColor=#E6F4EA;dashed=0;fontSize=12;fontStyle=0;fontColor=#188038;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1040" y="600" width="410" height="109" as="geometry"/></mxCell>
<mxCell id="c19" value="Extract only where there is a&lt;br&gt;reason: different scale, different&lt;br&gt;compliance, or a team blocked&lt;br&gt;by the release train. Everything&lt;br&gt;else stays in the core." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1050" y="624" width="390" height="77" as="geometry"/></mxCell>
<mxCell id="c20" style="edgeStyle=none;html=1;rounded=0;strokeColor=#5F6368;strokeWidth=3;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="488" y="410" as="sourcePoint"/><mxPoint x="512" y="410" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c21" style="edgeStyle=none;html=1;rounded=0;strokeColor=#5F6368;strokeWidth=3;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="983" y="410" as="sourcePoint"/><mxPoint x="1007" y="410" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram>
<diagram id="ecommerce-bounded-contexts" name="3. Service boundaries"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Where to cut: bounded contexts for an online shop, with the data each one owns" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1460" height="26" as="geometry"/></mxCell>
<mxCell id="c2" value="Solid arrows are synchronous calls on the checkout path. Dashed arrows are events. Every context owns its tables; nobody else writes them." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1460" height="19" as="geometry"/></mxCell>
<mxCell id="c3" value="&lt;b&gt;Discover team · Catalog &amp;amp; Search&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#188038;fillColor=#E6F4EA;dashed=1;fontSize=12;fontStyle=0;fontColor=#188038;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="460" height="250" as="geometry"/></mxCell>
<mxCell id="catalog" value='&lt;b&gt;Catalog&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;Product: title, images, attributes&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#188038;fillColor=#FFFFFF;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="200" height="72" as="geometry"/></mxCell>
<mxCell id="search" value='&lt;b&gt;Search&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;index rebuilt from events&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#188038;fillColor=#FFFFFF;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="260" y="170" width="200" height="72" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;b&gt;Promo team · Pricing &amp;amp; Promotions&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#7B3FE4;fillColor=#F3EDFD;dashed=1;fontSize=12;fontStyle=0;fontColor=#7B3FE4;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="520" y="80" width="460" height="250" as="geometry"/></mxCell>
<mxCell id="pricing" value='&lt;b&gt;Pricing&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;price lists, currency&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#7B3FE4;fillColor=#FFFFFF;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="540" y="170" width="200" height="72" as="geometry"/></mxCell>
<mxCell id="promos" value='&lt;b&gt;Promotions&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;coupons, rules, budgets&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#7B3FE4;fillColor=#FFFFFF;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760" y="170" width="200" height="72" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;Accounts team · Customer &amp;amp; Identity&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#202124;fillColor=#F8F9FA;dashed=1;fontSize=12;fontStyle=0;fontColor=#202124;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1020" y="80" width="460" height="250" as="geometry"/></mxCell>
<mxCell id="identity" value='&lt;b&gt;Identity&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;login, tokens, MFA&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#202124;fillColor=#FFFFFF;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1040" y="170" width="200" height="72" as="geometry"/></mxCell>
