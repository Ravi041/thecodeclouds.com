<mxCell id="bus" value="&lt;b&gt;Event bus (Kafka, Pub/Sub, Service Bus, EventBridge)&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;strokeColor=#E8710A;fillColor=#FEF0E3;strokeWidth=1.5;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="465" width="670" height="40" as="geometry"/></mxCell>
