<mxfile host="thecodeclouds.com" agent="hand-built" version="24.0.0" type="device">
<diagram id="ecommerce-monolith-vs-microservices" name="1. Same shop, two shapes"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Same e-commerce shop, two shapes: a modular monolith and microservices" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1460" height="26" as="geometry"/></mxCell>
<mxCell id="c2" value="Identical business modules. What changes is where the boundaries are enforced: in code, or over the network." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1460" height="19" as="geometry"/></mxCell>
<mxCell id="c3" value='&lt;b&gt;Modular monolith&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;one repo, one pipeline, one deployable&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#FBFDFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#1A73E8;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="710" height="700" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;b&gt;shop-app (one process, scaled to N identical replicas)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#1A73E8;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="670" height="330" as="geometry"/></mxCell>
<mxCell id="m_catalog" value='&lt;b&gt;Catalog&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;public interface only&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#E8F0FE;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="175" width="195" height="64" as="geometry"/></mxCell>
<mxCell id="m_search" value='&lt;b&gt;Search&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;public interface only&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#E8F0FE;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="275" y="175" width="195" height="64" as="geometry"/></mxCell>
<mxCell id="m_customers" value='&lt;b&gt;Customers&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;public interface only&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#E8F0FE;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="490" y="175" width="195" height="64" as="geometry"/></mxCell>
<mxCell id="m_cart" value='&lt;b&gt;Cart&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;public interface only&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#E8F0FE;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="195" height="64" as="geometry"/></mxCell>
<mxCell id="m_checkout" value='&lt;b&gt;Checkout&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;public interface only&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#E8F0FE;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="275" y="270" width="195" height="64" as="geometry"/></mxCell>
<mxCell id="m_pricing" value='&lt;b&gt;Pricing &amp;amp; promos&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;public interface only&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#E8F0FE;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="490" y="270" width="195" height="64" as="geometry"/></mxCell>
<mxCell id="m_inventory" value='&lt;b&gt;Inventory&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;public interface only&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#E8F0FE;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="365" width="195" height="64" as="geometry"/></mxCell>
<mxCell id="m_orders" value='&lt;b&gt;Orders&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;public interface only&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#E8F0FE;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="275" y="365" width="195" height="64" as="geometry"/></mxCell>
<mxCell id="m_payments" value='&lt;b&gt;Payments&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;public interface only&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#E8F0FE;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="490" y="365" width="195" height="64" as="geometry"/></mxCell>
<mxCell id="c5" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1A73E8;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m_checkout" target="m_cart"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c6" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1A73E8;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m_checkout" target="m_pricing"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c7" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1A73E8;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m_checkout" target="m_orders"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c8" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1A73E8;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m_checkout" target="m_inventory"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c9" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1A73E8;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m_checkout" target="m_payments"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c10" value="in-process calls: microseconds, one transaction if you need it" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#1A73E8;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="640" height="17" as="geometry"/></mxCell>
<mxCell id="mdb" value='&lt;b&gt;One PostgreSQL cluster&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;schema per module: catalog, cart, orders, payments, inventory ...&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;strokeColor=#1A73E8;fillColor=#FFFFFF;fontSize=11;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="110" y="490" width="530" height="70" as="geometry"/></mxCell>
<mxCell id="c11" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1A73E8;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="460" as="sourcePoint"/><mxPoint x="375" y="490" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c12" value="&lt;b&gt;Rules that keep it modular&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#E8F0FE;dashed=0;fontSize=12;fontStyle=0;fontColor=#1A73E8;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="585" width="670" height="94" as="geometry"/></mxCell>
<mxCell id="c13" value="Modules talk through their public interface, never through another module's tables.&lt;br&gt;Boundaries are checked in CI (import rules, ArchUnit, Packwerk, Spring Modulith).&lt;br&gt;Each module has an owning team in CODEOWNERS and its own folder of tests.&lt;br&gt;Events still flow out through an outbox table, so search and analytics stay async." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="609" width="650" height="62" as="geometry"/></mxCell>
<mxCell id="c14" value="Good fit: 1 to 4 teams, one release train, strong consistency in checkout" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1A73E8;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="735" width="670" height="18" as="geometry"/></mxCell>
<mxCell id="c15" value='&lt;b&gt;Microservices&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;one repo or folder, pipeline, on-call and datastore per service&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#188038;fillColor=#FBFEFC;dashed=0;fontSize=12;fontStyle=0;fontColor=#188038;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="770" y="80" width="710" height="700" as="geometry"/></mxCell>
<mxCell id="gw" value='&lt;b&gt;API gateway&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5F6368"&gt;auth, rate limits, routing&lt;/font&gt;' style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#7B3FE4;fillColor=#F3EDFD;strokeWidth=1.5;dashed=0;fontSize=12;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="130" width="670" height="46" as="geometry"/></mxCell>
