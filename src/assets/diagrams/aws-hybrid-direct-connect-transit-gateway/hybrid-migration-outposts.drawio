<mxCell id="c60" value="Service link over the&lt;br&gt;plant's DX: redundant,&lt;br&gt;at least 500 Mbps per&lt;br&gt;rack, at most 175 ms&lt;br&gt;round trip." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#8C4FFF;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1295" y="636" width="180" height="77" as="geometry"/></mxCell>
<mxCell id="c61" value="MES must answer the line in under 5 ms. If the service link drops, plan for&lt;br&gt;running-but-unmanaged: size for N+1 locally, keep line data on S3 on Outposts." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#DD344C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="950" y="830" width="520" height="32" as="geometry"/></mxCell></root></mxGraphModel></diagram>
