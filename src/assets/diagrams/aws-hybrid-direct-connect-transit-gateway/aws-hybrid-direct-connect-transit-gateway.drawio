<mxCell id="c9" value="transit VIF 2, location A" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#8C4FFF;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="160" y="213" width="210" height="17" as="geometry"/></mxCell>
<mxCell id="c10" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=3;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="136" y="413" as="sourcePoint"/><mxPoint x="470" y="322" as="targetPoint"/><Array as="points"><mxPoint x="385" y="413"/><mxPoint x="385" y="322"/></Array></mxGeometry></mxCell>
<mxCell id="c11" value="transit VIF 3, location B" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#8C4FFF;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="160" y="393" width="210" height="17" as="geometry"/></mxCell>
<mxCell id="c12" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=3;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="136" y="513" as="sourcePoint"/><mxPoint x="470" y="332" as="targetPoint"/><Array as="points"><mxPoint x="400" y="513"/><mxPoint x="400" y="332"/></Array></mxGeometry></mxCell>
<mxCell id="c13" value="transit VIF 4, location B" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#8C4FFF;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="160" y="493" width="210" height="17" as="geometry"/></mxCell>
<mxCell id="c14" value="Each VIF: own BGP session,&lt;br&gt;BFD 300 ms x 3 = 0.9 s,&lt;br&gt;MACsec on the port" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="250" y="150" width="130" height="44" as="geometry"/></mxCell>
<mxCell id="dxgw" value='&lt;b&gt;Direct Connect&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;gateway&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.direct_connect;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="470" y="292" width="50" height="50" as="geometry"/></mxCell>
<mxCell id="tgw" value='&lt;b&gt;Transit Gateway&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;us-east-1&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.transit_gateway;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="640" y="292" width="50" height="50" as="geometry"/></mxCell>
<mxCell id="c15" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=3;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="317" as="sourcePoint"/><mxPoint x="640" y="317" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="vpn" value='&lt;b&gt;Site-to-Site VPN&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;4 tunnels, ECMP&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.site_to_site_vpn;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="470" y="610" width="46" height="46" as="geometry"/></mxCell>
<mxCell id="c16" style="edgeStyle=none;html=1;rounded=0;strokeColor=#ED7100;strokeWidth=2;dashed=1;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="240" y="560" as="sourcePoint"/><mxPoint x="470" y="633" as="targetPoint"/><Array as="points"><mxPoint x="440" y="560"/><mxPoint x="440" y="633"/></Array></mxGeometry></mxCell>
<mxCell id="c17" value="VPN from both DC firewalls&lt;br&gt;over the internet" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#ED7100;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="250" y="572" width="190" height="30" as="geometry"/></mxCell>
<mxCell id="c18" style="edgeStyle=none;html=1;rounded=0;strokeColor=#ED7100;strokeWidth=2;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="516" y="633" as="sourcePoint"/><mxPoint x="690" y="317" as="targetPoint"/><Array as="points"><mxPoint x="782" y="633"/><mxPoint x="782" y="317"/></Array></mxGeometry></mxCell>
<mxCell id="c19" value="Same 2 prefixes as DX,&lt;br&gt;AS_PATH prepended x3" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#ED7100;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="600" y="590" width="150" height="30" as="geometry"/></mxCell>
<mxCell id="c20" value="&lt;b&gt;onprem route table (what AWS sees)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#147EBA;fillColor=#F2F8FD;dashed=0;fontSize=12;fontStyle=0;fontColor=#147EBA;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="520" y="400" width="250" height="150" as="geometry"/></mxCell>
<mxCell id="c21" value="10.0.0.0/11   DXGW  (VPN hidden)&lt;br&gt;10.32.0.0/11  DXGW  (VPN hidden)&lt;br&gt;10.0.0.0/10   DXGW  (VPN hidden)&lt;br&gt;All DX down: the same three&lt;br&gt;prefixes reappear via VPN." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="530" y="425" width="236" height="77" as="geometry"/></mxCell>
<mxCell id="c22" value="&lt;b&gt;AWS to on-prem: steer with local-preference communities&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#8C4FFF;fillColor=#FAF7FF;dashed=0;fontSize=12;fontStyle=0;fontColor=#8C4FFF;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="800" y="60" width="680" height="150" as="geometry"/></mxCell>
<mxCell id="c23" value="DC A routers send 10.0.0.0/11 with 7224:7300 (high) on VIFs 1 and 2.&lt;br&gt;DC B routers send 10.32.0.0/11 with 7224:7300 (high) on VIFs 3 and 4.&lt;br&gt;Every router also sends the other site's /11 and the 10.0.0.0/10 summary with 7224:7100 (low).&lt;br&gt;Result: AWS uses the location next to the data that owns the prefix, ECMP across its two VIFs,&lt;br&gt;and moves to the other location (then across the DCI) only when the first one is gone.&lt;br&gt;AWS evaluates these communities before AS_PATH length, so they are the reliable lever." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="815" y="90" width="655" height="98" as="geometry"/></mxCell>
<mxCell id="c24" value="&lt;b&gt;On-prem to AWS: prefer DX, VPN as last resort&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#ED7100;fillColor=#FFF8F1;dashed=0;fontSize=12;fontStyle=0;fontColor=#ED7100;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="800" y="225" width="680" height="130" as="geometry"/></mxCell>
<mxCell id="c25" value="AWS advertises only the allowed prefixes, 10.64.0.0/12 and 10.80.0.0/12, on every VIF.&lt;br&gt;The VPN advertises the same two, because the onprem TGW route table holds only static summaries.&lt;br&gt;Edge routers set local-pref 200 on DX-learned routes and 100 on VPN-learned routes.&lt;br&gt;On-prem advertises 6 prefixes per VIF. The default limit is 100, and going over it drops&lt;br&gt;the BGP session. Prefix controls can raise the allocation to 1,000." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="815" y="255" width="655" height="82" as="geometry"/></mxCell>
<mxCell id="c26" value="&lt;b&gt;Inside the Transit Gateway: same destination, which route wins?&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#147EBA;fillColor=#F2F8FD;dashed=0;fontSize=12;fontStyle=0;fontColor=#147EBA;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="800" y="370" width="680" height="205" as="geometry"/></mxCell>
<mxCell id="c27" value="1. The most specific prefix, always first&lt;br&gt;2. Static routes&lt;br&gt;3. Prefix-list referenced routes&lt;br&gt;4. VPC-propagated routes&lt;br&gt;5. Direct Connect gateway-propagated routes&lt;br&gt;6. Connect-propagated routes&lt;br&gt;7. VPN over private DX, then Site-to-Site VPN routes" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="815" y="400" width="330" height="114" as="geometry"/></mxCell>
<mxCell id="c28" value="The trap: a 10.0.12.0/22 learned over VPN&lt;br&gt;beats 10.0.0.0/11 learned over DX, because&lt;br&gt;longest match comes before attachment type.&lt;br&gt;&lt;br&gt;Filter the VPN to the same summaries, and&lt;br&gt;alarm when the onprem route table has&lt;br&gt;any route whose next hop is a VPN while&lt;br&gt;DX is up." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#DD344C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1160" y="400" width="310" height="130" as="geometry"/></mxCell>
<mxCell id="c29" value="&lt;b&gt;Failure modes this design was tested against (game day, quarterly)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#232F3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="690" width="1460" height="210" as="geometry"/></mxCell>
<mxCell id="c30" value="What fails" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="722" width="330" height="18" as="geometry"/></mxCell>
<mxCell id="c31" value="Detected by" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="390" y="722" width="330" height="18" as="geometry"/></mxCell>
<mxCell id="c32" value="What carries the traffic" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="640" y="722" width="330" height="18" as="geometry"/></mxCell>
<mxCell id="c33" value="Capacity left" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1120" y="722" width="330" height="18" as="geometry"/></mxCell>
<mxCell id="c34" style="edgeStyle=none;html=1;rounded=0;strokeColor=#D5DBDB;strokeWidth=1;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="36" y="744" as="sourcePoint"/><mxPoint x="1464" y="744" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c35" value="One connection or edge router" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="754" width="330" height="18" as="geometry"/></mxCell>
<mxCell id="c36" value="BFD, about 0.9 s" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="390" y="754" width="330" height="18" as="geometry"/></mxCell>
<mxCell id="c37" value="The other VIF at the same location (ECMP)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="640" y="754" width="470" height="18" as="geometry"/></mxCell>
<mxCell id="c38" value="30 Gbps" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1120" y="754" width="330" height="18" as="geometry"/></mxCell>
<mxCell id="c39" value="A whole DX location" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="788" width="330" height="18" as="geometry"/></mxCell>
<mxCell id="c40" value="BFD, about 0.9 s" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="390" y="788" width="330" height="18" as="geometry"/></mxCell>
<mxCell id="c41" value="The other location's VIFs (7224:7100 paths), then the DCI" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="640" y="788" width="470" height="18" as="geometry"/></mxCell>
<mxCell id="c42" value="20 Gbps" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1120" y="788" width="330" height="18" as="geometry"/></mxCell>
<mxCell id="c43" value="All four DX connections" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="822" width="330" height="18" as="geometry"/></mxCell>
<mxCell id="c44" value="BFD, then BGP withdraw" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="390" y="822" width="330" height="18" as="geometry"/></mxCell>
<mxCell id="c45" value="Site-to-Site VPN, 4 tunnels, ECMP on the TGW" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="640" y="822" width="470" height="18" as="geometry"/></mxCell>
<mxCell id="c46" value="About 4 Gbps (internet circuits)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1120" y="822" width="330" height="18" as="geometry"/></mxCell>
<mxCell id="c47" value="A link, with BFD missing on the router" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#DD344C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="856" width="330" height="18" as="geometry"/></mxCell>
<mxCell id="c48" value="BGP hold timer, 90 s" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#DD344C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="390" y="856" width="330" height="18" as="geometry"/></mxCell>
<mxCell id="c49" value="Nothing. Traffic is black-holed until the hold timer expires" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#DD344C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="640" y="856" width="470" height="18" as="geometry"/></mxCell>
<mxCell id="c50" value="Up to 90 s of loss" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#DD344C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1120" y="856" width="330" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="hybrid-dns" name="3. Hybrid DNS with Route 53 Resolver"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Hybrid DNS: Route 53 Resolver endpoints in one shared VPC, rules and zones handed out with a Route 53 Profile" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1400" height="24" as="geometry"/></mxCell>
<mxCell id="c2" value="&lt;b&gt;On-premises (both data centres)&lt;/b&gt;" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_corporate_data_center;strokeColor=#7D8998;fillColor=#F7F8FA;verticalAlign=top;align=left;spacingLeft=30;fontColor=#5A6C86;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="330" height="470" as="geometry"/></mxCell>
<mxCell id="client" value="&lt;b&gt;Users and apps&lt;/b&gt;" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#7D8998;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.users;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="46" height="46" as="geometry"/></mxCell>
<mxCell id="dnsa" value='&lt;b&gt;AD DNS, site A&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;10.1.0.10&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#7D8998;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.directory_service;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="230" y="110" width="46" height="46" as="geometry"/></mxCell>
