<mxCell id="c15" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7AA116;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1273" y="396" as="sourcePoint"/><mxPoint x="518" y="304" as="targetPoint"/><Array as="points"><mxPoint x="1273" y="545"/><mxPoint x="620" y="545"/><mxPoint x="620" y="304"/></Array></mxGeometry></mxCell>
