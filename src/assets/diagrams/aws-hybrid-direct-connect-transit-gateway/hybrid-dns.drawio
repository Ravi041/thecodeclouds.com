<mxCell id="c17" value="erp.corp.example?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#7AA116;fontStyle=0;spacing=0;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="300" y="286" width="140" height="17" as="geometry"/></mxCell>
<mxCell id="c18" value="2" style="ellipse;html=1;fillColor=#147EBA;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="150" y="112" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c19" style="edgeStyle=none;html=1;rounded=0;strokeColor=#147EBA;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="96" y="133" as="sourcePoint"/><mxPoint x="230" y="133" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c20" style="edgeStyle=none;html=1;rounded=0;strokeColor=#147EBA;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="276" y="145" as="sourcePoint"/><mxPoint x="470" y="145" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c21" value="orders.aws.corp.example?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#147EBA;fontStyle=0;spacing=0;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="292" y="126" width="170" height="17" as="geometry"/></mxCell>
<mxCell id="c22" style="edgeStyle=none;html=1;rounded=0;strokeColor=#147EBA;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="518" y="154" as="sourcePoint"/><mxPoint x="680" y="216" as="targetPoint"/><Array as="points"><mxPoint x="600" y="154"/><mxPoint x="600" y="216"/></Array></mxGeometry></mxCell>
<mxCell id="c23" style="edgeStyle=none;html=1;rounded=0;strokeColor=#DD344C;strokeWidth=1;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="225" as="sourcePoint"/><mxPoint x="880" y="160" as="targetPoint"/><Array as="points"><mxPoint x="820" y="225"/><mxPoint x="820" y="160"/></Array></mxGeometry></mxCell>
<mxCell id="c24" value="3" style="ellipse;html=1;fillColor=#8C4FFF;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="150" y="395" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c25" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=3;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="96" y="423" as="sourcePoint"/><mxPoint x="680" y="423" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c26" value="s3.us-east-1.amazonaws.com resolves to the&lt;br&gt;endpoint's private IPs, so backups go over DX" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#8C4FFF;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="120" y="440" width="300" height="30" as="geometry"/></mxCell>
<mxCell id="c27" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7D8998;strokeWidth=1;dashed=1;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="705" y="250" as="sourcePoint"/><mxPoint x="705" y="400" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c28" value="&lt;b&gt;How each lookup works&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#232F3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="570" width="1460" height="210" as="geometry"/></mxCell>
<mxCell id="c29" value="1" style="ellipse;html=1;fillColor=#7AA116;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="40" y="602" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c30" value="AWS to on-prem&lt;br&gt;orders-api asks the VPC Resolver for erp.corp.example.&lt;br&gt;The forwarding rule from the Profile matches, so&lt;br&gt;Resolver sends the query out of the outbound&lt;br&gt;endpoint, over DX, to both AD DNS servers.&lt;br&gt;Answers are cached for the record's TTL." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="70" y="602" width="400" height="98" as="geometry"/></mxCell>
<mxCell id="c31" value="2" style="ellipse;html=1;fillColor=#147EBA;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="520" y="602" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c32" value='On-prem to AWS&lt;br&gt;AD DNS has a conditional forwarder for&lt;br&gt;aws.corp.example pointing at the 3 inbound IPs.&lt;br&gt;Resolver answers from the private hosted zone&lt;br&gt;and checks DNS Firewall. Never forward "." or&lt;br&gt;corp.example back the other way: that is a loop.' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="550" y="602" width="420" height="98" as="geometry"/></mxCell>
<mxCell id="c33" value="3" style="ellipse;html=1;fillColor=#8C4FFF;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1000" y="602" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c34" value="PrivateLink from on-prem&lt;br&gt;For each interface endpoint on-prem should use,&lt;br&gt;AD DNS forwards that service name (for example&lt;br&gt;s3.us-east-1.amazonaws.com) to the inbound IPs.&lt;br&gt;Traffic then rides DX to private IPs instead of&lt;br&gt;the internet, and stays off the NAT bill." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1030" y="602" width="440" height="98" as="geometry"/></mxCell>
<mxCell id="c35" value="Sizing: one IP per AZ to start, watch the endpoint's query metrics, add IPs before peak. Restrictive security groups turn on connection tracking, which lowers per-IP capacity a lot." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#DD344C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="745" width="1420" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
