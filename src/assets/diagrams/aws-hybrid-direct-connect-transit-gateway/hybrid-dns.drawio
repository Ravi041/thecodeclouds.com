<mxCell id="c10" value="Profile associated at VPC creation&lt;br&gt;(account vending), so rules, PHZ and&lt;br&gt;DNS Firewall arrive with zero clicks." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1090" y="445" width="360" height="47" as="geometry"/></mxCell>
<mxCell id="c11" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7AA116;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1146" y="373" as="sourcePoint"/><mxPoint x="1250" y="373" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c12" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7D8998;strokeWidth=1;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1273" y="160" as="sourcePoint"/><mxPoint x="1273" y="305" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c13" value="associated" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1280" y="255" width="80" height="16" as="geometry"/></mxCell>
