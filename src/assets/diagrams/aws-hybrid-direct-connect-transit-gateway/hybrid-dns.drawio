<diagram id="hybrid-dns" name="3. Hybrid DNS with Route 53 Resolver"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Hybrid DNS: Route 53 Resolver endpoints in one shared VPC, rules and zones handed out with a Route 53 Profile" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1400" height="24" as="geometry"/></mxCell>
