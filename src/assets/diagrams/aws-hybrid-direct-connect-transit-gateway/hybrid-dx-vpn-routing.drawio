<mxCell id="c5" value="DCI 2 x 10G, iBGP&lt;br&gt;between all 4 routers" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="70" y="308" width="160" height="30" as="geometry"/></mxCell>
