<mxCell id="c7" value="transit VIF 1, location A" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#8C4FFF;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="160" y="113" width="210" height="17" as="geometry"/></mxCell>
