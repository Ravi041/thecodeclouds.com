<mxCell id="pool2" value="&lt;b&gt;Batch + CI pool&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#7D8998;fillColor=#F7F8FA;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="516" y="236" width="190" height="150" as="geometry"/></mxCell>
<mxCell id="pi2" value="&lt;b&gt;&lt;/b&gt;" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.spot_instance;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="586" y="268" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="c12" value="Spot only, scales to zero,&lt;br&gt;checkpointed jobs" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="526" y="330" width="172" height="30" as="geometry"/></mxCell>
<mxCell id="c13" value="Graviton for 70% of node hours, Spot for 35%,&lt;br&gt;consolidation lifts CPU use from 31% to 58%" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#1D8102;fillColor=#F2F9EE;fontColor=#1D5E0E;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="104" y="400" width="400" height="48" as="geometry"/></mxCell>
<mxCell id="c14" value="Compute: $92k → $34k / month" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#1D8102;fillColor=#F2F9EE;fontColor=#1D5E0E;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="520" y="400" width="190" height="48" as="geometry"/></mxCell>
<mxCell id="c15" value="Rule: a node pool must prefer arm64 and allow at least&lt;br&gt;10 instance types, or it doesn't pass review." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="104" y="466" width="600" height="32" as="geometry"/></mxCell>
<mxCell id="c16" value="&lt;b&gt;Data tier&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#C925D1;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="750" y="200" width="390" height="330" as="geometry"/></mxCell>
<mxCell id="aur" value='&lt;b&gt;Aurora PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;r7g.2xlarge (was r5.4xlarge)&lt;br&gt;I/O-Optimized, 1 reader&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="780" y="240" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="ec" value='&lt;b&gt;ElastiCache Valkey&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;r7g, one size down&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elasticache;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="780" y="336" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="c17" value="Database: $34k → $17k&lt;br&gt;Graviton, rightsized, RIs on the baseline" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#1D8102;fillColor=#F2F9EE;fontColor=#1D5E0E;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="770" y="430" width="350" height="48" as="geometry"/></mxCell>
<mxCell id="nat" value='&lt;b&gt;NAT gateway&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;only for real internet egress&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.nat_gateway;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="100" y="570" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="gwe" value='&lt;b&gt;Gateway endpoints S3 + DynamoDB&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;(no charge) + interface endpoints&lt;br&gt;for ECR, STS, Logs&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.vpc_privatelink;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="440" y="570" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="c18" value="Data transfer: $27k → $9k&lt;br&gt;image pulls and S3 reads stop going through NAT" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#1D8102;fillColor=#F2F9EE;fontColor=#1D5E0E;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="790" y="566" width="350" height="48" as="geometry"/></mxCell>
<mxCell id="c19" value="Topology-aware routing keeps service-to-service calls inside one AZ where it can." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="676" width="900" height="17" as="geometry"/></mxCell>
<mxCell id="s3" value='&lt;b&gt;S3 data lake&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;Intelligent-Tiering by default&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="80" y="760" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="dpa" value='&lt;b&gt;Lifecycle: raw → Deep&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;Archive at 180 days&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.glacier_deep_archive;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="400" y="760" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="cw" value='&lt;b&gt;CloudWatch Logs&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;Infrequent Access class,&lt;br&gt;retention 30 / 90 days&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="690" y="760" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="c20" value="EBS: gp3, not gp2&lt;br&gt;orphan volumes and old&lt;br&gt;snapshots deleted" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#ED7100;fillColor=#FFF6EE;fontColor=#232F3E;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="960" y="756" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="c21" value="S3 $24k → $11k   ·   Logs $18k → $7k   ·   EBS $14k → $6k" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#1D8102;fillColor=#F2F9EE;fontColor=#1D5E0E;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="80" y="834" width="760" height="36" as="geometry"/></mxCell>
<mxCell id="c22" value="&lt;b&gt;Outside the VPC&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#7D8998;fillColor=#F7F8FA;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1220" y="124" width="380" height="690" as="geometry"/></mxCell>
<mxCell id="sched" value='&lt;b&gt;Instance Scheduler&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;non-prod on 07:00-20:00&lt;br&gt;weekdays only&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1250" y="170" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="c23" value="Non-prod runs 65 of 168 hours&lt;br&gt;a week: about 61% fewer hours" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#1D8102;fillColor=#F2F9EE;fontColor=#1D5E0E;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1244" y="236" width="330" height="44" as="geometry"/></mxCell>
<mxCell id="spp" value='&lt;b&gt;Compute Savings Plan&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;1 year, no upfront,&lt;br&gt;sized to the lowest hour&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.savings_plans;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1250" y="320" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="c24" value="Covers 72% of eligible compute.&lt;br&gt;Utilisation target: above 98%" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#1D8102;fillColor=#F2F9EE;fontColor=#1D5E0E;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1244" y="386" width="330" height="44" as="geometry"/></mxCell>
<mxCell id="co2" value='&lt;b&gt;Compute Optimizer&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;weekly rightsizing list&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.compute_optimizer;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1250" y="470" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="c25" value="Customer Carbon Footprint Tool&lt;br&gt;tracked next to the bill,&lt;br&gt;month by month" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#1D8102;fillColor=#FFFFFF;fontColor=#1D5E0E;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1244" y="560" width="330" height="70" as="geometry"/></mxCell>
<mxCell id="c26" value="Proxy KPI: vCPU-hours per customer&lt;br&gt;down 47%; the CCFT trend follows" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#1D8102;fillColor=#F2F9EE;fontColor=#1D5E0E;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1244" y="650" width="330" height="44" as="geometry"/></mxCell>
<mxCell id="c27" value="Total: $236k → $105k a month while traffic kept growing." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#1D5E0E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="928" width="1200" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram>
