<mxCell id="aur" value='&lt;b&gt;Aurora PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;r7g.2xlarge (was r5.4xlarge)&lt;br&gt;I/O-Optimized, 1 reader&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="780" y="240" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="ec" value='&lt;b&gt;ElastiCache Valkey&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;r7g, one size down&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elasticache;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="780" y="336" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="c17" value="Database: $34k → $17k&lt;br&gt;Graviton, rightsized, RIs on the baseline" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#1D8102;fillColor=#F2F9EE;fontColor=#1D5E0E;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="770" y="430" width="350" height="48" as="geometry"/></mxCell>
<mxCell id="nat" value='&lt;b&gt;NAT gateway&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;only for real internet egress&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.nat_gateway;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="100" y="570" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="gwe" value='&lt;b&gt;Gateway endpoints S3 + DynamoDB&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;(no charge) + interface endpoints&lt;br&gt;for ECR, STS, Logs&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.vpc_privatelink;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="440" y="570" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="c18" value="Data transfer: $27k → $9k&lt;br&gt;image pulls and S3 reads stop going through NAT" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#1D8102;fillColor=#F2F9EE;fontColor=#1D5E0E;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="790" y="566" width="350" height="48" as="geometry"/></mxCell>
<mxCell id="c19" value="Topology-aware routing keeps service-to-service calls inside one AZ where it can." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="676" width="900" height="17" as="geometry"/></mxCell>
