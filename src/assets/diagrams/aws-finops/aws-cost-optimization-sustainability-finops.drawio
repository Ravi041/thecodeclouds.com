<mxCell id="c133" value="Runs every hour of the year.&lt;br&gt;1-year Compute SP, no upfront.&lt;br&gt;About 28% under on-demand&lt;br&gt;for this mix." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1166" y="198" width="300" height="62" as="geometry"/></mxCell>
