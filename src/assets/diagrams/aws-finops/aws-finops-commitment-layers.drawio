<mxCell id="c139" value="Stateless web, workers, CI&lt;br&gt;and batch. 60-75% under&lt;br&gt;on-demand, 2-minute notice." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1166" y="538" width="300" height="47" as="geometry"/></mxCell>
<mxCell id="c140" value="Rule of thumb: buy commitments for what you are sure of, review them every quarter,&lt;br&gt;and never commit to waste you have not removed yet. Rightsize first, then commit." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="110" y="740" width="1300" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram>
