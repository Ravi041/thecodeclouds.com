<mxCell id="c136" value="Stateful or interruption-&lt;br&gt;sensitive pods, and the first&lt;br&gt;minutes of a scale-up." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1166" y="368" width="300" height="47" as="geometry"/></mxCell>
