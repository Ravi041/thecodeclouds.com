<mxCell id="c50" value="Catch after retries: never refund&lt;br&gt;a shipped order automatically" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#0972D3;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1230" y="444" width="240" height="30" as="geometry"/></mxCell>
<mxCell id="c51" value="The parcel is already on a truck. Undoing the&lt;br&gt;payment would give the goods away, so the saga&lt;br&gt;stops compensating here and alerts a person." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1066" y="610" width="400" height="47" as="geometry"/></mxCell>
<mxCell id="c52" value="Rules used here" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="728" width="300" height="19" as="geometry"/></mxCell>
<mxCell id="c53" value="Every Task has Retry (with backoff and JitterStrategy FULL) and Catch.  Every external call carries an idempotency key built from orderId + step, so a retried step is safe.&lt;br&gt;Compensations are idempotent too: releasing stock twice must not add stock twice (use a reservation item per order, deleted with a condition).  Failed executions can be redriven from the failed state after a fix." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="752" width="1440" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
