<mxCell id="r1" value="Retry policy: up to 185 attempts over 24 hours (defaults),&lt;br&gt;exponential backoff. Lower MaximumEventAgeInSeconds&lt;br&gt;for events that are useless when late." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#D13212;fillColor=#FFFFFF;fontColor=#202124;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="520" y="287" width="410" height="92" as="geometry"/></mxCell>
