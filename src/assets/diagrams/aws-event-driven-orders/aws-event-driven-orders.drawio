<mxCell id="c55" value="+300 msgs/s&lt;br&gt;(400 in, 100 out)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#0972D3;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="945" y="520" width="120" height="30" as="geometry"/></mxCell>
