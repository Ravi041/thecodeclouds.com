<mxCell id="c47" value="Two rules that save the most pain:  keep the DLQ retention longer than the source queue (14 days is the maximum), and alarm on any message in any DLQ.&lt;br&gt;A DLQ nobody watches is just a slower way to lose orders." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="790" width="1440" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram>
