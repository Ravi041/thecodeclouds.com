<mxCell id="c46" value="4" style="ellipse;html=1;fillColor=#E7157B;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="860" y="442" width="22" height="22" as="geometry"/></mxCell>
