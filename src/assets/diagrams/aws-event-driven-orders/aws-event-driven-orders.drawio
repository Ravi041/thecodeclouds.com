<mxCell id="r0" value="MaximumRetryAttempts 10, MaximumRecordAgeInSeconds 3600.&lt;br&gt;Records for one item stay in order, so a stuck record holds&lt;br&gt;back that shard: cap the retries." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#D13212;fillColor=#FFFFFF;fontColor=#202124;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="520" y="127" width="410" height="92" as="geometry"/></mxCell>
