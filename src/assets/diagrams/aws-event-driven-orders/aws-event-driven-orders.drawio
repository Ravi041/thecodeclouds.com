<mxCell id="c48" value="6" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1080" y="560" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c49" value="7" style="ellipse;html=1;fillColor=#0972D3;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="580" y="730" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c50" value="1) Checkout calls POST /orders with an Idempotency-Key.   2) One conditional write stores the order; the stream is the outbox.   3) Pipes turns status changes into events on the bus.&lt;br&gt;4) Rules fan out to queues, never straight to fragile code.   5) The saga orchestrates stock, fraud, warehouse and capture, with compensations.   6) Max concurrency 20 protects the warehouse API.   7) ERP gets changes in order, per order." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="924" width="1440" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="saga" name="Order saga in Step Functions"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="The order saga: one Standard workflow per order" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1000" height="28" as="geometry"/></mxCell>
<mxCell id="c2" value="Execution name = orderId, so a duplicate OrderPlaced event cannot start a second saga. Green = happy path, red = compensation, blue = forward recovery after the pivot." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1440" height="19" as="geometry"/></mxCell>
