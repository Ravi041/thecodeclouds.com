<mxCell id="c38" value="DynamoDB Streams keep changes to one item in order;&lt;br&gt;a FIFO queue keeps that order per orderId." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#0972D3;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="560" y="838" width="380" height="30" as="geometry"/></mxCell>
