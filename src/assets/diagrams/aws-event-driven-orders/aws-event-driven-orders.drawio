<mxCell id="c45" value="no: high risk" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;fontSize=10;fontColor=#D13212;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="540" y="318" width="62" height="16" as="geometry"/></mxCell>
