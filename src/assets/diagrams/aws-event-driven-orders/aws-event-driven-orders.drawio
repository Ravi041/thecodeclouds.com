<mxCell id="c47" value="Catch: States.ALL, States.Timeout&lt;br&gt;(warehouse rejects or never answers)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#D13212;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="790" y="436" width="230" height="30" as="geometry"/></mxCell>
<mxCell id="ops" value="Park for ops&lt;br&gt;SQS ops-queue + alarm&lt;br&gt;retry capture by hand" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#0972D3;fillColor=#FFFFFF;fontColor=#202124;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1110" y="520" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="opsq" value="&lt;b&gt;&lt;/b&gt;" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1330" y="532" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="c49" style="edgeStyle=none;html=1;rounded=0;strokeColor=#0972D3;strokeWidth=2;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cp" target="ops"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1080" y="470"/><mxPoint x="1210" y="470"/></Array></mxGeometry></mxCell>
<mxCell id="c50" value="Catch after retries: never refund&lt;br&gt;a shipped order automatically" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#0972D3;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1230" y="444" width="240" height="30" as="geometry"/></mxCell>
<mxCell id="c51" value="The parcel is already on a truck. Undoing the&lt;br&gt;payment would give the goods away, so the saga&lt;br&gt;stops compensating here and alerts a person." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1066" y="610" width="400" height="47" as="geometry"/></mxCell>
<mxCell id="c52" value="Rules used here" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="728" width="300" height="19" as="geometry"/></mxCell>
<mxCell id="c53" value="Every Task has Retry (with backoff and JitterStrategy FULL) and Catch.  Every external call carries an idempotency key built from orderId + step, so a retried step is safe.&lt;br&gt;Compensations are idempotent too: releasing stock twice must not add stock twice (use a reservation item per order, deleted with a condition).  Failed executions can be redriven from the failed state after a fix." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="752" width="1440" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="failures" name="Where every failed order event goes"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Where every failed order event goes" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1000" height="28" as="geometry"/></mxCell>
<mxCell id="c2" value="Each hop retries on its own terms, then parks what it cannot process. Nothing is dropped silently, and nothing blocks the orders behind it forever." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1440" height="19" as="geometry"/></mxCell>
