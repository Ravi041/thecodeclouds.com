<mxCell id="c58" value="empty at ~53 min" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#0972D3;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1331.37" y="590" width="110" height="16" as="geometry"/></mxCell>
<mxCell id="c59" value="Alarm: ApproximateAgeOfOldestMessage &amp;gt; 45 min during sale events (&amp;gt; 5 min on normal days).&lt;br&gt;The saga waits on a task token with a 48-hour timeout, so a slow warehouse never cancels an order." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="790" y="690" width="680" height="32" as="geometry"/></mxCell></root></mxGraphModel></diagram>
