<mxCell id="c35" value="writes each step to the order item, so the&lt;br&gt;stream emits StockReserved, OrderShipped..." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#E7157B;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1250" y="390" width="230" height="28" as="geometry"/></mxCell>
