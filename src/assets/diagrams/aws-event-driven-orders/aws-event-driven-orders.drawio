<mxCell id="c19" value="Fix the target, then&lt;br&gt;replay the parked records&lt;br&gt;with a small script." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1250" y="154" width="220" height="47" as="geometry"/></mxCell>
