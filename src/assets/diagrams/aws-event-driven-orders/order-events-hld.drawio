<mxCell id="t41" value='&lt;b&gt;DLQ per hop&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;redrive after fix&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="456" width="144" height="26" as="geometry"/></mxCell>
<mxCell id="cw" value='&lt;b&gt;CloudWatch alarms&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;age of oldest message,&lt;br&gt;DLQ depth&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="230" y="410" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="xr" value='&lt;b&gt;X-Ray traces&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;orderId on&lt;br&gt;every event&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.xray;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="370" y="410" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="c42" value="Every queue has a DLQ (maxReceiveCount 5).&lt;br&gt;Every EventBridge target has a retry policy and a DLQ.&lt;br&gt;The saga has Retry + Catch on every task.&lt;br&gt;A reconciliation job flags orders stuck in one&lt;br&gt;status for longer than its SLO." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="76" y="536" width="370" height="77" as="geometry"/></mxCell>
