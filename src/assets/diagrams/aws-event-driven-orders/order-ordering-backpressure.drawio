<mxCell id="c18" value="A v2" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#0972D3;fillColor=#FFFFFF;fontColor=#202124;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="434" y="414" width="64" height="30" as="geometry"/></mxCell>
