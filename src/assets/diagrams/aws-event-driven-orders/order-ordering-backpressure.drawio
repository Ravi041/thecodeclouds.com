<mxCell id="c11" value="UpdateItem ... ConditionExpression:&lt;br&gt;  attribute_not_exists(version) OR version &amp;lt; :v&lt;br&gt;A late v1 after v3 fails the condition and is dropped on purpose." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="260" width="660" height="47" as="geometry"/></mxCell>
