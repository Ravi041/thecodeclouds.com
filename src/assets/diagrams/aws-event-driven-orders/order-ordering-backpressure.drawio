<diagram id="ordering" name="Ordering and backpressure"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="880" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Ordering and backpressure" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1000" height="28" as="geometry"/></mxCell>
<mxCell id="c2" value="Order only where it is needed, and let queues absorb the spikes your downstream systems cannot." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1440" height="19" as="geometry"/></mxCell>
<mxCell id="c3" value="&lt;b&gt;Ordering per order, not global&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#0972D3;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#0972D3;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="730" height="760" as="geometry"/></mxCell>
<mxCell id="c4" value="A. The bus does not promise order: make consumers tolerant" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="126" width="680" height="19" as="geometry"/></mxCell>
