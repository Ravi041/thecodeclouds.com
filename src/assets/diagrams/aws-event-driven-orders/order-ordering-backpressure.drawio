<mxCell id="erpw" value='&lt;b&gt;ERP sync&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;one batch per&lt;br&gt;group at a time&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="630" y="440" width="46" height="46" as="geometry"/></mxCell>
<mxCell id="c26" style="edgeStyle=none;html=1;rounded=0;strokeColor=#0972D3;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="592" y="463" as="sourcePoint"/><mxPoint x="626" y="463" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c27" value="Order is kept inside each message group. Different orders run in&lt;br&gt;parallel, so throughput grows with the number of active orders.&lt;br&gt;One stuck message blocks only its own group (one order), not&lt;br&gt;the queue. Use a FIFO DLQ, or the group stays blocked until&lt;br&gt;maxReceiveCount is reached." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="600" width="680" height="77" as="geometry"/></mxCell>
<mxCell id="c28" value="Do not put a FIFO queue after the bus and expect order: the bus&lt;br&gt;may already have reordered the events. Order must be kept from&lt;br&gt;the source (the stream) to the consumer." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#D13212;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="720" width="680" height="47" as="geometry"/></mxCell>
<mxCell id="c29" value="&lt;b&gt;Backpressure: Black Friday at the warehouse&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#7D8998;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="770" y="90" width="710" height="760" as="geometry"/></mxCell>
<mxCell id="sf" value='&lt;b&gt;Saga&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;400 orders/s peak&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.step_functions;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="800" y="150" width="46" height="46" as="geometry"/></mxCell>
<mxCell id="wq" value='&lt;b&gt;wms-requests&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;buffer, 4-day retention&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="960" y="150" width="46" height="46" as="geometry"/></mxCell>
<mxCell id="ww" value='&lt;b&gt;WMS worker&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;MaximumConcurrency 20&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1120" y="150" width="46" height="46" as="geometry"/></mxCell>
<mxCell id="wms" value="" style="sketch=0;outlineConnect=0;fillColor=#232F3E;strokeColor=none;aspect=fixed;shape=mxgraph.aws4.traditional_server;" vertex="1" parent="1"><mxGeometry x="1290" y="150" width="46" height="46" as="geometry"/></mxCell>
<mxCell id="t31" value='&lt;b&gt;Warehouse API&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;100 req/s&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1240" y="198" width="146" height="26" as="geometry"/></mxCell>
<mxCell id="c32" style="edgeStyle=none;html=1;rounded=0;strokeColor=#E7157B;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sf" target="wq"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c33" style="edgeStyle=none;html=1;rounded=0;strokeColor=#E7157B;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="wq" target="ww"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c34" style="edgeStyle=none;html=1;rounded=0;strokeColor=#232F3E;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ww" target="wms"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c35" value="20 workers x 200 ms per call = 100 calls/s. The queue grows instead of the warehouse falling over.&lt;br&gt;Use the event source mapping MaximumConcurrency, not low reserved concurrency: throttled&lt;br&gt;invocations send messages back to the queue and burn receive counts into the DLQ." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="790" y="250" width="680" height="47" as="geometry"/></mxCell>
