<mxCell id="c13" value="B. A consumer that truly needs order: FIFO from the stream" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="346" width="680" height="19" as="geometry"/></mxCell>
