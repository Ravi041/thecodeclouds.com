<mxCell id="c28" value='Checkout returns 202&lt;br&gt;"order received" once the&lt;br&gt;message is in the queue.&lt;br&gt;Workers drain it at a&lt;br&gt;fixed concurrency.' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1190" y="220" width="156" height="77" as="geometry"/></mxCell>
