<diagram id="flash-sale" name="4. Scenario: flash sale traffic spike"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="830" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Scenario: the 12:00 flash sale, 20x traffic in 90 seconds" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="900" height="24" as="geometry"/></mxCell>
<mxCell id="c2" value="Every layer exists to make sure the layer behind it sees less traffic, at a steadier rate. Numbers are requests per second at the peak." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1300" height="18" as="geometry"/></mxCell>
<mxCell id="c3" value="120,000" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#D13212;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="96" width="140" height="20" as="geometry"/></mxCell>
<mxCell id="users" value="&lt;b&gt;Shoppers&lt;/b&gt;" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.users;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="64" y="128" width="52" height="52" as="geometry"/></mxCell>
