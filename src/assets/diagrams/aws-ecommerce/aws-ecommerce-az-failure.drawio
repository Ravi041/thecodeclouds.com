<mxCell id="c34" value="AZ b starts dropping packets and adding 2 s of latency. Not a clean outage:&lt;br&gt;instances still pass some health checks. p99 checkout latency jumps." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1000" y="143" width="570" height="32" as="geometry"/></mxCell>
<mxCell id="c35" value="2" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="858" y="240" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c36" value="T+1 min" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="892" y="243" width="110" height="18" as="geometry"/></mxCell>
<mxCell id="c37" value="ALB marks the worst targets unhealthy, but gray failure flaps. Zonal autoshift&lt;br&gt;(or an on-call zonal shift) sets AZ b to 0% for the ALB. Errors stop here." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1000" y="243" width="570" height="32" as="geometry"/></mxCell>
<mxCell id="c38" value="3" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="858" y="340" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c39" value="T+1 min" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1D8102;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="892" y="343" width="110" height="18" as="geometry"/></mxCell>
<mxCell id="c40" value="Aurora sees the writer is unreachable and promotes the reader in AZ a.&lt;br&gt;RDS Proxy holds client connections, so pods see a pause, not a storm of errors." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1000" y="343" width="570" height="32" as="geometry"/></mxCell>
<mxCell id="c41" value="4" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="858" y="440" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c42" value="T+2 min" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1D8102;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="892" y="443" width="110" height="18" as="geometry"/></mxCell>
<mxCell id="c43" value="ElastiCache Multi-AZ promotes the replica in AZ c. Cart reads miss cache for&lt;br&gt;a few seconds and fall back to DynamoDB, which never noticed: it is regional." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1000" y="443" width="570" height="32" as="geometry"/></mxCell>
<mxCell id="c44" value="5" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="858" y="540" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c45" value="T+2 to 6 min" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1D8102;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="892" y="543" width="110" height="18" as="geometry"/></mxCell>
<mxCell id="c46" value="Nodes in AZ b go NotReady. With tolerationSeconds: 60 the pods are evicted&lt;br&gt;fast instead of after the default 300 s. Karpenter starts nodes in AZ a and c." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1000" y="543" width="570" height="32" as="geometry"/></mxCell>
<mxCell id="c47" value="6" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="858" y="640" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c48" value="T+6 min" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1D8102;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="892" y="643" width="110" height="18" as="geometry"/></mxCell>
<mxCell id="c49" value="All replicas are running in two AZs. HPA had already scaled the survivors from&lt;br&gt;66% to ~95% CPU. No orders lost: checkout writes retried with the same key." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1000" y="643" width="570" height="32" as="geometry"/></mxCell>
<mxCell id="c50" value="7" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="858" y="740" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c51" value="After" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="892" y="743" width="110" height="18" as="geometry"/></mxCell>
<mxCell id="c52" value="AZ recovers. End the shift, let Karpenter consolidate, check Aurora replica lag&lt;br&gt;and rebalance. Write down how long each step took, then shorten it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1000" y="743" width="570" height="32" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
