<mxCell id="c32" value="Writes arrive at the rate&lt;br&gt;the workers choose, not&lt;br&gt;the rate shoppers click.&lt;br&gt;Readers added the day&lt;br&gt;before, not during." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1382" y="220" width="156" height="77" as="geometry"/></mxCell>
