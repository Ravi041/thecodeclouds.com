<mxCell id="c55" value="T-1 day" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="996" y="448" width="80" height="17" as="geometry"/></mxCell>
<mxCell id="c56" value="Add Aurora readers; set DynamoDB warm throughput on carts" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1080" y="448" width="490" height="17" as="geometry"/></mxCell>
<mxCell id="c57" value="T-30 min" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="996" y="474" width="80" height="17" as="geometry"/></mxCell>
<mxCell id="c58" value="Raise HPA minReplicas and Karpenter headroom; warm caches" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1080" y="474" width="490" height="17" as="geometry"/></mxCell>
<mxCell id="c59" value="T-0" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="996" y="500" width="80" height="17" as="geometry"/></mxCell>
<mxCell id="c60" value="Watch queue age, p99 checkout, 5xx at the ALB, Valkey CPU" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1080" y="500" width="490" height="17" as="geometry"/></mxCell>
<mxCell id="c61" value="T+2 hours" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="996" y="526" width="80" height="17" as="geometry"/></mxCell>
<mxCell id="c62" value="Put the minimums back, let Karpenter consolidate" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1080" y="526" width="490" height="17" as="geometry"/></mxCell>
<mxCell id="c63" value="&lt;b&gt;What went wrong last year (and the fix)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#D13212;fillColor=#FDF6F5;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="1540" height="230" as="geometry"/></mxCell>
<mxCell id="c64" value="1" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="56" y="614" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c65" value="Checkout wrote straight to Aurora." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#D13212;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="90" y="616" width="380" height="18" as="geometry"/></mxCell>
<mxCell id="c66" value="Connections ran out at 1,800 and every pod retried. Fix: RDS Proxy, a queue in front of order writes, and retries with jitter." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="440" y="616" width="1130" height="18" as="geometry"/></mxCell>
<mxCell id="c67" value="2" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="56" y="654" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c68" value="Stock was checked in SQL with SELECT then UPDATE." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#D13212;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="90" y="656" width="380" height="18" as="geometry"/></mxCell>
<mxCell id="c69" value="Two shoppers bought the last unit. Fix: one conditional UPDATE (or a Valkey DECR) so the check and the write are the same step." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="440" y="656" width="1130" height="18" as="geometry"/></mxCell>
<mxCell id="c70" value="3" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="56" y="694" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c71" value="Karpenter needed 3 minutes for new nodes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#D13212;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="90" y="696" width="380" height="18" as="geometry"/></mxCell>
<mxCell id="c72" value="The spike was over in 2. Fix: scale before the sale, keep low-priority pause pods as headroom that real pods evict." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="440" y="696" width="1130" height="18" as="geometry"/></mxCell>
<mxCell id="c73" value="4" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="56" y="734" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c74" value="The CDN cached a 503 for 60 s." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#D13212;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="90" y="736" width="380" height="18" as="geometry"/></mxCell>
<mxCell id="c75" value='Fix: short error-caching TTLs on CloudFront and an origin failover group to a static "sold out" page in S3.' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="440" y="736" width="1130" height="18" as="geometry"/></mxCell>
<mxCell id="c76" value="5" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="56" y="774" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c77" value="Nobody watched the right graph." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#D13212;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="90" y="776" width="380" height="18" as="geometry"/></mxCell>
<mxCell id="c78" value="CPU looked fine while the queue age climbed to 9 minutes. Fix: alarm on ApproximateAgeOfOldestMessage and on p99, not on CPU." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="440" y="776" width="1130" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
