<mxCell id="m6" value='&lt;b&gt;KMS&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;encryption keys&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1318" y="615" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="m7" value='&lt;b&gt;ECR&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;container images&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1448" y="615" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="m8" value='&lt;b&gt;CloudWatch&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;metrics, alarms&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1318" y="750" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="m9" value='&lt;b&gt;SES&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;order emails&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_email_service;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1448" y="750" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="c66" style="edgeStyle=none;html=1;rounded=0;strokeColor=#E7157B;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1230" y="590" as="sourcePoint"/><mxPoint x="1280" y="590" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c67" value="VPC endpoints" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#E7157B;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1288" y="582" width="100" height="16" as="geometry"/></mxCell>
<mxCell id="c68" value="Gateway endpoints for S3 and DynamoDB,&lt;br&gt;interface endpoints for SQS, EventBridge,&lt;br&gt;ECR, KMS, Secrets Manager. App traffic&lt;br&gt;to AWS APIs never uses the NAT gateways." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1292" y="885" width="260" height="58" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="checkout" name="2. Checkout and order events (LLD)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Checkout on AWS: one transaction, then events" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="900" height="24" as="geometry"/></mxCell>
<mxCell id="c2" value='The synchronous path does as little as possible. Everything after "order accepted" happens from the outbox, on queues.' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1200" height="18" as="geometry"/></mxCell>
<mxCell id="users" value="&lt;b&gt;Shopper&lt;/b&gt;" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.users;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="150" width="52" height="52" as="geometry"/></mxCell>
<mxCell id="cf" value='&lt;b&gt;CloudFront&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;+ WAF&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="150" y="154" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="alb" value="&lt;b&gt;ALB&lt;/b&gt;" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.application_load_balancer;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="270" y="154" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="c3" style="edgeStyle=none;html=1;rounded=0;strokeColor=#232F3E;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="users" target="cf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c4" style="edgeStyle=none;html=1;rounded=0;strokeColor=#232F3E;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cf" target="alb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c5" value="1" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="100" y="140" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;What happens, in order&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#232F3E;fillColor=#F7F8FA;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="320" height="345" as="geometry"/></mxCell>
<mxCell id="c7" value="1  POST /orders with an Idempotency-Key header" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="334" width="300" height="17" as="geometry"/></mxCell>
<mxCell id="c8" value="2  Read the cart and re-price every line" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="366" width="300" height="17" as="geometry"/></mxCell>
<mxCell id="c9" value="3  One Aurora transaction: order, stock&lt;br&gt;    reservation and an outbox row" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="398" width="300" height="32" as="geometry"/></mxCell>
<mxCell id="c10" value="4  Authorise payment with the same key" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="445" width="300" height="17" as="geometry"/></mxCell>
<mxCell id="c11" value="5  Relay publishes OrderPlaced to EventBridge" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="477" width="300" height="17" as="geometry"/></mxCell>
<mxCell id="c12" value="6  Rules fan the event out to one SQS&lt;br&gt;    queue per consumer" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="509" width="300" height="32" as="geometry"/></mxCell>
<mxCell id="c13" value="7  Consumers work at their own pace and&lt;br&gt;    are idempotent on order_id" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="556" width="300" height="32" as="geometry"/></mxCell>
<mxCell id="c14" value="8  Poison messages land in a DLQ, with an&lt;br&gt;    alarm on the age of the oldest message" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="603" width="300" height="32" as="geometry"/></mxCell>
<mxCell id="c15" value="&lt;b&gt;Amazon EKS, namespace shop&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#ED7100;fillColor=#FFF8F0;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="90" width="420" height="580" as="geometry"/></mxCell>
<mxCell id="c16" value="" style="sketch=0;outlineConnect=0;fillColor=#ED7100;strokeColor=none;aspect=fixed;shape=mxgraph.aws4.eks;" vertex="1" parent="1"><mxGeometry x="766" y="96" width="26" height="26" as="geometry"/></mxCell>
<mxCell id="co" value='&lt;b&gt;checkout service&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;POST /orders, 3 to 60 pods (HPA)&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#ED7100;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="410" y="150" width="230" height="56" as="geometry"/></mxCell>
<mxCell id="cart" value="&lt;b&gt;cart service&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#ED7100;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="410" y="268" width="150" height="40" as="geometry"/></mxCell>
<mxCell id="price" value="&lt;b&gt;pricing service&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#ED7100;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="410" y="340" width="150" height="40" as="geometry"/></mxCell>
<mxCell id="tx" value='&lt;b&gt;One database transaction&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;INSERT orders, order_lines&lt;br&gt;UPDATE inventory SET reserved = reserved + :qty&lt;br&gt;   WHERE sku = :sku AND on_hand - reserved &amp;gt;= :qty&lt;br&gt;INSERT outbox (type = OrderPlaced, payload)&lt;br&gt;COMMIT&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#C925D1;fillColor=#FBEEFC;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="410" y="420" width="360" height="104" as="geometry"/></mxCell>
<mxCell id="relay" value='&lt;b&gt;outbox relay&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;polls outbox, marks rows sent&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#ED7100;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="410" y="580" width="230" height="56" as="geometry"/></mxCell>
<mxCell id="c22" style="edgeStyle=none;html=1;rounded=0;strokeColor=#232F3E;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="alb" target="co"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c23" style="edgeStyle=none;html=1;rounded=0;strokeColor=#232F3E;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.3067;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="co" target="cart"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c24" style="edgeStyle=none;html=1;rounded=0;strokeColor=#232F3E;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="co" target="price"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="396" y="195"/><mxPoint x="396" y="360"/></Array></mxGeometry></mxCell>
<mxCell id="c25" value="2" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="380" y="236" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c26" style="edgeStyle=none;html=1;rounded=0;strokeColor=#C925D1;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.575;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="co" target="tx"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c27" value="3" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="660" y="380" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="ddb" value='&lt;b&gt;DynamoDB&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;carts table (on-demand)&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="880" y="266" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="valkey" value='&lt;b&gt;ElastiCache (Valkey)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;prices, stock counters&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elasticache_for_redis;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="880" y="338" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="aurora" value='&lt;b&gt;Aurora PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;orders, inventory, outbox&lt;br&gt;writer + 2 readers&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="880" y="450" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="c28" style="edgeStyle=none;html=1;rounded=0;strokeColor=#C925D1;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cart" target="ddb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c29" style="edgeStyle=none;html=1;rounded=0;strokeColor=#C925D1;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="price" target="valkey"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c30" style="edgeStyle=none;html=1;rounded=0;strokeColor=#C925D1;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tx" target="aurora"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="proxy" value="&lt;b&gt;RDS Proxy&lt;/b&gt;" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds_proxy;labelPosition=center;verticalLabelPosition=top;align=center;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="808" y="455" width="34" height="34" as="geometry"/></mxCell>
<mxCell id="nat" value="&lt;b&gt;NAT gateway&lt;/b&gt;" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.nat_gateway;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="880" y="154" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="psp" value='&lt;b&gt;Payment provider (external)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;authorise with Idempotency-Key = order_id&lt;br&gt;3 s timeout, 1 retry, then "payment pending"&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#ED7100;fillColor=#FFFFFF;dashed=1;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1060" y="140" width="300" height="72" as="geometry"/></mxCell>
<mxCell id="c32" style="edgeStyle=none;html=1;rounded=0;strokeColor=#ED7100;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="co" target="nat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c33" style="edgeStyle=none;html=1;rounded=0;strokeColor=#ED7100;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="nat" target="psp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
