<mxCell id="c30" value="400 tx/s, flat" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#1D8102;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1364" y="96" width="140" height="20" as="geometry"/></mxCell>
