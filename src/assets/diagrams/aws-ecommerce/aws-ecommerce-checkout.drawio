<mxCell id="c52" value="one rule per consumer, so a slow&lt;br&gt;consumer never slows the others" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#E7157B;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1170" y="226" width="260" height="30" as="geometry"/></mxCell>
<mxCell id="c53" value='&lt;b&gt;Every queue: visibility timeout &amp;gt; consumer timeout, maxReceiveCount 5,&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;then a DLQ. CloudWatch alarm on ApproximateAgeOfOldestMessage.&lt;br&gt;Consumers keep a processed(order_id, event_id) table, so a retry is harmless.&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#E7157B;fillColor=#FFF7FB;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1080" y="800" width="500" height="70" as="geometry"/></mxCell>
