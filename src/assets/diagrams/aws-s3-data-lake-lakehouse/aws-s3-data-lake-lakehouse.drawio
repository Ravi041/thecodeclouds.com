<mxCell id="c10" value="2  Data cell filter&lt;br&gt;rows: country IN ('DE','FR','NL','ES','IT', ...)&lt;br&gt;columns: all except email, phone, date_of_birth" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#8C4FFF;fillColor=#FAF7FF;fontColor=#232F3E;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="548" y="266" width="470" height="78" as="geometry"/></mxCell>
<mxCell id="c11" value="3  Credential vending&lt;br&gt;Short-lived credentials scoped to the table's&lt;br&gt;registered S3 prefix, issued to the engine only" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#8C4FFF;fillColor=#FAF7FF;fontColor=#232F3E;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="548" y="362" width="470" height="78" as="geometry"/></mxCell>
<mxCell id="c12" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="783" y="248" as="sourcePoint"/><mxPoint x="783" y="266" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c13" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="783" y="344" as="sourcePoint"/><mxPoint x="783" y="362" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c14" value="LF-Tags on databases, tables, columns&lt;br&gt;domain       = sales | finance | marketing&lt;br&gt;sensitivity  = public | internal | pii&lt;br&gt;Grant once on the tag expression, new tables inherit it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="548" y="458" width="470" height="62" as="geometry"/></mxCell>
<mxCell id="c15" value="Hybrid access mode while migrating, then remove&lt;br&gt;IAMAllowedPrincipals so IAM alone grants nothing." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#DD344C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="548" y="552" width="470" height="32" as="geometry"/></mxCell>
<mxCell id="c16" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="426" y="126" as="sourcePoint"/><mxPoint x="548" y="209" as="targetPoint"/><Array as="points"><mxPoint x="500" y="126"/><mxPoint x="500" y="209"/></Array></mxGeometry></mxCell>
<mxCell id="c17" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="426" y="256" as="sourcePoint"/><mxPoint x="500" y="256" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c18" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="426" y="386" as="sourcePoint"/><mxPoint x="500" y="386" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c19" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="426" y="516" as="sourcePoint"/><mxPoint x="500" y="126" as="targetPoint"/><Array as="points"><mxPoint x="500" y="516"/></Array></mxGeometry></mxCell>
<mxCell id="c20" value="1" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="506" y="150" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c21" value="&lt;b&gt;Curated bucket (registered location)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#7AA116;fillColor=#F5F9EC;dashed=0;fontSize=12;fontStyle=0;fontColor=#3F6212;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1070" y="64" width="410" height="560" as="geometry"/></mxCell>
<mxCell id="s3" value='&lt;b&gt;s3://lake-curated-prod/&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;Iceberg data and metadata&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1100" y="120" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="kms" value='&lt;b&gt;KMS key: lake-curated&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;key policy lets only the LF&lt;br&gt;data-access role and ETL&lt;br&gt;roles decrypt&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1100" y="230" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="c22" value="Bucket policy&lt;br&gt;Deny s3:GetObject and s3:PutObject unless&lt;br&gt;aws:PrincipalArn is the LF data-access&lt;br&gt;role or an approved ETL role.&lt;br&gt;Require TLS and aws:PrincipalOrgID." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#DD344C;fillColor=#FFFFFF;fontColor=#232F3E;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1090" y="360" width="370" height="110" as="geometry"/></mxCell>
<mxCell id="c23" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1D8102;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1018" y="401" as="sourcePoint"/><mxPoint x="1100" y="144" as="targetPoint"/><Array as="points"><mxPoint x="1052" y="401"/><mxPoint x="1052" y="144"/></Array></mxGeometry></mxCell>
<mxCell id="c24" value="scoped credentials" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#1D8102;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1080" y="186" width="140" height="16" as="geometry"/></mxCell>
<mxCell id="c25" value="The result set leaves Lake Formation already&lt;br&gt;filtered: EU rows, no email or phone." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1090" y="496" width="370" height="32" as="geometry"/></mxCell>
<mxCell id="c26" style="edgeStyle=none;html=1;rounded=0;strokeColor=#D13212;strokeWidth=2;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="624" as="sourcePoint"/><mxPoint x="1440" y="470" as="targetPoint"/><Array as="points"><mxPoint x="150" y="650"/><mxPoint x="1440" y="650"/></Array></mxGeometry></mxCell>
<mxCell id="c27" value="analyst-eu tries aws s3 cp s3://lake-curated-prod/... directly: AccessDenied. Without this deny, raw Parquet would bypass every column filter." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#D13212;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="170" y="656" width="1100" height="18" as="geometry"/></mxCell>
<mxCell id="c28" value="&lt;b&gt;Detect, audit and share&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#7D8998;fillColor=#F7F8FA;dashed=0;fontSize=12;fontStyle=0;fontColor=#545B64;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="690" width="1460" height="112" as="geometry"/></mxCell>
<mxCell id="macie" value='&lt;b&gt;Macie scans raw buckets&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;finding -&amp;gt; EventBridge -&amp;gt; Lambda&lt;br&gt;tags column sensitivity=pii&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.macie;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="50" y="730" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="trail" value='&lt;b&gt;CloudTrail&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;LF GetDataAccess + Athena&lt;br&gt;query events, per principal&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudtrail;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="420" y="730" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="dz" value='&lt;b&gt;Business catalog (DataZone /&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;SageMaker Unified Studio)&lt;br&gt;subscribe-and-approve on top&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.datazone;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="760" y="730" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="org" value='&lt;b&gt;Cross-account share&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;LF grant via AWS RAM, resource&lt;br&gt;link in the marketing account&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.organizations;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1110" y="730" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="c29" value="2" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1450" y="696" width="22" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="small-files" name="3. Small files and table maintenance"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="The small-files problem: same clickstream, same query, before and after" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1400" height="24" as="geometry"/></mxCell>
<mxCell id="c2" value="&lt;b&gt;Before: one S3 object per Lambda invocation&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#D13212;fillColor=#FFF6F4;dashed=0;fontSize=12;fontStyle=0;fontColor=#D13212;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="1460" height="270" as="geometry"/></mxCell>
<mxCell id="b_web" value='&lt;b&gt;Web and mobile&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;24k events/s avg&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.client;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="50" y="120" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="b_kds" value='&lt;b&gt;Kinesis Data Streams&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;40 shards&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.kinesis_data_streams;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="250" y="120" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="b_fn" value='&lt;b&gt;Lambda consumer&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;batch of ~600 records,&lt;br&gt;one PutObject per batch&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="460" y="120" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="b_s3" value='&lt;b&gt;raw/clicks/dt=.../hr=.../&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;40 objects/s, avg 0.6 MB&lt;br&gt;3.46 M objects a day&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="700" y="120" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="b_ath" value='&lt;b&gt;Athena: one day of clicks&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;5 min 40 s, 3.46 M GET requests,&lt;br&gt;S3 503 Slow Down retries&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.athena;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1000" y="120" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="c3" style="edgeStyle=none;html=1;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_web" target="b_kds"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c4" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_kds" target="b_fn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c5" style="edgeStyle=none;html=1;rounded=0;strokeColor=#ED7100;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_fn" target="b_s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c6" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_s3" target="b_ath"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c7" value="Why it hurts&lt;br&gt;Every file is a request to list, open and read a footer from.&lt;br&gt;Planning time grows with file count, not data size.&lt;br&gt;GETs per prefix hit the 5,500 req/s guidance and get throttled." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#D13212;fillColor=#FFFFFF;fontColor=#232F3E;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="230" width="620" height="86" as="geometry"/></mxCell>
<mxCell id="c8" value="Monthly side effects&lt;br&gt;~105 M new objects, about $525 in PUT requests alone&lt;br&gt;1.26 billion objects in the raw zone after a year&lt;br&gt;Glue crawler runs take hours and add a partition per hour" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#D13212;fillColor=#FFFFFF;fontColor=#232F3E;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="690" y="230" width="620" height="86" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;b&gt;After: buffer at ingest, write Iceberg, compact in the background&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1D8102;fillColor=#F4FAF1;dashed=0;fontSize=12;fontStyle=0;fontColor=#1D8102;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="350" width="1460" height="330" as="geometry"/></mxCell>
<mxCell id="a_web" value='&lt;b&gt;Web and mobile&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;SDK packs ~20 events&lt;br&gt;per record&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.client;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="50" y="410" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="a_fh" value='&lt;b&gt;Data Firehose&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;128 MiB / 300 s buffer,&lt;br&gt;GZIP, dynamic partitions&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.kinesis_data_firehose;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="230" y="410" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="a_raw" value='&lt;b&gt;raw/clicks/dt=.../&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;a few thousand objects&lt;br&gt;a day, not millions&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="420" y="410" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="a_glue" value='&lt;b&gt;Glue job, hourly&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;INSERT INTO the&lt;br&gt;Iceberg table&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.glue;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="610" y="410" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="a_tbl" value='&lt;b&gt;curated.clicks (Iceberg)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;hidden partition day(event_ts)&lt;br&gt;~220 GB/day Parquet + zstd&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3_tables;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="800" y="410" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="a_ath" value='&lt;b&gt;Athena: one day of clicks&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;14 s, ~450 data files,&lt;br&gt;11 GB scanned (3 of 60&lt;br&gt;columns) = about $0.06&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.athena;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1040" y="410" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="c10" style="edgeStyle=none;html=1;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_web" target="a_fh"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c11" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_fh" target="a_raw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c12" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7AA116;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_raw" target="a_glue"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c13" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_glue" target="a_tbl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c14" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_tbl" target="a_ath"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c15" value="&lt;b&gt;Table maintenance (Glue Data Catalog optimizers, or built in with S3 Tables)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#8C4FFF;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#8C4FFF;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="560" y="520" width="720" height="146" as="geometry"/></mxCell>
<mxCell id="c16" value="Compaction&lt;br&gt;bin-pack to 512 MB files,&lt;br&gt;rewrites delete files too" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#8C4FFF;fillColor=#FAF7FF;fontColor=#232F3E;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="580" y="556" width="220" height="90" as="geometry"/></mxCell>
<mxCell id="c17" value="Snapshot expiry&lt;br&gt;keep 7 days for time travel,&lt;br&gt;then drop old snapshots" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#8C4FFF;fillColor=#FAF7FF;fontColor=#232F3E;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="810" y="556" width="220" height="90" as="geometry"/></mxCell>
<mxCell id="c18" value="Orphan file removal&lt;br&gt;delete files no snapshot&lt;br&gt;references, after 3 days" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#8C4FFF;fillColor=#FAF7FF;fontColor=#232F3E;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1040" y="556" width="220" height="90" as="geometry"/></mxCell>
<mxCell id="c19" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=1.5;dashed=0;startArrow=block;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="940" y="434" as="sourcePoint"/><mxPoint x="940" y="520" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c20" value="Need no raw copy? Firehose can&lt;br&gt;also write straight into Iceberg." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="560" width="300" height="32" as="geometry"/></mxCell>
<mxCell id="c21" value="&lt;b&gt;Rules of thumb&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#7D8998;fillColor=#F7F8FA;dashed=0;fontSize=12;fontStyle=0;fontColor=#545B64;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="696" width="1460" height="90" as="geometry"/></mxCell>
<mxCell id="c22" value="Aim for 128 MB to 1 GB per data file.        Partition by what queries filter on (day), not by everything (day + hour + country + device).&lt;br&gt;Watch average object size in S3 Storage Lens and the Iceberg $files metadata table.        Never point a crawler at an Iceberg table." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="728" width="1420" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram>
