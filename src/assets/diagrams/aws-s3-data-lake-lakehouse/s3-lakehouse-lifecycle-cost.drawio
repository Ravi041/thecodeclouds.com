<mxCell id="c19" value="Standard" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#7AA116;fillColor=#E9F3DA;fontColor=#232F3E;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="250" y="130" width="130" height="44" as="geometry"/></mxCell>
<mxCell id="c20" value="Standard-IA" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#7AA116;fillColor=#D5E8B8;fontColor=#232F3E;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="380" y="130" width="120" height="44" as="geometry"/></mxCell>
<mxCell id="c21" value="expire at 90 d" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#DD344C;fillColor=#FFF5F6;fontColor=#DD344C;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="506" y="130" width="110" height="44" as="geometry"/></mxCell>
<mxCell id="c22" value="Standard" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#7AA116;fillColor=#E9F3DA;fontColor=#232F3E;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="250" y="200" width="130" height="44" as="geometry"/></mxCell>
<mxCell id="c23" value="Glacier Flexible Retrieval" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#7AA116;fillColor=#C4DE9C;fontColor=#232F3E;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="380" y="200" width="270" height="44" as="geometry"/></mxCell>
<mxCell id="c24" value="Glacier Deep Archive" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#7AA116;fillColor=#A9CC74;fontColor=#232F3E;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="650" y="200" width="300" height="44" as="geometry"/></mxCell>
<mxCell id="c25" value="Intelligent-Tiering from day 0: Frequent, then Infrequent after 30 idle days, Archive Instant after 90" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#7AA116;fillColor=#EEF6E2;fontColor=#232F3E;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="250" y="270" width="700" height="44" as="geometry"/></mxCell>
<mxCell id="c26" value="Standard (small, read all day)" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#7AA116;fillColor=#E9F3DA;fontColor=#232F3E;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="250" y="340" width="700" height="44" as="geometry"/></mxCell>
<mxCell id="c27" value="Noncurrent versions expire after 7 days (curated) or 30 (raw); incomplete multipart uploads abort after 7 days.&lt;br&gt;Clicks leave curated through Iceberg DELETE at 25 months, not lifecycle: lifecycle on a table's files corrupts it.&lt;br&gt;Minimum durations bite: Standard-IA 30 days, Glacier Flexible 90, Deep Archive 180. Transitions cost per object,&lt;br&gt;so lifecycle on millions of tiny files can cost more than it saves." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="412" width="920" height="62" as="geometry"/></mxCell>
<mxCell id="c28" value="&lt;b&gt;Query and compute guardrails&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#8C4FFF;fillColor=#FAF7FF;dashed=0;fontSize=12;fontStyle=0;fontColor=#8C4FFF;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="990" y="60" width="490" height="470" as="geometry"/></mxCell>
<mxCell id="ath" value='&lt;b&gt;Athena workgroups&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;per-query scan cutoff: analysts 200 GB,&lt;br&gt;engineering 2 TB; enforced settings;&lt;br&gt;result reuse up to 60 min&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.athena;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1010" y="100" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="rs" value='&lt;b&gt;Redshift Serverless&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;base 32 RPU, max RPU cap,&lt;br&gt;usage limit on RPU-hours per day&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.redshift;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1010" y="200" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="glue" value='&lt;b&gt;Glue&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;Flex execution for jobs that can wait,&lt;br&gt;auto scaling, job timeouts&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.glue;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1010" y="300" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="bud" value='&lt;b&gt;Budgets + Cost Anomaly Detection&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;by CostCentre tag and workgroup,&lt;br&gt;alert at 80% of forecast&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.budgets;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1010" y="400" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="c29" value="&lt;b&gt;What it did for the example lake (monthly, us-east-1 list prices)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#7D8998;fillColor=#F7F8FA;dashed=0;fontSize=12;fontStyle=0;fontColor=#545B64;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="550" width="1460" height="210" as="geometry"/></mxCell>
<mxCell id="c30" value="S3 storage, 331 TB&lt;br&gt;all Standard: about $7,300&lt;br&gt;with this lifecycle: about $2,100" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#7AA116;fillColor=#FFFFFF;fontColor=#232F3E;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="590" width="320" height="100" as="geometry"/></mxCell>
<mxCell id="c31" value="Athena scans&lt;br&gt;JSON, no partitions: 180 TB/day, $27,000&lt;br&gt;Iceberg + Parquet: 2.7 TB/day, about $400" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#8C4FFF;fillColor=#FFFFFF;fontColor=#232F3E;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="590" width="360" height="100" as="geometry"/></mxCell>
<mxCell id="c32" value="Largest single query&lt;br&gt;before: 140 TB scanned, $700&lt;br&gt;after: stopped at the 200 GB cutoff, $1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#DD344C;fillColor=#FFFFFF;fontColor=#232F3E;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="790" y="590" width="330" height="100" as="geometry"/></mxCell>
<mxCell id="c33" value="Requests&lt;br&gt;PUTs on clickstream&lt;br&gt;$525 down to under $5" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#E7157B;fillColor=#FFFFFF;fontColor=#232F3E;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1150" y="590" width="300" height="100" as="geometry"/></mxCell>
<mxCell id="c34" value="Estimates from public list prices for the workload described in the article; check your own region in the AWS Pricing Calculator." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="712" width="1300" height="17" as="geometry"/></mxCell></root></mxGraphModel></diagram>
