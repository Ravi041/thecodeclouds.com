<mxfile host="thecodeclouds.com" agent="hand-built" version="24.0.0" type="device">
<diagram id="decision" name="Which cloud for which shop"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Which cloud for which shop? A decision path" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="22" width="900" height="28" as="geometry"/></mxCell>
<mxCell id="c2" value='Ask the questions in this order. The first "yes" usually decides it; price differences come last because they are the smallest.' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="1300" height="19" as="geometry"/></mxCell>
<mxCell id="c3" value="Start: new shop, or a replatform?" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;strokeColor=#202124;fillColor=#202124;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="190" y="96" width="280" height="44" as="geometry"/></mxCell>
<mxCell id="q0" value="Does the team already run&lt;br&gt;production on one cloud&lt;br&gt;and know it well?" style="rhombus;html=1;whiteSpace=wrap;strokeColor=#5F6368;fillColor=#FFFFFF;fontColor=#202124;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="150" y="160" width="360" height="128" as="geometry"/></mxCell>
<mxCell id="c5" style="edgeStyle=none;html=1;rounded=0;strokeColor=#202124;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="q0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="r0" value="Stay on that cloud&lt;br&gt;Skills, landing zone, security reviews and support contracts are&lt;br&gt;already paid for. A move costs more than any price gap between clouds." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#5F6368;fillColor=#F1F3F4;fontColor=#202124;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="640" y="174" width="600" height="88" as="geometry"/></mxCell>
<mxCell id="c7" style="edgeStyle=none;html=1;rounded=0;strokeColor=#188038;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q0" target="r0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c8" value="yes" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#188038;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="546" y="202" width="40" height="18" as="geometry"/></mxCell>
<mxCell id="q1" value="Microsoft estate? Entra ID,&lt;br&gt;.NET, SQL Server licences,&lt;br&gt;an existing Enterprise Agreement" style="rhombus;html=1;whiteSpace=wrap;strokeColor=#5F6368;fillColor=#FFFFFF;fontColor=#202124;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="150" y="330" width="360" height="128" as="geometry"/></mxCell>
<mxCell id="c10" style="edgeStyle=none;html=1;rounded=0;strokeColor=#C5221F;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q0" target="q1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c11" value="no" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#C5221F;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="338" y="300" width="40" height="18" as="geometry"/></mxCell>
<mxCell id="r1" value="Microsoft Azure&lt;br&gt;AKS or Container Apps, Azure SQL Database, Cosmos DB, Front Door.&lt;br&gt;Azure Hybrid Benefit reuses SQL Server and Windows licences; Entra ID&lt;br&gt;already runs your staff sign-in." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#0078D4;fillColor=#E8F1FB;fontColor=#202124;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="640" y="344" width="600" height="100" as="geometry"/></mxCell>
<mxCell id="c13" style="edgeStyle=none;html=1;rounded=0;strokeColor=#188038;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q1" target="r1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c14" value="yes" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#188038;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="546" y="372" width="40" height="18" as="geometry"/></mxCell>
<mxCell id="q2" value="Fewer than ~10 engineers and&lt;br&gt;no platform team; want the&lt;br&gt;least to operate?" style="rhombus;html=1;whiteSpace=wrap;strokeColor=#5F6368;fillColor=#FFFFFF;fontColor=#202124;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="150" y="500" width="360" height="128" as="geometry"/></mxCell>
<mxCell id="c16" style="edgeStyle=none;html=1;rounded=0;strokeColor=#C5221F;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q1" target="q2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c17" value="no" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#C5221F;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="338" y="470" width="40" height="18" as="geometry"/></mxCell>
<mxCell id="r2" value="Google Cloud (or AWS serverless)&lt;br&gt;Cloud Run + Cloud SQL + Firestore: containers without a cluster,&lt;br&gt;scale to zero overnight, per-request billing. On AWS the same shape&lt;br&gt;is ECS on Fargate + Aurora Serverless v2 + DynamoDB." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#E8F0FE;fontColor=#202124;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="640" y="514" width="600" height="100" as="geometry"/></mxCell>
<mxCell id="c19" style="edgeStyle=none;html=1;rounded=0;strokeColor=#188038;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q2" target="r2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c20" value="yes" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#188038;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="546" y="542" width="40" height="18" as="geometry"/></mxCell>
<mxCell id="q3" value="Are analytics, recommendations&lt;br&gt;or personalisation the&lt;br&gt;core of the product?" style="rhombus;html=1;whiteSpace=wrap;strokeColor=#5F6368;fillColor=#FFFFFF;fontColor=#202124;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="150" y="670" width="360" height="128" as="geometry"/></mxCell>
<mxCell id="c22" style="edgeStyle=none;html=1;rounded=0;strokeColor=#C5221F;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q2" target="q3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c23" value="no" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#C5221F;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="338" y="640" width="40" height="18" as="geometry"/></mxCell>
<mxCell id="r3" value="Google Cloud&lt;br&gt;Pub/Sub straight into BigQuery, BigQuery ML and Google's recommendation&lt;br&gt;and retail search products. The data platform decides; the storefront&lt;br&gt;can sit next to it on GKE or Cloud Run." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#E8F0FE;fontColor=#202124;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="640" y="684" width="600" height="100" as="geometry"/></mxCell>
<mxCell id="c25" style="edgeStyle=none;html=1;rounded=0;strokeColor=#188038;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q3" target="r3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c26" value="yes" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#188038;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="546" y="712" width="40" height="18" as="geometry"/></mxCell>
<mxCell id="aws" value="AWS&lt;br&gt;EKS or ECS, Aurora, DynamoDB, ElastiCache, OpenSearch, CloudFront.&lt;br&gt;The widest service catalog and Marketplace, the biggest hiring pool,&lt;br&gt;and the most third-party commerce integrations built for it first." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#232F3E;fillColor=#FFF4E5;fontColor=#202124;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="840" width="600" height="96" as="geometry"/></mxCell>
<mxCell id="c28" style="edgeStyle=none;html=1;rounded=0;strokeColor=#C5221F;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q3" target="aws"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c29" value="no" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#C5221F;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="338" y="806" width="40" height="18" as="geometry"/></mxCell>
<mxCell id="c30" value="&lt;b&gt;Keep the exit door open&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#7D8998;fillColor=#F7F8FA;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1270" y="96" width="210" height="290" as="geometry"/></mxCell>
<mxCell id="c31" value="• Kubernetes or plain&lt;br&gt;containers" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1282" y="132" width="190" height="32" as="geometry"/></mxCell>
<mxCell id="c32" value="• PostgreSQL, not a&lt;br&gt;proprietary SQL dialect" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1282" y="174" width="190" height="32" as="geometry"/></mxCell>
<mxCell id="c33" value="• Valkey / Redis protocol&lt;br&gt;for the cache" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1282" y="216" width="190" height="32" as="geometry"/></mxCell>
<mxCell id="c34" value="• OpenTelemetry for&lt;br&gt;traces and metrics" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1282" y="258" width="190" height="32" as="geometry"/></mxCell>
<mxCell id="c35" value="• Terraform for every&lt;br&gt;resource" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1282" y="300" width="190" height="32" as="geometry"/></mxCell>
<mxCell id="c36" value="• Payments via a PSP,&lt;br&gt;not cloud-specific" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1282" y="342" width="190" height="32" as="geometry"/></mxCell>
<mxCell id="c37" value="&lt;b&gt;Real numbers beat opinions&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#E8710A;fillColor=#FEF7E0;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1270" y="410" width="210" height="170" as="geometry"/></mxCell>
<mxCell id="c38" value="Price the same bill of&lt;br&gt;materials on all three&lt;br&gt;calculators: nodes, DB,&lt;br&gt;cache, egress, support.&lt;br&gt;Then ask each provider&lt;br&gt;for startup or migration&lt;br&gt;credits." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1282" y="444" width="190" height="107" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
