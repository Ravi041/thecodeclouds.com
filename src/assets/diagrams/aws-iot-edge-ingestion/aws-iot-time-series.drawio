<mxfile host="thecodeclouds.com" agent="hand-built" version="24.0.0" type="device">
<diagram id="time-series" name="4. Time-series storage by query pattern"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Time-series storage: one stream, four stores, each chosen by the question it answers (EU numbers, 600,000 devices)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1450" height="24" as="geometry"/></mxCell>
<mxCell id="kds" value='&lt;b&gt;Kinesis Data Streams&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;hp-telemetry-eu&lt;br&gt;2,000 records/s, 2.4 MB/s&lt;br&gt;8 shards (3x headroom)&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.kinesis_data_streams;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="84" y="250" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="flink" value="&lt;b&gt;Managed Service for Apache Flink: one application, three operators&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#8C4FFF;fillColor=#FAF7FF;dashed=0;fontSize=12;fontStyle=0;fontColor=#8C4FFF;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="210" y="80" width="340" height="420" as="geometry"/></mxCell>
<mxCell id="op1" value='&lt;b&gt;1. Dedupe&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;key (thing, sample_ts), 48 h state;&lt;br&gt;backlog uploads and QoS 1 retries&lt;br&gt;become no-ops&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#8C4FFF;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="230" y="120" width="300" height="92" as="geometry"/></mxCell>
<mxCell id="op2" value='&lt;b&gt;2. Per-device windows (event time)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;hourly block of 60 one-minute samples,&lt;br&gt;15-min rollups, late data allowed 48 h&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#8C4FFF;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="230" y="240" width="300" height="92" as="geometry"/></mxCell>
<mxCell id="op3" value='&lt;b&gt;3. Fleet aggregates and anomalies&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;per country, model, firmware;&lt;br&gt;compressor short-cycling detector&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#8C4FFF;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="230" y="360" width="300" height="92" as="geometry"/></mxCell>
<mxCell id="c6" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=2.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="kds" target="flink"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="278"/><mxPoint x="170" y="290"/></Array></mxGeometry></mxCell>
<mxCell id="c7" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="op1" target="op2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c8" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="op2" target="op3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="state" value='&lt;b&gt;DynamoDB device_state&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;latest sample per device, written&lt;br&gt;only if sample_ts is newer&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="620" y="100" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="hist" value='&lt;b&gt;DynamoDB device_history&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;1 item per device-hour, TTL 90 days;&lt;br&gt;1 item per device-day of rollups, 2 years&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="620" y="222" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="influx" value='&lt;b&gt;Timestream for InfluxDB&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;fleet + site aggregates, ~50k series,&lt;br&gt;Grafana boards for ops&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.timestream;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="620" y="344" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="eb" value='&lt;b&gt;EventBridge&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;anomaly events to field-service&lt;br&gt;tickets and the owner app&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="620" y="456" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="c9" style="edgeStyle=none;html=1;rounded=0;strokeColor=#C925D1;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="530" y="166" as="sourcePoint"/><mxPoint x="620" y="124" as="targetPoint"/><Array as="points"><mxPoint x="575" y="166"/><mxPoint x="575" y="124"/></Array></mxGeometry></mxCell>
<mxCell id="c10" style="edgeStyle=none;html=1;rounded=0;strokeColor=#C925D1;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="530" y="286" as="sourcePoint"/><mxPoint x="620" y="246" as="targetPoint"/><Array as="points"><mxPoint x="575" y="286"/><mxPoint x="575" y="246"/></Array></mxGeometry></mxCell>
<mxCell id="c11" style="edgeStyle=none;html=1;rounded=0;strokeColor=#C925D1;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="530" y="396" as="sourcePoint"/><mxPoint x="620" y="368" as="targetPoint"/><Array as="points"><mxPoint x="575" y="396"/><mxPoint x="575" y="368"/></Array></mxGeometry></mxCell>
<mxCell id="c12" style="edgeStyle=none;html=1;rounded=0;strokeColor=#E7157B;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="530" y="420" as="sourcePoint"/><mxPoint x="620" y="480" as="targetPoint"/><Array as="points"><mxPoint x="590" y="420"/><mxPoint x="590" y="480"/></Array></mxGeometry></mxCell>
<mxCell id="fh" value='&lt;b&gt;Data Firehose&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;5-min / 128 MB buffers,&lt;br&gt;Parquet into Iceberg&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.kinesis_data_firehose;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="330" y="600" width="52" height="52" as="geometry"/></mxCell>
<mxCell id="s3t" value='&lt;b&gt;S3 Tables: raw.telemetry (Iceberg)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;partitioned by day(sample_ts),&lt;br&gt;kept 13 months, compaction managed&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3_tables;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="660" y="600" width="52" height="52" as="geometry"/></mxCell>
<mxCell id="ath" value='&lt;b&gt;Athena, QuickSight, SageMaker&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;year-over-year, warranty, ML training&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.athena;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1000" y="600" width="52" height="52" as="geometry"/></mxCell>
<mxCell id="c13" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="kds" target="fh"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="24" y="278"/><mxPoint x="24" y="626"/></Array></mxGeometry></mxCell>
<mxCell id="c14" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fh" target="s3t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c15" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3t" target="ath"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c16" value="&lt;b&gt;Pick the store by the question&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#232F3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1000" y="80" width="480" height="230" as="geometry"/></mxCell>
<mxCell id="c17" value='"Is my heat pump on, and how warm is it?"&lt;br&gt;    device_state: one GetItem, single-digit ms&lt;br&gt;"Show me last week, minute by minute."&lt;br&gt;    device_history: one Query, 168 items&lt;br&gt;"Which firmware has more defrost faults?"&lt;br&gt;    InfluxDB aggregates (live), Athena (deep dive)&lt;br&gt;"Compare this winter with last winter."&lt;br&gt;    Athena over Iceberg, partition-pruned by day' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1014" y="108" width="460" height="130" as="geometry"/></mxCell>
<mxCell id="c18" value="&lt;b&gt;Sizing, EU region&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#545B64;fillColor=#F7F8FA;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1000" y="330" width="480" height="230" as="geometry"/></mxCell>
<mxCell id="c19" value="600,000 devices x 12 messages/hour = 2,000 msg/s&lt;br&gt;1.2 KB per message = 2.4 MB/s, about 207 GB/day as JSON&lt;br&gt;Kinesis: 3 shards by throughput, 8 to drain backlogs&lt;br&gt;device_history: 600,000 / 3,600 s = 167 writes/s,&lt;br&gt;    about 4 KB each, about 5 TB at 90 days&lt;br&gt;InfluxDB: series = dimensions you group by,&lt;br&gt;    not devices. 600,000 device tags would be 7.2M series&lt;br&gt;Iceberg: Parquet + ZSTD is usually several times&lt;br&gt;    smaller than the JSON; measure with your payloads" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1014" y="358" width="460" height="146" as="geometry"/></mxCell>
<mxCell id="c20" value="Why not put every sample in a time-series database? Because the per-device question is a key lookup,&lt;br&gt;and a tag per device turns 12 fields into millions of series. Keep the TSDB for the questions it is good at." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="230" y="720" width="1200" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
