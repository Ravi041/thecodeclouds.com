<mxCell id="c14" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7AA116;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ipc" target="logic"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c15" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7AA116;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ipc" target="stream"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="289.5"/><mxPoint x="470" y="179"/></Array></mxGeometry></mxCell>
<mxCell id="c16" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7AA116;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="ipc" target="shadowm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c17" style="edgeStyle=none;html=1;rounded=0;strokeColor=#DD344C;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="logic" target="spool"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c18" style="edgeStyle=none;html=1;rounded=0;strokeColor=#DD344C;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="logic" target="siren"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="439"/><mxPoint x="150" y="430"/></Array></mxGeometry></mxCell>
<mxCell id="c19" value="local alarm in&lt;br&gt;seconds, offline" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#DD344C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="96" y="372" width="110" height="30" as="geometry"/></mxCell>
<mxCell id="router" value='&lt;b&gt;Site router&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;4G backup failed too&lt;/font&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#545B64;strokeColor=none;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.router;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="830" y="290" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="c20" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7AA116;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="179" as="sourcePoint"/><mxPoint x="770" y="179" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c21" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7AA116;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="309" as="sourcePoint"/><mxPoint x="770" y="309" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c22" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7AA116;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="439" as="sourcePoint"/><mxPoint x="770" y="439" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c23" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7AA116;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="770" y="179" as="sourcePoint"/><mxPoint x="770" y="439" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c24" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7AA116;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="770" y="312" as="sourcePoint"/><mxPoint x="830" y="312" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="home" value="&lt;b&gt;Heat pump at home, Wi-Fi down for 40 minutes&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#7AA116;fillColor=#F5F9EC;dashed=0;fontSize=12;fontStyle=0;fontColor=#3B5E0A;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="600" width="900" height="220" as="geometry"/></mxCell>
<mxCell id="hp" value='&lt;b&gt;Controller&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;FreeRTOS&lt;/font&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=none;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.iot_thing_freertos_device;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="46" height="46" as="geometry"/></mxCell>
<mxCell id="c26" value="Samples keep going into a 64 KB flash ring buffer: 1 per minute, about 40 bytes&lt;br&gt;each in CBOR, so 24 hours fit. The device timestamp travels with every sample.&lt;br&gt;&lt;br&gt;Reconnect: exponential backoff with full jitter, 1 s doubling to a 5-minute cap,&lt;br&gt;so 180,000 homes on one broadband provider do not reconnect in the same second.&lt;br&gt;&lt;br&gt;MQTT 5 with clean start = 0 and a 24 h session expiry: QoS 1 commands sent while&lt;br&gt;it was away are delivered on reconnect. The backlog uploads oldest first, at most&lt;br&gt;2 messages per second, and only after the device has received the latest shadow." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="150" y="640" width="760" height="146" as="geometry"/></mxCell>
<mxCell id="c27" value="&lt;b&gt;AWS Cloud, eu-central-1&lt;/b&gt;" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=1;" vertex="1" parent="1"><mxGeometry x="960" y="60" width="520" height="760" as="geometry"/></mxCell>
<mxCell id="core" value='&lt;b&gt;AWS IoT Core&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;persistent sessions hold QoS 1&lt;br&gt;messages for offline devices&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.iot_core;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1000" y="110" width="52" height="52" as="geometry"/></mxCell>
<mxCell id="shadow" value='&lt;b&gt;Device Shadow&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;new setpoint waits in "desired";&lt;br&gt;device gets a delta on reconnect&lt;/font&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=none;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.shadow;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1006" y="240" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="kds" value='&lt;b&gt;Kinesis Data Streams&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;site backlog arrives in order,&lt;br&gt;with original timestamps&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.kinesis_data_streams;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1000" y="370" width="52" height="52" as="geometry"/></mxCell>
<mxCell id="gg" value='&lt;b&gt;IoT Greengrass service&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;deployments queue until&lt;br&gt;the core is back&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.greengrass;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1000" y="500" width="52" height="52" as="geometry"/></mxCell>
<mxCell id="cw" value='&lt;b&gt;Presence rule + CloudWatch&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;$aws/events/presence/disconnected&lt;br&gt;alert if a site is silent &amp;gt; 15 min&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1000" y="630" width="52" height="52" as="geometry"/></mxCell>
<mxCell id="c28" value="Late data is normal, not an error: every store&lt;br&gt;downstream keys on device time, not arrival time,&lt;br&gt;and accepts samples days late." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1000" y="745" width="460" height="50" as="geometry"/></mxCell>
<mxCell id="c29" style="edgeStyle=none;html=1;rounded=0;strokeColor=#DD344C;strokeWidth=2;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="874" y="312" as="sourcePoint"/><mxPoint x="1000" y="136" as="targetPoint"/></mxGeometry></mxCell>
