<mxCell id="c10" value="All components ship as one deployment to the thing group sites/eu;&lt;br&gt;recipes are versioned and artifacts live in S3." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="210" y="500" width="520" height="32" as="geometry"/></mxCell>
