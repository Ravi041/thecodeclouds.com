<mxfile host="thecodeclouds.com" agent="hand-built" version="24.0.0" type="device">
<diagram id="edge-offline" name="3. Edge and offline behaviour"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="840" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Edge and offline: a supermarket site keeps working through a 6-hour WAN outage, and a home device rides out a Wi-Fi drop" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1450" height="24" as="geometry"/></mxCell>
<mxCell id="c2" value="&lt;b&gt;Supermarket site, Greengrass gateway (WAN down 06:10 to 12:10)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#545B64;fillColor=#F7F8FA;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="900" height="520" as="geometry"/></mxCell>
<mxCell id="sens" value='&lt;b&gt;Case sensors&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;300, Modbus RTU&lt;br&gt;1 reading / 10 s&lt;/font&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=none;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.iot_thing_temperature_sensor;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="plc" value='&lt;b&gt;Refrigeration&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;controller&lt;/font&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=none;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.iot_thing_plc;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="siren" value='&lt;b&gt;Store alarm panel&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;+ staff pager&lt;/font&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=none;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.iot_thing_stacklight;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="c3" value="&lt;b&gt;Greengrass core device: industrial PC, 64 GB SSD&lt;/b&gt;" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="190" y="100" width="560" height="460" as="geometry"/></mxCell>
<mxCell id="adapter" value='&lt;b&gt;Modbus adapter&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;reads registers, publishes&lt;br&gt;local/site/case/&amp;lt;id&amp;gt;&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#7AA116;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="220" y="140" width="220" height="78" as="geometry"/></mxCell>
<mxCell id="adapter_i" value="&lt;b&gt;&lt;/b&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=none;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.iot_greengrass_protocol;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="400" y="178" width="32" height="32" as="geometry"/></mxCell>
<mxCell id="ipc" value='&lt;b&gt;Local pub/sub (IPC)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;all components talk here,&lt;br&gt;no cloud round trip&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#7AA116;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="220" y="270" width="220" height="78" as="geometry"/></mxCell>
<mxCell id="ipc_i" value="&lt;b&gt;&lt;/b&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=none;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.iot_greengrass_interprocess_communication;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="400" y="308" width="32" height="32" as="geometry"/></mxCell>
<mxCell id="logic" value='&lt;b&gt;Case-temperature logic&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;alarm if &amp;gt; -15 °C for 15 min,&lt;br&gt;starts defrost lockout&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#7AA116;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="220" y="400" width="220" height="78" as="geometry"/></mxCell>
<mxCell id="logic_i" value="&lt;b&gt;&lt;/b&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=none;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.iot_greengrass_component;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="400" y="438" width="32" height="32" as="geometry"/></mxCell>
<mxCell id="stream" value='&lt;b&gt;Stream manager&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;4 GB disk stream, 7 days,&lt;br&gt;exports in order to Kinesis&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#7AA116;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="500" y="140" width="220" height="78" as="geometry"/></mxCell>
<mxCell id="stream_i" value="&lt;b&gt;&lt;/b&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=none;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.iot_greengrass_stream_manager;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="680" y="178" width="32" height="32" as="geometry"/></mxCell>
<mxCell id="shadowm" value='&lt;b&gt;Shadow manager&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;local setpoint shadows,&lt;br&gt;synced on reconnect&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#7AA116;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="500" y="270" width="220" height="78" as="geometry"/></mxCell>
<mxCell id="shadowm_i" value="&lt;b&gt;&lt;/b&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=none;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.shadow;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="680" y="308" width="32" height="32" as="geometry"/></mxCell>
<mxCell id="spool" value='&lt;b&gt;Nucleus + disk spooler&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;QoS 1 alarms kept on disk&lt;br&gt;until IoT Core PUBACKs&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#7AA116;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="500" y="400" width="220" height="78" as="geometry"/></mxCell>
