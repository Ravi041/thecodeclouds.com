<mxfile host="thecodeclouds.com" agent="hand-built" version="24.0.0" type="device">
<diagram id="identity" name="2. Device identity and fleet provisioning"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="910" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Device identity: from the factory line to a unique X.509 certificate, with fleet provisioning by claim and a pre-provisioning hook" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1450" height="24" as="geometry"/></mxCell>
<mxCell id="fac" value="&lt;b&gt;Factory&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#545B64;fillColor=#F7F8FA;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="310" height="330" as="geometry"/></mxCell>
<mxCell id="factory" value='&lt;b&gt;Contract manufacturer&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;end-of-line test station&lt;/font&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#545B64;strokeColor=none;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.factory;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="46" height="46" as="geometry"/></mxCell>
<mxCell id="c3" value="1. Secure element on the controller&lt;br&gt;    generates the key pair. The private&lt;br&gt;    key never leaves the chip.&lt;br&gt;2. Station records serial + public-key&lt;br&gt;    hash + batch ID.&lt;br&gt;3. Firmware ships with a claim certificate&lt;br&gt;    shared by one production batch&lt;br&gt;    (about 20,000 units).&lt;br&gt;4. Batch manifest is signed and uploaded&lt;br&gt;    before the units leave the factory." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="170" width="290" height="152" as="geometry"/></mxCell>
<mxCell id="dev" value="&lt;b&gt;Heat pump, first boot at the customer&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#7AA116;fillColor=#F5F9EC;dashed=0;fontSize=12;fontStyle=0;fontColor=#3B5E0A;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="310" height="200" as="geometry"/></mxCell>
<mxCell id="hp" value='&lt;b&gt;Controller&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;claim cert in flash,&lt;br&gt;device key in secure element&lt;/font&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=none;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.iot_thing_freertos_device;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="40" y="465" width="46" height="46" as="geometry"/></mxCell>
<mxCell id="c5" value="After step 6 it reconnects with its own&lt;br&gt;certificate; client ID = thing name.&lt;br&gt;The claim cert is never used again." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="552" width="290" height="47" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;eu-central-1 (same in us-east-1)&lt;/b&gt;" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=1;" vertex="1" parent="1"><mxGeometry x="360" y="60" width="1120" height="570" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;AWS IoT Core&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#7AA116;fillColor=#F5F9EC;dashed=0;fontSize=12;fontStyle=0;fontColor=#3B5E0A;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="100" width="520" height="510" as="geometry"/></mxCell>
<mxCell id="gw" value='&lt;b&gt;Device gateway&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;claim cert can only use the&lt;br&gt;$aws/certificates and&lt;br&gt;$aws/provisioning-templates topics&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.iot_core;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="400" y="136" width="46" height="46" as="geometry"/></mxCell>
<mxCell id="csr" value='&lt;b&gt;CreateCertificateFromCsr&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;signs the device CSR, returns the&lt;br&gt;certificate + an ownership token&lt;/font&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=none;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.iot_certificate;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="403" y="255" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="reg" value='&lt;b&gt;RegisterThing&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;provisioning template hp-prod-eu&lt;/font&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=none;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.iot_device_management_fleet;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="403" y="365" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="registry" value='&lt;b&gt;Registry&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;thing hp-&amp;lt;serial&amp;gt;, cert ACTIVE,&lt;br&gt;policy hp-device, group eu/heatpump&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.iot_device_management;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="400" y="470" width="46" height="46" as="geometry"/></mxCell>
<mxCell id="c8" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7AA116;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="csr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c9" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7AA116;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="csr" target="reg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c10" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7AA116;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="reg" target="registry"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="hook" value='&lt;b&gt;Pre-provisioning hook&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;serial on the list? not yet&lt;br&gt;claimed? batch not revoked?&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="980" y="360" width="52" height="52" as="geometry"/></mxCell>
<mxCell id="ddb" value='&lt;b&gt;DynamoDB allow-list&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;one row per serial,&lt;br&gt;conditional write "claimed"&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1240" y="360" width="52" height="52" as="geometry"/></mxCell>
<mxCell id="s3" value='&lt;b&gt;S3 batch manifests&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;signed per production batch&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1240" y="150" width="52" height="52" as="geometry"/></mxCell>
<mxCell id="c11" style="edgeStyle=none;html=1;rounded=0;strokeColor=#ED7100;strokeWidth=1.5;dashed=0;startArrow=block;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="386" as="sourcePoint"/><mxPoint x="980" y="386" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c12" value="allowProvisioning?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#ED7100;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="760" y="366" width="160" height="17" as="geometry"/></mxCell>
<mxCell id="c13" style="edgeStyle=none;html=1;rounded=0;strokeColor=#C925D1;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="hook" target="ddb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c14" style="edgeStyle=none;html=1;rounded=0;strokeColor=#C925D1;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="ddb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1380" y="176"/><mxPoint x="1380" y="386"/></Array></mxGeometry></mxCell>
<mxCell id="c15" value="import Lambda on&lt;br&gt;S3 object created" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1388" y="260" width="140" height="32" as="geometry"/></mxCell>
<mxCell id="c16" style="edgeStyle=none;html=1;rounded=0;strokeColor=#545B64;strokeWidth=1.5;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fac" target="s3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="345" y="109.5"/><mxPoint x="345" y="90"/><mxPoint x="1266" y="90"/></Array></mxGeometry></mxCell>
<mxCell id="defender" value='&lt;b&gt;Device Defender&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;audit: shared or expiring certs,&lt;br&gt;loose policies; Detect: anomalies&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.iot_device_defender;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="980" y="510" width="46" height="46" as="geometry"/></mxCell>
<mxCell id="c17" style="edgeStyle=none;html=1;rounded=0;strokeColor=#DD344C;strokeWidth=1.5;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="980" y="533" as="sourcePoint"/><mxPoint x="700" y="493" as="targetPoint"/><Array as="points"><mxPoint x="940" y="533"/><mxPoint x="940" y="493"/></Array></mxGeometry></mxCell>
<mxCell id="c18" value="quarantine group,&lt;br&gt;cert INACTIVE" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#DD344C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="790" y="505" width="140" height="32" as="geometry"/></mxCell>
<mxCell id="c19" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7AA116;strokeWidth=2.5;dashed=0;startArrow=block;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev" target="gw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="345" y="460"/><mxPoint x="345" y="159"/></Array></mxGeometry></mxCell>
<mxCell id="c20" value="MQTT over mTLS" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#7AA116;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="230" y="400" width="120" height="17" as="geometry"/></mxCell>
<mxCell id="c21" value="1" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="320" y="84" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c22" value="2" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="370" y="140" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c23" value="3" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="373" y="260" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c24" value="4" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="373" y="370" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c25" value="5" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="950" y="330" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c26" value="6" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="373" y="474" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c27" value="&lt;b&gt;Steps&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#232F3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="360" y="650" width="560" height="245" as="geometry"/></mxCell>
<mxCell id="c28" value='1  Factory uploads the batch manifest; an import Lambda loads&lt;br&gt;    one allow-list row per serial.&lt;br&gt;2  Device connects with the batch claim certificate.&lt;br&gt;3  Device sends a CSR; IoT Core returns a unique certificate&lt;br&gt;    and a certificateOwnershipToken.&lt;br&gt;4  Device publishes RegisterThing with the token and its serial.&lt;br&gt;5  Hook checks the allow-list and marks the serial "claimed"&lt;br&gt;    with a conditional write, so a serial can register only once.&lt;br&gt;6  Template creates the thing, activates the cert, attaches the&lt;br&gt;    policy and adds the thing group. Device reconnects as itself.' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="374" y="678" width="540" height="152" as="geometry"/></mxCell>
<mxCell id="c29" value="&lt;b&gt;Device policy hp-device (policy variables, one policy for all 1M things)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#DD344C;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#DD344C;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="940" y="650" width="540" height="245" as="geometry"/></mxCell>
<mxCell id="c30" value="iot:Connect     client/${iot:Connection.Thing.ThingName}&lt;br&gt;                     only if iot:Connection.Thing.IsAttached = true&lt;br&gt;iot:Publish      topic/$aws/rules/telemetry/hp/${iot:Connection.Thing.ThingName}/telemetry&lt;br&gt;                     topic/hp/${iot:Connection.Thing.ThingName}/alarm&lt;br&gt;iot:Subscribe   $aws/things/${iot:Connection.Thing.ThingName}/shadow/name/config/*&lt;br&gt;iot:Receive      $aws/things/${iot:Connection.Thing.ThingName}/jobs/*&lt;br&gt;&lt;br&gt;No wildcard publish, no other thing's topics, no iot:UpdateThingShadow on&lt;br&gt;anyone else. A stolen device can only ever speak as itself." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="954" y="678" width="520" height="137" as="geometry"/></mxCell>
<mxCell id="c31" value="&lt;b&gt;Option B: JITP with your own CA&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#545B64;fillColor=#F7F8FA;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="650" width="310" height="245" as="geometry"/></mxCell>
<mxCell id="c32" value="If the chip vendor or your factory PKI&lt;br&gt;signs a unique device certificate at&lt;br&gt;manufacture, register that CA with IoT Core&lt;br&gt;(or AWS Private CA) and attach a&lt;br&gt;provisioning template to it. The first&lt;br&gt;connection auto-creates the thing.&lt;br&gt;No claim certificate exists at all, which&lt;br&gt;is the stronger option when your supply&lt;br&gt;chain can support it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="34" y="680" width="290" height="137" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
