<mxCell id="c37" value="R1  devices publish to $aws/rules/telemetry/hp/&amp;lt;thing&amp;gt;/telemetry&lt;br&gt;      SELECT *, topic(2) AS thing FROM 'hp/+/telemetry'&lt;br&gt;      → Kinesis, partition key ${topic(2)}&lt;br&gt;R2  SELECT * FROM 'hp/+/alarm' WHERE severity &amp;gt;= 2&lt;br&gt;      → SQS&lt;br&gt;R3  SELECT * FROM '$aws/events/presence/+/+'&lt;br&gt;      → Lambda (out-of-order safe)&lt;br&gt;Every rule: error action → S3" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="882" y="758" width="395" height="122" as="geometry"/></mxCell>
