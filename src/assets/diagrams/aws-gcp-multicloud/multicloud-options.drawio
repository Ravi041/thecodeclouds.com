<mxCell id="c31" value="Managed by AWS and Google: MACsec, 4-way redundant" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=12;fontColor=#1E8E3E;fontStyle=1;spacing=0;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="560" y="700" width="380" height="18" as="geometry"/></mxCell>
<mxCell id="c32" value="No routers, no cross-connects. 1 to 100 Gbps, resize in place.&lt;br&gt;Hourly price per bandwidth, no per-GB transfer charge.&lt;br&gt;Same-metro region pairs only (5 pairs at GA, April 2026)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="470" y="760" width="560" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
