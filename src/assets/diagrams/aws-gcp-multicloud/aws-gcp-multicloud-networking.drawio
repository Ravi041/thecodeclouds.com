<mxCell id="c12" value="4 IPsec tunnels, BGP over each" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=12;fontColor=#E8710A;fontStyle=1;spacing=0;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="600" y="142" width="300" height="18" as="geometry"/></mxCell>
<mxCell id="c13" value="Up in an afternoon. Encrypted. Internet egress pricing.&lt;br&gt;About 1.25 Gbps per tunnel on the AWS side, ~5 Gbps with ECMP.&lt;br&gt;Use it for: a first link, low volume, or the backup path." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="470" y="220" width="560" height="50" as="geometry"/></mxCell>
