<mxCell id="colo" value='&lt;b&gt;Colocation / cloud exchange&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;(your routers, or a fabric such as Equinix or Megaport)&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#5A6C86;fillColor=#F7F8FA;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="560" y="380" width="380" height="100" as="geometry"/></mxCell>
