<mxCell id="c22" value="registry: status = ACTIVE; billing, metering and&lt;br&gt;dashboards subscribe to the same event" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1150" y="370" width="320" height="32" as="geometry"/></mxCell>
<mxCell id="c23" value="Offboarding is the same machine in reverse: suspend, export data for the customer,&lt;br&gt;wait the contractual retention period, then delete data, keys and (silo) close the account." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="395" width="900" height="34" as="geometry"/></mxCell>
