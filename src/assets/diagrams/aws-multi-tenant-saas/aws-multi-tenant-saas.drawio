<diagram id="onboarding-metering" name="4. Onboarding automation and per-tenant metering"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Onboarding is one workflow with two paths, and metering joins usage events with the AWS bill to give cost per tenant" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1460" height="24" as="geometry"/></mxCell>
<mxCell id="c2" value="&lt;b&gt;Onboarding (control plane account)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#E7157B;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#E7157B;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="55" width="1460" height="400" as="geometry"/></mxCell>
