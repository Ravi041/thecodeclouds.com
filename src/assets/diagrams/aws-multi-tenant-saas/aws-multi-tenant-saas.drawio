<mxCell id="st1" value="1. Tenant record&lt;br&gt;registry: status = PROVISIONING" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#E7157B;fillColor=#FFF5FA;fontColor=#232F3E;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="470" y="100" width="190" height="64" as="geometry"/></mxCell>
<mxCell id="st2" value="2. Identity&lt;br&gt;Cognito group or SAML IdP,&lt;br&gt;first admin user" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#E7157B;fillColor=#FFF5FA;fontColor=#232F3E;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="680" y="100" width="190" height="64" as="geometry"/></mxCell>
