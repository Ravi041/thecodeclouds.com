<mxCell id="c14" value="Enterprise: silo path, about 90 minutes, no human steps" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#DD344C;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="510" y="230" width="420" height="18" as="geometry"/></mxCell>
