<mxCell id="c11" value="Basic / Pro: pool path, about 40 seconds" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#E7157B;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1020" y="80" width="320" height="18" as="geometry"/></mxCell>
<mxCell id="pool" value="3a. API key + usage plan&lt;br&gt;4a. Pro only: database, KMS key,&lt;br&gt;      pro-&amp;lt;tenant&amp;gt; namespace via GitOps&lt;br&gt;5a. Seed config in AppConfig" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#E7157B;fillColor=#FFF5FA;fontColor=#232F3E;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1020" y="100" width="300" height="84" as="geometry"/></mxCell>
