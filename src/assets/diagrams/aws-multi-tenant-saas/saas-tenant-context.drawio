<mxCell id="c2" value="ID token (JWT)&lt;br&gt;sub = 7f3c...&lt;br&gt;custom:tenant_id = t-4821&lt;br&gt;custom:tier = pro&lt;br&gt;read-only to app clients" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#DD344C;fillColor=#FFF7F8;fontColor=#DD344C;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="360" y="92" width="200" height="96" as="geometry"/></mxCell>
