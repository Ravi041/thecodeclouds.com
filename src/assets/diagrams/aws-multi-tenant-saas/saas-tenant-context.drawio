<mxCell id="c22" value="app DB role: no BYPASSRLS,&lt;br&gt;not table owner, FORCE RLS" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;fontSize=11;fontColor=#C925D1;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="900" y="440" width="210" height="32" as="geometry"/></mxCell>
<mxCell id="c23" value="&lt;b&gt;When the code has a bug&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#DD344C;fillColor=#FFF7F8;dashed=0;fontSize=12;fontStyle=0;fontColor=#DD344C;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="715" width="700" height="120" as="geometry"/></mxCell>
<mxCell id="c24" value="A missing filter asks for PK = TENANT#t-1007 with t-4821 credentials.&lt;br&gt;DynamoDB returns AccessDeniedException, nothing leaks. The 403 is counted&lt;br&gt;as CrossTenantDenied (EMF metric). Any value above 0 pages security,&lt;br&gt;because it is either a bug or someone probing." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="56" y="745" width="680" height="66" as="geometry"/></mxCell>
<mxCell id="c25" value="&lt;b&gt;Every hop records the tenant&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#E7157B;fillColor=#FFF5FA;dashed=0;fontSize=12;fontStyle=0;fontColor=#E7157B;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="770" y="715" width="690" height="120" as="geometry"/></mxCell>
