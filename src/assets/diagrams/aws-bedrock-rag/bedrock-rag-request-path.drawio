<mxfile host="thecodeclouds.com" agent="hand-built" version="24.0.0" type="device">
<diagram id="request" name="One question, end to end, with a latency budget"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="One question, end to end: what happens in the 1.5 seconds before the first word" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1540" height="28" as="geometry"/></mxCell>
<mxCell id="c2" value="p95 latency budget per step for the agent console (streamed). The customer portal adds a full-response grounding check before it shows the answer." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1540" height="19" as="geometry"/></mxCell>
