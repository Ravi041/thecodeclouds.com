<mxCell id="c25" value="Generate" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1098" y="134" width="182" height="21" as="geometry"/></mxCell>
<mxCell id="c26" value="Converse (stream) via EU&lt;br&gt;inference profile. Cached system&lt;br&gt;prompt + 6 chunks + last 3 turns.&lt;br&gt;Answer must cite chunk ids." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1070" y="176" width="208" height="66" as="geometry"/></mxCell>
<mxCell id="c27" value="TTFT 900 ms" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#E8F0FE;fontColor=#1A73E8;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1096" y="272" width="152" height="36" as="geometry"/></mxCell>
