<mxCell id="c11" value="ApplyGuardrail on the question:&lt;br&gt;prompt attack, denied topics,&lt;br&gt;PII mask. Blocked = canned reply,&lt;br&gt;no retrieval, no model call." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="308" y="176" width="208" height="66" as="geometry"/></mxCell>
