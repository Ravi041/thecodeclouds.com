<mxCell id="c5" value="Auth + filter" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="82" y="134" width="182" height="21" as="geometry"/></mxCell>
<mxCell id="c6" value="ALB validates the Cognito token.&lt;br&gt;Orchestrator reads tenant_id,&lt;br&gt;role, product entitlements and&lt;br&gt;builds the metadata filter." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="54" y="176" width="208" height="66" as="geometry"/></mxCell>
