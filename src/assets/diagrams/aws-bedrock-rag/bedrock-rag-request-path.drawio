<mxCell id="s1" value="" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeColor=#7D8998;fillColor=#FFFFFF;fontColor=#202124;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="294" y="120" width="232" height="210" as="geometry"/></mxCell>
