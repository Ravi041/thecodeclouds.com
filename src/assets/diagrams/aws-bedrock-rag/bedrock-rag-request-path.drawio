<mxCell id="c20" value="Rerank" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="844" y="134" width="182" height="21" as="geometry"/></mxCell>
<mxCell id="c21" value="Cohere Rerank 3.5 keeps the&lt;br&gt;best 6 chunks. Orchestrator&lt;br&gt;asserts every chunk tenant_id&lt;br&gt;is allowed (drop + alarm if not)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="816" y="176" width="208" height="66" as="geometry"/></mxCell>
