<mxCell id="c30" value="Check + log" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1352" y="134" width="182" height="21" as="geometry"/></mxCell>
<mxCell id="c31" value="Contextual grounding on the&lt;br&gt;full answer (threshold 0.75).&lt;br&gt;Log ids, scores, tokens and&lt;br&gt;latency. Store turn in DynamoDB." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1324" y="176" width="208" height="66" as="geometry"/></mxCell>
