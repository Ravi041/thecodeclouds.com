<mxCell id="c41" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1E8E3E;strokeWidth=2;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1400" y="440" as="sourcePoint"/><mxPoint x="1300" y="362" as="targetPoint"/><Array as="points"><mxPoint x="1400" y="362"/></Array></mxGeometry></mxCell>
<mxCell id="c42" value="write back:&lt;br&gt;soft 300 s,&lt;br&gt;hard 900 s,&lt;br&gt;±10% jitter" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#1E8E3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1306" y="372" width="90" height="58" as="geometry"/></mxCell>
<mxCell id="c43" style="edgeStyle=none;html=1;rounded=0;strokeColor=#5F6368;strokeWidth=2;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="362" as="sourcePoint"/><mxPoint x="960" y="252" as="targetPoint"/><Array as="points"><mxPoint x="900" y="362"/><mxPoint x="900" y="252"/></Array></mxGeometry></mxCell>
<mxCell id="c44" value="losers return&lt;br&gt;the stale value" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="800" y="290" width="96" height="30" as="geometry"/></mxCell>
<mxCell id="c45" value="Shoppers see a price that is at most a few seconds old.&lt;br&gt;The database sees one query per key per refresh." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="800" y="540" width="660" height="34" as="geometry"/></mxCell>
<mxCell id="c46" value="Result: p99 stays at 45 ms through the expiry." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1E8E3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="800" y="596" width="660" height="18" as="geometry"/></mxCell>
<mxCell id="t1" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="284" height="84" as="geometry"/></mxCell>
<mxCell id="c48" value="Jittered TTL" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="668" width="268" height="18" as="geometry"/></mxCell>
<mxCell id="c49" value="TTL ± 10% so keys loaded together&lt;br&gt;do not expire together" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="686" width="268" height="30" as="geometry"/></mxCell>
<mxCell id="t2" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="314" y="660" width="284" height="84" as="geometry"/></mxCell>
<mxCell id="c51" value="Single-flight lock" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="324" y="668" width="268" height="18" as="geometry"/></mxCell>
<mxCell id="c52" value="SET NX PX: one rebuild per key,&lt;br&gt;lock expires if the pod dies" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="324" y="686" width="268" height="30" as="geometry"/></mxCell>
<mxCell id="t3" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="608" y="660" width="284" height="84" as="geometry"/></mxCell>
<mxCell id="c54" value="Soft + hard TTL" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="618" y="668" width="268" height="18" as="geometry"/></mxCell>
<mxCell id="c55" value="serve stale while one caller&lt;br&gt;refreshes in the background" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="618" y="686" width="268" height="30" as="geometry"/></mxCell>
<mxCell id="t4" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="902" y="660" width="284" height="84" as="geometry"/></mxCell>
<mxCell id="c57" value="L1 for hot keys" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="912" y="668" width="268" height="18" as="geometry"/></mxCell>
<mxCell id="c58" value="1-5 s in-process copy cuts Redis&lt;br&gt;reads by 100x on the top 50 keys" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="912" y="686" width="268" height="30" as="geometry"/></mxCell>
<mxCell id="t5" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1196" y="660" width="284" height="84" as="geometry"/></mxCell>
<mxCell id="c60" value="Pre-warm" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1206" y="668" width="268" height="18" as="geometry"/></mxCell>
<mxCell id="c61" value="load the sale keys at T-10 min,&lt;br&gt;never let them expire mid-sale" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1206" y="686" width="268" height="30" as="geometry"/></mxCell>
<mxCell id="c62" value="Use all five for the keys that matter. For the long tail, jitter alone is usually enough." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="768" width="1460" height="18" as="geometry"/></mxCell>
<mxCell id="c63" value="Locks are best-effort here: if two callers rebuild once in a while that is fine. Never use this lock pattern for money or stock." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="794" width="1460" height="17" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
