<mxCell id="c32" value="SET lock:deal:homepage NX PX 3000" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="970" y="448" width="324" height="18" as="geometry"/></mxCell>
<mxCell id="c33" value="one caller wins" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="970" y="466" width="324" height="16" as="geometry"/></mxCell>
