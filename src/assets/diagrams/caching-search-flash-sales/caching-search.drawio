<mxCell id="c43" value='query the read alias "products"' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1A73E8;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="640" y="258" width="300" height="17" as="geometry"/></mxCell>
<mxCell id="c44" value="hydrate the live fields" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#1A73E8;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="760" y="350" width="240" height="17" as="geometry"/></mxCell>
<mxCell id="c45" value="6" style="ellipse;html=1;fillColor=#1A73E8;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="360" y="371" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c46" value="7" style="ellipse;html=1;fillColor=#1A73E8;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1000" y="269" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c47" value="8" style="ellipse;html=1;fillColor=#1A73E8;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="860" y="371" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c48" value="Write path (green): 1 seller saves, 2 outbox row commits with the change, 3 CDC publishes it, 4 ordered per product, 5 bulk indexed.&lt;br&gt;Read path (blue): 6 query arrives, 7 search returns ids and facets, 8 price and stock come from the cache, not the index." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="456" width="1460" height="34" as="geometry"/></mxCell>
<mxCell id="c49" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#E37400;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="460" height="150" as="geometry"/></mxCell>
<mxCell id="c50" style="edgeStyle=none;html=1;rounded=0;strokeColor=#E37400;strokeWidth=5;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="524" as="sourcePoint"/><mxPoint x="20" y="666" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c51" value="Measure lag, do not guess it" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#E37400;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="34" y="530" width="436" height="19" as="geometry"/></mxCell>
<mxCell id="c52" value="Every event carries updated_at from the database.&lt;br&gt;The indexer publishes now - updated_at as a metric.&lt;br&gt;Normal: 1-3 s. Alert at 30 s, page at 5 min.&lt;br&gt;Also watch consumer lag on the stream: if it&lt;br&gt;grows while workers are healthy, add partitions&lt;br&gt;or bulk size, not more retries." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="34" y="554" width="436" height="92" as="geometry"/></mxCell>
<mxCell id="c53" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#8430CE;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="520" y="520" width="460" height="150" as="geometry"/></mxCell>
<mxCell id="c54" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8430CE;strokeWidth=5;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="524" as="sourcePoint"/><mxPoint x="520" y="666" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c55" value="Reindex with zero downtime" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#8430CE;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="534" y="530" width="436" height="19" as="geometry"/></mxCell>
<mxCell id="c56" value="1  Create products_v8 with the new mapping.&lt;br&gt;2  Point the write alias at both v7 and v8,&lt;br&gt;    or replay the stream from a snapshot offset.&lt;br&gt;3  Backfill v8 from the database.&lt;br&gt;4  Compare counts and run saved queries.&lt;br&gt;5  Swap the read alias in one atomic call.&lt;br&gt;6  Keep v7 for a day, then delete it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="534" y="554" width="436" height="107" as="geometry"/></mxCell>
<mxCell id="c57" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1020" y="520" width="460" height="150" as="geometry"/></mxCell>
<mxCell id="c58" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1A73E8;strokeWidth=5;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="524" as="sourcePoint"/><mxPoint x="1020" y="666" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c59" value="Read your own writes" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#1A73E8;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1034" y="530" width="436" height="19" as="geometry"/></mxCell>
<mxCell id="c60" value="A seller changes a price and searches for it at&lt;br&gt;once. The index is 2 s behind, so they see the&lt;br&gt;old price and open a ticket.&lt;br&gt;Fix: for 60 s after a seller edit, show that&lt;br&gt;seller their products from the database, and&lt;br&gt;show shoppers price from the cache, which the&lt;br&gt;write path updates directly." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1034" y="554" width="436" height="107" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
