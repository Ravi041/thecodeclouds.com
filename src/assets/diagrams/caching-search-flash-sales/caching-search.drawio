<mxCell id="c36" value="query + facets,&lt;br&gt;returns product ids" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="532" y="366" width="189" height="30" as="geometry"/></mxCell>
