<mxCell id="c17" value="bulk 1,000 docs or 1 s,&lt;br&gt;skip older versions" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1034" y="136" width="189" height="30" as="geometry"/></mxCell>
