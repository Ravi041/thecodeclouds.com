<mxCell id="c58" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="470" width="700" height="200" as="geometry"/></mxCell>
<mxCell id="c59" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1A73E8;strokeWidth=5;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="474" as="sourcePoint"/><mxPoint x="20" y="666" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c60" value="What happens to one shopper" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#1A73E8;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="34" y="480" width="676" height="19" as="geometry"/></mxCell>
<mxCell id="c61" value='1  Page and assets come from the CDN. The origin is not involved.&lt;br&gt;2  Pressing Buy puts them in the waiting room queue, first come first served.&lt;br&gt;3  Their turn: a signed token admits them through the gateway.&lt;br&gt;4  Gateway checks the token and the per-user limit, then forwards.&lt;br&gt;5  Redis reserves 1 unit atomically, or says sold out. No database touched.&lt;br&gt;6  Reservation written to the queue with an order id. Shopper sees "reserved".&lt;br&gt;7  Workers pull at a fixed rate the database can take.&lt;br&gt;8  One transaction: order row + ledger row. Retries are safe (same order id).&lt;br&gt;9  Payment is captured. Failure releases the unit.&lt;br&gt;10 Unpaid reservations expire and the unit goes back on sale.' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="34" y="504" width="676" height="152" as="geometry"/></mxCell>
<mxCell id="c62" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#E37400;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="740" y="470" width="740" height="150" as="geometry"/></mxCell>
<mxCell id="c63" style="edgeStyle=none;html=1;rounded=0;strokeColor=#E37400;strokeWidth=5;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="474" as="sourcePoint"/><mxPoint x="740" y="616" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c64" value="Sizing from the scenario" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#E37400;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="754" y="480" width="716" height="19" as="geometry"/></mxCell>
<mxCell id="c65" value="Normal day: 4,000 req/s, Redis 30k ops/s, 2 orders/s&lt;br&gt;Sale peak: 45,000 req/s at the edge (11x)&lt;br&gt;After edge + bot filtering: 21,000 req/s reach the waiting room&lt;br&gt;Admitted: 3,000 shoppers/s (about 9,000 req/s)&lt;br&gt;Redis inventory: one key per SKU, ~12k reserve calls/s&lt;br&gt;Database: 1,500 order writes/s, never more&lt;br&gt;Sold out: 8,000 units in 7 min 40 s, 0 oversold" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="754" y="504" width="716" height="107" as="geometry"/></mxCell>
<mxCell id="c66" value="The database sees a flat line. The spike lives in the CDN, the waiting room and the queue." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="740" y="636" width="740" height="18" as="geometry"/></mxCell>
<mxCell id="c67" value="Numbers are from a load-test plan for a mid-size retailer; use your own forecast." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="740" y="660" width="740" height="17" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="stampede" name="3. Cache stampede"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Cache stampede: one key expires at 12:00:00 and 8,000 requests hit the database at once" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1400" height="24" as="geometry"/></mxCell>
<mxCell id="c2" value="Same traffic, same Redis, same database. The difference is what happens on a miss." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1400" height="18" as="geometry"/></mxCell>
<mxCell id="c3" value="&lt;b&gt;Before: plain cache-aside, fixed TTL&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#D93025;fillColor=#FFF8F7;dashed=0;fontSize=12;fontStyle=0;fontColor=#D93025;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="700" height="560" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;b&gt;After: soft TTL, one rebuilder, everyone else served stale&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#F6FBF7;dashed=0;fontSize=12;fontStyle=0;fontColor=#1E8E3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="780" y="70" width="700" height="560" as="geometry"/></mxCell>
<mxCell id="r1" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#5F6368;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="200" y="110" width="340" height="64" as="geometry"/></mxCell>
<mxCell id="c6" value="8,000 req/s for the homepage deal" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="210" y="118" width="324" height="18" as="geometry"/></mxCell>
<mxCell id="c7" value="key: deal:homepage" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="210" y="136" width="324" height="16" as="geometry"/></mxCell>
<mxCell id="p1" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="200" y="220" width="340" height="64" as="geometry"/></mxCell>
<mxCell id="c9" value="App pods (40)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="210" y="228" width="324" height="18" as="geometry"/></mxCell>
<mxCell id="c10" value="no local cache" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="210" y="246" width="324" height="16" as="geometry"/></mxCell>
<mxCell id="c1" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#8430CE;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="200" y="330" width="340" height="64" as="geometry"/></mxCell>
<mxCell id="c12" value="Redis: MISS on every request" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="210" y="338" width="324" height="18" as="geometry"/></mxCell>
<mxCell id="c13" value="TTL was exactly 300 s for all deal keys" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="210" y="356" width="324" height="16" as="geometry"/></mxCell>
<mxCell id="d1" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#D93025;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="200" y="440" width="340" height="64" as="geometry"/></mxCell>
<mxCell id="c15" value="Database: 8,000 identical queries" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="210" y="448" width="324" height="18" as="geometry"/></mxCell>
<mxCell id="c16" value="CPU 100%, p99 from 40 ms to 4.2 s" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="210" y="466" width="324" height="16" as="geometry"/></mxCell>
<mxCell id="c17" style="edgeStyle=none;html=1;rounded=0;strokeColor=#D93025;strokeWidth=4;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r1" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c18" style="edgeStyle=none;html=1;rounded=0;strokeColor=#D93025;strokeWidth=4;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="c1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c19" style="edgeStyle=none;html=1;rounded=0;strokeColor=#D93025;strokeWidth=4;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c20" value="Every request misses at the same instant,&lt;br&gt;every request rebuilds the same value,&lt;br&gt;and the slow database makes the window longer." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="660" height="50" as="geometry"/></mxCell>
<mxCell id="c21" value="Result: checkout times out, retries add more load." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#D93025;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="596" width="660" height="18" as="geometry"/></mxCell>
<mxCell id="r2" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#5F6368;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="960" y="110" width="340" height="64" as="geometry"/></mxCell>
<mxCell id="c23" value="8,000 req/s for the homepage deal" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="970" y="118" width="324" height="18" as="geometry"/></mxCell>
<mxCell id="c24" value="key: deal:homepage" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="970" y="136" width="324" height="16" as="geometry"/></mxCell>
<mxCell id="p2" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="960" y="220" width="340" height="64" as="geometry"/></mxCell>
<mxCell id="c26" value="App pods (40) with L1 cache" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="970" y="228" width="324" height="18" as="geometry"/></mxCell>
<mxCell id="c27" value="2 s in memory: Redis sees ~20 req/s" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="970" y="246" width="324" height="16" as="geometry"/></mxCell>
<mxCell id="c2" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#8430CE;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="960" y="330" width="340" height="64" as="geometry"/></mxCell>
<mxCell id="c29" value="Redis: soft TTL passed, hard TTL not" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="970" y="338" width="324" height="18" as="geometry"/></mxCell>
<mxCell id="c30" value='value returned + "stale" flag' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="970" y="356" width="324" height="16" as="geometry"/></mxCell>
<mxCell id="l2" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#E37400;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="960" y="440" width="340" height="64" as="geometry"/></mxCell>
<mxCell id="c32" value="SET lock:deal:homepage NX PX 3000" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="970" y="448" width="324" height="18" as="geometry"/></mxCell>
<mxCell id="c33" value="one caller wins" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="970" y="466" width="324" height="16" as="geometry"/></mxCell>
<mxCell id="d2" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1340" y="440" width="120" height="64" as="geometry"/></mxCell>
<mxCell id="c35" value="Database" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1350" y="448" width="104" height="18" as="geometry"/></mxCell>
<mxCell id="c36" value="1 query" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1350" y="466" width="104" height="16" as="geometry"/></mxCell>
<mxCell id="c37" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1E8E3E;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r2" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c38" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1E8E3E;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c39" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1E8E3E;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="l2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c40" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1E8E3E;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="l2" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c41" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1E8E3E;strokeWidth=2;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1400" y="440" as="sourcePoint"/><mxPoint x="1300" y="362" as="targetPoint"/><Array as="points"><mxPoint x="1400" y="362"/></Array></mxGeometry></mxCell>
<mxCell id="c42" value="write back:&lt;br&gt;soft 300 s,&lt;br&gt;hard 900 s,&lt;br&gt;±10% jitter" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#1E8E3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1306" y="372" width="90" height="58" as="geometry"/></mxCell>
<mxCell id="c43" style="edgeStyle=none;html=1;rounded=0;strokeColor=#5F6368;strokeWidth=2;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="362" as="sourcePoint"/><mxPoint x="960" y="252" as="targetPoint"/><Array as="points"><mxPoint x="900" y="362"/><mxPoint x="900" y="252"/></Array></mxGeometry></mxCell>
<mxCell id="c44" value="losers return&lt;br&gt;the stale value" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="800" y="290" width="96" height="30" as="geometry"/></mxCell>
<mxCell id="c45" value="Shoppers see a price that is at most a few seconds old.&lt;br&gt;The database sees one query per key per refresh." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="800" y="540" width="660" height="34" as="geometry"/></mxCell>
<mxCell id="c46" value="Result: p99 stays at 45 ms through the expiry." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1E8E3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="800" y="596" width="660" height="18" as="geometry"/></mxCell>
<mxCell id="t1" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="284" height="84" as="geometry"/></mxCell>
<mxCell id="c48" value="Jittered TTL" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="668" width="268" height="18" as="geometry"/></mxCell>
<mxCell id="c49" value="TTL ± 10% so keys loaded together&lt;br&gt;do not expire together" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="686" width="268" height="30" as="geometry"/></mxCell>
<mxCell id="t2" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="314" y="660" width="284" height="84" as="geometry"/></mxCell>
<mxCell id="c51" value="Single-flight lock" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="324" y="668" width="268" height="18" as="geometry"/></mxCell>
<mxCell id="c52" value="SET NX PX: one rebuild per key,&lt;br&gt;lock expires if the pod dies" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="324" y="686" width="268" height="30" as="geometry"/></mxCell>
<mxCell id="t3" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="608" y="660" width="284" height="84" as="geometry"/></mxCell>
<mxCell id="c54" value="Soft + hard TTL" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="618" y="668" width="268" height="18" as="geometry"/></mxCell>
<mxCell id="c55" value="serve stale while one caller&lt;br&gt;refreshes in the background" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="618" y="686" width="268" height="30" as="geometry"/></mxCell>
<mxCell id="t4" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="902" y="660" width="284" height="84" as="geometry"/></mxCell>
<mxCell id="c57" value="L1 for hot keys" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="912" y="668" width="268" height="18" as="geometry"/></mxCell>
<mxCell id="c58" value="1-5 s in-process copy cuts Redis&lt;br&gt;reads by 100x on the top 50 keys" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="912" y="686" width="268" height="30" as="geometry"/></mxCell>
<mxCell id="t5" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1196" y="660" width="284" height="84" as="geometry"/></mxCell>
<mxCell id="c60" value="Pre-warm" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1206" y="668" width="268" height="18" as="geometry"/></mxCell>
<mxCell id="c61" value="load the sale keys at T-10 min,&lt;br&gt;never let them expire mid-sale" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1206" y="686" width="268" height="30" as="geometry"/></mxCell>
<mxCell id="c62" value="Use all five for the keys that matter. For the long tail, jitter alone is usually enough." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="768" width="1460" height="18" as="geometry"/></mxCell>
<mxCell id="c63" value="Locks are best-effort here: if two callers rebuild once in a while that is fine. Never use this lock pattern for money or stock." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="794" width="1460" height="17" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="search" name="4. Search indexing pipeline"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Search: keep the index fresh without letting it decide price or stock" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1400" height="24" as="geometry"/></mxCell>
<mxCell id="c2" value="Writes go through an outbox and a stream, so the index catches up in seconds and can always be rebuilt from scratch." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1400" height="18" as="geometry"/></mxCell>
<mxCell id="cat" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="205" height="84" as="geometry"/></mxCell>
<mxCell id="c4" value="Catalog service" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="118" width="189" height="18" as="geometry"/></mxCell>
<mxCell id="c5" value="seller edits a product&lt;br&gt;or a price" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="136" width="189" height="30" as="geometry"/></mxCell>
<mxCell id="pdb" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#5F6368;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="271" y="110" width="205" height="84" as="geometry"/></mxCell>
<mxCell id="c7" value="Primary database" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="281" y="118" width="189" height="18" as="geometry"/></mxCell>
<mxCell id="c8" value="products + outbox row&lt;br&gt;in one transaction" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="281" y="136" width="189" height="30" as="geometry"/></mxCell>
