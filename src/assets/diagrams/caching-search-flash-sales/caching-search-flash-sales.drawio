<mxCell id="c42" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#E37400;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="610" width="700" height="120" as="geometry"/></mxCell>
<mxCell id="c43" style="edgeStyle=none;html=1;rounded=0;strokeColor=#E37400;strokeWidth=5;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="614" as="sourcePoint"/><mxPoint x="20" y="726" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c44" value="Token bucket in Redis, one key per user and route" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#E37400;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="34" y="620" width="676" height="19" as="geometry"/></mxCell>
<mxCell id="c45" value="key rl:{user42}:checkout  holds tokens + last refill time.&lt;br&gt;A Lua script refills at 5/s up to 10, takes 1 token or says no.&lt;br&gt;Atomic, one round trip, ~0.2 ms. Keys expire after 60 s idle." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="34" y="644" width="676" height="47" as="geometry"/></mxCell>
<mxCell id="c46" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#D93025;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="760" y="610" width="720" height="120" as="geometry"/></mxCell>
<mxCell id="c47" style="edgeStyle=none;html=1;rounded=0;strokeColor=#D93025;strokeWidth=5;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="614" as="sourcePoint"/><mxPoint x="760" y="726" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c48" value="Clients must back off, or the limit makes things worse" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#D93025;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="774" y="620" width="696" height="19" as="geometry"/></mxCell>
<mxCell id="c49" value="Honour Retry-After. Otherwise exponential backoff with full jitter:&lt;br&gt;sleep = random(0, min(cap, base x 2^attempt)). Cap retries at 3.&lt;br&gt;Without jitter every rejected client comes back in the same second." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="774" y="644" width="696" height="47" as="geometry"/></mxCell>
<mxCell id="c50" value="Rejected early is cheap. A request dropped at the edge costs a fraction of a cent; one that reaches the database costs a checkout." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="752" width="1460" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
