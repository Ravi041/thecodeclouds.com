<mxCell id="c52" value="5" style="ellipse;html=1;fillColor=#1A73E8;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1243" y="140" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c53" value="6" style="ellipse;html=1;fillColor=#1E8E3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1137" y="270" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c54" value="7" style="ellipse;html=1;fillColor=#1E8E3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="992" y="370" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c55" value="8" style="ellipse;html=1;fillColor=#1E8E3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="741" y="370" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c56" value="9" style="ellipse;html=1;fillColor=#1E8E3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="490" y="370" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c57" value="10" style="ellipse;html=1;fillColor=#8430CE;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1387" y="270" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c58" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="470" width="700" height="200" as="geometry"/></mxCell>
<mxCell id="c59" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1A73E8;strokeWidth=5;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="474" as="sourcePoint"/><mxPoint x="20" y="666" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c60" value="What happens to one shopper" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#1A73E8;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="34" y="480" width="676" height="19" as="geometry"/></mxCell>
<mxCell id="c61" value='1  Page and assets come from the CDN. The origin is not involved.&lt;br&gt;2  Pressing Buy puts them in the waiting room queue, first come first served.&lt;br&gt;3  Their turn: a signed token admits them through the gateway.&lt;br&gt;4  Gateway checks the token and the per-user limit, then forwards.&lt;br&gt;5  Redis reserves 1 unit atomically, or says sold out. No database touched.&lt;br&gt;6  Reservation written to the queue with an order id. Shopper sees "reserved".&lt;br&gt;7  Workers pull at a fixed rate the database can take.&lt;br&gt;8  One transaction: order row + ledger row. Retries are safe (same order id).&lt;br&gt;9  Payment is captured. Failure releases the unit.&lt;br&gt;10 Unpaid reservations expire and the unit goes back on sale.' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="34" y="504" width="676" height="152" as="geometry"/></mxCell>
<mxCell id="c62" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#E37400;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="740" y="470" width="740" height="150" as="geometry"/></mxCell>
<mxCell id="c63" style="edgeStyle=none;html=1;rounded=0;strokeColor=#E37400;strokeWidth=5;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="474" as="sourcePoint"/><mxPoint x="740" y="616" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c64" value="Sizing from the scenario" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#E37400;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="754" y="480" width="716" height="19" as="geometry"/></mxCell>
<mxCell id="c65" value="Normal day: 4,000 req/s, Redis 30k ops/s, 2 orders/s&lt;br&gt;Sale peak: 45,000 req/s at the edge (11x)&lt;br&gt;After edge + bot filtering: 21,000 req/s reach the waiting room&lt;br&gt;Admitted: 3,000 shoppers/s (about 9,000 req/s)&lt;br&gt;Redis inventory: one key per SKU, ~12k reserve calls/s&lt;br&gt;Database: 1,500 order writes/s, never more&lt;br&gt;Sold out: 8,000 units in 7 min 40 s, 0 oversold" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="754" y="504" width="716" height="107" as="geometry"/></mxCell>
<mxCell id="c66" value="The database sees a flat line. The spike lives in the CDN, the waiting room and the queue." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="740" y="636" width="740" height="18" as="geometry"/></mxCell>
<mxCell id="c67" value="Numbers are from a load-test plan for a mid-size retailer; use your own forecast." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="740" y="660" width="740" height="17" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
