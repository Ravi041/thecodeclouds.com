<mxCell id="c20" value="Lua: check + decrement&lt;br&gt;in one atomic step" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1285" y="136" width="189" height="30" as="geometry"/></mxCell>
