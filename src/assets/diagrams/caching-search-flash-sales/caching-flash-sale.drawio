<mxCell id="c26" value="orders + inventory ledger,&lt;br&gt;steady 1,500 writes/s" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="532" y="366" width="189" height="30" as="geometry"/></mxCell>
