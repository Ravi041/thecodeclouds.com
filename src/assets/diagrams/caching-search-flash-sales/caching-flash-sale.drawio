<mxCell id="c10" value="Waiting room" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="532" y="118" width="189" height="18" as="geometry"/></mxCell>
<mxCell id="c11" value="admits 3,000 shoppers/s,&lt;br&gt;issues a signed token" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="532" y="136" width="189" height="30" as="geometry"/></mxCell>
