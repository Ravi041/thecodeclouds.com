<mxCell id="c14" value="checks token, 5 req/s per&lt;br&gt;user, sheds non-checkout" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="783" y="136" width="189" height="30" as="geometry"/></mxCell>
