<mxCell id="c47" value='sold out: flag pushed to the edge, a cached "sold out" page replaces the buy button' style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#D93025;fontStyle=0;spacing=0;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="520" y="70" width="520" height="17" as="geometry"/></mxCell>
<mxCell id="c48" value="1" style="ellipse;html=1;fillColor=#1A73E8;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="239" y="140" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c49" value="2" style="ellipse;html=1;fillColor=#1A73E8;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="490" y="140" width="22" height="22" as="geometry"/></mxCell>
