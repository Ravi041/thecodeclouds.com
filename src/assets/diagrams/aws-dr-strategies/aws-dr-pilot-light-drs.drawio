<mxCell id="c26" value="Snapshots, ~9 TB, 7 days" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1214" y="140" width="180" height="18" as="geometry"/></mxCell>
