<mxCell id="c18" value="(or another AWS Region)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5A6C86;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="92" width="290" height="17" as="geometry"/></mxCell>
<mxCell id="c19" style="edgeStyle=none;html=1;rounded=0;strokeColor=#DD344C;strokeWidth=2;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="422" as="sourcePoint"/><mxPoint x="200" y="622" as="targetPoint"/><Array as="points"><mxPoint x="1180" y="422"/><mxPoint x="1180" y="640"/><mxPoint x="200" y="640"/></Array></mxGeometry></mxCell>
<mxCell id="c20" value="failback: replicate changes made during the disaster back to the source, then cut over in a quiet hour" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#DD344C;fontStyle=0;spacing=0;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="420" y="646" width="720" height="17" as="geometry"/></mxCell>
