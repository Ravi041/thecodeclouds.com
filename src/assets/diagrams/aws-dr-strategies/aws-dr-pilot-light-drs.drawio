<mxCell id="c6" value="&lt;b&gt;Staging area subnet (cheap, always on)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#7AA116;fillColor=#F6FAEE;dashed=0;fontSize=12;fontStyle=0;fontColor=#3F5E0B;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="440" y="230" width="330" height="350" as="geometry"/></mxCell>
<mxCell id="rep" value='&lt;b&gt;Replication servers&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;t3.small, 1 per 15 disks&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="470" y="280" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="ebs" value='&lt;b&gt;Staging EBS volumes&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;one per source disk&lt;br&gt;low-cost volume types&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_block_store;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="470" y="380" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="snap" value='&lt;b&gt;Point-in-time snapshots&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;every 10 min for the last hour,&lt;br&gt;then hourly, then daily (7 days)&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.snapshot;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="470" y="490" width="44" height="44" as="geometry"/></mxCell>
