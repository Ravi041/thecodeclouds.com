<mxCell id="s2" value='&lt;b&gt;SQL Server x4&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;2 TB data in total&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#5A6C86;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.traditional_server;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="50" y="360" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="c3" value="AWS Replication Agent on each&lt;br&gt;server: block-level, continuous,&lt;br&gt;compressed, encrypted in transit" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="480" width="290" height="50" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;b&gt;Recovery Region  us-east-2&lt;/b&gt;" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=1;" vertex="1" parent="1"><mxGeometry x="400" y="60" width="760" height="560" as="geometry"/></mxCell>
<mxCell id="drs" value='&lt;b&gt;Elastic Disaster Recovery&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;replication settings, launch settings,&lt;br&gt;drills, recovery jobs, failback&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudendure_disaster_recovery;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="430" y="100" width="48" height="48" as="geometry"/></mxCell>
