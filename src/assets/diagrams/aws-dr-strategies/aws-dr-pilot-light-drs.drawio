<mxCell id="c9" value="&lt;b&gt;Recovery subnet (empty until launch)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#ED7100;fillColor=#FFF8F0;dashed=0;fontSize=12;fontStyle=0;fontColor=#8A4300;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="790" y="230" width="330" height="350" as="geometry"/></mxCell>
<mxCell id="tmpl" value='&lt;b&gt;Launch templates&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;right-sized types, subnets,&lt;br&gt;security groups, tags&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#AAB7B8;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="820" y="280" width="44" height="44" as="geometry"/></mxCell>
