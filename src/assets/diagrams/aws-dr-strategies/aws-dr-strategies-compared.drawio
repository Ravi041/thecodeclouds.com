<mxCell id="c30" value="Total per month" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1214" y="188" width="180" height="18" as="geometry"/></mxCell>
<mxCell id="c31" value="~$1,975" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1390" y="188" width="76" height="18" as="geometry"/></mxCell>
<mxCell id="c32" value="A full copy of the 40 servers&lt;br&gt;running all month: about&lt;br&gt;$9,000 to $11,000.&lt;br&gt;&lt;br&gt;Prices: us-east-1 list prices,&lt;br&gt;Nov 2026. Check your Region." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1214" y="230" width="260" height="98" as="geometry"/></mxCell>
<mxCell id="c33" value="&lt;b&gt;Drill result (quarterly)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#ED7100;fillColor=#FFF8F0;dashed=0;fontSize=12;fontStyle=0;fontColor=#8A4300;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1200" y="410" width="280" height="210" as="geometry"/></mxCell>
<mxCell id="c34" value="Launch 40 drill instances: 11 min" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1214" y="442" width="260" height="18" as="geometry"/></mxCell>
<mxCell id="c35" value="Boot + app checks: 19 min" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1214" y="468" width="260" height="18" as="geometry"/></mxCell>
<mxCell id="c36" value="DNS switch, smoke tests: 6 min" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1214" y="494" width="260" height="18" as="geometry"/></mxCell>
<mxCell id="c37" value="Measured RTO: 36 min (target 1 h)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1214" y="520" width="260" height="18" as="geometry"/></mxCell>
<mxCell id="c38" value="RPO: under 1 min" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1214" y="546" width="260" height="18" as="geometry"/></mxCell>
<mxCell id="c39" value="Drill cost: about $45 for 8 h" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1214" y="572" width="260" height="18" as="geometry"/></mxCell>
<mxCell id="c40" value="&lt;b&gt;Pilot light, cloud-native version (no agents)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#147EBA;fillColor=#F2F8FC;dashed=0;fontSize=12;fontStyle=0;fontColor=#0B4F7A;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="690" width="1460" height="120" as="geometry"/></mxCell>
<mxCell id="c41" value="Data layer live in the recovery Region: Aurora Global Database secondary (headless or one small instance), DynamoDB global table replica, S3 replication.&lt;br&gt;Compute switched off: AMIs and container images replicated, Auto Scaling groups at desired = 0, EKS node groups at zero, Lambda functions deployed.&lt;br&gt;Recovery: promote the database, scale compute from 0 to production size, flip DNS or routing controls. The slowest step is usually waiting for capacity.&lt;br&gt;Pre-check: service quotas and On-Demand Capacity Reservations for the instance types you will need in the recovery Region." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="722" width="1430" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="dr-warm-standby-failover" name="4. Warm standby, Region switch and game days"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Warm standby on AWS: a small working copy, a scripted Region switch, and a game day every quarter" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="24" as="geometry"/></mxCell>
<mxCell id="users" value='&lt;b&gt;Customers&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;1,200 req/s peak&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.users;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="72" width="48" height="48" as="geometry"/></mxCell>
