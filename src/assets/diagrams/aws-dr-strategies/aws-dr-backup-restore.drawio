<mxCell id="c7" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7AA116;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="384" y="310" as="sourcePoint"/><mxPoint x="94" y="398" as="targetPoint"/><Array as="points"><mxPoint x="384" y="345"/><mxPoint x="94" y="345"/></Array></mxGeometry></mxCell>
<mxCell id="c8" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7AA116;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="529" y="310" as="sourcePoint"/><mxPoint x="94" y="398" as="targetPoint"/><Array as="points"><mxPoint x="529" y="345"/><mxPoint x="94" y="345"/></Array></mxGeometry></mxCell>
<mxCell id="c9" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7AA116;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="plan" target="vault1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c10" value="recovery points" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#7AA116;fontStyle=0;spacing=0;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="250" y="404" width="140" height="17" as="geometry"/></mxCell>
<mxCell id="cfn" value='&lt;b&gt;CloudFormation / Terraform&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;VPC, IAM, ASG, ALB as code&lt;br&gt;same templates for any Region&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudformation;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="70" y="560" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="restore" value='&lt;b&gt;Restore testing&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;weekly sample restore,&lt;br&gt;validation Lambda&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.backup_restore;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="360" y="560" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="c11" value="&lt;b&gt;Workload account, us-west-2 (recovery Region)&lt;/b&gt;" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=1;" vertex="1" parent="1"><mxGeometry x="720" y="140" width="360" height="260" as="geometry"/></mxCell>
<mxCell id="vault2" value='&lt;b&gt;Backup vault  dr-copy&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;multi-Region KMS key&lt;br&gt;daily copy, 35 days&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.backup_vault;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="760" y="210" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="c12" style="edgeStyle=none;html=1;rounded=0;strokeColor=#147EBA;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="vault1" target="vault2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="412"/><mxPoint x="690" y="234"/></Array></mxGeometry></mxCell>
<mxCell id="c13" value="cross-Region copy" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#147EBA;fontStyle=0;spacing=0;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="620" y="330" width="140" height="17" as="geometry"/></mxCell>
<mxCell id="c14" value="Covers: Region-wide outage.&lt;br&gt;Restore here, deploy the same&lt;br&gt;templates, point DNS here." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="760" y="300" width="300" height="50" as="geometry"/></mxCell>
<mxCell id="c15" value="&lt;b&gt;Backup account (separate admins, no prod access)&lt;/b&gt;" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="1"><mxGeometry x="720" y="440" width="360" height="260" as="geometry"/></mxCell>
<mxCell id="lag" value='&lt;b&gt;Logically air-gapped vault&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;vault lock in compliance mode&lt;br&gt;retain 90 days, nobody can delete&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aws_backup_vault_lock;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="810" y="500" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="c16" style="edgeStyle=none;html=1;rounded=0;strokeColor=#DD344C;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="vault1" target="lag"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="436"/><mxPoint x="700" y="524"/></Array></mxGeometry></mxCell>
<mxCell id="c17" value="copy job" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#DD344C;fontStyle=0;spacing=0;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="640" y="470" width="80" height="17" as="geometry"/></mxCell>
<mxCell id="c18" value="Covers: ransomware, a deleted&lt;br&gt;account, an insider with admin&lt;br&gt;rights in prod." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="760" y="610" width="300" height="50" as="geometry"/></mxCell>
<mxCell id="c19" value="&lt;b&gt;Recovery account (clean room)&lt;/b&gt;" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="1"><mxGeometry x="1120" y="440" width="360" height="260" as="geometry"/></mxCell>
<mxCell id="rec" value='&lt;b&gt;Restored stack&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;rebuilt from code,&lt;br&gt;data from the vault&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1210" y="500" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="c20" style="edgeStyle=none;html=1;rounded=0;strokeColor=#DD344C;strokeWidth=2;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lag" target="rec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c21" value="shared via AWS RAM" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#DD344C;fontStyle=0;spacing=0;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1070" y="470" width="120" height="17" as="geometry"/></mxCell>
<mxCell id="c22" value="Restore into a fresh account when&lt;br&gt;you cannot trust the original one.&lt;br&gt;Scan before you reconnect users." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1160" y="610" width="300" height="50" as="geometry"/></mxCell>
<mxCell id="c23" value="&lt;b&gt;Example timeline (2 TB, 25 EC2)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#5A6C86;fillColor=#F8F9FA;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1120" y="140" width="360" height="260" as="geometry"/></mxCell>
<mxCell id="c24" value="0:00  disaster declared" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1136" y="172" width="340" height="18" as="geometry"/></mxCell>
<mxCell id="c25" value="0:10  pipeline deploys VPC, IAM, ALB" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1136" y="196" width="340" height="18" as="geometry"/></mxCell>
<mxCell id="c26" value="0:25  EBS + AMI restores start (parallel)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1136" y="220" width="340" height="18" as="geometry"/></mxCell>
<mxCell id="c27" value="0:30  Aurora restore from recovery point" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1136" y="244" width="340" height="18" as="geometry"/></mxCell>
<mxCell id="c28" value="1:50  Aurora cluster available" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1136" y="268" width="340" height="18" as="geometry"/></mxCell>
<mxCell id="c29" value="2:10  app tier healthy, smoke tests pass" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1136" y="292" width="340" height="18" as="geometry"/></mxCell>
<mxCell id="c30" value="2:30  DNS switched, traffic flowing" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1136" y="316" width="340" height="18" as="geometry"/></mxCell>
<mxCell id="c31" value="RTO met: 2 h 30 min  (target 4 h)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1136" y="340" width="340" height="18" as="geometry"/></mxCell>
<mxCell id="c32" value="RPO met: 1 h  (last hourly point)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1136" y="364" width="340" height="18" as="geometry"/></mxCell>
<mxCell id="c33" value="&lt;b&gt;What backup and restore does not give you&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#9AA0A6;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="730" width="1460" height="120" as="geometry"/></mxCell>
<mxCell id="c34" value="1. An RTO in minutes: restoring a large database is bound by data size, not by how fast you click.&lt;br&gt;2. Capacity guarantees: the recovery Region has to have the instance types and the service quotas you need on the day.&lt;br&gt;3. Confidence, unless you restore on a schedule. A backup you have never restored is a hope, not a recovery point.&lt;br&gt;4. Protection from your own mistakes if the copies sit in the same account, under the same admins, with the same KMS key." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="36" y="762" width="1430" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
