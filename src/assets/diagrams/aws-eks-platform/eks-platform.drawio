<mxCell id="karp" value='&lt;b&gt;Karpenter controller&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;runs on the system pool&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.auto_scaling;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="290" y="345" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="c9" value='&lt;b&gt;system&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;on-demand, arm64, 3-6 nodes&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#ED7100;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="270" y="420" width="234" height="46" as="geometry"/></mxCell>
<mxCell id="np_gen" value='&lt;b&gt;general (most tenants)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;Spot + on-demand, arm64 + amd64&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#ED7100;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="270" y="480" width="234" height="46" as="geometry"/></mxCell>
<mxCell id="c11" value='&lt;b&gt;search-batch (tainted)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;Spot only, team=search&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#ED7100;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="270" y="540" width="234" height="46" as="geometry"/></mxCell>
<mxCell id="c12" value="consolidation: WhenEmptyOrUnderutilized&lt;br&gt;budget: 10% of nodes, 0 during peak&lt;br&gt;expireAfter: 720h, AMI pinned in&lt;br&gt;EC2NodeClass, Spot interruptions via SQS" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="270" y="600" width="240" height="62" as="geometry"/></mxCell>
