<mxfile host="thecodeclouds.com" agent="hand-built" version="24.0.0" type="device">
<diagram id="ip-exhaustion" name="2. Scenario: pod IP exhaustion and the fix"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Scenario: the load test that ran the VPC out of IPs, and the networking that fixed it (VPC CNI custom networking + /28 prefixes)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1560" height="24" as="geometry"/></mxCell>
<mxCell id="c2" value="&lt;b&gt;Before: default VPC CNI, pods share the node subnets&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#DD344C;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#DD344C;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="765" height="600" as="geometry"/></mxCell>
<mxCell id="c3" value="&lt;b&gt;Node subnet 10.40.0.0/20 (eu-west-1a) - nodes AND pods&lt;/b&gt;" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;strokeColor=#00A4A6;fillColor=#E6F6F7;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="725" height="250" as="geometry"/></mxCell>
<mxCell id="n1" value='&lt;b&gt;m7g.2xlarge node&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;4 ENIs x 15 IPv4&lt;br&gt;max 58 pods&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="52" height="52" as="geometry"/></mxCell>
<mxCell id="c4" value='&lt;b&gt;ENI 0 (primary)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;1 node IP + 14 for pods&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#00A4A6;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="220" y="140" width="250" height="44" as="geometry"/></mxCell>
<mxCell id="c5" value='&lt;b&gt;ENI 1&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;15 IPs for pods&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#00A4A6;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="220" y="192" width="250" height="44" as="geometry"/></mxCell>
<mxCell id="c6" value='&lt;b&gt;ENI 2&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;15 IPs, 3 in use&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#00A4A6;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="220" y="244" width="250" height="44" as="geometry"/></mxCell>
<mxCell id="c7" value='&lt;b&gt;ENI 3: warm spare&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;15 IPs idle (WARM_ENI_TARGET=1)&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#DD344C;fillColor=#FFF5F6;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="220" y="296" width="250" height="44" as="geometry"/></mxCell>
<mxCell id="c8" value="32 pods on this node&lt;br&gt;hold 60 VPC IPs.&lt;br&gt;&lt;br&gt;Every node keeps a&lt;br&gt;whole spare ENI of&lt;br&gt;addresses attached,&lt;br&gt;whether it needs it&lt;br&gt;or not." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="495" y="150" width="260" height="122" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;b&gt;3 node subnets  x  /20  =  12,273 usable IPs, shared by nodes and pods&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#00A4A6;fillColor=#E6F6F7;dashed=0;fontSize=12;fontStyle=0;fontColor=#147EBA;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="375" width="725" height="34" as="geometry"/></mxCell>
<mxCell id="c10" value="205 nodes  x  ~60 IPs held  =  ~12,300  &amp;gt;  12,273" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#DD344C;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="448" width="700" height="21" as="geometry"/></mxCell>
<mxCell id="c11" value="Load test, Thursday 19:40. HPA asks for 9,600 pods. At ~205 nodes and ~6,400 pods:" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="700" height="17" as="geometry"/></mxCell>
<mxCell id="c12" value='&lt;b&gt;kubelet: FailedCreatePodSandBox ... failed to assign an IP address to container&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;Karpenter: launch failed, InsufficientFreeAddressesInSubnet&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#DD344C;fillColor=#FFF5F6;dashed=0;fontSize=12;fontStyle=0;fontColor=#DD344C;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="504" width="690" height="56" as="geometry"/></mxCell>
<mxCell id="c13" value="Pods sit in ContainerCreating, new nodes cannot even get a primary IP, checkout p99&lt;br&gt;climbs from 180 ms to 2.4 s, and the test is stopped at 67% of the target." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="576" width="700" height="32" as="geometry"/></mxCell>
<mxCell id="c14" value="Quick relief that night: MINIMUM_IP_TARGET=30 and WARM_IP_TARGET=4 on the aws-node DaemonSet&lt;br&gt;(~36 IPs per node instead of ~60, at the cost of more EC2 API calls)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="616" width="700" height="32" as="geometry"/></mxCell>
<mxCell id="c15" value="&lt;b&gt;After: pods get their own non-routable range, in /28 prefixes&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#7AA116;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#248814;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="815" y="60" width="765" height="600" as="geometry"/></mxCell>
<mxCell id="c16" value="&lt;b&gt;Node subnet 10.40.0.0/20 (routable)&lt;/b&gt;" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;strokeColor=#00A4A6;fillColor=#E6F6F7;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=0;" vertex="1" parent="1"><mxGeometry x="835" y="100" width="330" height="250" as="geometry"/></mxCell>
<mxCell id="n2" value='&lt;b&gt;same node type&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;maxPods = 110&lt;br&gt;(RESERVED_ENIS=1)&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="855" y="150" width="52" height="52" as="geometry"/></mxCell>
<mxCell id="e0" value='&lt;b&gt;ENI 0 (primary)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;node IP only, no pods&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#00A4A6;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="990" y="150" width="160" height="44" as="geometry"/></mxCell>
<mxCell id="c18" value="Node subnets now hold&lt;br&gt;node IPs, load balancer&lt;br&gt;ENIs and endpoints only:&lt;br&gt;room for ~12,000 nodes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="990" y="216" width="170" height="62" as="geometry"/></mxCell>
<mxCell id="c19" value="&lt;b&gt;Pod subnet 100.64.0.0/18 (eu-west-1a), ENIConfig&lt;/b&gt;" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;strokeColor=#00A4A6;fillColor=#E6F6F7;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=0;" vertex="1" parent="1"><mxGeometry x="1180" y="100" width="380" height="250" as="geometry"/></mxCell>
<mxCell id="e1" value='&lt;b&gt;ENI 1: /28 prefixes&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;2 in use (32 pods) + 1 warm&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#7AA116;fillColor=#F2F6E8;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1200" y="140" width="340" height="44" as="geometry"/></mxCell>
<mxCell id="c21" value='&lt;b&gt;ENI 2, ENI 3: attached only when needed&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;up to 14 prefixes x 16 IPs each&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#00A4A6;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1200" y="192" width="340" height="44" as="geometry"/></mxCell>
<mxCell id="c22" value="WARM_PREFIX_TARGET=1: the node holds&lt;br&gt;48 IPs for 32 pods, and one EC2 call&lt;br&gt;adds 16 addresses at a time.&lt;br&gt;Subnet CIDR reservation (type prefix)&lt;br&gt;keeps /28 blocks contiguous." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1200" y="250" width="350" height="77" as="geometry"/></mxCell>
<mxCell id="c23" style="edgeStyle=none;html=1;rounded=0;strokeColor=#00A4A6;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n2" target="e0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c24" value="&lt;b&gt;3 pod subnets  x  /18  =  49,137 usable pod IPs (100.64.0.0/16 is a VPC secondary CIDR)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#7AA116;fillColor=#F2F6E8;dashed=0;fontSize=12;fontStyle=0;fontColor=#248814;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="835" y="375" width="725" height="34" as="geometry"/></mxCell>
<mxCell id="c25" value="300 nodes  x  48 IPs  =  ~14,400 needed  vs  49,137 available" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#248814;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="855" y="448" width="700" height="21" as="geometry"/></mxCell>
<mxCell id="c26" value="Retest two weeks later: 9,600 pods on 296 nodes, zero IP errors, pod&lt;br&gt;scheduled-to-running p95 down from 21 s to 9 s (fewer EC2 calls per pod)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="855" y="480" width="700" height="32" as="geometry"/></mxCell>
<mxCell id="c27" value="Rolled out by creating new Karpenter NodePools that point at an EC2NodeClass&lt;br&gt;with the new settings, then draining the old pools with a 10% disruption budget.&lt;br&gt;No node ever mixed secondary IPs and prefixes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="855" y="530" width="700" height="47" as="geometry"/></mxCell>
<mxCell id="c28" value="Long-term option for new clusters: IPv6 (chosen at cluster creation, cannot be changed)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="855" y="600" width="700" height="17" as="geometry"/></mxCell>
<mxCell id="c29" value="&lt;b&gt;How traffic flows once pods live in 100.64.0.0/16&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#232F3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="690" width="1560" height="290" as="geometry"/></mxCell>
<mxCell id="alb" value='&lt;b&gt;ALB in public subnets&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;target type: ip&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.application_load_balancer;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="760" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="pod" value='&lt;b&gt;pod 100.64.21.37&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;checkout&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#ED7100;fillColor=#FFF8F1;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="300" y="760" width="150" height="48" as="geometry"/></mxCell>
<mxCell id="node" value='&lt;b&gt;node 10.40.3.18&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;iptables SNAT&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#00A4A6;fillColor=#E6F6F7;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="580" y="760" width="150" height="48" as="geometry"/></mxCell>
<mxCell id="tgw" value="&lt;b&gt;Transit Gateway&lt;/b&gt;" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.transit_gateway;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="880" y="760" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="dc" value='&lt;b&gt;On-prem ERP&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;sees 10.40.3.18&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#545B64;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.corporate_data_center;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1100" y="760" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="lat" value='&lt;b&gt;VPC Lattice&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;no routing needed&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.vpc_lattice;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1330" y="760" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="c32" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="alb" target="pod"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c33" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pod" target="node"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c34" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="node" target="tgw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c35" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tgw" target="dc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c36" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=2;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pod" target="lat"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="375" y="735"/><mxPoint x="1354" y="735"/></Array></mxGeometry></mxCell>
<mxCell id="c37" value="1" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="170" y="760" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c38" value="2" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="790" y="760" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c39" value="3" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="860" y="712" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c40" value="1. Inbound: the ALB lives in routable subnets and sends straight to pod IPs inside the VPC." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="860" width="760" height="17" as="geometry"/></mxCell>
<mxCell id="c41" value="2. Outbound beyond the VPC: the CNI rewrites the source to the node IP, so 100.64.0.0/16 never needs a route anywhere else." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="880" width="900" height="17" as="geometry"/></mxCell>
<mxCell id="c42" value="3. Service-to-service across VPCs and accounts: VPC Lattice, which also handles overlapping CIDRs." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="900" width="900" height="17" as="geometry"/></mxCell>
<mxCell id="c43" value="Security groups for pods and network policies still apply to pod IPs in the 100.64 range." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="926" width="900" height="17" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
