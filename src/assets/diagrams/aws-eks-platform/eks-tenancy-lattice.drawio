<diagram id="tenancy-lattice" name="3. Tenant isolation and east-west traffic"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Tenant isolation inside the shared cluster, and service-to-service calls across clusters and accounts with VPC Lattice" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1560" height="24" as="geometry"/></mxCell>
<mxCell id="c2" value="&lt;b&gt;Account platform-prod&lt;/b&gt;" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="720" height="900" as="geometry"/></mxCell>
<mxCell id="c3" value="&lt;b&gt;EKS cluster prod-euw1 (shared)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#ED7100;fillColor=#FFF8F1;dashed=0;fontSize=12;fontStyle=0;fontColor=#ED7100;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="680" height="520" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;b&gt;namespace checkout  (team A)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#232F3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="300" height="200" as="geometry"/></mxCell>
<mxCell id="chk" value='&lt;b&gt;checkout-api&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;SA: checkout-api&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#ED7100;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="80" y="180" width="150" height="46" as="geometry"/></mxCell>
<mxCell id="role" value='&lt;b&gt;IAM role&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;checkout-prod&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="270" y="180" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="c6" style="edgeStyle=none;html=1;rounded=0;strokeColor=#DD344C;strokeWidth=1.5;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="chk" target="role"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c7" value="Pod Identity association:&lt;br&gt;SA checkout-api -&amp;gt; role checkout-prod&lt;br&gt;quota: 120 vCPU, 240 GiB, 400 pods" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="80" y="262" width="270" height="47" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;namespace catalog  (team B)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#232F3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="140" width="320" height="200" as="geometry"/></mxCell>
<mxCell id="cat" value='&lt;b&gt;catalog-api&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;SA: catalog-api&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#ED7100;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="400" y="180" width="150" height="46" as="geometry"/></mxCell>
<mxCell id="c10" value="access entry: team-b-devs&lt;br&gt;AmazonEKSEditPolicy&lt;br&gt;scope: namespace catalog" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="470" y="232" width="220" height="47" as="geometry"/></mxCell>
<mxCell id="c11" value="&lt;b&gt;namespace search  (team C, own NodePool)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#232F3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="370" width="640" height="120" as="geometry"/></mxCell>
<mxCell id="idx" value='&lt;b&gt;search-indexer&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;Spot, tainted team=search&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#ED7100;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="80" y="410" width="190" height="46" as="geometry"/></mxCell>
<mxCell id="sapi" value='&lt;b&gt;search-api&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;ingress: catalog only&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#ED7100;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="300" y="410" width="150" height="46" as="geometry"/></mxCell>
<mxCell id="c14" value="Heavy reindex jobs cannot&lt;br&gt;starve other tenants: they only&lt;br&gt;fit on the tainted search pool." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="480" y="410" width="210" height="47" as="geometry"/></mxCell>
<mxCell id="c15" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7AA116;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.767;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat" target="sapi"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c16" value="allowed by NetworkPolicy;&lt;br&gt;checkout -&amp;gt; search is denied" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#7AA116;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="425" y="296" width="200" height="30" as="geometry"/></mxCell>
<mxCell id="c17" value="Guardrails every namespace gets from the tenant manifest" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="510" width="640" height="17" as="geometry"/></mxCell>
<mxCell id="c18" value='Isolation: default-deny NetworkPolicy (VPC CNI network policy agent), PSA "restricted",&lt;br&gt;   Kyverno: no hostPath, no privileged, images only from our ECR, PDB requires 2+ replicas&lt;br&gt;Fairness: ResourceQuota, LimitRange defaults, PriorityClass per tier, dedicated NodePools&lt;br&gt;Identity: access entries per team, Pod Identity per service account, no node role sharing' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="534" width="650" height="62" as="geometry"/></mxCell>
<mxCell id="c19" value="&lt;b&gt;Hard tenancy goes in its own cluster and account&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#DD344C;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#DD344C;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="680" height="270" as="geometry"/></mxCell>
<mxCell id="c20" value="Soft tenancy (namespaces) is fine for teams that trust each other&lt;br&gt;and share a release process. It is not a security boundary&lt;br&gt;against a hostile workload: the kernel, the nodes and the API&lt;br&gt;server are shared.&lt;br&gt;&lt;br&gt;So a separate cluster in a separate account for:&lt;br&gt;  - PCI scope (payments), regulated data, customer-supplied code&lt;br&gt;  - workloads that need cluster-wide admin or their own CRDs&lt;br&gt;  - anything whose blast radius you would not share&lt;br&gt;&lt;br&gt;VPC Lattice then joins them back together at the service level,&lt;br&gt;without peering VPCs or sharing nodes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="640" height="182" as="geometry"/></mxCell>
<mxCell id="lat" value='&lt;b&gt;VPC Lattice&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;service network&lt;br&gt;prod-services&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.vpc_lattice;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="820" y="360" width="60" height="60" as="geometry"/></mxCell>
<mxCell id="c21" value='&lt;b&gt;Auth policy on payments service&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;allow principal:&lt;br&gt;  role/checkout-prod&lt;br&gt;only POST /v1/authorizations&lt;br&gt;all other callers: 403&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#8C4FFF;fillColor=#FAF7FF;dashed=0;fontSize=12;fontStyle=0;fontColor=#8C4FFF;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="770" y="480" width="200" height="112" as="geometry"/></mxCell>
<mxCell id="c22" value="Service network shared to&lt;br&gt;the other accounts with RAM.&lt;br&gt;Each VPC gets a service&lt;br&gt;network association." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="780" y="620" width="190" height="62" as="geometry"/></mxCell>
<mxCell id="c23" value="&lt;b&gt;Account payments-pci (separate cluster)&lt;/b&gt;" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="1"><mxGeometry x="1000" y="60" width="580" height="440" as="geometry"/></mxCell>
<mxCell id="c24" value="&lt;b&gt;EKS cluster payments-euw1&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#ED7100;fillColor=#FFF8F1;dashed=0;fontSize=12;fontStyle=0;fontColor=#ED7100;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1020" y="100" width="540" height="380" as="geometry"/></mxCell>
<mxCell id="c25" value="&lt;b&gt;namespace payments-api&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#232F3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1040" y="140" width="500" height="200" as="geometry"/></mxCell>
<mxCell id="pay" value='&lt;b&gt;payments-api&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;3 pods, 3 AZs&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#ED7100;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1060" y="260" width="150" height="46" as="geometry"/></mxCell>
<mxCell id="route" value='&lt;b&gt;HTTPRoute&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;parentRef: prod-services&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#8C4FFF;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1250" y="260" width="180" height="46" as="geometry"/></mxCell>
<mxCell id="c28" value="AWS Gateway API Controller turns the&lt;br&gt;HTTPRoute into a Lattice service and a&lt;br&gt;target group of pod IPs." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1060" y="180" width="470" height="47" as="geometry"/></mxCell>
<mxCell id="c29" value="Node security group allows inbound from the&lt;br&gt;VPC Lattice managed prefix list only.&lt;br&gt;No VPC peering, no Transit Gateway route&lt;br&gt;from platform-prod to this VPC." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1040" y="360" width="500" height="62" as="geometry"/></mxCell>
<mxCell id="c30" value="&lt;b&gt;Account orders-legacy (acquired, VPC 10.40.0.0/16: overlaps!)&lt;/b&gt;" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="1"><mxGeometry x="1000" y="540" width="580" height="300" as="geometry"/></mxCell>
<mxCell id="ecs" value='&lt;b&gt;invoice service&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;ECS on Fargate&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1060" y="610" width="52" height="52" as="geometry"/></mxCell>
<mxCell id="fn" value='&lt;b&gt;refund-worker&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;Lambda target&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1260" y="610" width="52" height="52" as="geometry"/></mxCell>
<mxCell id="c31" value="Same CIDR as the platform VPC, so peering and&lt;br&gt;Transit Gateway are off the table. Lattice does not&lt;br&gt;route between VPCs, it proxies requests, so the&lt;br&gt;overlap does not matter. invoice calls catalog;&lt;br&gt;payments calls refund-worker (a Lambda target)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1060" y="730" width="500" height="77" as="geometry"/></mxCell>
<mxCell id="c32" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=2.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="chk" target="lat"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="50" y="203"/><mxPoint x="50" y="128"/><mxPoint x="750" y="128"/><mxPoint x="750" y="378"/></Array></mxGeometry></mxCell>
<mxCell id="c33" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=2.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lat" target="pay"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="378"/><mxPoint x="1000" y="283"/></Array></mxGeometry></mxCell>
<mxCell id="c34" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=1.5;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="route" target="pay"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c35" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="ecs" target="lat"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="985" y="636"/><mxPoint x="985" y="414"/></Array></mxGeometry></mxCell>
<mxCell id="c36" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lat" target="cat"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="203"/></Array></mxGeometry></mxCell>
<mxCell id="c37" value="1" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1440" y="254" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c38" value="2" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="600" y="117" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c39" value="3" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="760" y="470" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c40" value="4" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1010" y="300" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c41" value="5" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1020" y="590" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c42" value="1  HTTPRoute -&amp;gt; Lattice service&lt;br&gt;2  checkout calls payments.prod.internal,&lt;br&gt;    SigV4-signed with its Pod Identity creds&lt;br&gt;3  auth policy checks the IAM principal&lt;br&gt;4  Lattice forwards to payments pod IPs&lt;br&gt;5  invoice (overlapping VPC) calls catalog" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="770" y="730" width="220" height="92" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
