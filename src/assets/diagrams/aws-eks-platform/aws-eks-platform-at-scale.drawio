<mxCell id="sm" value='&lt;b&gt;Secrets Manager&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;CSI driver mounts&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1465" y="640" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="kms" value='&lt;b&gt;KMS&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;envelope encryption&lt;br&gt;of Kubernetes secrets&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1290" y="775" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="gd" value='&lt;b&gt;GuardDuty&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;EKS + runtime&lt;br&gt;monitoring&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.guardduty;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1465" y="775" width="48" height="48" as="geometry"/></mxCell>
