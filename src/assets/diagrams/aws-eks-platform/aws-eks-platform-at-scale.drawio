<mxCell id="c37" value="1" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1440" y="254" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c38" value="2" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="600" y="117" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c39" value="3" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="760" y="470" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c40" value="4" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1010" y="300" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c41" value="5" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1020" y="590" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c42" value="1  HTTPRoute -&amp;gt; Lattice service&lt;br&gt;2  checkout calls payments.prod.internal,&lt;br&gt;    SigV4-signed with its Pod Identity creds&lt;br&gt;3  auth policy checks the IAM principal&lt;br&gt;4  Lattice forwards to payments pod IPs&lt;br&gt;5  invoice (overlapping VPC) calls catalog" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="770" y="730" width="220" height="92" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="upgrades" name="4. Upgrade playbook: 1.34 to 1.35"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Scenario: upgrading the shared cluster from Kubernetes 1.34 to 1.35 before standard support ends (2 Dec 2026)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1560" height="24" as="geometry"/></mxCell>
<mxCell id="c2" value="" style="rounded=1;arcSize=8;html=1;strokeColor=#7AA116;fillColor=#F2F6E8;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="1560" height="64" as="geometry"/></mxCell>
<mxCell id="t0" value="dev  (3 Nov)&lt;br&gt;2 clusters, in place" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;strokeColor=#248814;fillColor=#FFFFFF;fontColor=#248814;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="70" width="320" height="44" as="geometry"/></mxCell>
<mxCell id="t1" value="staging  (10 Nov)&lt;br&gt;same steps, load test after" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;strokeColor=#248814;fillColor=#FFFFFF;fontColor=#248814;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="440" y="70" width="320" height="44" as="geometry"/></mxCell>
<mxCell id="c5" style="edgeStyle=none;html=1;rounded=0;strokeColor=#248814;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t0" target="t1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="t2" value="prod  (17 Nov)&lt;br&gt;Tuesday 06:00, quietest hour" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;strokeColor=#248814;fillColor=#FFFFFF;fontColor=#248814;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="830" y="70" width="320" height="44" as="geometry"/></mxCell>
<mxCell id="c7" style="edgeStyle=none;html=1;rounded=0;strokeColor=#248814;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t1" target="t2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="t3" value="2 Dec 2026&lt;br&gt;1.34 leaves standard support" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;strokeColor=#DD344C;fillColor=#FFFFFF;fontColor=#DD344C;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1220" y="70" width="320" height="44" as="geometry"/></mxCell>
<mxCell id="c9" style="edgeStyle=none;html=1;rounded=0;strokeColor=#248814;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t2" target="t3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s1" value="&lt;b&gt;Read the upgrade insights&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#232F3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="170" width="355" height="150" as="geometry"/></mxCell>
<mxCell id="c11" value="EKS cluster insights for 1.35:&lt;br&gt;deprecated API calls seen in the&lt;br&gt;audit log, add-on compatibility,&lt;br&gt;kubelet version skew.&lt;br&gt;Found: 2 Helm charts on an old API." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="196" width="285" height="82" as="geometry"/></mxCell>
<mxCell id="c12" value="1" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="19" y="159" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="i1" value="&lt;b&gt;&lt;/b&gt;" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eks;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="333" y="268" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="s2" value="&lt;b&gt;Fix it in Git first&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#232F3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="425" y="170" width="355" height="150" as="geometry"/></mxCell>
<mxCell id="c14" value="Bump the two charts, Karpenter,&lt;br&gt;and every add-on to versions that&lt;br&gt;support 1.35. CI runs the manifests&lt;br&gt;against the 1.35 API with a&lt;br&gt;deprecation checker." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="435" y="196" width="285" height="82" as="geometry"/></mxCell>
<mxCell id="c15" value="2" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="414" y="159" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="i2" value="&lt;b&gt;&lt;/b&gt;" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codepipeline;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="728" y="268" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="s3" value="&lt;b&gt;Control plane 1.34 -&amp;gt; 1.35&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#232F3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="820" y="170" width="355" height="150" as="geometry"/></mxCell>
<mxCell id="c17" value="One minor version at a time,&lt;br&gt;in place, no workload restart.&lt;br&gt;Rollback to 1.34 is possible&lt;br&gt;for 7 days if something breaks." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="830" y="196" width="285" height="66" as="geometry"/></mxCell>
<mxCell id="c18" value="3" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="809" y="159" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="i3" value="&lt;b&gt;&lt;/b&gt;" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eks;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1123" y="268" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="s4" value="&lt;b&gt;Managed add-ons&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#232F3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1215" y="170" width="355" height="150" as="geometry"/></mxCell>
<mxCell id="c20" value="VPC CNI, CoreDNS, kube-proxy,&lt;br&gt;Pod Identity Agent, EBS CSI:&lt;br&gt;updated one by one, each with&lt;br&gt;a 10-minute soak and a check&lt;br&gt;of DNS errors and pod starts." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1225" y="196" width="285" height="82" as="geometry"/></mxCell>
<mxCell id="c21" value="4" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1204" y="159" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="i4" value="&lt;b&gt;&lt;/b&gt;" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.containers;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1518" y="268" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="s5" value="&lt;b&gt;Nodes: let Karpenter drift them&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#232F3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="380" width="355" height="150" as="geometry"/></mxCell>
<mxCell id="c23" value="Point amiSelectorTerms at the 1.35&lt;br&gt;AMI release in the EC2NodeClass.&lt;br&gt;Every node is marked Drifted and&lt;br&gt;replaced: new node first, then&lt;br&gt;cordon and drain the old one." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="406" width="285" height="82" as="geometry"/></mxCell>
<mxCell id="c24" value="5" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="19" y="369" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="i5" value="&lt;b&gt;&lt;/b&gt;" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.auto_scaling;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="333" y="478" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="s6" value="&lt;b&gt;Drain under guardrails&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#232F3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="425" y="380" width="355" height="150" as="geometry"/></mxCell>
<mxCell id="c26" value="NodePool budget: 10% of nodes at&lt;br&gt;a time, 0 between 17:00 and 22:00.&lt;br&gt;PodDisruptionBudgets and readiness&lt;br&gt;probes gate each eviction.&lt;br&gt;terminationGracePeriod: 24h." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="435" y="406" width="285" height="82" as="geometry"/></mxCell>
<mxCell id="c27" value="6" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="414" y="369" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="i6" value="&lt;b&gt;&lt;/b&gt;" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.spot_instance;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="728" y="478" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="s7" value="&lt;b&gt;Watch the SLOs, not the nodes&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#232F3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="820" y="380" width="355" height="150" as="geometry"/></mxCell>
<mxCell id="c29" value="Managed Grafana: p99 latency and&lt;br&gt;5xx per service, error budget burn,&lt;br&gt;pending pods, CoreDNS errors.&lt;br&gt;296 nodes replaced in 2 h 10 min,&lt;br&gt;no SLO alert fired." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="830" y="406" width="285" height="82" as="geometry"/></mxCell>
<mxCell id="c30" value="7" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="809" y="369" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="i7" value="&lt;b&gt;&lt;/b&gt;" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.managed_service_for_grafana;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1123" y="478" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="s8" value="&lt;b&gt;Close it out&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#232F3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1215" y="380" width="355" height="150" as="geometry"/></mxCell>
<mxCell id="c32" value="Tag the Git release, write down&lt;br&gt;timings, move the platform&lt;br&gt;version in the tenant docs.&lt;br&gt;Next: plan 1.36 for Q1, well&lt;br&gt;inside its standard support." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1225" y="406" width="285" height="82" as="geometry"/></mxCell>
