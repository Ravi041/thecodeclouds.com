<mxCell id="c37" value="request / service call" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="86" y="861" width="96" height="17" as="geometry"/></mxCell>
<mxCell id="c38" style="edgeStyle=none;html=1;rounded=0;strokeColor=#E7157B;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="34" y="889" as="sourcePoint"/><mxPoint x="74" y="889" as="targetPoint"/></mxGeometry></mxCell>
