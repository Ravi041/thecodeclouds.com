<mxCell id="c13" value="Bottlerocket / AL2023 · Spot · On-Demand" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="278" y="734" width="240" height="17" as="geometry"/></mxCell>
<mxCell id="tenants" value="&lt;b&gt;Tenant namespaces (soft multi-tenancy)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#232F3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="532" y="308" width="400" height="300" as="geometry"/></mxCell>
<mxCell id="c15" value='&lt;b&gt;checkout&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;14 services&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#232F3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="548" y="344" width="116" height="46" as="geometry"/></mxCell>
<mxCell id="c16" value='&lt;b&gt;catalog&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;22 services&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#232F3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="674" y="344" width="116" height="46" as="geometry"/></mxCell>
<mxCell id="c17" value='&lt;b&gt;search&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;9 services&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#232F3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="800" y="344" width="116" height="46" as="geometry"/></mxCell>
<mxCell id="c18" value='&lt;b&gt;payments-api&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;calls PCI cluster&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#232F3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="548" y="402" width="116" height="46" as="geometry"/></mxCell>
<mxCell id="c19" value='&lt;b&gt;loyalty&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;6 services&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#232F3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="674" y="402" width="116" height="46" as="geometry"/></mxCell>
<mxCell id="c20" value='&lt;b&gt;+33 more teams&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;~370 services&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#232F3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="800" y="402" width="116" height="46" as="geometry"/></mxCell>
<mxCell id="c21" value='Every namespace gets, from one Git manifest:&lt;br&gt;ResourceQuota + LimitRange, default-deny NetworkPolicy,&lt;br&gt;Pod Security Admission "restricted", Kyverno policies,&lt;br&gt;an access entry scoped to the namespace,&lt;br&gt;Pod Identity associations per service account,&lt;br&gt;and a cost label for split cost allocation.' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="548" y="470" width="380" height="92" as="geometry"/></mxCell>
<mxCell id="addons" value="&lt;b&gt;Platform add-ons&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#ED7100;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="946" y="308" width="214" height="446" as="geometry"/></mxCell>
<mxCell id="c23" value="Amazon VPC CNI&lt;br&gt;· custom networking&lt;br&gt;· /28 prefix delegation&lt;br&gt;· network policy agent&lt;br&gt;CoreDNS + NodeLocal DNSCache&lt;br&gt;AWS Load Balancer Controller&lt;br&gt;AWS Gateway API Controller&lt;br&gt;· for VPC Lattice&lt;br&gt;EKS Pod Identity Agent&lt;br&gt;ADOT collector&lt;br&gt;Kyverno&lt;br&gt;EBS CSI driver&lt;br&gt;metrics-server, KEDA" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="960" y="340" width="196" height="197" as="geometry"/></mxCell>
<mxCell id="c24" value="~120 nodes / 3,500 pods on a normal day&lt;br&gt;~300 nodes / 9,600 pods at peak" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#ED7100;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="548" y="640" width="380" height="32" as="geometry"/></mxCell>
<mxCell id="c25" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.225;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="alb" target="tenants"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c26" value="&lt;b&gt;Node subnets  10.40.0.0/20, .16.0/20, .32.0/20&lt;/b&gt;" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;strokeColor=#00A4A6;fillColor=#E6F6F7;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=0;" vertex="1" parent="1"><mxGeometry x="240" y="790" width="460" height="112" as="geometry"/></mxCell>
<mxCell id="c27" value="Node primary IPs, load balancer ENIs,&lt;br&gt;VPC endpoints. 12,273 usable, routable." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="258" y="830" width="430" height="32" as="geometry"/></mxCell>
<mxCell id="c28" value="&lt;b&gt;Pod subnets  100.64.0.0/18, .64.0/18, .128.0/18&lt;/b&gt;" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;strokeColor=#00A4A6;fillColor=#E6F6F7;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=0;" vertex="1" parent="1"><mxGeometry x="715" y="790" width="460" height="112" as="geometry"/></mxCell>
<mxCell id="c29" value="Pods only, via ENIConfig per AZ, /28 prefixes.&lt;br&gt;49,137 usable. SNAT to the node IP leaving the VPC." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="733" y="830" width="430" height="32" as="geometry"/></mxCell>
<mxCell id="tgw" value='&lt;b&gt;Transit Gateway&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;shared services, on-prem&lt;br&gt;(pods appear as node IPs)&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.transit_gateway;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="300" y="945" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="pci" value='&lt;b&gt;Payments EKS cluster, PCI account (hard tenancy)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;own VPC, own nodes, reached only through VPC Lattice&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#DD344C;fillColor=#FFF5F6;dashed=0;fontSize=12;fontStyle=0;fontColor=#DD344C;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="640" y="950" width="540" height="60" as="geometry"/></mxCell>
<mxCell id="cp" value='&lt;b&gt;EKS control plane&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;AWS-managed, audit logs&lt;br&gt;access entries&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eks;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1290" y="100" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="sqs" value='&lt;b&gt;SQS + EventBridge&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;Spot interruption queue&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1465" y="100" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="lat" value='&lt;b&gt;VPC Lattice&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;service network, IAM auth&lt;br&gt;shared with RAM&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.vpc_lattice;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1290" y="235" width="48" height="48" as="geometry"/></mxCell>
