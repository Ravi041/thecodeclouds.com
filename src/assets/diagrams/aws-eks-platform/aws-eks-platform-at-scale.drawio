<mxCell id="c33" style="edgeStyle=none;html=1;rounded=0;strokeColor=#E7157B;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="addons" target="amp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1200" y="442"/><mxPoint x="1200" y="394"/></Array></mxGeometry></mxCell>
