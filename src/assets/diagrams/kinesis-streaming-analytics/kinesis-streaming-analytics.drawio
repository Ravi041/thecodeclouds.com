<diagram id="hot-shards" name="2. Hot shards and partition keys"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="745" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Why one busy key throttles a 72-shard stream, and how to fix it without adding shards" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1300" height="24" as="geometry"/></mxCell>
<mxCell id="c2" value="&lt;b&gt;Before: partition key = zone_id (1,200 delivery zones)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#DD344C;fillColor=#FFF7F8;dashed=0;fontSize=12;fontStyle=0;fontColor=#DD344C;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="720" height="520" as="geometry"/></mxCell>
<mxCell id="c3" value="PutRecords → MD5(partition key) → 128-bit hash key range → exactly one shard" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="680" height="18" as="geometry"/></mxCell>
<mxCell id="c4" value="Friday 19:00, a free-delivery promo in one district: zone dub-centre-04&lt;br&gt;alone offers 1.6 MB/s. Every record for that key lands on shard 17." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="118" width="600" height="34" as="geometry"/></mxCell>
