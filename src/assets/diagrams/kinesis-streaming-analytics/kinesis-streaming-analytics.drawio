<mxCell id="c74" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#7AA116;fillColor=#7AA11655;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1360" y="331.6" width="58" height="118.4" as="geometry"/></mxCell>
<mxCell id="c75" value="74%" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#7AA116;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1360" y="313.6" width="58" height="17" as="geometry"/></mxCell>
<mxCell id="c76" value="shard 70" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1354" y="456" width="70" height="17" as="geometry"/></mxCell>
<mxCell id="c77" style="edgeStyle=none;html=1;rounded=0;strokeColor=#DD344C;strokeWidth=1.5;dashed=1;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="786" y="290" as="sourcePoint"/><mxPoint x="1432" y="290" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c78" value="100% = 1 MB/s or 1,000 records/s write per shard" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;fontSize=11;fontColor=#DD344C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1110" y="270" width="320" height="17" as="geometry"/></mxCell>
<mxCell id="c79" value="No throttling at the same 54 MB/s peak: 0.75 MB/s per shard, 75% of capacity,&lt;br&gt;leaving a third of headroom over the 54 shards the peak strictly needs." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3F6B0A;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="780" y="490" width="690" height="34" as="geometry"/></mxCell>
<mxCell id="c80" value="Per-session ordering is kept, which is all the clickstream needs." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="780" y="536" width="690" height="18" as="geometry"/></mxCell>
<mxCell id="c81" value='&lt;b&gt;Need per-key order?&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;Keep the key but add a bounded suffix,&lt;br&gt;zone_id#(hash(session_id) % 8), and merge&lt;br&gt;the 8 sub-streams in Flink. Order holds&lt;br&gt;within each sub-key.&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#9AA0A6;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="610" width="350" height="92" as="geometry"/></mxCell>
<mxCell id="c82" value='&lt;b&gt;Find the hot shard&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;Enable shard-level metrics&lt;br&gt;(EnableEnhancedMonitoring) and sort&lt;br&gt;IncomingBytes and&lt;br&gt;WriteProvisionedThroughputExceeded by shard.&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#9AA0A6;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="388" y="610" width="350" height="92" as="geometry"/></mxCell>
<mxCell id="c83" value='&lt;b&gt;Producer side&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;KPL aggregation packs small events into&lt;br&gt;~25 KB records, which fixes the 1,000&lt;br&gt;records/s limit, not the 1 MB/s one.&lt;br&gt;Retry with jitter, never in a tight loop.&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#9AA0A6;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="756" y="610" width="350" height="92" as="geometry"/></mxCell>
<mxCell id="c84" value='&lt;b&gt;Read side&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;Shared reads are 2 MB/s per shard across&lt;br&gt;all consumers. Give the Flink job enhanced&lt;br&gt;fan-out (its own 2 MB/s per shard) so&lt;br&gt;Firehose and Lambda do not starve it.&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#9AA0A6;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1124" y="610" width="350" height="92" as="geometry"/></mxCell>
<mxCell id="c85" value="Quotas per AWS Kinesis Data Streams documentation; check service-sizes-and-limits for your region and capacity mode." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="716" width="1200" height="17" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="late-data" name="3. Event time, watermarks and late data"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="790" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Late data in a 1-minute per-zone window: what fires when, and where stragglers go" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1300" height="24" as="geometry"/></mxCell>
