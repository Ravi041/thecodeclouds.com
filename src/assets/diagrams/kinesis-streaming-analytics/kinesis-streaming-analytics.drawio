<mxCell id="c19" value="A: watermark reaches 12:01:00&lt;br&gt;(newest event seen is 12:01:30, minus 30 s)&lt;br&gt;W fires its first result" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#ED7100;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="448" y="96" width="290" height="47" as="geometry"/></mxCell>
<mxCell id="c20" style="edgeStyle=none;html=1;rounded=0;strokeColor=#DD344C;strokeWidth=2;dashed=1;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="96" as="sourcePoint"/><mxPoint x="1040" y="226" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c21" value="B: watermark reaches 12:03:00&lt;br&gt;allowed lateness (2 min) is over,&lt;br&gt;W state is purged" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#DD344C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1048" y="96" width="290" height="47" as="geometry"/></mxCell>
<mxCell id="c22" value="e1  event_time 12:00:20, arrives before A&lt;br&gt;→ counted in the first result" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#147EBA;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="330" height="32" as="geometry"/></mxCell>
<mxCell id="c23" value="e2  event_time 12:00:45, arrives between A and B&lt;br&gt;(courier in a tunnel, app flushed late)&lt;br&gt;→ W re-fires with a corrected count" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#ED7100;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="448" y="160" width="300" height="47" as="geometry"/></mxCell>
<mxCell id="c24" value="e3  event_time 12:00:50, arrives after B&lt;br&gt;(phone was off for 4 min)&lt;br&gt;→ goes to the late-data side output" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#DD344C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1048" y="160" width="300" height="47" as="geometry"/></mxCell>
<mxCell id="c25" value="e1" style="ellipse;html=1;fillColor=#147EBA;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="240" y="258" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c26" value="e2" style="ellipse;html=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="350" y="258" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c27" value="e3" style="ellipse;html=1;fillColor=#DD344C;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="390" y="258" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c28" value="Watermark = newest event time seen - 30 s. withIdleness(1 min) stops a quiet shard from holding it back." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="348" width="1100" height="18" as="geometry"/></mxCell>
<mxCell id="ks" value='&lt;b&gt;courier-locations&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;app-events, orders&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.kinesis_data_streams;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="52" height="52" as="geometry"/></mxCell>
<mxCell id="src" value='&lt;b&gt;Flink source (EFO)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;WatermarkStrategy&lt;br&gt;.forBoundedOutOfOrderness(30 s)&lt;br&gt;.withIdleness(1 min)&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#8C4FFF;fillColor=#FAF7FF;dashed=0;fontSize=12;fontStyle=0;fontColor=#8C4FFF;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="190" y="452" width="250" height="90" as="geometry"/></mxCell>
<mxCell id="win" value='&lt;b&gt;keyBy(zone_id)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;TumblingEventTimeWindows(1 min)&lt;br&gt;.allowedLateness(2 min)&lt;br&gt;.sideOutputLateData(lateTag)&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#8C4FFF;fillColor=#FAF7FF;dashed=0;fontSize=12;fontStyle=0;fontColor=#8C4FFF;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="500" y="452" width="260" height="90" as="geometry"/></mxCell>
<mxCell id="c31" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ks" target="src"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c32" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="src" target="win"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="os" value='&lt;b&gt;OpenSearch Service&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;upsert, doc id = zone|window_start&lt;br&gt;first result, then corrections&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elasticsearch_service;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="900" y="410" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="c33" style="edgeStyle=none;html=1;rounded=0;strokeColor=#ED7100;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="win" target="os"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="830" y="479"/><mxPoint x="830" y="434"/></Array></mxGeometry></mxCell>
<mxCell id="c34" value="on time + late ≤ 2 min" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#ED7100;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="790" y="410" width="140" height="17" as="geometry"/></mxCell>
<mxCell id="s3late" value='&lt;b&gt;S3 late/ prefix&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;Iceberg table, partitioned by hour&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="900" y="560" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="c35" style="edgeStyle=none;html=1;rounded=0;strokeColor=#DD344C;strokeWidth=2;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="win" target="s3late"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="830" y="524"/><mxPoint x="830" y="584"/></Array></mxGeometry></mxCell>
<mxCell id="c36" value="late &amp;gt; 2 min" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#DD344C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="790" y="590" width="100" height="17" as="geometry"/></mxCell>
<mxCell id="ath" value='&lt;b&gt;Athena, nightly at 02:00&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;MERGE late rows into hourly_zone_metrics&lt;br&gt;lake stays the system of record&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.athena;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="900" y="700" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="c37" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7AA116;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3late" target="ath"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c38" value='&lt;b&gt;Why this shape&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;- Dashboards get a number within ~35 s of the minute closing,&lt;br&gt;  and it corrects itself for 2 more minutes.&lt;br&gt;- Upserts by a deterministic id make re-fires and job restarts&lt;br&gt;  idempotent: no double counting in OpenSearch.&lt;br&gt;- Nothing is dropped. Data later than 2 min is rare (0.3% here),&lt;br&gt;  so it is fixed in batch instead of holding state for hours.&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#9AA0A6;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="600" width="760" height="128" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
