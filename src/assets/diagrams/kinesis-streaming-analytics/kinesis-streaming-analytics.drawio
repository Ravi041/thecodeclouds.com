<mxCell id="c39" value="100% = 1 MB/s or 1,000 records/s write per shard" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;fontSize=11;fontColor=#DD344C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="370" y="270" width="320" height="17" as="geometry"/></mxCell>
<mxCell id="c40" value="Shard 17 accepts 1 MB/s and rejects the rest: WriteProvisionedThroughputExceeded, PutRecords&lt;br&gt;FailedRecordCount &amp;gt; 0, producer retries add load. The stream-level average still reads about 76%." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#DD344C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="690" height="34" as="geometry"/></mxCell>
<mxCell id="c41" value="Resharding does not help: a single partition key always maps to a single shard." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="536" width="690" height="18" as="geometry"/></mxCell>
<mxCell id="c42" value="&lt;b&gt;After: partition key = session_id (about 400,000 live sessions)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#7AA116;fillColor=#F8FBF2;dashed=0;fontSize=12;fontStyle=0;fontColor=#3F6B0A;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="760" y="60" width="720" height="520" as="geometry"/></mxCell>
<mxCell id="c43" value="Same traffic, high-cardinality key: the hash spreads it evenly across all 72 shards" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="780" y="92" width="680" height="18" as="geometry"/></mxCell>
<mxCell id="c44" value="Stream key spreads load. Flink keyBy(zone_id) regroups events after the read,&lt;br&gt;so per-zone windows are unchanged." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="780" y="118" width="600" height="34" as="geometry"/></mxCell>
