<mxCell id="c24" value="e3  event_time 12:00:50, arrives after B&lt;br&gt;(phone was off for 4 min)&lt;br&gt;→ goes to the late-data side output" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#DD344C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1048" y="160" width="300" height="47" as="geometry"/></mxCell>
