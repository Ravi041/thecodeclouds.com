<mxCell id="c7" value="&lt;b&gt;us-east-2 witness&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#5F6368;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#5F6368;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="200" y="140" width="110" height="26" as="geometry"/></mxCell>
<mxCell id="c8" style="edgeStyle=none;html=1;rounded=0;strokeColor=#C4C7CC;strokeWidth=1.5;dashed=1;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="255" y="166" as="sourcePoint"/><mxPoint x="255" y="470" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c9" value="&lt;b&gt;us-west-2&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#147EBA;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#147EBA;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="350" y="140" width="110" height="26" as="geometry"/></mxCell>
<mxCell id="c10" style="edgeStyle=none;html=1;rounded=0;strokeColor=#C4C7CC;strokeWidth=1.5;dashed=1;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="405" y="166" as="sourcePoint"/><mxPoint x="405" y="470" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c11" value='&lt;b&gt;Pay $80&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;IF version = 7&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#147EBA;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#147EBA;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="186" width="150" height="42" as="geometry"/></mxCell>
<mxCell id="c12" value='&lt;b&gt;Pay $60&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;IF version = 7&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#147EBA;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#147EBA;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="330" y="186" width="150" height="42" as="geometry"/></mxCell>
<mxCell id="c13" value="same millisecond, balance $100" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=0;spacing=0;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="165" y="246" width="180" height="16" as="geometry"/></mxCell>
<mxCell id="c14" style="edgeStyle=none;html=1;rounded=0;strokeColor=#147EBA;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="105" y="270" as="sourcePoint"/><mxPoint x="251" y="290" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c15" style="edgeStyle=none;html=1;rounded=0;strokeColor=#147EBA;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="405" y="270" as="sourcePoint"/><mxPoint x="259" y="290" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c16" value="quorum: 2 of 3" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=10;fontColor=#147EBA;fontStyle=1;spacing=0;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="205" y="300" width="100" height="16" as="geometry"/></mxCell>
<mxCell id="c17" value='&lt;b&gt;Committed&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;balance $20, version 8&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1D8102;fillColor=#F2FAF0;dashed=0;fontSize=12;fontStyle=0;fontColor=#1D8102;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="330" width="160" height="42" as="geometry"/></mxCell>
<mxCell id="c18" value='&lt;b&gt;Write conflict&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;exception, retry&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#DD344C;fillColor=#FFF5F5;dashed=0;fontSize=12;fontStyle=0;fontColor=#DD344C;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="330" y="330" width="150" height="42" as="geometry"/></mxCell>
<mxCell id="c19" value='&lt;b&gt;Re-read: $20 &amp;lt; $60&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;payment declined&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#232F3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="330" y="400" width="150" height="42" as="geometry"/></mxCell>
<mxCell id="c20" value='&lt;b&gt;Result: no double spend, RPO 0&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;Every write waits for a second Region to agree,&lt;br&gt;so write latency includes a cross-Region round trip.&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1D8102;fillColor=#F2FAF0;dashed=0;fontSize=12;fontStyle=0;fontColor=#1D8102;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="38" y="490" width="434" height="74" as="geometry"/></mxCell>
<mxCell id="c21" value="Rules for this table" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#C925D1;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="38" y="586" width="440" height="18" as="geometry"/></mxCell>
<mxCell id="c22" value="• Exactly three Regions: three replicas, or two plus a witness.&lt;br&gt;• Every money movement is a conditional write on a version.&lt;br&gt;• Idempotency keys live here too, so a retry that lands in the&lt;br&gt;   other Region still finds the first attempt.&lt;br&gt;• Keep the table small and hot: balances, holds, idempotency.&lt;br&gt;   History goes to a cheaper store through streams.&lt;br&gt;• Check the MRSC feature list (for example transactions)&lt;br&gt;   before you design around it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="38" y="608" width="440" height="122" as="geometry"/></mxCell>
<mxCell id="c23" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#D5D8DC;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="515" y="60" width="470" height="780" as="geometry"/></mxCell>
<mxCell id="h515" value="&lt;b&gt;&lt;/b&gt;" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="531" y="74" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="c24" value="User state: converge, never block" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="587" y="76" width="390" height="21" as="geometry"/></mxCell>
<mxCell id="c25" value="profiles table: DynamoDB global table, eventual consistency (MREC)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="587" y="98" width="390" height="17" as="geometry"/></mxCell>
<mxCell id="c26" value="&lt;b&gt;us-east-1&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#147EBA;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#147EBA;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="570" y="140" width="110" height="26" as="geometry"/></mxCell>
<mxCell id="c27" style="edgeStyle=none;html=1;rounded=0;strokeColor=#C4C7CC;strokeWidth=1.5;dashed=1;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="625" y="166" as="sourcePoint"/><mxPoint x="625" y="470" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c28" value="&lt;b&gt;us-west-2&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#147EBA;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#147EBA;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="820" y="140" width="110" height="26" as="geometry"/></mxCell>
<mxCell id="c29" style="edgeStyle=none;html=1;rounded=0;strokeColor=#C4C7CC;strokeWidth=1.5;dashed=1;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="875" y="166" as="sourcePoint"/><mxPoint x="875" y="470" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c30" value='&lt;b&gt;Phone, 12:00:00.120&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;Put user#42&lt;br&gt;notify = off&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#147EBA;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#147EBA;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="540" y="186" width="170" height="56" as="geometry"/></mxCell>
<mxCell id="c31" value='&lt;b&gt;Laptop, 12:00:00.310&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;Put user#42&lt;br&gt;language = hi&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#147EBA;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#147EBA;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="790" y="186" width="170" height="56" as="geometry"/></mxCell>
<mxCell id="c32" style="edgeStyle=none;html=1;rounded=0;strokeColor=#147EBA;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="625" y="260" as="sourcePoint"/><mxPoint x="875" y="300" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c33" style="edgeStyle=none;html=1;rounded=0;strokeColor=#147EBA;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="875" y="260" as="sourcePoint"/><mxPoint x="625" y="300" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c34" value="replicate ~1 s" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=10;fontColor=#147EBA;fontStyle=1;spacing=0;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="700" y="268" width="100" height="16" as="geometry"/></mxCell>
<mxCell id="c35" value='&lt;b&gt;Both Regions keep the&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;.310 item: language = hi,&lt;br&gt;notify = on (lost update)&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#DD344C;fillColor=#FFF5F5;dashed=0;fontSize=12;fontStyle=0;fontColor=#DD344C;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="540" y="320" width="170" height="56" as="geometry"/></mxCell>
<mxCell id="c36" value='&lt;b&gt;Same item here.&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;The whole item wins,&lt;br&gt;not single attributes&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#DD344C;fillColor=#FFF5F5;dashed=0;fontSize=12;fontStyle=0;fontColor=#DD344C;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="790" y="320" width="170" height="56" as="geometry"/></mxCell>
<mxCell id="c37" value='&lt;b&gt;Fix: one item per setting&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;pk = user#42, sk = pref#notify and sk = pref#language.&lt;br&gt;Two writers now touch two items, and both survive.&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1D8102;fillColor=#F2FAF0;dashed=0;fontSize=12;fontStyle=0;fontColor=#1D8102;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="533" y="490" width="434" height="74" as="geometry"/></mxCell>
<mxCell id="c38" value="Rules for this table" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#C925D1;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="533" y="586" width="440" height="18" as="geometry"/></mxCell>
<mxCell id="c39" value="• Last writer wins is per item, so model data as small items&lt;br&gt;   that one actor changes.&lt;br&gt;• Give each user a home Region claim in the token and send&lt;br&gt;   their writes there while it is healthy.&lt;br&gt;• Append-only facts (devices, sessions) use unique sort keys&lt;br&gt;   and never conflict.&lt;br&gt;• Conditional writes only check the local replica: never use&lt;br&gt;   this table to stop duplicate payments.&lt;br&gt;• Alarm on ReplicationLatency; it is your real RPO here." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="533" y="608" width="440" height="137" as="geometry"/></mxCell>
<mxCell id="c40" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#D5D8DC;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1010" y="60" width="470" height="780" as="geometry"/></mxCell>
<mxCell id="h1010" value="&lt;b&gt;&lt;/b&gt;" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1026" y="74" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="c41" value="Relational back office: one writer" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1082" y="76" width="390" height="21" as="geometry"/></mxCell>
<mxCell id="c42" value="KYC, merchants, settlement: Aurora PostgreSQL Global Database" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1082" y="98" width="390" height="17" as="geometry"/></mxCell>
<mxCell id="c43" value="&lt;b&gt;us-east-1 writer&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#C925D1;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#C925D1;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1065" y="140" width="110" height="26" as="geometry"/></mxCell>
<mxCell id="c44" style="edgeStyle=none;html=1;rounded=0;strokeColor=#C4C7CC;strokeWidth=1.5;dashed=1;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1120" y="166" as="sourcePoint"/><mxPoint x="1120" y="470" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c45" value="&lt;b&gt;us-west-2 reader&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#C925D1;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#C925D1;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1315" y="140" width="110" height="26" as="geometry"/></mxCell>
<mxCell id="c46" style="edgeStyle=none;html=1;rounded=0;strokeColor=#C4C7CC;strokeWidth=1.5;dashed=1;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1370" y="166" as="sourcePoint"/><mxPoint x="1370" y="470" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c47" value='&lt;b&gt;App in us-west-2:&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;UPDATE merchant ...&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#C925D1;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#C925D1;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1285" y="186" width="170" height="42" as="geometry"/></mxCell>
<mxCell id="c48" style="edgeStyle=none;html=1;rounded=0;strokeColor=#C925D1;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1370" y="246" as="sourcePoint"/><mxPoint x="1120" y="270" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c49" value="write forwarding&lt;br&gt;(+ one round trip)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=10;fontColor=#C925D1;fontStyle=1;spacing=0;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1185" y="226" width="120" height="30" as="geometry"/></mxCell>
<mxCell id="c50" value='&lt;b&gt;Commit on the&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;single writer&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1D8102;fillColor=#F2FAF0;dashed=0;fontSize=12;fontStyle=0;fontColor=#1D8102;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1035" y="276" width="170" height="42" as="geometry"/></mxCell>
<mxCell id="c51" style="edgeStyle=none;html=1;rounded=0;strokeColor=#147EBA;strokeWidth=1.5;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1120" y="336" as="sourcePoint"/><mxPoint x="1370" y="360" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c52" value="storage replication,&lt;br&gt;lag typically &amp;lt; 1 s" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=10;fontColor=#147EBA;fontStyle=1;spacing=0;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1185" y="316" width="120" height="30" as="geometry"/></mxCell>
<mxCell id="c53" value='&lt;b&gt;Readers see the row&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;after the lag&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#232F3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1285" y="370" width="170" height="42" as="geometry"/></mxCell>
<mxCell id="c54" value='&lt;b&gt;Result: no write conflicts, by design&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;The price: writes from us-west-2 are slower, and stop&lt;br&gt;until you fail over if us-east-1 is lost.&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1D8102;fillColor=#F2FAF0;dashed=0;fontSize=12;fontStyle=0;fontColor=#1D8102;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1028" y="490" width="434" height="74" as="geometry"/></mxCell>
<mxCell id="c55" value="Rules for this database" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#C925D1;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1028" y="586" width="440" height="18" as="geometry"/></mxCell>
<mxCell id="c56" value="• Apps connect through the global writer endpoint, so a&lt;br&gt;   switchover or failover needs no config change.&lt;br&gt;• Planned move: switchover (RPO 0). Region loss: failover&lt;br&gt;   with allow-data-loss, after a human decision.&lt;br&gt;• Watch AuroraGlobalDBRPOLag; Aurora PostgreSQL can cap it&lt;br&gt;   with the rds.global_db_rpo parameter.&lt;br&gt;• Keep it off the pay path. If it is read-only for five minutes,&lt;br&gt;   customers can still pay." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1028" y="608" width="440" height="122" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
