<mxCell id="c4" value="ledger table: DynamoDB global table, multi-Region strong consistency (MRSC)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="92" y="98" width="390" height="17" as="geometry"/></mxCell>
