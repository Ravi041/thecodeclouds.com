<mxCell id="c46" value="bucket 5&lt;br&gt;0 left" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=10;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="534" y="620" width="74" height="30" as="geometry"/></mxCell>
<mxCell id="c47" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#5F6368;fillColor=#F1F3F4;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="618" y="604" width="74" height="48" as="geometry"/></mxCell>
<mxCell id="c48" value="bucket 6&lt;br&gt;0 left" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=10;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="618" y="620" width="74" height="30" as="geometry"/></mxCell>
<mxCell id="c49" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="702" y="604" width="74" height="48" as="geometry"/></mxCell>
<mxCell id="c50" value="bucket 7&lt;br&gt;50 left" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=10;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="702" y="620" width="74" height="30" as="geometry"/></mxCell>
<mxCell id="c51" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="786" y="604" width="74" height="48" as="geometry"/></mxCell>
<mxCell id="c52" value="bucket 8&lt;br&gt;50 left" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=10;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="786" y="620" width="74" height="30" as="geometry"/></mxCell>
<mxCell id="c53" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="870" y="604" width="74" height="48" as="geometry"/></mxCell>
<mxCell id="c54" value="bucket 9&lt;br&gt;50 left" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=10;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="870" y="620" width="74" height="30" as="geometry"/></mxCell>
<mxCell id="c55" value="Each request picks a random bucket with stock. Empty buckets are skipped." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="534" y="670" width="432" height="16" as="geometry"/></mxCell>
<mxCell id="c56" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#8430CE;fillColor=#8430CE;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1000" y="76" width="460" height="50" as="geometry"/></mxCell>
<mxCell id="c57" value="C  One tap, two orders" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#FFFFFF;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1014" y="90" width="440" height="21" as="geometry"/></mxCell>
<mxCell id="c58" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#D93025;fillColor=#FDF3F2;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1000" y="140" width="460" height="170" as="geometry"/></mxCell>
<mxCell id="c59" value="What happened" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#D93025;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1014" y="152" width="440" height="19" as="geometry"/></mxCell>
<mxCell id="c60" value='Shopper taps "Place order" on a train.&lt;br&gt;Request reaches checkout, order is made,&lt;br&gt;card is charged, response is lost.&lt;br&gt;App shows "Something went wrong",&lt;br&gt;shopper taps again.&lt;br&gt;Result: 0.3 % of mobile orders are&lt;br&gt;duplicates, each one a support ticket.' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1014" y="182" width="436" height="114" as="geometry"/></mxCell>
<mxCell id="c61" style="edgeStyle=none;html=1;rounded=0;strokeColor=#5F6368;strokeWidth=3;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1230" y="314" as="sourcePoint"/><mxPoint x="1230" y="340" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c62" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#F0F9F2;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1000" y="346" width="460" height="410" as="geometry"/></mxCell>
<mxCell id="c63" value="Design that holds" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#1E8E3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1014" y="358" width="440" height="19" as="geometry"/></mxCell>
<mxCell id="c64" value="App makes an Idempotency-Key per&lt;br&gt;   checkout attempt, sends it on retries.&lt;br&gt;Checkout stores key + response for 24 h&lt;br&gt;   (unique index, insert first).&lt;br&gt;Same key, same body → saved response.&lt;br&gt;Same key, different body → 422.&lt;br&gt;Result: duplicates drop to zero." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1014" y="388" width="436" height="114" as="geometry"/></mxCell>
