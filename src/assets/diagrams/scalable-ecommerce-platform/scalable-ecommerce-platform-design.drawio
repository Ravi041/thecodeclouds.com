<mxCell id="c35" value="1.4 k q/s to DBs" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1034" y="352.4" width="195" height="22" as="geometry"/></mxCell>
