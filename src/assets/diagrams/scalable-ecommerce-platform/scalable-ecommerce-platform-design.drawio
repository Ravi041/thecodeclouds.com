<mxCell id="c66" value="order.placed: reservation r-5521 → sold" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontStyle=0;spacing=0;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="689" y="684" width="980" height="17" as="geometry"/></mxCell>
<mxCell id="c67" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#D93025;fillColor=#FDF3F2;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="690" height="150" as="geometry"/></mxCell>
<mxCell id="c68" value="If something fails half way" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#D93025;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="56" y="770" width="660" height="19" as="geometry"/></mxCell>
<mxCell id="c69" value="Step 3 fails (out of stock): return 409, nothing to undo.&lt;br&gt;Step 8 declined: release reservation r-5521, order → PAYMENT_FAILED.&lt;br&gt;Step 8 times out: order → PAYMENT_UNKNOWN, do NOT charge again.&lt;br&gt;   Reconciler asks the PSP by key o-88213 after 60 s and settles it.&lt;br&gt;Shopper never gets step 12: the app retries with the same key,&lt;br&gt;   step 2 returns the first response. One order, one charge." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="56" y="798" width="670" height="98" as="geometry"/></mxCell>
<mxCell id="c70" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#F0F9F2;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="750" y="760" width="710" height="150" as="geometry"/></mxCell>
<mxCell id="c71" value="Why it holds" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#1E8E3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="766" y="770" width="680" height="19" as="geometry"/></mxCell>
<mxCell id="c72" value="Reservations expire on their own, so a crashed checkout never locks stock.&lt;br&gt;Payment is authorized, not captured. Capture happens at shipping.&lt;br&gt;The outbox row commits with the order, so no event is ever lost&lt;br&gt;   and no event is published for an order that rolled back.&lt;br&gt;Everything after step 11 is asynchronous: email, fraud review,&lt;br&gt;   warehouse pick, search update. Checkout does not wait for them." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="766" y="798" width="690" height="98" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="ecom-peak" name="Black Friday: where 180,000 requests per second go"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="750" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Black Friday, 00:00 to 00:15: where 180,000 requests per second go" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1200" height="24" as="geometry"/></mxCell>
