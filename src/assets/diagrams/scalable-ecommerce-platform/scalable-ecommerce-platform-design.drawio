<mxCell id="c38" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1265" y="194.5" width="215" height="171" as="geometry"/></mxCell>
<mxCell id="c39" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1E8E3E;strokeWidth=5;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1265" y="198.5" as="sourcePoint"/><mxPoint x="1265" y="361.5" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c40" value="Buy path" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#1E8E3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1279" y="208.5" width="195" height="20" as="geometry"/></mxCell>
<mxCell id="c41" value="cart 1,100 writes/s&lt;br&gt;checkout 55 orders/s" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1279" y="234.5" width="195" height="32" as="geometry"/></mxCell>
<mxCell id="c42" value="55 payments/s" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1279" y="331.5" width="195" height="22" as="geometry"/></mxCell>
<mxCell id="c43" value="198 k orders&lt;br&gt;in the first hour" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1E8E3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1279" y="266" width="195" height="32" as="geometry"/></mxCell>
<mxCell id="c44" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1A73E8;fillColor=#F1F6FE;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="700" height="230" as="geometry"/></mxCell>
<mxCell id="c45" value="Capacity plan for the night" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#1A73E8;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="56" y="510" width="660" height="19" as="geometry"/></mxCell>
<mxCell id="c46" value="T-30 days" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1A73E8;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="56" y="540" width="90" height="18" as="geometry"/></mxCell>
<mxCell id="c47" value="load test at 1.5x forecast (270 k req/s at the edge)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="150" y="540" width="580" height="18" as="geometry"/></mxCell>
<mxCell id="c48" value="T-7 days" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1A73E8;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="56" y="570" width="90" height="18" as="geometry"/></mxCell>
<mxCell id="c49" value="change freeze on the buy path, kill switches tested" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="150" y="570" width="580" height="18" as="geometry"/></mxCell>
<mxCell id="c50" value="T-2 h" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1A73E8;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="56" y="600" width="90" height="18" as="geometry"/></mxCell>
<mxCell id="c51" value="pre-scale: checkout 12 → 60 pods, DB read replicas 2 → 6" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="150" y="600" width="580" height="18" as="geometry"/></mxCell>
<mxCell id="c52" value="T-15 min" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1A73E8;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="56" y="630" width="90" height="18" as="geometry"/></mxCell>
<mxCell id="c53" value="waiting room on, recommendations on cached fallback" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="150" y="630" width="580" height="18" as="geometry"/></mxCell>
<mxCell id="c54" value="T+0" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1A73E8;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="56" y="660" width="90" height="18" as="geometry"/></mxCell>
<mxCell id="c55" value="watch orders/min and payment success rate, not CPU" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="150" y="660" width="580" height="18" as="geometry"/></mxCell>
<mxCell id="c56" value="T+3 h" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1A73E8;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="56" y="690" width="90" height="18" as="geometry"/></mxCell>
<mxCell id="c57" value="scale down in 25 % steps; room off after 10 min of empty queue" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="150" y="690" width="580" height="18" as="geometry"/></mxCell>
<mxCell id="c58" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#E37400;fillColor=#FEF7E0;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="760" y="500" width="700" height="230" as="geometry"/></mxCell>
<mxCell id="c59" value="Why not just autoscale?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#E37400;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="776" y="510" width="660" height="19" as="geometry"/></mxCell>
<mxCell id="c60" value="Traffic went from 9 k to 180 k req/s in 90 seconds.&lt;br&gt;A new pod takes ~45 s to be ready, a new node ~3 min,&lt;br&gt;a new database read replica 10 to 20 min.&lt;br&gt;Autoscaling reacts to load you already have. For a peak you know&lt;br&gt;is coming, scale before it and let autoscaling handle only the&lt;br&gt;surprise on top. The waiting room covers the rest:&lt;br&gt;a 4 minute queue beats a 40 minute outage." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="776" y="540" width="680" height="114" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="ecom-failures" name="Three production failures and the design that survives them"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="780" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Three production failures, and the design that survives each one" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1200" height="24" as="geometry"/></mxCell>
<mxCell id="c2" value="Top: what happened. Bottom: what the platform does instead. All three are covered in the article with numbers." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5F6368;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1200" height="18" as="geometry"/></mxCell>
<mxCell id="c3" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#D93025;fillColor=#D93025;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="460" height="50" as="geometry"/></mxCell>
<mxCell id="c4" value="A  Payment provider slows down" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#FFFFFF;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="54" y="90" width="440" height="21" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#D93025;fillColor=#FDF3F2;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="460" height="170" as="geometry"/></mxCell>
<mxCell id="c6" value="What happened" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#D93025;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="54" y="152" width="440" height="19" as="geometry"/></mxCell>
<mxCell id="c7" value="PSP p99 goes from 400 ms to 12 s.&lt;br&gt;Client timeout is the library default, 60 s.&lt;br&gt;55 orders/s x 12 s = 660 calls in flight.&lt;br&gt;60 pods x 10 pooled PSP connections = 600.&lt;br&gt;Requests queue for the pool, health checks&lt;br&gt;time out, pods restart. Cart shares the&lt;br&gt;pool, so the whole buy path goes down." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="54" y="182" width="436" height="114" as="geometry"/></mxCell>
<mxCell id="c8" style="edgeStyle=none;html=1;rounded=0;strokeColor=#5F6368;strokeWidth=3;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="314" as="sourcePoint"/><mxPoint x="270" y="340" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c9" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#F0F9F2;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="346" width="460" height="410" as="geometry"/></mxCell>
<mxCell id="c10" value="Design that holds" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#1E8E3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="54" y="358" width="440" height="19" as="geometry"/></mxCell>
<mxCell id="c11" value="Timeout 3 s, one retry with the same key.&lt;br&gt;Circuit breaker opens at 20 % failures&lt;br&gt;   over 30 s, routes new auths to PSP B.&lt;br&gt;Separate pool (bulkhead) per dependency.&lt;br&gt;Unknown result → PAYMENT_UNKNOWN,&lt;br&gt;   reconciler settles it in 60 s.&lt;br&gt;Result: 2 % of orders delayed, 0 lost." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="54" y="388" width="436" height="114" as="geometry"/></mxCell>
<mxCell id="c12" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#5F6368;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="54" y="590" width="100" height="40" as="geometry"/></mxCell>
<mxCell id="c13" value="Checkout" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="54" y="602" width="100" height="17" as="geometry"/></mxCell>
<mxCell id="c14" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#E37400;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="204" y="582" width="110" height="56" as="geometry"/></mxCell>
<mxCell id="c15" value="Breaker&lt;br&gt;closed / open" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="204" y="602" width="110" height="32" as="geometry"/></mxCell>
<mxCell id="c16" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#D93025;fillColor=#FDF3F2;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="366" y="540" width="120" height="40" as="geometry"/></mxCell>
<mxCell id="c17" value="PSP A  p99 12 s" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="366" y="552" width="120" height="17" as="geometry"/></mxCell>
<mxCell id="c18" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="366" y="650" width="120" height="40" as="geometry"/></mxCell>
<mxCell id="c19" value="PSP B  p99 380 ms" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#202124;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="366" y="662" width="120" height="17" as="geometry"/></mxCell>
<mxCell id="c20" style="edgeStyle=none;html=1;rounded=0;strokeColor=#5F6368;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="154" y="610" as="sourcePoint"/><mxPoint x="202" y="610" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c21" style="edgeStyle=none;html=1;rounded=0;strokeColor=#D93025;strokeWidth=2;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="314" y="602" as="sourcePoint"/><mxPoint x="364" y="560" as="targetPoint"/><Array as="points"><mxPoint x="340" y="602"/><mxPoint x="340" y="560"/></Array></mxGeometry></mxCell>
<mxCell id="c22" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1E8E3E;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="314" y="618" as="sourcePoint"/><mxPoint x="364" y="670" as="targetPoint"/><Array as="points"><mxPoint x="340" y="618"/><mxPoint x="340" y="670"/></Array></mxGeometry></mxCell>
<mxCell id="c23" value="3 s timeout" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#D93025;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="334" y="522" width="140" height="16" as="geometry"/></mxCell>
<mxCell id="c24" value="new auths after trip" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#1E8E3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="344" y="700" width="150" height="16" as="geometry"/></mxCell>
<mxCell id="c25" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#E37400;fillColor=#E37400;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="520" y="76" width="460" height="50" as="geometry"/></mxCell>
<mxCell id="c26" value="B  500 TVs, 40,000 buyers" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#FFFFFF;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="534" y="90" width="440" height="21" as="geometry"/></mxCell>
<mxCell id="c27" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#D93025;fillColor=#FDF3F2;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="520" y="140" width="460" height="170" as="geometry"/></mxCell>
<mxCell id="c28" value="What happened" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#D93025;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="534" y="152" width="440" height="19" as="geometry"/></mxCell>
<mxCell id="c29" value='Doorbuster: 500 units at 00:00.&lt;br&gt;40,000 checkouts in the first 10 s.&lt;br&gt;Code reads stock, checks &amp;gt; 0, then writes.&lt;br&gt;Hundreds of requests read "available"&lt;br&gt;before any write lands.&lt;br&gt;Result: 731 orders for 500 TVs,&lt;br&gt;231 apology emails and refunds.' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="534" y="182" width="436" height="114" as="geometry"/></mxCell>
<mxCell id="c30" style="edgeStyle=none;html=1;rounded=0;strokeColor=#5F6368;strokeWidth=3;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="314" as="sourcePoint"/><mxPoint x="750" y="340" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c31" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#1E8E3E;fillColor=#F0F9F2;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="520" y="346" width="460" height="410" as="geometry"/></mxCell>
<mxCell id="c32" value="Design that holds" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#1E8E3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="534" y="358" width="440" height="19" as="geometry"/></mxCell>
<mxCell id="c33" value="One atomic statement, no read first:&lt;br&gt;   UPDATE stock SET reserved = reserved + 1&lt;br&gt;   WHERE sku = ? AND on_hand - reserved &amp;gt;= 1&lt;br&gt;Hot SKU split into 10 rows of 50 units&lt;br&gt;   to spread row-lock contention.&lt;br&gt;Reservation expires after 10 minutes.&lt;br&gt;Result: exactly 500 sold, p99 80 ms." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="534" y="388" width="436" height="114" as="geometry"/></mxCell>
<mxCell id="c34" value="SKU-TV55 stock split into 10 rows" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="534" y="520" width="432" height="17" as="geometry"/></mxCell>
