<mxCell id="c108" value="nodes here keep egress" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#605E5C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="896" y="890" width="196" height="16" as="geometry"/></mxCell>
<mxCell id="c109" value="&lt;b&gt;What shoppers and on-call actually see&lt;/b&gt;" style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;strokeColor=#CA5010;fillColor=#FFFAF5;dashed=0;strokeWidth=1;fontSize=12;fontColor=#CA5010;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1130" y="92" width="480" height="560" as="geometry"/></mxCell>
<mxCell id="c110" value="0 s" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;strokeColor=#CA5010;fillColor=#FFFFFF;fontSize=11;fontColor=#CA5010;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1146" y="136" width="76" height="24" as="geometry"/></mxCell>
<mxCell id="c111" value="In-flight requests on zone 2 pods fail. Front&lt;br&gt;Door shows a burst of 502s and 504s." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#201F1E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1234" y="138" width="360" height="32" as="geometry"/></mxCell>
<mxCell id="c112" value="5–15 s" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;strokeColor=#CA5010;fillColor=#FFFFFF;fontSize=11;fontColor=#CA5010;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1146" y="208" width="76" height="24" as="geometry"/></mxCell>
<mxCell id="c113" value="Load balancer probes and kube-proxy stop&lt;br&gt;sending to zone 2. Redis and Search promote&lt;br&gt;replicas." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#201F1E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1234" y="210" width="360" height="47" as="geometry"/></mxCell>
<mxCell id="c114" value="&amp;lt; 30 s" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;strokeColor=#CA5010;fillColor=#FFFFFF;fontSize=11;fontColor=#CA5010;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1146" y="280" width="76" height="24" as="geometry"/></mxCell>
<mxCell id="c115" value="Azure SQL completes its zone failover. Apps&lt;br&gt;with retry logic reconnect on their own." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#201F1E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1234" y="282" width="360" height="32" as="geometry"/></mxCell>
<mxCell id="c116" value="~1 min" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;strokeColor=#CA5010;fillColor=#FFFFFF;fontSize=11;fontColor=#CA5010;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1146" y="352" width="76" height="24" as="geometry"/></mxCell>
<mxCell id="c117" value="HPA sees CPU climb on the remaining pods and&lt;br&gt;adds replicas. Some go Pending." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#201F1E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1234" y="354" width="360" height="32" as="geometry"/></mxCell>
<mxCell id="c118" value="2–5 min" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;strokeColor=#CA5010;fillColor=#FFFFFF;fontSize=11;fontColor=#CA5010;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1146" y="424" width="76" height="24" as="geometry"/></mxCell>
<mxCell id="c119" value="Node autoprovisioning or the cluster&lt;br&gt;autoscaler adds nodes in zones 1 and 3, if&lt;br&gt;capacity exists there." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#201F1E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1234" y="426" width="360" height="47" as="geometry"/></mxCell>
<mxCell id="c120" value="5 min" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;strokeColor=#CA5010;fillColor=#FFFFFF;fontSize=11;fontColor=#CA5010;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1146" y="496" width="76" height="24" as="geometry"/></mxCell>
<mxCell id="c121" value="Pods stuck on unreachable nodes are finally&lt;br&gt;evicted (default tolerationSeconds 300)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#201F1E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1234" y="498" width="360" height="32" as="geometry"/></mxCell>
<mxCell id="c122" value="Zone back" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;strokeColor=#CA5010;fillColor=#FFFFFF;fontSize=11;fontColor=#CA5010;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1146" y="568" width="76" height="24" as="geometry"/></mxCell>
<mxCell id="c123" value="Nothing rebalances by itself. Roll the&lt;br&gt;deployments or run the descheduler." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#201F1E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1234" y="570" width="360" height="32" as="geometry"/></mxCell>
<mxCell id="c124" value="&lt;b&gt;Built in advance, or it does not work&lt;/b&gt;" style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;strokeColor=#107C10;fillColor=#F5FBF5;dashed=0;strokeWidth=1;fontSize=12;fontColor=#107C10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1130" y="668" width="480" height="324" as="geometry"/></mxCell>
<mxCell id="c125" value="• Each zone sized to carry 50% of peak, not 33%&lt;br&gt;• topologySpreadConstraints on zone, PDB per service&lt;br&gt;• One node pool per zone, or NAP with zone spread&lt;br&gt;• ZRS disks for anything stateful left in AKS&lt;br&gt;• Retries with backoff on SQL, Redis, Search clients&lt;br&gt;• Idempotent checkout so a retried POST is safe&lt;br&gt;• Alert on Front Door 5xx by origin, not CPU&lt;br&gt;• Chaos Studio zone-down drill every quarter" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#201F1E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1146" y="704" width="450" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
