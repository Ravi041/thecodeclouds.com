<mxCell id="c103" value="down with its zone" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#605E5C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="606" y="890" width="196" height="16" as="geometry"/></mxCell>
<mxCell id="c104" style="edgeStyle=none;html=1;rounded=0;strokeColor=#C4314B;strokeWidth=4;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="558" y="872" as="sourcePoint"/><mxPoint x="592" y="906" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c105" style="edgeStyle=none;html=1;rounded=0;strokeColor=#C4314B;strokeWidth=4;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="558" y="906" as="sourcePoint"/><mxPoint x="592" y="872" as="targetPoint"/></mxGeometry></mxCell>
