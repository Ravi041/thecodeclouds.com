<mxCell id="c118" value="2–5 min" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;strokeColor=#CA5010;fillColor=#FFFFFF;fontSize=11;fontColor=#CA5010;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1146" y="424" width="76" height="24" as="geometry"/></mxCell>
<mxCell id="c119" value="Node autoprovisioning or the cluster&lt;br&gt;autoscaler adds nodes in zones 1 and 3, if&lt;br&gt;capacity exists there." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#201F1E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1234" y="426" width="360" height="47" as="geometry"/></mxCell>
<mxCell id="c120" value="5 min" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;strokeColor=#CA5010;fillColor=#FFFFFF;fontSize=11;fontColor=#CA5010;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1146" y="496" width="76" height="24" as="geometry"/></mxCell>
<mxCell id="c121" value="Pods stuck on unreachable nodes are finally&lt;br&gt;evicted (default tolerationSeconds 300)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#201F1E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1234" y="498" width="360" height="32" as="geometry"/></mxCell>
<mxCell id="c122" value="Zone back" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;strokeColor=#CA5010;fillColor=#FFFFFF;fontSize=11;fontColor=#CA5010;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1146" y="568" width="76" height="24" as="geometry"/></mxCell>
<mxCell id="c123" value="Nothing rebalances by itself. Roll the&lt;br&gt;deployments or run the descheduler." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#201F1E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1234" y="570" width="360" height="32" as="geometry"/></mxCell>
<mxCell id="c124" value="&lt;b&gt;Built in advance, or it does not work&lt;/b&gt;" style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;strokeColor=#107C10;fillColor=#F5FBF5;dashed=0;strokeWidth=1;fontSize=12;fontColor=#107C10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1130" y="668" width="480" height="324" as="geometry"/></mxCell>
<mxCell id="c125" value="• Each zone sized to carry 50% of peak, not 33%&lt;br&gt;• topologySpreadConstraints on zone, PDB per service&lt;br&gt;• One node pool per zone, or NAP with zone spread&lt;br&gt;• ZRS disks for anything stateful left in AKS&lt;br&gt;• Retries with backoff on SQL, Redis, Search clients&lt;br&gt;• Idempotent checkout so a retried POST is safe&lt;br&gt;• Alert on Front Door 5xx by origin, not CPU&lt;br&gt;• Chaos Studio zone-down drill every quarter" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#201F1E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1146" y="704" width="450" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="azure-ecommerce-flash-sale" name="E-commerce on Azure: flash sale traffic spike"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Scenario: a limited drop at 18:00 sends 20x normal traffic in 90 seconds" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#201F1E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1300" height="26" as="geometry"/></mxCell>
<mxCell id="c2" value="The trick is to make every layer say no early and cheaply, so the one thing that cannot scale fast (the order database) only sees what it can take." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#605E5C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1400" height="18" as="geometry"/></mxCell>
<mxCell id="s0" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#C4314B;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="196" height="290" as="geometry"/></mxCell>
<mxCell id="c4" value="1" style="ellipse;html=1;fillColor=#C4314B;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c5" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#201F1E;image=img/lib/azure2/networking/Front_Doors.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="114" y="132.85" width="48" height="42.3" as="geometry"/></mxCell>
<mxCell id="c6" value="Front Door cache" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#201F1E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="52" y="196" width="172" height="20" as="geometry"/></mxCell>
<mxCell id="c7" value="Product and drop pages cached&lt;br&gt;30–60 s. Images and JS for a&lt;br&gt;day. Most GETs never reach a&lt;br&gt;region." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#201F1E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="54" y="224" width="168" height="62" as="geometry"/></mxCell>
<mxCell id="c8" value="100k req/s in" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;strokeColor=#C4314B;fillColor=#FFFFFF;fontSize=11;fontColor=#C4314B;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="52" y="350" width="172" height="26" as="geometry"/></mxCell>
<mxCell id="s1" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#C4314B;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="262" y="100" width="196" height="290" as="geometry"/></mxCell>
<mxCell id="c10" value="2" style="ellipse;html=1;fillColor=#C4314B;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="272" y="110" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c11" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#201F1E;image=img/lib/azure2/networking/Web_Application_Firewall_Policies_WAF.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="336" y="130.14" width="48" height="47.72" as="geometry"/></mxCell>
<mxCell id="c12" value="WAF at the edge" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#201F1E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="274" y="196" width="172" height="20" as="geometry"/></mxCell>
<mxCell id="c13" value="Bot Manager rule set, JS&lt;br&gt;challenge on the drop path,&lt;br&gt;rate limit 100 req/min per IP&lt;br&gt;on /cart and /checkout." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#201F1E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="276" y="224" width="168" height="62" as="geometry"/></mxCell>
<mxCell id="c14" value="bots and scripts out" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;strokeColor=#C4314B;fillColor=#FFFFFF;fontSize=11;fontColor=#C4314B;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="274" y="350" width="172" height="26" as="geometry"/></mxCell>
<mxCell id="s2" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#CA5010;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="484" y="100" width="196" height="290" as="geometry"/></mxCell>
<mxCell id="c16" value="3" style="ellipse;html=1;fillColor=#CA5010;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="494" y="110" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c17" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#201F1E;image=img/lib/azure2/databases/Azure_Managed_Redis.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="558" y="130" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="c18" value="Admission tokens" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#201F1E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="496" y="196" width="172" height="20" as="geometry"/></mxCell>
<mxCell id="c19" value="Storefront hands out checkout&lt;br&gt;tokens from Managed Redis at a&lt;br&gt;fixed rate. Everyone else sees&lt;br&gt;a queue page." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#201F1E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="498" y="224" width="168" height="62" as="geometry"/></mxCell>
<mxCell id="c20" value="≈ 2k checkouts/s let in" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;strokeColor=#CA5010;fillColor=#FFFFFF;fontSize=11;fontColor=#CA5010;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="496" y="350" width="172" height="26" as="geometry"/></mxCell>
<mxCell id="s3" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#0078D4;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="706" y="100" width="196" height="290" as="geometry"/></mxCell>
<mxCell id="c22" value="4" style="ellipse;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="716" y="110" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c23" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#201F1E;image=img/lib/azure2/containers/Kubernetes_Services.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="780" y="132.89" width="48" height="42.21" as="geometry"/></mxCell>
<mxCell id="c24" value="AKS, pre-scaled" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#201F1E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="718" y="196" width="172" height="20" as="geometry"/></mxCell>
<mxCell id="c25" value="Min replicas raised an hour&lt;br&gt;before. HPA on RPS, KEDA on&lt;br&gt;queue depth, spare nodes held&lt;br&gt;by low-priority pods." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#201F1E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="720" y="224" width="168" height="62" as="geometry"/></mxCell>
<mxCell id="c26" value="no cold starts" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;strokeColor=#0078D4;fillColor=#FFFFFF;fontSize=11;fontColor=#0078D4;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="718" y="350" width="172" height="26" as="geometry"/></mxCell>
<mxCell id="s4" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#CA5010;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="928" y="100" width="196" height="290" as="geometry"/></mxCell>
<mxCell id="c28" value="5" style="ellipse;html=1;fillColor=#CA5010;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="938" y="110" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c29" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#201F1E;image=img/lib/azure2/databases/Azure_Managed_Redis.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1002" y="130" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="c30" value="Stock in Redis" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#201F1E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="940" y="196" width="172" height="20" as="geometry"/></mxCell>
<mxCell id="c31" value="One counter per SKU. DECRBY is&lt;br&gt;atomic, so 50k people cannot&lt;br&gt;buy 500 units. Negative means&lt;br&gt;sold out." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#201F1E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="942" y="224" width="168" height="62" as="geometry"/></mxCell>
<mxCell id="c32" value="oversell impossible" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;strokeColor=#CA5010;fillColor=#FFFFFF;fontSize=11;fontColor=#CA5010;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="350" width="172" height="26" as="geometry"/></mxCell>
<mxCell id="s5" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#8661C5;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1150" y="100" width="196" height="290" as="geometry"/></mxCell>
<mxCell id="c34" value="6" style="ellipse;html=1;fillColor=#8661C5;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1160" y="110" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c35" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#201F1E;image=img/lib/azure2/integration/Service_Bus.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1224" y="132.62" width="48" height="42.75" as="geometry"/></mxCell>
<mxCell id="c36" value="Service Bus queue" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#201F1E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1162" y="196" width="172" height="20" as="geometry"/></mxCell>
<mxCell id="c37" value="Checkout returns 202 with an&lt;br&gt;order number. Workers drain&lt;br&gt;the queue at the pace SQL can&lt;br&gt;take." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#201F1E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1164" y="224" width="168" height="62" as="geometry"/></mxCell>
<mxCell id="c38" value="spike becomes a slope" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;strokeColor=#8661C5;fillColor=#FFFFFF;fontSize=11;fontColor=#8661C5;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1162" y="350" width="172" height="26" as="geometry"/></mxCell>
<mxCell id="s6" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#107C10;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1372" y="100" width="196" height="290" as="geometry"/></mxCell>
<mxCell id="c40" value="7" style="ellipse;html=1;fillColor=#107C10;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1382" y="110" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c41" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#201F1E;image=img/lib/azure2/databases/SQL_Database.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1451.9" y="130" width="36.2" height="48" as="geometry"/></mxCell>
<mxCell id="c42" value="Azure SQL" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#201F1E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1384" y="196" width="172" height="20" as="geometry"/></mxCell>
<mxCell id="c43" value="Writes orders in batches.&lt;br&gt;Stock reconciled from Redis&lt;br&gt;every minute. SQL stays the&lt;br&gt;source of truth." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#201F1E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1386" y="224" width="168" height="62" as="geometry"/></mxCell>
<mxCell id="c44" value="≈ 400 orders/s, steady" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;strokeColor=#107C10;fillColor=#FFFFFF;fontSize=11;fontColor=#107C10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1384" y="350" width="172" height="26" as="geometry"/></mxCell>
<mxCell id="c45" style="edgeStyle=none;html=1;rounded=0;strokeColor=#605E5C;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
