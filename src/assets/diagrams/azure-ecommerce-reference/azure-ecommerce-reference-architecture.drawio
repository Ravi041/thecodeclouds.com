<mxCell id="c151" value="Rules for every subscriber" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#201F1E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1096" y="662" width="460" height="18" as="geometry"/></mxCell>
<mxCell id="c152" value="• Peek-lock, complete only after the work is committed&lt;br&gt;• Idempotent: the same OrderPlaced twice changes nothing&lt;br&gt;• Max delivery count 10, then dead-letter and alert&lt;br&gt;• KEDA scales each worker on its own subscription depth&lt;br&gt;• Duplicate detection on the topic, MessageId = orderId" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#605E5C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1096" y="688" width="470" height="77" as="geometry"/></mxCell>
<mxCell id="c153" value='&lt;b&gt;Dead-letter queue&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;replayed by a runbook&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#201F1E;image=img/lib/azure2/integration/Service_Bus.svg;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1300" y="867.97" width="36" height="32.07" as="geometry"/></mxCell></root></mxGraphModel></diagram>
