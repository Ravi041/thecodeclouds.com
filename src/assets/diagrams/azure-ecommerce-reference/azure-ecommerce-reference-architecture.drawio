<mxCell id="c47" style="edgeStyle=none;html=1;rounded=0;strokeColor=#605E5C;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c48" style="edgeStyle=none;html=1;rounded=0;strokeColor=#605E5C;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c49" style="edgeStyle=none;html=1;rounded=0;strokeColor=#605E5C;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c50" style="edgeStyle=none;html=1;rounded=0;strokeColor=#605E5C;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c51" value="Request rates are illustrative, for a store that normally peaks at 5k req/s." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#605E5C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="402" width="900" height="17" as="geometry"/></mxCell>
<mxCell id="c52" value="&lt;b&gt;What breaks first when nobody planned for it&lt;/b&gt;" style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;strokeColor=#C4314B;fillColor=#FDF8F8;dashed=0;strokeWidth=1;fontSize=12;fontColor=#C4314B;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="30" y="450" width="780" height="430" as="geometry"/></mxCell>
<mxCell id="c53" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#201F1E;image=img/lib/azure2/databases/SQL_Database.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="54.18" y="496" width="25.64" height="34" as="geometry"/></mxCell>
<mxCell id="c54" value="One hot row" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#201F1E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="496" width="690" height="18" as="geometry"/></mxCell>
<mxCell id="c55" value="UPDATE stock SET qty = qty - 1 WHERE sku = ... from 3,000 sessions. Lock waits, then timeouts, then&lt;br&gt;retries that make it worse." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#605E5C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="514" width="690" height="32" as="geometry"/></mxCell>
<mxCell id="c56" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#201F1E;image=img/lib/azure2/databases/Azure_Cosmos_DB.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="50" y="572.09" width="34" height="33.82" as="geometry"/></mxCell>
<mxCell id="c57" value="One hot partition" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#201F1E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="572" width="690" height="18" as="geometry"/></mxCell>
<mxCell id="c58" value="Carts keyed by /skuId instead of /cartId. One physical partition takes the whole drop and returns&lt;br&gt;429s." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#605E5C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="590" width="690" height="32" as="geometry"/></mxCell>
<mxCell id="c59" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#201F1E;image=img/lib/azure2/app_services/Search_Services.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="50" y="652.63" width="34" height="24.74" as="geometry"/></mxCell>
<mxCell id="c60" value="Search scale-out started too late" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#201F1E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="648" width="690" height="18" as="geometry"/></mxCell>
<mxCell id="c61" value="Adding AI Search replicas can take hours. Scale the day before, not when latency alerts fire." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#605E5C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="666" width="690" height="17" as="geometry"/></mxCell>
<mxCell id="c62" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#201F1E;image=img/lib/azure2/containers/Kubernetes_Services.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="50" y="726.05" width="34" height="29.9" as="geometry"/></mxCell>
<mxCell id="c63" value="Pending pods, no nodes" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#201F1E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="724" width="690" height="18" as="geometry"/></mxCell>
<mxCell id="c64" value="HPA wants 300 pods, the node pool max is 40, and the region is short on that VM size today." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#605E5C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="742" width="690" height="17" as="geometry"/></mxCell>
<mxCell id="c65" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#201F1E;image=img/lib/azure2/networking/Web_Application_Firewall_Policies_WAF.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="50" y="800.1" width="34" height="33.8" as="geometry"/></mxCell>
<mxCell id="c66" value="WAF blocks real buyers" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#201F1E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="800" width="690" height="18" as="geometry"/></mxCell>
<mxCell id="c67" value="A rate limit counted per socket IP throttles a whole mobile carrier NAT. Test limits with real&lt;br&gt;traffic in detection mode." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#605E5C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="818" width="690" height="32" as="geometry"/></mxCell>
<mxCell id="c68" value="&lt;b&gt;Runbook: T-24h to T+1h&lt;/b&gt;" style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;strokeColor=#107C10;fillColor=#F5FBF5;dashed=0;strokeWidth=1;fontSize=12;fontColor=#107C10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="830" y="450" width="780" height="430" as="geometry"/></mxCell>
<mxCell id="c69" value="T-24h" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;strokeColor=#107C10;fillColor=#FFFFFF;fontSize=11;fontColor=#107C10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="846" y="498" width="70" height="24" as="geometry"/></mxCell>
<mxCell id="c70" value="Scale AI Search replicas, raise Cosmos DB autoscale max RU/s, request VM quota in both&lt;br&gt;regions" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#201F1E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="930" y="500" width="670" height="32" as="geometry"/></mxCell>
<mxCell id="c71" value="T-2h" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;strokeColor=#107C10;fillColor=#FFFFFF;fontSize=11;fontColor=#107C10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="846" y="560" width="70" height="24" as="geometry"/></mxCell>
<mxCell id="c72" value="Load stock counters into Redis, warm Front Door cache for the drop pages, freeze deploys" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#201F1E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="930" y="562" width="670" height="17" as="geometry"/></mxCell>
<mxCell id="c73" value="T-1h" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;strokeColor=#107C10;fillColor=#FFFFFF;fontSize=11;fontColor=#107C10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="846" y="622" width="70" height="24" as="geometry"/></mxCell>
<mxCell id="c74" value="Raise HPA minReplicas and node pool minimums, add buffer pods, switch WAF challenge on" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#201F1E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="930" y="624" width="670" height="17" as="geometry"/></mxCell>
<mxCell id="c75" value="T-0" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;strokeColor=#107C10;fillColor=#FFFFFF;fontSize=11;fontColor=#107C10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="846" y="684" width="70" height="24" as="geometry"/></mxCell>
<mxCell id="c76" value="Watch: Front Door 429/5xx by route, queue depth, SQL waits, Redis CPU, admission rate" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#201F1E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="930" y="686" width="670" height="17" as="geometry"/></mxCell>
<mxCell id="c77" value="T+15m" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;strokeColor=#107C10;fillColor=#FFFFFF;fontSize=11;fontColor=#107C10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="846" y="746" width="70" height="24" as="geometry"/></mxCell>
<mxCell id="c78" value="Lower the admission rate if SQL waits climb. Never raise it past what the workers drain" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#201F1E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="930" y="748" width="670" height="17" as="geometry"/></mxCell>
<mxCell id="c79" value="T+1h" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;strokeColor=#107C10;fillColor=#FFFFFF;fontSize=11;fontColor=#107C10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="846" y="808" width="70" height="24" as="geometry"/></mxCell>
<mxCell id="c80" value="Reconcile Redis stock against SQL, release reservations, scale back, write the review" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#201F1E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="930" y="810" width="670" height="17" as="geometry"/></mxCell></root></mxGraphModel></diagram>
