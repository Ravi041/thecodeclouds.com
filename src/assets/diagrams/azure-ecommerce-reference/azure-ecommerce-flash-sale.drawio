<mxCell id="c30" value="Stock in Redis" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#201F1E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="940" y="196" width="172" height="20" as="geometry"/></mxCell>
<mxCell id="c31" value="One counter per SKU. DECRBY is&lt;br&gt;atomic, so 50k people cannot&lt;br&gt;buy 500 units. Negative means&lt;br&gt;sold out." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#201F1E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="942" y="224" width="168" height="62" as="geometry"/></mxCell>
<mxCell id="c32" value="oversell impossible" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;strokeColor=#CA5010;fillColor=#FFFFFF;fontSize=11;fontColor=#CA5010;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="350" width="172" height="26" as="geometry"/></mxCell>
