<mxCell id="c74" value="Raise HPA minReplicas and node pool minimums, add buffer pods, switch WAF challenge on" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#201F1E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="930" y="624" width="670" height="17" as="geometry"/></mxCell>
