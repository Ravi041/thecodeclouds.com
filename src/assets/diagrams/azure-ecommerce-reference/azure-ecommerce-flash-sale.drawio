<mxCell id="c11" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#201F1E;image=img/lib/azure2/networking/Web_Application_Firewall_Policies_WAF.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="336" y="130.14" width="48" height="47.72" as="geometry"/></mxCell>
<mxCell id="c12" value="WAF at the edge" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#201F1E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="274" y="196" width="172" height="20" as="geometry"/></mxCell>
<mxCell id="c13" value="Bot Manager rule set, JS&lt;br&gt;challenge on the drop path,&lt;br&gt;rate limit 100 req/min per IP&lt;br&gt;on /cart and /checkout." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#201F1E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="276" y="224" width="168" height="62" as="geometry"/></mxCell>
<mxCell id="c14" value="bots and scripts out" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;strokeColor=#C4314B;fillColor=#FFFFFF;fontSize=11;fontColor=#C4314B;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="274" y="350" width="172" height="26" as="geometry"/></mxCell>
