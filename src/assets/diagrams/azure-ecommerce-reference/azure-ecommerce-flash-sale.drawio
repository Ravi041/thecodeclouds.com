<mxCell id="c63" value="Pending pods, no nodes" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#201F1E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="724" width="690" height="18" as="geometry"/></mxCell>
<mxCell id="c64" value="HPA wants 300 pods, the node pool max is 40, and the region is short on that VM size today." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#605E5C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="742" width="690" height="17" as="geometry"/></mxCell>
<mxCell id="c65" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#201F1E;image=img/lib/azure2/networking/Web_Application_Firewall_Policies_WAF.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="50" y="800.1" width="34" height="33.8" as="geometry"/></mxCell>
<mxCell id="c66" value="WAF blocks real buyers" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#201F1E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="800" width="690" height="18" as="geometry"/></mxCell>
<mxCell id="c67" value="A rate limit counted per socket IP throttles a whole mobile carrier NAT. Test limits with real&lt;br&gt;traffic in detection mode." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#605E5C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="818" width="690" height="32" as="geometry"/></mxCell>
