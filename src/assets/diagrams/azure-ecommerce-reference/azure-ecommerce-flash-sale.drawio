<mxCell id="c36" value="Service Bus queue" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#201F1E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1162" y="196" width="172" height="20" as="geometry"/></mxCell>
<mxCell id="c37" value="Checkout returns 202 with an&lt;br&gt;order number. Workers drain&lt;br&gt;the queue at the pace SQL can&lt;br&gt;take." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#201F1E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1164" y="224" width="168" height="62" as="geometry"/></mxCell>
