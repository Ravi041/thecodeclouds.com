<mxfile host="thecodeclouds.com" agent="hand-built" version="24.0.0" type="device">
<diagram id="azure-ecommerce-flash-sale" name="E-commerce on Azure: flash sale traffic spike"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Scenario: a limited drop at 18:00 sends 20x normal traffic in 90 seconds" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#201F1E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1300" height="26" as="geometry"/></mxCell>
<mxCell id="c2" value="The trick is to make every layer say no early and cheaply, so the one thing that cannot scale fast (the order database) only sees what it can take." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#605E5C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1400" height="18" as="geometry"/></mxCell>
<mxCell id="s0" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#C4314B;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="196" height="290" as="geometry"/></mxCell>
<mxCell id="c4" value="1" style="ellipse;html=1;fillColor=#C4314B;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c5" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#201F1E;image=img/lib/azure2/networking/Front_Doors.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="114" y="132.85" width="48" height="42.3" as="geometry"/></mxCell>
<mxCell id="c6" value="Front Door cache" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#201F1E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="52" y="196" width="172" height="20" as="geometry"/></mxCell>
<mxCell id="c7" value="Product and drop pages cached&lt;br&gt;30–60 s. Images and JS for a&lt;br&gt;day. Most GETs never reach a&lt;br&gt;region." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#201F1E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="54" y="224" width="168" height="62" as="geometry"/></mxCell>
<mxCell id="c8" value="100k req/s in" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;strokeColor=#C4314B;fillColor=#FFFFFF;fontSize=11;fontColor=#C4314B;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="52" y="350" width="172" height="26" as="geometry"/></mxCell>
