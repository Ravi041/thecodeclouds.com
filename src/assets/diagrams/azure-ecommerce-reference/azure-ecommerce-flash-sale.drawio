<mxCell id="c42" value="Azure SQL" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#201F1E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1384" y="196" width="172" height="20" as="geometry"/></mxCell>
<mxCell id="c43" value="Writes orders in batches.&lt;br&gt;Stock reconciled from Redis&lt;br&gt;every minute. SQL stays the&lt;br&gt;source of truth." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#201F1E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1386" y="224" width="168" height="62" as="geometry"/></mxCell>
