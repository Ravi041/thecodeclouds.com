<mxCell id="c23" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#201F1E;image=img/lib/azure2/containers/Kubernetes_Services.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="780" y="132.89" width="48" height="42.21" as="geometry"/></mxCell>
<mxCell id="c24" value="AKS, pre-scaled" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#201F1E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="718" y="196" width="172" height="20" as="geometry"/></mxCell>
<mxCell id="c25" value="Min replicas raised an hour&lt;br&gt;before. HPA on RPS, KEDA on&lt;br&gt;queue depth, spare nodes held&lt;br&gt;by low-priority pods." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#201F1E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="720" y="224" width="168" height="62" as="geometry"/></mxCell>
<mxCell id="c26" value="no cold starts" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;strokeColor=#0078D4;fillColor=#FFFFFF;fontSize=11;fontColor=#0078D4;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="718" y="350" width="172" height="26" as="geometry"/></mxCell>
<mxCell id="s4" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#CA5010;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="928" y="100" width="196" height="290" as="geometry"/></mxCell>
