<mxCell id="c51" value="Request rates are illustrative, for a store that normally peaks at 5k req/s." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#605E5C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="402" width="900" height="17" as="geometry"/></mxCell>
<mxCell id="c52" value="&lt;b&gt;What breaks first when nobody planned for it&lt;/b&gt;" style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;strokeColor=#C4314B;fillColor=#FDF8F8;dashed=0;strokeWidth=1;fontSize=12;fontColor=#C4314B;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="30" y="450" width="780" height="430" as="geometry"/></mxCell>
<mxCell id="c53" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#201F1E;image=img/lib/azure2/databases/SQL_Database.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="54.18" y="496" width="25.64" height="34" as="geometry"/></mxCell>
<mxCell id="c54" value="One hot row" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#201F1E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="496" width="690" height="18" as="geometry"/></mxCell>
<mxCell id="c55" value="UPDATE stock SET qty = qty - 1 WHERE sku = ... from 3,000 sessions. Lock waits, then timeouts, then&lt;br&gt;retries that make it worse." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#605E5C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="514" width="690" height="32" as="geometry"/></mxCell>
<mxCell id="c56" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#201F1E;image=img/lib/azure2/databases/Azure_Cosmos_DB.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="50" y="572.09" width="34" height="33.82" as="geometry"/></mxCell>
<mxCell id="c57" value="One hot partition" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#201F1E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="572" width="690" height="18" as="geometry"/></mxCell>
<mxCell id="c58" value="Carts keyed by /skuId instead of /cartId. One physical partition takes the whole drop and returns&lt;br&gt;429s." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#605E5C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="590" width="690" height="32" as="geometry"/></mxCell>
<mxCell id="c59" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;fontColor=#201F1E;image=img/lib/azure2/app_services/Search_Services.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="50" y="652.63" width="34" height="24.74" as="geometry"/></mxCell>
<mxCell id="c60" value="Search scale-out started too late" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#201F1E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="648" width="690" height="18" as="geometry"/></mxCell>
<mxCell id="c61" value="Adding AI Search replicas can take hours. Scale the day before, not when latency alerts fire." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#605E5C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="666" width="690" height="17" as="geometry"/></mxCell>
