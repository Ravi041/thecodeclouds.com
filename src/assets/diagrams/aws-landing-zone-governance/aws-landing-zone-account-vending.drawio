<mxCell id="c28" value="&lt;b&gt;Global customizations (every account)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#DD344C;fillColor=#FDF3F4;dashed=0;fontSize=12;fontStyle=0;fontColor=#DD344C;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="460" width="350" height="230" as="geometry"/></mxCell>
<mxCell id="c29" value="- Delete default VPCs in every region&lt;br&gt;- S3 Block Public Access at account level&lt;br&gt;- EBS encryption by default (org CMK)&lt;br&gt;- IAM Access Analyzer (unused access)&lt;br&gt;- Account alternate contacts (security,&lt;br&gt;  billing, operations)&lt;br&gt;- Baseline tags: CostCentre, Owner, DataClass&lt;br&gt;- Root credentials removed (central root&lt;br&gt;  access management)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="392" y="490" width="330" height="137" as="geometry"/></mxCell>
