<mxCell id="c21" value="findings from every account and region" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#DD344C;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1022" y="34" width="450" height="16" as="geometry"/></mxCell>
<mxCell id="c22" value="&lt;b&gt;Three kinds of control, and where each one runs&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#E7157B;fillColor=#FFF5FA;dashed=0;fontSize=12;fontStyle=0;fontColor=#E7157B;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="650" width="1460" height="200" as="geometry"/></mxCell>
<mxCell id="c23" value="Preventive" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="684" width="330" height="19" as="geometry"/></mxCell>
<mxCell id="c24" value="SCPs, RCPs, declarative policies.&lt;br&gt;The API call fails with AccessDenied.&lt;br&gt;Example: StopLogging on the org trail,&lt;br&gt;PutBucketPolicy that makes a bucket public&lt;br&gt;from outside the org." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="708" width="340" height="77" as="geometry"/></mxCell>
<mxCell id="c25" value="Proactive" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="402" y="684" width="330" height="19" as="geometry"/></mxCell>
<mxCell id="c26" value="Control Tower proactive controls&lt;br&gt;(CloudFormation Hooks). The resource is&lt;br&gt;rejected before it is created.&lt;br&gt;Example: an RDS instance without&lt;br&gt;encryption in a CloudFormation stack." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="402" y="708" width="340" height="77" as="geometry"/></mxCell>
<mxCell id="c27" value="Detective" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="764" y="684" width="330" height="19" as="geometry"/></mxCell>
<mxCell id="c28" value="Config rules, Security Hub controls,&lt;br&gt;GuardDuty. Something already exists&lt;br&gt;and is reported, then fixed or excepted.&lt;br&gt;Example: a security group open to&lt;br&gt;0.0.0.0/0 on port 22." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="764" y="708" width="340" height="77" as="geometry"/></mxCell>
<mxCell id="c29" value="Responsive" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1126" y="684" width="330" height="19" as="geometry"/></mxCell>
<mxCell id="c30" value="EventBridge + Lambda / SSM Automation.&lt;br&gt;Only for fixes that are safe to automate.&lt;br&gt;Example: re-enable S3 Block Public Access&lt;br&gt;within 60 seconds; quarantine-tag an&lt;br&gt;instance GuardDuty flags for crypto-mining." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1126" y="708" width="340" height="77" as="geometry"/></mxCell>
<mxCell id="c31" value="Rule of thumb: if a violation is never acceptable, prevent it; if it is sometimes acceptable, detect it and track the exception with an expiry date." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="1420" height="17" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="guardrail-rollout" name="5. Guardrail rollout"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="650" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Guardrails as code: every SCP and RCP change goes through staging accounts before it can break production" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1460" height="24" as="geometry"/></mxCell>
