<mxCell id="c34" value="The OUs people forget (from AWS's &quot;Organizing your AWS environment&quot; guidance)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="632" width="900" height="19" as="geometry"/></mxCell>
<mxCell id="c35" value="&lt;b&gt;Sandbox OU&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#7AA116;fillColor=#F5F9EC;dashed=0;fontSize=12;fontStyle=0;fontColor=#7AA116;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="280" height="140" as="geometry"/></mxCell>
<mxCell id="c36" value="Per-engineer accounts.&lt;br&gt;No TGW attachment, no prod&lt;br&gt;data. $150 budget; a Budgets&lt;br&gt;action attaches a deny SCP&lt;br&gt;at 100%." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="32" y="688" width="260" height="77" as="geometry"/></mxCell>
<mxCell id="c37" value="&lt;b&gt;Policy Staging OU&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#E7157B;fillColor=#FFF5FA;dashed=0;fontSize=12;fontStyle=0;fontColor=#E7157B;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="314" y="660" width="280" height="140" as="geometry"/></mxCell>
<mxCell id="c38" value="Canary accounts that get every&lt;br&gt;new SCP/RCP first. 7-day soak&lt;br&gt;while AccessDenied events&lt;br&gt;are watched in CloudTrail." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="326" y="688" width="260" height="62" as="geometry"/></mxCell>
<mxCell id="c39" value="&lt;b&gt;Exceptions OU&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#DD344C;fillColor=#FDF3F4;dashed=0;fontSize=12;fontStyle=0;fontColor=#DD344C;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="608" y="660" width="280" height="140" as="geometry"/></mxCell>
<mxCell id="c40" value="Workloads with an approved,&lt;br&gt;dated exception (e.g. a vendor&lt;br&gt;needing a region you block).&lt;br&gt;Reviewed every 90 days." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="620" y="688" width="260" height="62" as="geometry"/></mxCell>
<mxCell id="c41" value="&lt;b&gt;Transitional OU&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#8C4FFF;fillColor=#FAF7FF;dashed=0;fontSize=12;fontStyle=0;fontColor=#8C4FFF;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="902" y="660" width="280" height="140" as="geometry"/></mxCell>
<mxCell id="c42" value="Accounts arriving from an&lt;br&gt;acquisition. Only the&lt;br&gt;audit-trail SCPs at first,&lt;br&gt;then moved to Workloads." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="914" y="688" width="260" height="62" as="geometry"/></mxCell>
<mxCell id="c43" value="&lt;b&gt;Suspended OU&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#7D8998;fillColor=#F7F8FA;dashed=0;fontSize=12;fontStyle=0;fontColor=#7D8998;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1196" y="660" width="280" height="140" as="geometry"/></mxCell>
<mxCell id="c44" value="Deny-all SCP. Accounts wait&lt;br&gt;here before closure, so&lt;br&gt;nobody can recreate&lt;br&gt;resources in them." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1208" y="688" width="260" height="62" as="geometry"/></mxCell>
<mxCell id="c45" value="&lt;b&gt;Organization policy types and the limits that shape the design&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#E7157B;fillColor=#FFF5FA;dashed=0;fontSize=12;fontStyle=0;fontColor=#E7157B;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="820" width="1460" height="150" as="geometry"/></mxCell>
<mxCell id="c46" value="SCP: limits what principals in your accounts can do (never grants)&lt;br&gt;RCP: limits what anyone can do to your resources (S3, KMS, STS, SQS, Secrets Manager...)&lt;br&gt;Declarative policy: enforced by the service itself (e.g. EC2 public sharing, IMDS)&lt;br&gt;Tag, backup and AI-services opt-out policies: consistency, not security" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="852" width="720" height="66" as="geometry"/></mxCell>
<mxCell id="c47" value="Up to 5 SCPs and 5 RCPs attached per root, OU or account&lt;br&gt;Each SCP or RCP document: max 5,120 characters&lt;br&gt;OU nesting: up to 5 levels below the root&lt;br&gt;Neither SCPs nor RCPs affect the management account or service-linked roles" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="790" y="852" width="680" height="66" as="geometry"/></mxCell>
<mxCell id="c48" value="Design rule: put a policy on the highest OU where it is always true, and keep OU depth to 2-3 so the 5-policy limit never forces you to merge unrelated statements." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="936" width="1420" height="17" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="account-vending" name="2. Account vending with AFT"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Account vending: one pull request in, a governed account out (Control Tower Account Factory for Terraform)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1400" height="24" as="geometry"/></mxCell>
<mxCell id="team" value='&lt;b&gt;Team lead&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;needs dev, stg, prod&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.users;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="repo" value="&lt;b&gt;account-requests repo&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#7D8998;fillColor=#F7F8FA;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="150" y="112" width="180" height="120" as="geometry"/></mxCell>
<mxCell id="c3" value="One Terraform module&lt;br&gt;call per account. CODEOWNERS:&lt;br&gt;platform team approves." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="160" y="148" width="165" height="44" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;b&gt;AFT management account (Infrastructure OU)&lt;/b&gt;" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="1"><mxGeometry x="360" y="70" width="560" height="300" as="geometry"/></mxCell>
<mxCell id="cp" value='&lt;b&gt;account-request&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;pipeline&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codepipeline;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="390" y="126" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="ddb" value='&lt;b&gt;aft-request&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;table&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="520" y="126" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="lam" value='&lt;b&gt;request&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;processor&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="650" y="126" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="sqs" value='&lt;b&gt;FIFO queue&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;ordered, throttled&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="800" y="126" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="cp2" value='&lt;b&gt;per-account&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;customizations&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codepipeline;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="520" y="258" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="sfn" value='&lt;b&gt;provisioning&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;framework&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.step_functions;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="650" y="258" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="eb" value='&lt;b&gt;CreateManaged&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;Account event&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="800" y="258" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;Management account&lt;/b&gt;" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="1"><mxGeometry x="960" y="70" width="510" height="300" as="geometry"/></mxCell>
<mxCell id="ct" value='&lt;b&gt;Account Factory&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;(Service Catalog product)&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.control_tower;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1010" y="126" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="org" value='&lt;b&gt;CreateAccount,&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;place in target OU&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.organizations;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1180" y="126" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="sso" value='&lt;b&gt;Identity Center&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;user + assignments&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.single_sign_on;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1350" y="126" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="c6" value="The account inherits the target OU's SCPs, RCPs and&lt;br&gt;Control Tower controls the moment it lands. No gap&lt;br&gt;where a fresh account is ungoverned." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="990" y="300" width="460" height="47" as="geometry"/></mxCell>
