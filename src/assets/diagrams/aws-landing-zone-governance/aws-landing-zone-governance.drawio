<mxCell id="c15" value="Count AccessDenied&lt;br&gt;events that name a&lt;br&gt;service control policy&lt;br&gt;or resource control policy" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="774" y="170" width="190" height="66" as="geometry"/></mxCell>
<mxCell id="c16" style="edgeStyle=none;html=1;rounded=0;strokeColor=#232F3E;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="195" as="sourcePoint"/><mxPoint x="760" y="195" as="targetPoint"/></mxGeometry></mxCell>
