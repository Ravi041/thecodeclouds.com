<mxCell id="c48" value="roles" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#DD344C;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="994" y="230" width="50" height="16" as="geometry"/></mxCell>
<mxCell id="c49" value="&lt;b&gt;Temporary elevated access (prod writes)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#E7157B;fillColor=#FFF5FA;dashed=0;fontSize=12;fontStyle=0;fontColor=#E7157B;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="476" width="470" height="334" as="geometry"/></mxCell>
<mxCell id="u1" value="&lt;b&gt;Engineer&lt;/b&gt;" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.users;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="46" y="524" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="appr" value='&lt;b&gt;Approver&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;on-call lead&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.users;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="196" y="524" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="as" value='&lt;b&gt;Assignment&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;for 60 min&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.single_sign_on;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="346" y="524" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="c50" style="edgeStyle=none;html=1;rounded=0;strokeColor=#232F3E;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="u1" target="appr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c51" style="edgeStyle=none;html=1;rounded=0;strokeColor=#232F3E;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="appr" target="as"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c52" value="1. Request: account, permission set, duration,&lt;br&gt;    ticket or incident ID, reason&lt;br&gt;2. Approval by someone else (two for PlatformAdmin)&lt;br&gt;3. A Step Functions workflow creates the account&lt;br&gt;    assignment, then deletes it when time is up&lt;br&gt;4. Every request, approval and API call lands in&lt;br&gt;    CloudTrail in Log Archive&lt;br&gt;&lt;br&gt;AWS publishes an open-source reference for this&lt;br&gt;(TEAM, temporary elevated access management).&lt;br&gt;IdP-side PIM works too; the point is that standing&lt;br&gt;prod-write access is zero." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="440" height="182" as="geometry"/></mxCell>
<mxCell id="c53" value="&lt;b&gt;Machines: CI/CD with OIDC, no access keys&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#8C4FFF;fillColor=#FAF7FF;dashed=0;fontSize=12;fontStyle=0;fontColor=#8C4FFF;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="510" y="476" width="470" height="334" as="geometry"/></mxCell>
<mxCell id="gh" value='&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;job&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.external_sdk;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="536" y="524" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="sts" value='&lt;b&gt;IAM OIDC provider&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;+ deploy role&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="700" y="524" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="tgt" value='&lt;b&gt;orders-prod&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;resources&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eks;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="866" y="524" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="c54" style="edgeStyle=none;html=1;rounded=0;strokeColor=#232F3E;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gh" target="sts"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c55" style="edgeStyle=none;html=1;rounded=0;strokeColor=#232F3E;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sts" target="tgt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c56" value='Trust policy condition on the deploy role:&lt;br&gt;  token.actions.githubusercontent.com:sub =&lt;br&gt;  "repo:acme/orders:environment:prod"&lt;br&gt;&lt;br&gt;Only the prod environment of that one repo,&lt;br&gt;after its required reviewers approve, can&lt;br&gt;assume the prod deploy role. Credentials&lt;br&gt;last one hour and are never stored.&lt;br&gt;&lt;br&gt;SCP on Workloads OU: deny iam:CreateUser&lt;br&gt;and iam:CreateAccessKey for everyone.' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="530" y="610" width="440" height="167" as="geometry"/></mxCell>
<mxCell id="c57" value="&lt;b&gt;Root and break-glass&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#DD344C;fillColor=#FDF3F4;dashed=0;fontSize=12;fontStyle=0;fontColor=#DD344C;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1000" y="476" width="480" height="334" as="geometry"/></mxCell>
<mxCell id="root" value='&lt;b&gt;Centralized root&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;access&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.organizations;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1030" y="524" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="bg" value='&lt;b&gt;2 break-glass&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;IAM users (mgmt)&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1190" y="524" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="al" value='&lt;b&gt;Login alarm&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;&amp;lt; 1 min page&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1350" y="524" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="c58" style="edgeStyle=none;html=1;rounded=0;strokeColor=#DD344C;strokeWidth=2;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="bg" target="al"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c59" value="Member accounts: root credentials removed.&lt;br&gt;The few root-only tasks (unlock a bucket&lt;br&gt;policy that denies everyone, for example)&lt;br&gt;run as a short sts:AssumeRoot session&lt;br&gt;from the management account.&lt;br&gt;&lt;br&gt;Break-glass: two IAM users in the management&lt;br&gt;account, hardware MFA keys in two safes,&lt;br&gt;used only when Identity Center or the IdP is&lt;br&gt;down. Any ConsoleLogin by them pages the&lt;br&gt;security on-call and is tested every quarter." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1020" y="610" width="450" height="167" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="logging-detection" name="4. Central logging and detection"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="870" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Central logging and detection: evidence in one place nobody can edit, findings in one place somebody watches" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1460" height="24" as="geometry"/></mxCell>
<mxCell id="c2" value="&lt;b&gt;Every member account (180 and counting)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#CD2264;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#CD2264;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="64" width="380" height="560" as="geometry"/></mxCell>
<mxCell id="w0" value="&lt;b&gt;orders-prod&lt;/b&gt;" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="1"><mxGeometry x="36" y="98" width="348" height="132" as="geometry"/></mxCell>
<mxCell id="ct0" value="&lt;b&gt;Org trail&lt;/b&gt;" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudtrail;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="138" width="40" height="40" as="geometry"/></mxCell>
