<mxCell id="i5" value="&lt;b&gt;&lt;/b&gt;" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.organizations;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1321" y="104" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="c23" value="Change window,&lt;br&gt;on-call aware,&lt;br&gt;rollback rehearsed" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1254" y="170" width="190" height="50" as="geometry"/></mxCell>
<mxCell id="c24" style="edgeStyle=none;html=1;rounded=0;strokeColor=#232F3E;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1210" y="195" as="sourcePoint"/><mxPoint x="1240" y="195" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c25" style="edgeStyle=none;html=1;rounded=0;strokeColor=#DD344C;strokeWidth=2;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1345" y="270" as="sourcePoint"/><mxPoint x="145" y="270" as="targetPoint"/><Array as="points"><mxPoint x="1345" y="310"/><mxPoint x="145" y="310"/></Array></mxGeometry></mxCell>
<mxCell id="c26" value="Rollback: git revert, pipeline detaches the policy. Target: under 15 minutes from first alarm to detached." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#DD344C;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="360" y="316" width="900" height="18" as="geometry"/></mxCell>
<mxCell id="c27" value='&lt;b&gt;What "watch AccessDenied" means in practice (Athena over the org trail in Log Archive)&lt;/b&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#C925D1;fillColor=#FBF3FD;dashed=0;fontSize=12;fontStyle=0;fontColor=#C925D1;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="700" height="270" as="geometry"/></mxCell>
<mxCell id="c28" value="SELECT recipientaccountid, eventsource, eventname,&lt;br&gt;       count(*) AS denied&lt;br&gt;FROM   cloudtrail_org&lt;br&gt;WHERE  errorcode = 'AccessDenied'&lt;br&gt;  AND  (errormessage LIKE '%service control policy%'&lt;br&gt;        OR errormessage LIKE '%resource control policy%')&lt;br&gt;  AND  from_iso8601_timestamp(eventtime)&lt;br&gt;         &amp;gt; now() - interval '1' day&lt;br&gt;GROUP  BY 1, 2, 3&lt;br&gt;ORDER  BY denied DESC;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="394" width="660" height="162" as="geometry"/></mxCell>
<mxCell id="c29" value="Run hourly during a soak. A new row that is not an attack is a guardrail bug." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="600" width="660" height="17" as="geometry"/></mxCell>
<mxCell id="c30" value="&lt;b&gt;Why the staging OU exists: a real failure it would have caught&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#DD344C;fillColor=#FDF3F4;dashed=0;fontSize=12;fontStyle=0;fontColor=#DD344C;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="760" y="360" width="700" height="270" as="geometry"/></mxCell>
<mxCell id="c31" value="A region-deny SCP allowing only eu-west-1 and eu-central-1 went&lt;br&gt;straight to the Workloads OU on a Tuesday at 10:00.&lt;br&gt;&lt;br&gt;10:04  CloudFront deploys start failing: the ACM certificate for a&lt;br&gt;           CloudFront distribution must be requested in us-east-1&lt;br&gt;10:20  47 failed pipeline runs across 19 accounts&lt;br&gt;10:31  Policy detached by hand from the console&lt;br&gt;11:30  Fixed version exempts acm:* in us-east-1 for the&lt;br&gt;           pipeline role; goes through staging this time&lt;br&gt;&lt;br&gt;The canary accounts deploy a CloudFront distribution every day.&lt;br&gt;That one daily job would have failed in staging, not in 19 teams." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="780" y="394" width="670" height="182" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
