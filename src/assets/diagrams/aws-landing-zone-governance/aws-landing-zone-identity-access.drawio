<mxCell id="tgt" value='&lt;b&gt;orders-prod&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;resources&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eks;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="866" y="524" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="c54" style="edgeStyle=none;html=1;rounded=0;strokeColor=#232F3E;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gh" target="sts"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c55" style="edgeStyle=none;html=1;rounded=0;strokeColor=#232F3E;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sts" target="tgt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c56" value='Trust policy condition on the deploy role:&lt;br&gt;  token.actions.githubusercontent.com:sub =&lt;br&gt;  "repo:acme/orders:environment:prod"&lt;br&gt;&lt;br&gt;Only the prod environment of that one repo,&lt;br&gt;after its required reviewers approve, can&lt;br&gt;assume the prod deploy role. Credentials&lt;br&gt;last one hour and are never stored.&lt;br&gt;&lt;br&gt;SCP on Workloads OU: deny iam:CreateUser&lt;br&gt;and iam:CreateAccessKey for everyone.' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="530" y="610" width="440" height="167" as="geometry"/></mxCell>
<mxCell id="c57" value="&lt;b&gt;Root and break-glass&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#DD344C;fillColor=#FDF3F4;dashed=0;fontSize=12;fontStyle=0;fontColor=#DD344C;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1000" y="476" width="480" height="334" as="geometry"/></mxCell>
<mxCell id="root" value='&lt;b&gt;Centralized root&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;access&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.organizations;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1030" y="524" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="bg" value='&lt;b&gt;2 break-glass&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;IAM users (mgmt)&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1190" y="524" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="al" value='&lt;b&gt;Login alarm&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;&amp;lt; 1 min page&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1350" y="524" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="c58" style="edgeStyle=none;html=1;rounded=0;strokeColor=#DD344C;strokeWidth=2;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="bg" target="al"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c59" value="Member accounts: root credentials removed.&lt;br&gt;The few root-only tasks (unlock a bucket&lt;br&gt;policy that denies everyone, for example)&lt;br&gt;run as a short sts:AssumeRoot session&lt;br&gt;from the management account.&lt;br&gt;&lt;br&gt;Break-glass: two IAM users in the management&lt;br&gt;account, hardware MFA keys in two safes,&lt;br&gt;used only when Identity Center or the IdP is&lt;br&gt;down. Any ConsoleLogin by them pages the&lt;br&gt;security on-call and is tested every quarter." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1020" y="610" width="450" height="167" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
