<mxCell id="c19" value="MEDIUM: ticket to owning team (CostCentre&lt;br&gt;tag), 14-day SLA. LOW: weekly review." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="940" y="560" width="520" height="32" as="geometry"/></mxCell>
