<mxCell id="c25" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pay" target="awsep"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="684"/><mxPoint x="240" y="762"/></Array></mxGeometry></mxCell>
<mxCell id="c26" value="&lt;b&gt;Endpoint policy (Secrets Manager)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#DD344C;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#DD344C;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="590" y="600" width="295" height="230" as="geometry"/></mxCell>
<mxCell id="c27" value="Allow secretsmanager:GetSecretValue&lt;br&gt;only when both are true:&lt;br&gt;  aws:PrincipalOrgID = o-a1b2c3d4e5&lt;br&gt;  aws:ResourceOrgID = o-a1b2c3d4e5&lt;br&gt;&lt;br&gt;Credentials from outside the org are&lt;br&gt;refused at this endpoint, and our own&lt;br&gt;roles cannot reach secrets in another&lt;br&gt;org through it (no exfiltration path)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="605" y="625" width="275" height="137" as="geometry"/></mxCell>
<mxCell id="c28" value="&lt;b&gt;Credit bureau (partner AWS account)&lt;/b&gt;" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="1"><mxGeometry x="950" y="530" width="530" height="330" as="geometry"/></mxCell>
<mxCell id="nlb" value='&lt;b&gt;Network Load Balancer&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;endpoint service,&lt;br&gt;acceptance required&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.network_load_balancer;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1000" y="600" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="bureau" value='&lt;b&gt;Credit check API&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;bureau VPC&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1250" y="600" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="c29" style="edgeStyle=none;html=1;rounded=0;strokeColor=#E7157B;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="nlb" target="bureau"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c30" style="edgeStyle=none;html=1;rounded=0;strokeColor=#E7157B;strokeWidth=2.5;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="vpce" target="nlb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="312" y="585"/><mxPoint x="930" y="585"/><mxPoint x="930" y="624"/></Array></mxGeometry></mxCell>
<mxCell id="c31" value="AWS PrivateLink, TCP 443, one direction only" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#E7157B;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="560" y="568" width="340" height="17" as="geometry"/></mxCell>
<mxCell id="c32" value="Only our account is an allowed principal on the&lt;br&gt;endpoint service. No peering, no route tables,&lt;br&gt;no CIDR coordination, and the bureau cannot&lt;br&gt;open a connection back into the CDE." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="975" y="715" width="490" height="62" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
