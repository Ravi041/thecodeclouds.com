<mxCell id="c19" value="&lt;b&gt;Service auth policy (fine-grained, owned by payments)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#DD344C;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#DD344C;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="985" y="225" width="460" height="175" as="geometry"/></mxCell>
<mxCell id="c20" value='"Effect": "Allow",&lt;br&gt;"Principal": {"AWS": "arn:aws:iam::&amp;lt;core-acct&amp;gt;:role/loans-svc"},&lt;br&gt;"Action": "vpc-lattice-svcs:Invoke",&lt;br&gt;"Resource": "&amp;lt;tokenizer-service-arn&amp;gt;/*",&lt;br&gt;"Condition": {&lt;br&gt;  "StringEquals": {"vpc-lattice-svcs:RequestMethod": "POST"},&lt;br&gt;  "StringLike": {"vpc-lattice-svcs:RequestPath": "/v1/tokens*"}}' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1000" y="250" width="440" height="107" as="geometry"/></mxCell>
<mxCell id="c21" value="Access logs to Security Lake. Allowed and denied&lt;br&gt;calls both show the caller role ARN." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="985" y="420" width="460" height="32" as="geometry"/></mxCell>
