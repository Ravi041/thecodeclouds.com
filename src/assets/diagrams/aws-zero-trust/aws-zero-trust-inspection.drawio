<mxCell id="c42" value="3" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="712" y="470" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c43" value="4" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1085" y="312" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c44" value="5" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1085" y="182" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c45" value="6" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1170" y="60" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="c46" value="Return path: public subnet RT sends 10.0.0.0/8 to the&lt;br&gt;same-AZ firewall endpoint, then TGW, then the firewall RT&lt;br&gt;picks the spoke. Both directions are inspected." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#147EBA;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="832" y="565" width="290" height="47" as="geometry"/></mxCell>
<mxCell id="c47" value="&lt;b&gt;Firewall policy: stateful, strict order, default action drop established + alert established&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#DD344C;fillColor=#FFF5F6;dashed=0;fontSize=12;fontStyle=0;fontColor=#DD344C;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="680" width="760" height="205" as="geometry"/></mxCell>
<mxCell id="c48" value="1. deny prod &amp;lt;-&amp;gt; non-prod by CIDR (belt and braces with the blackhole route)&lt;br&gt;2. allow core -&amp;gt; CDE tokenizer on TCP 443 only, from two named subnets&lt;br&gt;3. egress allow-list: 38 FQDNs matched on TLS SNI and HTTP Host (domain list rule group)&lt;br&gt;4. Suricata: drop TLS without SNI, drop non-TLS on 443, drop DNS over HTTPS resolvers&lt;br&gt;5. AWS managed threat signature groups (malware, botnet, emerging events) in drop mode&lt;br&gt;Alert and flow logs to S3 in the log archive account, then Security Lake.&lt;br&gt;Every rule change ships through a pipeline with a test VPC, alert mode first." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="35" y="712" width="740" height="114" as="geometry"/></mxCell>
<mxCell id="c49" value="&lt;b&gt;DNS and the things people forget&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#8C4FFF;fillColor=#FAF7FF;dashed=0;fontSize=12;fontStyle=0;fontColor=#8C4FFF;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="800" y="680" width="680" height="205" as="geometry"/></mxCell>
<mxCell id="c50" value="Route 53 Resolver DNS Firewall on every VPC: block known-bad lists,&lt;br&gt;Advanced rules for DNS tunnelling and DGA domains, alert on everything else.&lt;br&gt;Appliance mode keeps both directions of a flow in one AZ. Without it,&lt;br&gt;return traffic can land on the other AZ firewall and be dropped as asymmetric.&lt;br&gt;One firewall endpoint and one NAT gateway per AZ: losing an AZ loses only&lt;br&gt;that AZ, not every egress flow in the Region." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="815" y="712" width="660" height="98" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
