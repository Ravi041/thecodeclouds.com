<mxCell id="c10" value='"Effect": "Allow", "Principal": "*",&lt;br&gt;"Action": "vpc-lattice-svcs:Invoke",&lt;br&gt;"Condition": {"StringEquals":&lt;br&gt;  {"aws:PrincipalOrgID": "o-a1b2c3d4e5"}}' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="505" y="220" width="400" height="62" as="geometry"/></mxCell>
<mxCell id="c11" value="&lt;b&gt;On every request Lattice&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#545B64;fillColor=#F7F8FA;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="490" y="325" width="420" height="160" as="geometry"/></mxCell>
<mxCell id="c12" value="1. resolves tokenizer.bank.internal to a link-local address&lt;br&gt;2. checks the SigV4 signature and the network policy&lt;br&gt;3. checks the service policy (both must allow)&lt;br&gt;4. forwards to a healthy target in the payments VPC&lt;br&gt;5. writes an access log: caller ARN, path, status&lt;br&gt;&lt;br&gt;No TGW hop, no route tables, no CIDR overlap issue." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="505" y="350" width="400" height="107" as="geometry"/></mxCell>
