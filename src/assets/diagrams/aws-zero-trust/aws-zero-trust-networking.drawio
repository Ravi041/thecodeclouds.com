<mxCell id="c25" value="Verified Access endpoints: internal ALBs (HTTPS) and RDS (TCP)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#147EBA;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="800" y="55" width="420" height="17" as="geometry"/></mxCell>
<mxCell id="c26" value="&lt;b&gt;Security tooling account&lt;/b&gt;" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="1"><mxGeometry x="1270" y="80" width="195" height="885" as="geometry"/></mxCell>
<mxCell id="sec0" value='&lt;b&gt;Security Lake&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;OCSF: flow, DNS, VA,&lt;br&gt;Lattice, firewall logs&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.security_lake;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1343" y="120" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="sec1" value='&lt;b&gt;GuardDuty&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;runtime + DNS&lt;br&gt;anomaly findings&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.guardduty;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1343" y="280" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="sec2" value='&lt;b&gt;Security Hub&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;findings and&lt;br&gt;control status&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.security_hub;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1343" y="440" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="sec3" value='&lt;b&gt;Network Access Analyzer&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;nightly scopes:&lt;br&gt;no path into the CDE&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.vpc_network_access_analyzer;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1343" y="600" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="sec4" value='&lt;b&gt;Firewall Manager&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;NFW and DNS Firewall&lt;br&gt;policies org-wide&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.firewall_manager;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1343" y="760" width="48" height="48" as="geometry"/></mxCell>
<mxCell id="c27" value="&lt;b&gt;Legend&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#9AA0A6;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#3C4043;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="800" y="790" width="215" height="93" as="geometry"/></mxCell>
<mxCell id="c28" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8C4FFF;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="814" y="828" as="sourcePoint"/><mxPoint x="854" y="828" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c29" value="routed via Transit Gateway" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="866" y="821" width="139" height="17" as="geometry"/></mxCell>
<mxCell id="c30" style="edgeStyle=none;html=1;rounded=0;strokeColor=#147EBA;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="814" y="849" as="sourcePoint"/><mxPoint x="854" y="849" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c31" value="workforce access" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="866" y="842" width="139" height="17" as="geometry"/></mxCell>
<mxCell id="c32" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7AA116;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=none;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="814" y="870" as="sourcePoint"/><mxPoint x="854" y="870" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c33" value="inspected egress" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3C4043;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="866" y="863" width="139" height="17" as="geometry"/></mxCell>
<mxCell id="c34" value='&lt;b&gt;The rules this design enforces&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;1. Identity is checked on every request&lt;br&gt;2. No route means no reach&lt;br&gt;3. Traffic between trust zones is inspected&lt;br&gt;4. Every flow is logged to Security Lake&lt;/font&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#DD344C;fillColor=#FFF5F6;dashed=0;fontSize=12;fontStyle=0;fontColor=#DD344C;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1030" y="790" width="220" height="125" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="workforce-access" name="2. Workforce access with Verified Access"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="840" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Workforce access without a VPN: AWS Verified Access checks who you are and what device you are on, on every request" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1400" height="24" as="geometry"/></mxCell>
<mxCell id="emp" value='&lt;b&gt;Loan officer&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;managed laptop,&lt;br&gt;CrowdStrike agent&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.client;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="52" height="52" as="geometry"/></mxCell>
<mxCell id="dba" value='&lt;b&gt;DBA on call&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;Connectivity Client&lt;br&gt;for TCP endpoints&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.client;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="340" width="52" height="52" as="geometry"/></mxCell>
<mxCell id="bad" value='&lt;b&gt;Same user, laptop&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;with agent disabled&lt;br&gt;(score drops to 22)&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.client;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="52" height="52" as="geometry"/></mxCell>
<mxCell id="c2" value="&lt;b&gt;Trust providers&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#DD344C;fillColor=#FFF5F6;dashed=0;fontSize=12;fontStyle=0;fontColor=#DD344C;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="240" y="60" width="400" height="120" as="geometry"/></mxCell>
<mxCell id="idc" value='&lt;b&gt;IAM Identity Center&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;OIDC, passkey MFA,&lt;br&gt;groups from the HR feed&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.single_sign_on;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="262" y="92" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="c3" value="Device trust provider&lt;br&gt;CrowdStrike Zero Trust&lt;br&gt;Assessment score 0-100" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="470" y="96" width="160" height="47" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;b&gt;Workforce access account&lt;/b&gt;" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="1"><mxGeometry x="240" y="200" width="560" height="610" as="geometry"/></mxCell>
<mxCell id="va" value='&lt;b&gt;Verified Access instance&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;both trust providers attached&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.verified_access;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="262" y="240" width="52" height="52" as="geometry"/></mxCell>
<mxCell id="g1" value="&lt;b&gt;Group: back-office (policy applies to every endpoint in it)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#DD344C;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#DD344C;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="262" y="320" width="520" height="170" as="geometry"/></mxCell>
<mxCell id="c6" value='permit(principal, action, resource)&lt;br&gt;when {&lt;br&gt;  context.idc.groups has "&amp;lt;loan-officers-group-id&amp;gt;"&lt;br&gt;    &amp;amp;&amp;amp; context.crwd.assessment.overall &amp;gt;= 70&lt;br&gt;};' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="280" y="346" width="490" height="77" as="geometry"/></mxCell>
<mxCell id="c7" value="Endpoint: loans.internal.bank  -&amp;gt;  internal ALB (HTTPS)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#147EBA;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="280" y="452" width="490" height="17" as="geometry"/></mxCell>
<mxCell id="g2" value="&lt;b&gt;Group: database-admin&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;strokeColor=#DD344C;fillColor=#FFFFFF;dashed=0;fontSize=12;fontStyle=0;fontColor=#DD344C;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="262" y="505" width="520" height="150" as="geometry"/></mxCell>
<mxCell id="c9" value='permit(principal, action, resource)&lt;br&gt;when {&lt;br&gt;  context.idc.groups has "&amp;lt;dba-oncall-group-id&amp;gt;"&lt;br&gt;    &amp;amp;&amp;amp; context.crwd.assessment.overall &amp;gt;= 80&lt;br&gt;};' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="280" y="531" width="490" height="77" as="geometry"/></mxCell>
<mxCell id="c10" value="Endpoint: ledger-db  -&amp;gt;  Aurora (TCP 5432)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#147EBA;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="280" y="628" width="490" height="17" as="geometry"/></mxCell>
<mxCell id="c11" value="Each request is evaluated again, so a posture change&lt;br&gt;mid-session ends access on the next request." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="262" y="670" width="520" height="32" as="geometry"/></mxCell>
<mxCell id="vlogs" value='&lt;b&gt;Access logs (OCSF)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;user, groups, device score,&lt;br&gt;decision, endpoint&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="262" y="725" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="lake" value='&lt;b&gt;Security Lake&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;in the security&lt;br&gt;tooling account&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.security_lake;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="590" y="725" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="c12" style="edgeStyle=none;html=1;rounded=0;strokeColor=#545B64;strokeWidth=1.5;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;endSize=4;startSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="747" as="sourcePoint"/><mxPoint x="590" y="747" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c13" value="&lt;b&gt;Core banking account&lt;/b&gt;" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="1"><mxGeometry x="840" y="60" width="630" height="750" as="geometry"/></mxCell>
<mxCell id="vpc" value="&lt;b&gt;Core VPC 10.48.0.0/18 (no IGW, no public subnets)&lt;/b&gt;" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=#FAF7FF;verticalAlign=top;align=left;spacingLeft=30;fontColor=#8C4FFF;dashed=0;" vertex="1" parent="1"><mxGeometry x="860" y="95" width="590" height="700" as="geometry"/></mxCell>
<mxCell id="alb" value='&lt;b&gt;Internal ALB&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;SG: inbound only from the&lt;br&gt;Verified Access endpoint SG&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.application_load_balancer;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="900" y="400" width="52" height="52" as="geometry"/></mxCell>
<mxCell id="app" value='&lt;b&gt;loans back office&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;EKS pods,&lt;br&gt;reads x-amzn-ava-user-context&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eks;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1120" y="400" width="52" height="52" as="geometry"/></mxCell>
<mxCell id="db" value='&lt;b&gt;Aurora PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#545B64"&gt;ledger cluster&lt;br&gt;IAM database auth&lt;/font&gt;' style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1120" y="620" width="52" height="52" as="geometry"/></mxCell>
